+def _enum_equality_declaration(name: str, enum_decl: str, decls: dict[str, dict[str, Any]],
+                               decl_hashes: dict[str, str] | None = None) -> str:
+    """Check the actual pinned export, not a guessed deriving-instance name.
+
+    The fixed frontend emits exactly `DecidableEq.{1} E`. Other aliases and
+    arbitrary BEq functions are outside this increment. The full local semantic
+    closure is checked here; production acceptance separately freezes its hashes
+    in the environment and obligation semantic closure.
+    """
+    from .exprjson import closure, constants, decl_hash
+    from .policy import NATIVE_AXIOM_MARKERS
+
+    row = decls.get(name)
+    if not isinstance(row, dict) or row.get("type") != app(const("DecidableEq", [1]), const(enum_decl)):
+        raise Unsupported(f"enumeration equality instance {name} has no exact nominal DecidableEq type")
+    if row.get("kind") != "definition" or row.get("level_params") or "value" not in row:
+        raise Unsupported(f"enumeration equality instance {name} is not a monomorphic computable definition")
+    for dependency in sorted(closure({name}, decls)):
+        c = decls[dependency]
+        if (c.get("safety") != "safe" or c.get("kind") not in
+                {"definition", "theorem", "inductive", "constructor", "recursor"}
+                or c.get("unresolved_constants")):
+            raise Unsupported(f"enumeration equality depends on unavailable or noncomputable declaration {dependency}")
+        axioms = {name_str(a) for a in c.get("axioms", [])}
+        # Choice can inhabit a Decidable type without executable decision
+        # machinery. This restriction does not change the global proof policy.
+        if axioms - {"propext", "Quot.sound"}:
+            raise Unsupported(f"enumeration equality depends on noncomputable or forbidden axioms in {dependency}")
+        refs = constants(c.get("value", {})) | constants(c["type"])
+        if any(n.startswith("Classical.") or n == "sorryAx" or
+               any(marker in n for marker in NATIVE_AXIOM_MARKERS) for n in refs):
+            raise Unsupported(f"enumeration equality depends on noncomputable or forbidden machinery in {dependency}")
+        actual_hash = decl_hash(c)
+        if decl_hashes is not None and decl_hashes.get(dependency) != actual_hash:
+            raise Unsupported(f"enumeration equality has stale semantic identity for {dependency}")
+    return decl_hash(row)
+
