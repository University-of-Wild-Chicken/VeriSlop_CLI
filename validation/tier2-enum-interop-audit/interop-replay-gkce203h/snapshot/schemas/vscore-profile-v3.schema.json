{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:verislop:schema:vscore-profile:0.3",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.3"
    },
    "format": {
      "const": "verislop.vscore-profile/0.3"
    },
    "language": {
      "const": "vscore/0.3"
    },
    "accepted_profile": {
      "type": "string"
    },
    "accepted_profile_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "enums": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "constructors": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "lean_decl": {"type": "string", "minLength": 1},
          "lean_constructors": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "decl_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "decidable_eq": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "lean_decl": {"type": "string", "minLength": 1},
              "decl_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
            },
            "required": ["lean_decl", "decl_hash"]
          }
        },
        "required": ["constructors"]
      }
    },
    "records": {
      "type": "object"
    },
    "symbols": {
      "type": "object"
    },
    "representation": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "format",
    "language",
    "accepted_profile",
    "accepted_profile_hash",
    "enums",
    "records",
    "symbols",
    "representation"
  ],
  "$comment": "Enum equality metadata is optional for legacy carrier/formula profiles. Accepted bindings contain only the exact AST-derived declaration name and semantic declaration hash; candidate_decidable_eq is forbidden. Kernel replay, safe computable closure, exact nominal instance type and accepted-profile byte/hash correspondence remain mandatory semantic checks."
}
