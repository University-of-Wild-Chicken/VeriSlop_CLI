{
  "ground": {
    "max_polarity_compilations": 2,
    "options": {
      "maxHeartbeats": 2000000,
      "maxRecDepth": 100000,
      "smartUnfolding": false
    },
    "polarity_order": [
      false,
      true
    ],
    "whole_probe_deadline_seconds": 30
  },
  "strict_policy": {
    "allowed_axioms": [
      "Classical.choice",
      "Quot.sound",
      "propext"
    ],
    "allowed_import_roots": [
      "Init",
      "Std",
      "Lean"
    ],
    "build_timeout_seconds": 300,
    "forbid_module_axioms": true,
    "gate": "accepted_and_proved",
    "id": "verislop.policy.strict/0.1",
    "kernel_timeout_seconds": 300,
    "memory_mb": 8192,
    "require_filesystem_isolation": true,
    "require_kernel_replay": true,
    "require_network_isolation": true,
    "require_witnesses": true
  },
  "unicode": {
    "compile_timeout_seconds": 300,
    "kernel_timeout_seconds": 30,
    "memory_mb": 8192
  }
}
