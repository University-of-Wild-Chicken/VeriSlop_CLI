{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:verislop:schema:formalizer-ast:0.1",
  "title": "Untrusted typed formalizer proposal; kernel-derived IR remains authoritative",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "encoding": {"const": "verislop.formalizer-ast/0.1"},
    "records": {"type": "object", "maxProperties": 128, "propertyNames": {"$ref": "#/$defs/identifier"}, "additionalProperties": {"$ref": "#/$defs/record"}},
    "symbols": {"type": "object", "maxProperties": 128, "propertyNames": {"$ref": "#/$defs/identifier"}, "additionalProperties": {"$ref": "#/$defs/symbol"}},
    "predicates": {"type": "object", "maxProperties": 128, "propertyNames": {"$ref": "#/$defs/identifier"}, "additionalProperties": {"$ref": "#/$defs/predicate"}},
    "theorems": {"type": "object", "maxProperties": 128, "propertyNames": {"$ref": "#/$defs/identifier"}, "additionalProperties": {"type": "object", "additionalProperties": false, "properties": {"formula": {"type": "object"}}, "required": ["formula"]}},
    "obligations": {"type": "object", "maxProperties": 128, "additionalProperties": {"$ref": "#/$defs/binding"}},
    "witness_obligations": {"type": "object", "maxProperties": 128, "propertyNames": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"}, "additionalProperties": {"$ref": "#/$defs/witness"}}
  },
  "required": ["encoding", "records", "symbols", "predicates", "theorems", "obligations", "witness_obligations"],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "not": {"pattern": "^_vs_"}},
    "sort": {"oneOf": [
      {"enum": ["Nat", "Int", "String", "Bool", "Unit"]},
      {"type": "object", "additionalProperties": false, "properties": {"list": {"$ref": "#/$defs/sort"}}, "required": ["list"]},
      {"type": "object", "additionalProperties": false, "properties": {"record": {"$ref": "#/$defs/identifier"}}, "required": ["record"]},
      {"type": "object", "additionalProperties": false, "properties": {"result": {"type": "object", "additionalProperties": false, "properties": {"error": {"$ref": "#/$defs/sort"}, "ok": {"$ref": "#/$defs/sort"}}, "required": ["error", "ok"]}}, "required": ["result"]}
    ]},
    "record": {"type": "object", "additionalProperties": false, "properties": {"fields": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "properties": {"name": {"$ref": "#/$defs/identifier"}, "sort": {"$ref": "#/$defs/sort"}}, "required": ["name", "sort"]}}}, "required": ["fields"]},
    "symbol": {"type": "object", "additionalProperties": false, "properties": {"args": {"type": "array", "items": {"$ref": "#/$defs/sort"}}, "result": {"$ref": "#/$defs/sort"}, "body": {"type": "object"}}, "required": ["args", "result", "body"]},
    "predicate": {"type": "object", "additionalProperties": false, "properties": {"args": {"type": "array", "items": {"$ref": "#/$defs/sort"}}, "formula": {"type": "object"}}, "required": ["args", "formula"]},
    "declaration_ref": {"type": "object", "additionalProperties": false, "properties": {"kind": {"enum": ["record", "symbol", "predicate"]}, "name": {"$ref": "#/$defs/identifier"}}, "required": ["kind", "name"]},
    "binding": {"oneOf": [
      {"type": "object", "additionalProperties": false, "properties": {"theorem": {"$ref": "#/$defs/identifier"}}, "required": ["theorem"]},
      {"type": "object", "additionalProperties": false, "properties": {"predicate": {"$ref": "#/$defs/identifier"}}, "required": ["predicate"]},
      {"type": "object", "additionalProperties": false, "properties": {"declarations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/declaration_ref"}}}, "required": ["declarations"]},
      {"type": "object", "maxProperties": 0}
    ]},
    "witness": {"type": "object", "additionalProperties": false, "properties": {"theorem": {"$ref": "#/$defs/identifier"}, "witnesses_for": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "description": {"type": "string", "minLength": 1}}, "required": ["theorem", "witnesses_for", "description"]}
  },
  "$comment": "Term/formula typing, predicate macro typing, frozen role/ID preservation, primitive-shadow exclusion, scope budgets, declaration cycles and witness semantics require formal_frontend and the existing kernel pipeline; JSON Schema proves structure only. Predicate calls are frontend-only and are never downstream accepted DSL nodes."
}
