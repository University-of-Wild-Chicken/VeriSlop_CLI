    {
      "id": "O2",
      "kind": "postcondition",
      "role": "guarantee",
      "statement": "The output field labels is the list of remaining input labels (excluding empty strings) with the prefix concatenated to the front of each, preserving original order and duplicates.",
      "required": true,
      "scope": [
        "output labels content"
      ],
      "dependencies": [
        {
          "id": "A1",
          "relation": "assumes"
        },
        {
          "id": "D3",
          "relation": "uses_definition"
        }
      ],
      "acceptance_criteria": [
        "For each input label L in data['labels'] where L != '', the output contains prefix + L at the corresponding position",
        "Input labels where L == '' are not present in the output",
        "The relative order of non-empty labels is preserved",
        "Duplicate non-empty labels appear the same number of times in the output as in the input"
      ],
      "sources": [
        {
          "quote": "Remove exactly the labels that are the empty string.",
          "origin": "explicit",
          "interpretation": "filtering rule"
        },
        {
          "quote": "For every remaining label, concatenate prefix followed by that label.",
          "origin": "explicit",
          "interpretation": "transformation rule"
        },
        {
          "quote": "Preserve original order and duplicates.",
          "origin": "explicit",
          "interpretation": "ordering and multiplicity preservation"
        }
      ]
    },
