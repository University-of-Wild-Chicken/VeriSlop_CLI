{"encoding": "verislop.autonomous-critique/0.1", "phase": "formalize", "attempt": 1, "request": "Implement a Python function solve(data) for a row filtering and projection pipeline.\nThe input is a JSON object with exactly the fields rows and minimum. minimum is a signed integer. rows is a list of JSON objects, each with exactly the fields tag, amount and enabled: tag is a Unicode string, amount is a signed integer and enabled is a Boolean.\nKeep exactly the rows whose enabled field is true and whose amount is greater than or equal to minimum. Preserve original order and duplicates.\nReturn a JSON object with exactly the fields rows, total and count. Each output row has exactly the fields tag and amount, copied without alteration from its retained input row. total is the sum of retained amounts and count is the number of retained rows.\nAn empty result has rows equal to an empty list, total equal to zero and count equal to zero. Arithmetic is exact arbitrary-precision signed integer arithmetic. Preserve Unicode strings exactly, including empty strings, whitespace and combining characters.\nInputs outside the stated schema and environmental effects are outside this task's scope.\n", "clauses": [{"clause_id": "C1", "quote": "Implement a Python function solve(data) for a row filtering and projection pipeline.", "refs": ["D1"]}, {"clause_id": "C2", "quote": "The input is a JSON object with exactly the fields rows and minimum.", "refs": ["D1"]}, {"clause_id": "C3", "quote": "minimum is a signed integer.", "refs": ["D2"]}, {"clause_id": "C4", "quote": "rows is a list of JSON objects, each with exactly the fields tag, amount and enabled: tag is a Unicode string, amount is a signed integer and enabled is a Boolean.", "refs": ["D3", "D4"]}, {"clause_id": "C5", "quote": "Keep exactly the rows whose enabled field is true and whose amount is greater than or equal to minimum.", "refs": ["O2"]}, {"clause_id": "C6", "quote": "Preserve original order and duplicates.", "refs": ["O2"]}, {"clause_id": "C7", "quote": "Return a JSON object with exactly the fields rows, total and count.", "refs": ["O1"]}, {"clause_id": "C8", "quote": "Each output row has exactly the fields tag and amount, copied without alteration from its retained input row.", "refs": ["O3"]}, {"clause_id": "C9", "quote": "total is the sum of retained amounts and count is the number of retained rows.", "refs": ["O4"]}, {"clause_id": "C10", "quote": "An empty result has rows equal to an empty list, total equal to zero and count equal to zero.", "refs": ["O5"]}, {"clause_id": "C11", "quote": "Arithmetic is exact arbitrary-precision signed integer arithmetic.", "refs": ["I1"]}, {"clause_id": "C12", "quote": "Preserve Unicode strings exactly, including empty strings, whitespace and combining characters.", "refs": ["I2"]}, {"clause_id": "C13", "quote": "Inputs outside the stated schema and environmental effects are outside this task's scope.", "refs": ["N1", "N2"]}], "records": [{"id": "D1", "revision": 1, "kind": "entity", "role": "declaration", "statement": "The function solve(data) accepts a JSON object with exactly the fields rows and minimum.", "required": true, "source_refs": [{"document_hash": "sha256:f24a391c9fb1c31e0d6fbfa13527bcb28a855696a85bdb7b7f2b70830b1acdfa", "document_ref": "data-pipelines/P02-row-projection.txt", "end_byte": 84, "interpretation": "function signature and purpose", "origin": "explicit", "start_byte": 0}, {"document_hash": "sha256:f24a391c9fb1c31e0d6fbfa13527bcb28a855696a85bdb7b7f2b70830b1acdfa", "document_ref": "data-pipelines/P02-row-projection.txt", "end_byte": 153, "interpretation": "input structure", "origin": "explicit", "start_byte": 85}], "scope": ["input schema"], "dependencies": [], "acceptance_criteria": ["data is a JSON object", "data has exactly the keys 'rows' and 'minimum'"], "origin": "interpreted", "record_digest": "sha256:dce0c695f9af56686e4c87ec13fc0ade13dcbe0df8c25d2f6408383e2ce97c55", "blocked_by": []}, {"id": "D2", "revision": 1, "kind": "entity", "role": "declaration", "statement": "The field minimum is a signed integer.", "required": true, "source_refs": [{"document_hash": "sha256:f24a391c9fb1c31e0d6fbfa13527bcb28a855696a85bdb7b7f2b70830b1acdfa", "document_ref": "data-pipelines/P02-row-projection.txt", "end_byte": 182, "interpretation": "type of minimum", "origin": "explicit", "start_byte": 154}], "scope": ["input field minimum"], "dependencies": [{"id": "D1", "relation": "refines"}], "acceptance_criteria": ["minimum is an integer"], "origin": "interpreted", "record_digest": "sha256:e830089e0f0fe3dbb5821c1b658a665767052577fe68e4d55ff105b44b505126", "blocked_by": []}, {"id": "D3", "revision": 1, "kind": "entity", "role": "declaration", "statement": "The field rows is a list of JSON objects, each with exactly the fields tag, amount and enabled.", "required": true, "source_refs": [{"document_hash": "sha256:f24a391c9fb1c31e0d6fbfa13527bcb28a855696a85bdb7b7f2b70830b1acdfa", "document_ref": "data-pipelines/P02-row-projection.txt", "end_byte": 346, "interpretation": "structure of rows", "origin": "explicit", "start_byte": 183}], "scope": ["input field rows"], "dependencies": [{"id": "D1", "relation": "refines"}], "acceptance_criteria": ["rows is a list", "each element is a JSON object with exactly keys 'tag', 'amount', 'enabled'"], "origin": "interpreted", "record_digest": "sha256:70df0a885874895ece0fa43c013c95c693543431aed476da6bd2e53491e100f2", "blocked_by": []}, {"id": "D4", "revision": 1, "kind": "entity", "role": "declaration", "statement": "In each row, tag is a Unicode string, amount is a signed integer, and enabled is a Boolean.", "required": true, "source_refs": [{"document_hash": "sha256:f24a391c9fb1c31e0d6fbfa13527bcb28a855696a85bdb7b7f2b70830b1acdfa", "document_ref": "data-pipelines/P02-row-projection.txt", "end_byte": 346, "interpretation": "types of row fields", "origin": "explicit", "start_byte": 183}], "scope": ["row fields"], "dependencies": [{"id": "D3", "relation": "refines"}], "a