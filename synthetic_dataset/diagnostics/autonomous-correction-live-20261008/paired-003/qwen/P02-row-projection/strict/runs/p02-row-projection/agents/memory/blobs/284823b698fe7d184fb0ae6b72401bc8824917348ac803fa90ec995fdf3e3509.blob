t >= minimum", "The relative order of included rows matches the input order", "Duplicate rows are preserved"], "origin": "interpreted", "record_digest": "sha256:287361178197e55b47da7a440852dc0d770c0e5ddb14673201969464748cde09", "blocked_by": []}, {"id": "O3", "revision": 1, "kind": "postcondition", "role": "guarantee", "statement": "Each output row has exactly the fields tag and amount, copied without alteration from its retained input row.", "required": true, "source_refs": [{"document_hash": "sha256:f24a391c9fb1c31e0d6fbfa13527bcb28a855696a85bdb7b7f2b70830b1acdfa", "document_ref": "data-pipelines/P02-row-projection.txt", "end_byte": 668, "interpretation": "projection and copying", "origin": "explicit", "start_byte": 559}], "scope": ["projection logic"], "dependencies": [{"id": "O2", "relation": "refines"}], "acceptance_criteria": ["Each output row object has exactly keys 'tag' and 'amount'", "The value of 'tag' is identical to the input row's 'tag'", "The value of 'amount' is identical to the input row's 'amount'"], "origin": "interpreted", "record_digest": "sha256:832cff10d367ceac613cbe25576da103d29c73e2146d4ec2ee52a1af49be5b37", "blocked_by": []}, {"id": "O4", "revision": 1, "kind": "postcondition", "role": "guarantee", "statement": "The output total is the sum of the amount fields of all retained rows, and count is the number of retained rows.", "required": true, "source_refs": [{"document_hash": "sha256:f24a391c9fb1c31e0d6fbfa13527bcb28a855696a85bdb7b7f2b70830b1acdfa", "document_ref": "data-pipelines/P02-row-projection.txt", "end_byte": 747, "interpretation": "aggregation definitions", "origin": "explicit", "start_byte": 669}], "scope": ["aggregation logic"], "dependencies": [{"id": "O2", "relation": "uses_proof"}], "acceptance_criteria": ["total == sum(amount for row in retained_rows)", "count == len(retained_rows)"], "origin": "interpreted", "record_digest": "sha256:f5099391fed8045b1e10902eb73a4217b673e1eb6a4364111872ac0268a9ff24", "blocked_by": []}, {"id": 