{"obligations":[{"id":"D1","revision":1,"kind":"entity","role":"declaration","statement":"Implement the Python function solve(data) with input data a JSON object containing exactly labels and prefix; labels is a list of Unicode strings and prefix is a Unicode string, including the empty string.","required":true,"scope":["function interface","input domain"],"dependencies":[],"acceptance_criteria":["The function is named solve and accepts data.","The stated input domain has exactly fields labels and prefix.","labels contains Unicode strings; prefix is a Unicode string and may be empty."],"sources":[{"quote":"Implement a Python function solve(data) for a Unicode label pipeline.","origin":"explicit","interpretation":"Python function interface"},{"quote":"The input is a JSON object with exactly the fields labels and prefix.","origin":"explicit","interpretation":"Input object fields"},{"quote":"labels is a list of Unicode strings and prefix is a Unicode string.","origin":"explicit","interpretation":"Input types"},{"quote":"The prefix may be empty.","origin":"explicit","interpretation":"Empty prefix is permitted"}]},{"id":"O1","revision":1,"kind":"postcondition","role":"guarantee","statement":"For every input in the stated domain, produce the sequence of prefix concatenated with each original label whose value is not the empty string, preserving original order and multiplicity.","required":true,"scope":["all inputs in the stated schema"],"dependencies":[{"id":"D1","relation":"uses_definition"}],"acceptance_criteria":["Remove an input label if and only if it equals the empty string, before prefix concatenation.","Each retained label contributes exactly one output string equal to prefix followed by that label.","Retained labels appear in original order and duplicates remain duplicated.","With an empty prefix, each retained label appears unchanged."],"sources":[{"quote":"Remove exactly the labels that are the empty string.","origin":"explicit","interpretation":"Exact empty-string filtering"},{"quote":"For every remaining label, concatenate prefix followed by that label.","origin":"explicit","interpretation":"Prefix concatenation after filtering"},{"quote":"Preserve original order and duplicates.","origin":"explicit","interpretation":"Stable sequence and multiplicity"},{"quote":"The prefix may be empty.","origin":"explicit","interpretation":"Transformation applies also to an empty prefix"}]},{"id":"O2","revision":1,"kind":"postcondition","role":"guarantee","statement":"Return a JSON object with exactly labels and count, where labels is the sequence produced by O1 and count is its length; an empty sequence yields labels=[] and count=0.","required":true,"scope":["return value for every input in the stated schema"],"dependencies":[{"id":"O1","relation":"uses_proof"}],"acceptance_criteria":["The return object has exactly the fields labels and count.","The labels field equals the resulting list.","The count field equals the length of labels.","When no labels remain, return labels as an empty list and count as zero."],"sources":[{"quote":"Return a JSON object with exactly the fields labels and count.","origin":"explicit","interpretation":"Exact output object fields"},{"quote":"labels is the resulting list and count is its length.","origin":"explicit","interpretation":"Output values and count consistency"},{"quote":"An empty result has labels equal to an empty list and count equal to zero.","origin":"explicit","interpretation":"Empty-result behavior"}]},{"id":"O3","revision":1,"kind":"safety_property","role":"guarantee","statement":"Preserve the exact Unicode text of the prefix and every retained label during concatenation, without trimming whitespace or normalizing combining characters.","required":true,"scope":["prefix and retained labels","output strings"],"dependencies":[{"id":"D1","relation":"uses_definition"}],"acceptance_criteria":["Each output string contains the exact Unicode sequence of prefix followed by the exact Unicode sequence of the retained label.","Whitespace is preserved, including labels consisting only of whitespace.","Combining characters are preserved without normalization."],"sources":[{"quote":"Preserve Unicode text exactly.","origin":"explicit","interpretation":"Exact Unicode preservation"},{"quote":"Do not trim whitespace or normalize combining characters.","origin":"explicit","interpretation":"Forbidden text transformations"}]},{"id":"N1","revision":1,"kind":"explicit_non_goal","role":"exclusion","statement":"Behavior for inputs outside the stated schema and environmental effects are outside the task scope.","required":true,"scope":["out-of-schema inputs","environmental effects"],"dependencies":[{"id":"D1","relation":"uses_definition"}],"acceptance_criteria":["No behavior is required for inputs outside the stated schema.","Environmental effects have no obligations in this proposal."],"sources":[{"quote":"Inputs outside the stated schema and environmental effects are outside this task's scope.","origin":"explicit","interpretation":"Explicit scope exclusions"}]}],"category_review":{"entities":"Python solve(data), input object with labels and prefix, output object with labels and count","preconditions":"No separately stated caller assumptions; the input schema defines the task domain.","postconditions":"Exact empty-string filtering, prefix concatenation, order and duplicate preservation, exact output fields and length, empty-result behavior","invariants":"None separately stated","safety_properties":"Exact Unicode preservation without whitespace trimming or combining-character normalization","liveness_properties":"None stated","resource_constraints":"None stated","error_semantics":"Out-of-schema behavior is excluded","explicit_non_goals":"Out-of-schema inputs and environmental effects","ambiguities":"None"},"clauses":[{"clause_id":"C1","quote":"Implement a Python function solve(data) for a Unicode label pipeline.","disposition":"obligations","refs":["D1"],"note":""},{"clause_id":"C2","quote":"The input is a JSON object with exactly the fields labels and prefix.","disposition":"obligations","refs":["D1"],"note":""},{"clause_id":"C3","quote":"labels is a list of Unicode strings and prefix is a Unicode string.","disposition":"obligations","refs":["D1"],"note":""},{"clause_id":"C4","quote":"Remove exactly the labels that are the empty string.","disposition":"obligations","refs":["O1"],"note":""},{"clause_id":"C5","quote":"For every remaining label, concatenate prefix followed by that label.","disposition":"obligations","refs":["O1"],"note":""},{"clause_id":"C6","quote":"Preserve original order and duplicates.","disposition":"obligations","refs":["O1"],"note":""},{"clause_id":"C7","quote":"Return a JSON object with exactly the fields labels and count.","disposition":"obligations","refs":["O2"],"note":""},{"clause_id":"C8","quote":"labels is the resulting list and count is its length.","disposition":"obligations","refs":["O2"],"note":""},{"clause_id":"C9","quote":"An empty result has labels equal to an empty list and count equal to zero.","disposition":"obligations","refs":["O2"],"note":""},{"clause_id":"C10","quote":"Preserve Unicode text exactly.","disposition":"obligations","refs":["O3"],"note":""},{"clause_id":"C11","quote":"Do not trim whitespace or normalize combining characters.","disposition":"obligations","refs":["O3"],"note":""},{"clause_id":"C12","quote":"The prefix may be empty.","disposition":"obligations","refs":["D1","O1"],"note":""},{"clause_id":"C13","quote":"Inputs outside the stated schema and environmental effects are outside this task's scope.","disposition":"exclusion","refs":["N1"],"note":""}],"assumptions":[],"ambiguities":[],"selected_defaults":[]}