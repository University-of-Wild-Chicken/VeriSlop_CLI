{"files":{"solution.py":"def solve(x):\n    values = [v * x[\"factor\"] for v in x[\"values\"] if x[\"minimum\"] <= v]\n    return {\"values\": values, \"total\": sum(values), \"count\": len(values)}\n"},"bindings":{"schema_version":"0.1","artifact_kind":"implementation_bindings","target":"python","serialization_profile":"python-v0_2","bindings":[{"binding_id":"B-solve","symbol":"solve","object":{"file":"solution.py","qualname":"solve"},"obligations":["O1","O2","O3","O4","O5"]}],"helpers":[]}}