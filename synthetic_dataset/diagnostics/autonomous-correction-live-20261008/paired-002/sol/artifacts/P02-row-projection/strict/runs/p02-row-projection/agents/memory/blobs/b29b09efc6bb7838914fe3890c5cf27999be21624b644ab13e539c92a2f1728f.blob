n\",\n  role := \"guarantee\",\n  statement := \"All pipeline arithmetic uses exact arbitrary-precision signed integers.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"data-pipelines/P02-row-projection.txt\", documentHash := \"sha256:f24a391c9fb1c31e0d6fbfa13527bcb28a855696a85bdb7b7f2b70830b1acdfa\", startByte := 842, endByte := 908, origin := \"explicit\", interpretation := \"Required numeric semantics.\" }],\n  scope := [\"threshold comparison, summation and count\"],\n  dependencies := [{ id := \"D2\", relation := \"uses_definition\" }],\n  acceptanceCriteria := [\"Signed integer values and sums are represented exactly without overflow or rounding.\", \"Filtering comparisons and aggregate arithmetic remain correct for arbitrarily large positive and negative integers.\"],\n  bindings := [\"VeriSlopAST.pipeline_contract\"] }\n\ndef «O7» : Entry := {\n  id := \"O7\",\n  revision := 1,\n  kind := \"postcondition\",\n  role := \"guarantee\",\n  statement := \"Retained tags preserve their Unicode string values exactly, including empty strings, whitespace and combining characters.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"data-pipelines/P02-row-projection.txt\", documentHash := \"sha256:f24a391c9fb1c31e0d6fbfa13527bcb28a855696a85bdb7b7f2b70830b1acdfa\", startByte := 909, endByte := 1004, origin := \"explicit\", interpretation := \"Exact string preservation and explicit edge cases.\" }],\n  scope := [\"retained tag strings\"],\n  dependencies := [{ id := \"O3\", relation := \"uses_proof\" }],\n  acceptanceCriteria := [\"Each output tag has exactly the same Unicode sequence as its retained input tag.\", \"Empty strings, whitespace and combining characters are preserved without trimming or normalization.\"],\n  bindings := [\"VeriSlopAST.pipeline_contract\"] }\n\ndef «N1» : Entry := {\n  id := \"N1\",\n  revision := 1,\n  kind := \"explicit_non_goal\",\n  role := \"exclusion\",\n  statement := \"Behavior for inputs outside the stated schema