 kind := \"postcondition\",\n  role := \"guarantee\",\n  statement := \"The retained row occurrences preserve input order and multiplicity, including duplicates.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"data-pipelines/P02-row-projection.txt\", documentHash := \"sha256:f24a391c9fb1c31e0d6fbfa13527bcb28a855696a85bdb7b7f2b70830b1acdfa\", startByte := 451, endByte := 490, origin := \"explicit\", interpretation := \"Stable filtering with preserved multiplicity.\" }],\n  scope := [\"retained row sequence\"],\n  dependencies := [{ id := \"O1\", relation := \"uses_proof\" }],\n  acceptanceCriteria := [\"Retained occurrences appear in increasing original position order.\", \"Every qualifying duplicate occurrence appears once for each occurrence in the input.\"],\n  bindings := [\"VeriSlopAST.pipeline_contract\"] }\n\ndef «O3» : Entry := {\n  id := \"O3\",\n  revision := 1,\n  kind := \"postcondition\",\n  role := \"guarantee\",\n  statement := \"Return a JSON object with exactly rows, total and count. Its rows list contains one projection for each retained row occurrence, with exactly tag and amount copied without alteration.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"data-pipelines/P02-row-projection.txt\", documentHash := \"sha256:f24a391c9fb1c31e0d6fbfa13527bcb28a855696a85bdb7b7f2b70830b1acdfa\", startByte := 491, endByte := 558, origin := \"explicit\", interpretation := \"Exact output object schema.\" }, { documentRef := \"data-pipelines/P02-row-projection.txt\", documentHash := \"sha256:f24a391c9fb1c31e0d6fbfa13527bcb28a855696a85bdb7b7f2b70830b1acdfa\", startByte := 559, endByte := 668, origin := \"explicit\", interpretation := \"Exact projection schema and value preservation.\" }],\n  scope := [\"output structure and projection\"],\n  dependencies := [{ id := \"O1\", relation := \"uses_proof\" }, { id := \"O2\", relation := \"uses_proof\" }],\n  acceptanceCriteria := [\"The output object's keys are exactly rows, total and count.\", \"Output rows is the ordered list of retained projections.\", \"Each projected row has exactly tag and amount, equal to the respective retained input values.\"],\n  bindings := [\"VeriSlopAST.pipeline_contract\"] }\n\ndef «O4» : Entry := {\n  id := \"O4\",\n  revision := 1,\n  kind := \"postcondition\",\n  role := \"guarantee\",\n  statement := \"total equals the sum of retained amounts and count equals the number of retained row occurrences.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"data-pipelines/P02-row-projection.txt\", documentHash := \"sha256:f24a391c9fb1c31e0d6fbfa13527bcb28a855696a85bdb7b7f2b70830b1acdfa\", startByte := 669, endByte := 747, origin := \"explicit\", interpretation := \"Required aggregate values.\" }],\n  scope := [\"output aggregates\"],\n  dependencies := [{ id := \"O1\", relation := \"uses_proof\" }],\n  acceptanceCriteria := [\"total = sum of amount over all retained occurrences.\", \"count = number of retained occurrences, including duplicates.\"],\n  bindings := [\"VeriSlopAST.pipeline_contract\"] }\n\ndef «O5» : Entry := {\n  id := \"O5\",\n  revision := 1,\n  kind := \"postcondition\",\n  role := \"guarantee\",\n  statement := \"Whenever no rows are retained, the output has rows equal to an empty list, total equal to zero and count equal to zero.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"data-pipelines/P02-row-projection.txt\", documentHash := \"sha256:f24a391c9fb1c31e0d6fbfa13527bcb28a855696a85bdb7b7f2b70830b1acdfa\", startByte := 748, endByte := 841, origin := \"explicit\", interpretation := \"Explicit empty-result behavior.\" }],\n  scope := [\"empty input and inputs with no qualifying rows\"],\n  dependencies := [{ id := \"O1\", relation := \"uses_proof\" }],\n  acceptanceCriteria := [\"No retained occurrences implies rows = [], total = 0 and count = 0.\"],\n  bindings := [\"VeriSlopAST.pipeline_contract\"] }\n\ndef «O6» : Entry := {\n  id := \"O6\",\n  revision := 1,\n  kind := \"postcondition\",\n  role := \"guarantee\",\n  statement := \"All pipeline arithmetic uses exact arbitrary-precision signed integers.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"data-pipelines/P02-row-projection.txt\", documentHash := \"sha256:f24a391c9fb1c31e0d6fbfa13527bcb28a855696a85bdb7b7f2b70830b1acdfa\", startByte := 842, endByte := 908, origin := \"explicit\", interpretation := \"Required numeric semantics.\" }],\n  scope := [\"threshold comparison, summation and count\"],\n  dependencies := [{ id := \"D2\", relation := \"uses_definition\" }],\n  acceptanceCriteria := [\"Signed integer values and sums are represented exactly without overflow or rounding.\", \"Filtering comparisons and aggregate arithmetic remain correct for arbitrarily large positive and negative integers.\"],\n  bindings := [\"VeriSlopAST.pipeline_contract\"] }\n\ndef «O7» : Entry := {\n  id := \"O7\",\n  revision := 1,\n  kind := \"postcondition\",\n  role := \"guarantee\",\n  statement := \"Retained tags preserve their Unicode string values exactly, including empty strings, whitespace and combining characters.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"data-pipelines/P02-row-projection.txt\", documentHash := \"sha256:f24a391c9fb1c31e0d6fbfa13527bcb28a855696a85bdb7b7f2b70830b1acdfa\", startByte := 909, endByte := 1004, origin := \"explicit\", interpretation := \"Exact string preservation and explicit edge cases.\" }],\n  scope := [\"retained tag strings\"],\n  dependencies := [{ id := \"O3\", relation := \"uses_proof\" }],\n  acceptanceCriteria := [\"Each output tag has exactly the same Unicode sequence as its retained input tag.\", \"Empty strings, whitespace and combining characters are preserved without trimming or normalization.\"],\n  bindings := [\"VeriSlopAST.pipeline_contract\"] }\n\ndef «N1» : Entry := {\n  id := \"N1\",\n  revision := 1,\n  kind := \"explicit_non_goal\",\n  role := \"exclusion\",\n  statement := \"Behavior for inputs outside the stated schema 