{"files":{"implementation.py":"def solve(x):\n    rows = []\n    total = 0\n    for row in x['rows']:\n        if row['enabled'] and x['minimum'] <= row['amount']:\n            rows.append({'tag': row['tag'], 'amount': row['amount']})\n            total += row['amount']\n    return {'rows': rows, 'total': total, 'count': len(rows)}\n"},"bindings":{"schema_version":"0.1","artifact_kind":"implementation_bindings","target":"python","serialization_profile":"python-v0_2","bindings":[{"binding_id":"B-solve","symbol":"solve","object":{"file":"implementation.py","qualname":"solve"},"obligations":["D1","O1","O2","O3","O4","O5","O6","O7"]}],"helpers":[]}}