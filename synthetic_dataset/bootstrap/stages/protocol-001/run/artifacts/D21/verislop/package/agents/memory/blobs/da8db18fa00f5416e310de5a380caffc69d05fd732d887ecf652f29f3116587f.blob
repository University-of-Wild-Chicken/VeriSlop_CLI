  "kind": "invariant",
  "role": "guarantee",
  "statement": "Within each group, previous starts absent and after each bucket equals the sum of the latest nonempty emitted bucket processed so far, if one exists. Nonempty buckets update previous, including zero sums; empty buckets preserve it. Events before start never seed previous.",
  "required": true,
  "dependencies": [
