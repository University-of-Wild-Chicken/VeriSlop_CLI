 },
 {
  "id": "O2",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "Enumerate all unique event group names lexicographically, including groups with no in-range events. For each group emit buckets at start+k*width for nonnegative integers k strictly below end, covering [bucketStart,min(bucketStart+width,end)). Return records in group then ascending bucket order.",
  "required": true,
  "dependencies": [
   {
    "id": "D1",
    "relation": "uses_definition"
   }
  ],
  "acceptance_criteria": [
   "Groups equal the sorted set of all event group names.",
   "Bucket starts are exactly start+k*width<end for k>=0.",
   "Intervals include their left boundary and exclude their clipped right boundary.",
   "start=end produces no records.",
   "Empty events produces no records.",
   "Records contain group,start,count,value in the specified group then bucket order."
  ],
  "blocked_by": []
 },
 {
  "id": "O3",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "For each group and bucket, count every event occurrence in that group whose time lies in the bucket and whose value is non-null, and sum precisely those values. Duplicate occurrences contribute separately. A bucket is nonempty exactly when count>0, and its output value then equals the sum.",
  "required": true,
  "dependencies": [
   {
    "id": "O2",
    "relation": "uses_proof"
   }
  ],
  "acceptance_criteria": [
   "count equals the number of qualifying non-null event occurrences.",
   "Null and out-of-range values contribute neither count nor sum.",
   "Duplicates contribute separately.",
   "For count>0, value equals the sum, including zero and negative sums."
  ],
  "blocked_by": []
 },
 {
  "id": "O4",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "A bucket with count zero has null value for fill='none'. For fill='previous', its value is the latest preceding nonempty bucket sum within that group, or null before the first nonempty bucket.",
  "required": true,
  "dependencies": [
   {
    "id": "I1",
    "relation": "uses_proof"
   },
   {
    "id": "O3",
    "relation": "uses_proof"
   }
  ],
  "acceptance_criteria": [
   "Empty buckets retain count zero regardless of fill.",
   "fill='none' gives null for every empty bucket.",
   "fill='previous' gives the latest previous nonempty sum, including zero.",
   "Before the first nonempty bucket, fill='previous' gives null."
  ],
  "blocked_by": []
 },
 {
  "id": "O5",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "Match both public examples exactly: cancelling a events produce count 2 and value 0 at start 0, then count-zero buckets at 2 and 4 filled with 0; the pre-start z event yields a count-zero bucket at 0 with null value.",
  "required": true,
  "dependencies": [
   {
