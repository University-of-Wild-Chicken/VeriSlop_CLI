 => cases r <;> simp_all [witnessEntries] <;> grind\n\ntheorem admission_inhabited (rs : List NativeRequirement) : AdmissionInhabited rs := by\n  refine ⟨modelWitness rs, List.all_eq_true.mpr ?_⟩\n  intro r hr\n  cases r with\n  | entry f n a =>\n    simp [checkRequirement, modelWitness, entry_in_witness f n a rs hr]\n  | pureJson => rfl\n  | standardRuntimeOnly => rfl\n  | noExternalIO => rfl\n  | inputPreserved => rfl\n  | deterministic => rfl\n  | noFloatingPoint => rfl\n\ntheorem contract_sound {τ : Type} (d : NativeDefinition τ) : Contract d :=\n  ⟨transfer_sound d.requirements, admission_inhabited d.requirements⟩\n\nend VeriSlop.Native\n\nnamespace VeriSlopAST\nstructure «Event» where\n  «group» : _root_.String\n  «time» : _root_.Int\n  «value» : (_root_.Option _root_.Int)\nstructure «Input» where\n  «events» : (_root_.List _root_.VeriSlopAST.«Event»)\n  «start» : _root_.Int\n  «end» : _root_.Int\n  «width» : _root_.Int\n  «fill» : _root_.String\nstructure «Output» where\n  «group» : _root_.String\n  «start» : _root_.Int\n  «count» : _root_.Int\n  «value» : (_root_.Option _root_.Int)\ndef «aggregate» («_v0» : _root_.VeriSlopAST.«Input») : (_root_.List _root_.VeriSlopAST.«Output») := (@_root_.List.foldl (_root_.List _root_.VeriSlopAST.«Output») _root_.String (fun («_v1» : (_root_.List _root_.VeriSlopAST.«Output»)) («_v2» : _root_.String) => (@_root_.List.append _root_.VeriSlopAST.«Output» «_v1» (@_root_.List.foldl (_root_.List _root_.VeriSlopAST.«Output») _root_.Nat (fun («_v3» : (_root_.List _root_.VeriSlopAST.«Output»)) («_v4» : _root_.Nat) => (@_root_.List.foldl (_root_.List _root_.VeriSlopAST.«Output») (_root_.List _root_.VeriSlopAST.«Event») (fun («_v5» : (_root_.List _root_.VeriSlopAST.«Output»)) («_v6» : (_root_.List _root_.VeriSlopAST.«Event»)) => (@_root_.List.append _root_.VeriSlopAST.«Output» «_v5» ([(_root_.VeriSlopAST.«Output».«mk» «_v2» (_root_.Int.add (_root_.VeriSlopAST.«Input».«start» «_v0») (_root_.Int.mul (_root_.Int.ofNat «_v4») (_root_.Veri