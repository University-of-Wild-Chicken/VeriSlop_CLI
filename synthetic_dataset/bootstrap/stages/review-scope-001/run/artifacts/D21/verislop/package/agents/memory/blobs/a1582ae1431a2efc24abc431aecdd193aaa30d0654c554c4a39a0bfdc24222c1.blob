{"obligations":[{"id":"D1","revision":1,"kind":"entity","role":"declaration","statement":"Input is an object with events containing string group, integer time and integer-or-null value, integer start and end, positive integer width, and fill equal to none or previous. Output is a list of records with group, start, count and value.","required":true,"scope":["input and output"],"dependencies":[],"acceptance_criteria":["Input and output use the specified JSON-compatible structure.","Output record group is a string, start and count are integers, and value is an integer or null."],"sources":[{"clause_id":"C5","origin":"explicit","interpretation":"Input schema."},{"clause_id":"C15","origin":"explicit","interpretation":"Output schema."},{"clause_id":"C3","origin":"explicit","interpretation":"JSON-compatible values."},{"clause_id":"C19","origin":"explicit","interpretation":"JSON input and serializable output."}]},{"id":"A1","revision":1,"kind":"precondition","role":"assumption","statement":"The caller supplies input conforming to D1, with width greater than zero and start less than or equal to end.","required":true,"scope":["function invocation"],"dependencies":[{"id":"D1","relation":"uses_definition"}],"acceptance_criteria":["Input conforms to the specified schema, width > 0, and start <= end."],"sources":[{"clause_id":"C5","origin":"explicit","interpretation":"Stated valid input domain."}]},{"id":"O1","revision":1,"kind":"postcondition","role":"guarantee","statement":"Provide a pure deterministic Python 3 solve(data) function in solution.py that receives the specified JSON-compatible input and returns JSON-serializable output without mutating the input.","required":true,"scope":["solution.py","all valid inputs"],"dependencies":[{"id":"A1","relation":"assumes"},{"id":"D1","relation":"uses_definition"}],"acceptance_criteria":["solution.py exposes solve(data).","Repeated calls on equal input produce equal output.","Input remains unchanged and output is JSON-serializable."],"sources":[{"clause_id":"C2","origin":"explicit","interpretation":"Required function and file, with purity."},{"clause_id":"C17","origin":"explicit","interpretation":"Python 3, purity and determinism."},{"clause_id":"C19","origin":"explicit","interpretation":"JSON interface."}]},{"id":"S1","revision":1,"kind":"safety_property","role":"guarantee","statement":"The implementation uses only the Python standard library and performs no external I/O.","required":true,"scope":["implementation and execution"],"dependencies":[],"acceptance_criteria":["No third-party dependencies are used.","Execution performs no external I/O."],"sources":[{"clause_id":"C4","origin":"explicit","interpretation":"Dependency and I/O restrictions."},{"clause_id":"C18","origin":"explicit","interpretation":"Repeated dependency and I/O restrictions."}]},{"id":"O2","revision":1,"kind":"postcondition","role":"guarantee","statement":"Enumerate every unique group appearing anywhere in events in lexicographic order, including groups whose events are all outside the requested interval.","required":true,"scope":["all valid inputs"],"dependencies":[{"id":"A1","relation":"assumes"}],"acceptance_criteria":["The group sequence is sorted unique event group names.","Group discovery does not discard groups with no in-range events."],"sources":[{"clause_id":"C6","origin":"explicit","interpretation":"Complete sorted group enumeration."}]},{"id":"O3","revision":1,"kind":"postcondition","role":"guarantee","statement":"For each group emit one record for every bucket start start + k*width with integer k >= 0 and bucket start < end. Each bucket covers [bucket start, min(bucket start + width, end)).","required":true,"scope":["all groups and valid intervals"],"dependencies":[{"id":"A1","relation":"assumes"},{"id":"O2","relation":"uses_proof"}],"acceptance_criteria":["Bucket starts increase by width from start and are strictly below end.","Bucket membership includes the lower boundary and excludes the upper boundary.","The final bucket is clipped to end.","When start equals end or there are no groups, output is empty."],"sources":[{"clause_id":"C7","origin":"explicit","interpretation":"Bucket progression."},{"clause_id":"C8","origin":"explicit","interpretation":"Half-open and clipped bucket intervals."}]},{"id":"O4","revision":1,"kind":"postcondition","role":"guarantee","statement":"For each group bucket, count and sum include exactly the event occurrences of that group whose times fall in the bucket and whose values are non-null. Duplicate occurrences contribute separately.","required":true,"scope":["all group buckets"],"dependencies":[{"id":"O3","relation":"uses_proof"}],"acceptance_criteria":["count equals the number of qualifying non-null event occurrences.","sum equals the integer sum of those values.","Null values and out-of-range events contribute neither count nor sum.","Duplicate events are counted and summed separately."],"sources":[{"clause_id":"C9","origin":"explicit","interpretation":"Qualifying values for sums."},{"clause_id":"C10","origin":"explicit","interpretation":"Count uses the same values."},{"clause_id":"C16","origin":"explicit","interpretation":"Duplicate occurrences count separately."}]},{"id":"I1","revision":1,"kind":"invariant","role":"guarantee","statement":"For each group, previous is initially absent and thereafter equals the sum of its latest earlier nonempty emitted bucket. Nonempty means count > 0; a zero sum is a valid previous value. Empty buckets preserve previous, and events before start never seed it.","required":true,"scope":["per-group traversal in increasing bucket order"],"dependencies":[{"id":"O4","relation":"uses_proof"}],"acceptance_criteria":["Previous is isolated per group and initially absent.","Each bucket with count > 0 updates previous to its sum, including zero.","Buckets with count = 0 never update or clear previous.","No event before start contributes to previous."],"sources":[{"clause_id":"C11","origin":"explicit","interpretation":"Nonempty bucket updates previous."},{"clause_id":"C13","origin":"explicit","interpretation":"Empty buckets retain previous."},{"clause_id":"C14","origin":"explicit","interpretation":"No historical seeding before start."},{"clause_id":"C16","origin":"explicit","interpretation":"Zero is a valid previous value."}]},{"id":"O5","revision":1,"kind":"postcondition","role":"guarantee","statement":"A bucket with count > 0 returns its sum as value. An empty bucket returns null for fill none; for fill previous it returns the latest previous nonempty bucket sum for that group, or null if no such bucket exists.","required":true,"scope":["all emitted buckets and both fill modes"],"dependencies":[{"id":"O4","relation":"uses_proof"},{"id":"I1","relation":"uses_proof"}],"acceptance_criteria":["Nonempty bucket value equals its sum in either fill mode.","Empty bucket count remains zero regardless of filling.","Empty bucket value is null in none mode.","Empty bucket value in previous mode follows I1, including zero and null before the first nonempty bucket."],"sources":[{"clause_id":"C11","origin":"explicit","interpretation":"Nonempty bucket value."},{"clause_id":"C12","origin":"explicit","interpretation":"Empty bucket filling rules."}]},{"id":"O6","revision":1,"kind":"postcondition","role":"guarantee","statement":"Return the specified list of group, start, count and value records ordered first by lexicographically sorted group and then by increasing bucket start.","required":true,"scope":["returned output"],"dependencies":[{"id":"D1","relation":"uses_definition"},{"id":"O2","relation":"uses_proof"},{"id":"O3","relation":"uses_proof"},{"id":"O5","relation":"uses_proof"}],"acceptance_criteria":["Each record has the specified group, start, count and value fields.","Records appear in group order followed by increasing bucket order.","The specified input/output structure and exact ordering are preserved."],"sources":[{"clause_id":"C15","origin":"explicit","interpretation":"Return shape and ordering."},{"clause_id":"C20","origin":"explicit","interpretation":"Preserve exact structure and ordering."}]},{"id":"O7","revision":1,"kind":"postcondition","role":"guarantee","statement":"Both public examples produce their supplied outputs exactly.","required":true,"scope":["public examples"],"dependencies":[{"id":"O6","relation":"uses_proof"}],"acceptance_criteria":["For group a with values 2 and -2 in the first width-2 bucket over [0,5), return starts 0,2,4, counts 2,0,0 and values 0,0,0.","For group z with only time -1 over [0,1), return one record with start 0, count 0 and value null."],"sources":[{"clause_id":"C21","origin":"explicit","interpretation":"Required example behavior, including zero carry and exclusion of historical seeding."}]}],"category_review":{"entities":"Specified input schema and output records.","preconditions":"Caller supplies the stated valid input schema, positive width and start <= end.","postconditions":"Pure deterministic function, complete group and bucket enumeration, aggregation, filling, ordered output and examples.","invariants":"Per-group previous value is the latest nonempty bucket sum and persists across empty buckets.","safety_properties":"Standard library only and no external I/O.","liveness_properties":"None separately stated.","resource_constraints":"None stated.","error_semantics":"Behavior outside the stated valid input domain is not specified.","explicit_non_goals":"None stated.","ambiguities":"None within the stated input domain."},"clauses":[{"clause_id":"C1","disposition":"context","refs":[],"note":"Task title identifies grouped aggregation with causal filling."},{"clause_id":"C2","disposition":"obligations","refs":["O1"],"note":""},{"clause_id":"C3","disposition":"obligations","refs":["D1"],"note":""},{"clause_id":"C4","disposition":"obligations","refs":["S1"],"note":""},{"clause_id":"C5","disposition":"obligations","refs":["D1","A1"],"note":""},{"clause_id":"C6","disposition":"obligations","refs":["O2"],"note":""},{"clause_id":"C7","disposition":"obligations","refs":["O3"],"note":""},{"clause_id":"C8","disposition":"obligations","refs":["O3"],"note":""},{"clause_id":"C9","disposition":"obligations","refs":["O4"],"note":""},{"clause_id":"C10","disposition":"obligations","refs":["O4"],"note":""},{"clause_id":"C11","disposition":"obligations","refs":["I1","O5"],"note":""},{"clause_id":"C12","disposition":"obligations","refs":["O5"],"note":""},{"clause_id":"C13","disposition":"obligations","refs":["I1"],"note":""},{"clause_id":"C14","disposition":"obligations","refs":["I1"],"note":""},{"clause_id":"C15","disposition":"obligations","refs":["D1","O6"],"note":""},{"clause_id":"C16","disposition":"obligations","refs":["O4","I1"],"note":""},{"clause_id":"C17","disposition":"obligations","refs":["O1"],"note":""},{"clause_id":"C18","disposition":"obligations","refs":["S1"],"note":""},{"clause_id":"C19","disposition":"obligations","refs":["D1","O1"],"note":""},{"clause_id":"C20","disposition":"obligations","refs":["O6"],"note":""},{"clause_id":"C21","disposition":"obligations","refs":["O7"],"note":""}],"assumptions":[{"id":"A1","supplied_by":"caller","discharged_at":"Function invocation through input conforming to the stated schema, width > 0 and start <= end."}],"ambiguities":[],"selected_defaults":[]}