  "role": "declaration",
  "statement": "Input is an object with events containing string group, integer time and integer-or-null value, integer start and end, positive integer width, and fill equal to none or previous. Output is a list of records with group, start, count and value.",
  "required": true,
  "dependencies": [],
  "acceptance_criteria": [
   "Input and output use the specified JSON-compatible structure.",
   "Output record group is a string, start and count are integers, and value is an integer or null."
