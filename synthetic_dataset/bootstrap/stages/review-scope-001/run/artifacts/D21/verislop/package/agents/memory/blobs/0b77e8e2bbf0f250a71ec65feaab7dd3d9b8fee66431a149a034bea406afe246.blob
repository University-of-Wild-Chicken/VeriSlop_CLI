 },
 {
  "id": "O1",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "Provide a pure deterministic Python 3 solve(data) function in solution.py that receives the specified JSON-compatible input and returns JSON-serializable output without mutating the input.",
  "required": true,
  "dependencies": [
   {
    "id": "A1",
    "relation": "assumes"
   },
   {
    "id": "D1",
    "relation": "uses_definition"
   }
