   "solution.py exposes solve(data).",
   "Repeated calls on equal input produce equal output.",
   "Input remains unchanged and output is JSON-serializable."
  ],
  "blocked_by": []
 },
 {
  "id": "O2",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "Enumerate every unique group appearing anywhere in events in lexicographic order, including groups whose events are all outside the requested interval.",
  "required": true,
  "dependencies": [
   {
    "id": "A1",
    "relation": "assumes"
   }
  ],
  "acceptance_criteria": [
   "The group sequence is sorted unique event group names.",
   "Group discovery does not discard groups with no in-range events."
  ],
  "blocked_by": []
 },
 {
  "id": "O3",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "For each group emit one record for every bucket start start + k*width with integer k >= 0 and bucket start < end. Each bucket covers [bucket start, min(bucket start + width, end)).",
  "required": true,
  "dependencies": [
   {
    "id": "A1",
    "relation": "assumes"
   },
   {
    "id": "O2",
    "relation": "uses_proof"
   }
  ],
  "acceptance_criteria": [
   "Bucket starts increase by width from start and are strictly below end.",
   "Bucket membership includes the lower boundary and excludes the upper boundary.",
   "The final bucket is clipped to end.",
   "When start equals end or there are no groups, output is empty."
  ],
  "blocked_by": []
 },
 {
  "id": "O4",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "For each group bucket, count and sum include exactly the event occurrences of that group whose times fall in the bucket and whose values are non-null. Duplicate occurrences contribute separately.",
  "required": true,
  "dependencies": [
   {
    "id": "O3",
    "relation": "uses_proof"
   }
  ],
  "acceptance_criteria": [
   "count equals the number of qualifying non-null event occurrences.",
   "sum equals the integer sum of those values.",
   "Null values and out-of-range events contribute neither count nor sum.",
   "Duplicate events are counted and summed separately."
  ],
  "blocked_by": []
 },
 {
  "id": "O5",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "A bucket with count > 0 returns its sum as value. An empty bucket returns null for fill none; for fill previous it returns the latest previous nonempty bucket sum for that group, or null if no such bucket exists.",
  "required": true,
  "dependencies": [
   {
    "id": "O4",
    "relation": "uses_proof"
   },
   {
    "id": "I1",
    "relation": "uses_proof"
   }
  ],
  "acceptance_criteria": [
   "Nonempty bucket value equals its sum in either fill mode.",
   "Empty bucket count remains zero regardless of filling.",
   "Empty bucket value is null in none mode.",
   "Empty bucket value in previous mode follows I1, including zero and null before the first nonempty bucket."
  ],
  "blocked_by": []
 },
 {
  "id": "O6",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "Return the specified list of group, start, count and value records ordered first by lexicographically sorted group and then by increasing bucket start.",
  "required": true,
  "dependencies": [
   {
    "id": "D1",
    "relation": "uses_definition"
   },
   {
    "id": "O2",
    "relation": "uses_proof"
   },
   {
    "id": "O3",
    "relation": "uses_proof"
   },
   {
    "id": "O5",
    "relation": "uses_proof"
   }
  ],
  "acceptance_criteria": [
   "Each record has the specified group, start, count and value fields.",
   "Records appear in group order followed by increasing bucket order.",
   "The specified input/output structure and exact ordering are preserved."
  ],
  "blocked_by": []
 },
 {
  "id": "O7",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "Both public examples produce their supplied outputs exactly.",
  "required": true,
  "dependencies": [
   {
    "id": "O6",
    "relation": "uses_proof"
   }
  ],
  "acceptance_criteria": [
   "For group a with values 2 and -2 in the first width-2 bucket over [0,5), return starts 0,2,4, counts 2,0,0 and values 0,0,0.",
   "For group z with only time -1 over [0,1), return one record with start 0, count 0 and value null."
  ],
  "blocked_by": []
 },
 {
  "id": "I1",
  "kind": "invariant",
  "role": "guarantee",
  "statement": "For each group, previous is initially absent and thereafter equals the sum of its latest earlier nonempty emitted bucket. Nonempty means count > 0; a zero sum is a valid previous value. Empty buckets preserve previous, and events before start never seed it.",
  "required": true,
  "dependencies": [
   {
    "id": "O4",
    "relation": "uses_proof"
   }
  ],
  "acceptance_criteria": [
   "Previous is isolated per group and initially absent.",
   "Each bucket with count > 0 updates previous to its sum, including zero.",
   "Buckets with count = 0 never update or clear previous.",
   "No event before start contributes to previous."
  ],
  "blocked_by": []
 },
 {
