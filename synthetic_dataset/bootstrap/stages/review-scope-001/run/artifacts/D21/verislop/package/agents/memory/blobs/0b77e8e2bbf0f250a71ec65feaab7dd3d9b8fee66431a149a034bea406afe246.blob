  "blocked_by": []
 },
 {
  "id": "A1",
  "kind": "precondition",
  "role": "assumption",
  "statement": "The caller supplies input conforming to D1, with width greater than zero and start less than or equal to end.",
  "required": true,
  "dependencies": [
   {
    "id": "D1",
    "relation": "uses_definition"
   }
  ],
