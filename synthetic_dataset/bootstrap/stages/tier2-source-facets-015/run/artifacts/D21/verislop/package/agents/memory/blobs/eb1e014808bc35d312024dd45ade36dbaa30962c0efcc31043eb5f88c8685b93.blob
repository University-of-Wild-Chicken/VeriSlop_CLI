7af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":5654,"interpretation":"Universal source implementation refinement","origin":"explicit","start_byte":5459},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":8118,"interpretation":"O1 required source and value facets","origin":"explicit","start_byte":5957}],"state":"INTERPRETED","statement":"Deliver canonical program.vscore.json with exactly one admitted typed entry solve of arity 1, implementing the full grouped bucket aggregation for every input satisfying A1 under normative Lean vscore-semantics/0.3 and data-pipeline/0.3. Its result is exactly the list defined by O2 through O6. This source must be typed total, deterministic, input preserving, free of external I/O and floating point, pure data, and restricted to the admitted runtime."},{"acceptance_criteria":["G = sortScalarLex(distinct([e.group for e in events])); no name is omitted due to its event times or null values.","Empty events give G = []; groups have no duplicates and their order compares scalar codepoints.","The canonical arity-1 solve source universally refines this formula and meets all seven specified source properties."],"dependencies":[{"id":"D1","relation":"uses_definition"},{"id":"A1","relation":"assumes"}],"id":"O2","kind":"postcondition","lifecycle":{"END_TO_END_VERIFIED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"FORMALIZED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"IMPLEMENTED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"INTERPRETED":{"evidence_refs":["provenance:tier2:tier2-source-facets-015:D21"],"outcome":"PASS","reason":"Recorded interpretation proposal; not mathematical proof.","scope":["recorded interpretation of the request"]},"LINKED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"PROVED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"TESTED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"TYPECHECKED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]}},"required":true,"revision":1,"role":"guarantee","scope":["every valid input and canonical solve source"],"source_refs":[{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":501,"interpretation":"Complete sorted group set","origin":"explicit","start_byte":394},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":1596,"interpretation":"Scalar codepoint lexicographic ordering","origin":"explicit","start_byte":1507},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":5288,"interpretation":"Canonical source requirements","origin":"explicit","start_byte":5036},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":5654,"interpretation":"Universal refinement","origin":"explicit","start_byte":5459},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":8118,"interpretation":"O2 source and value facets","origin":"explicit","start_byte":5957}],"state":"INTERPRETED","statement":"For every valid input, the group enumeration is exactly the distinct group names in all input events, sorted lexicographically by Unicode scalar codepoints, including names occurring only outside [start,end). program.vscore.json's arity-1 solve must universally implement this enumeration while satisfying typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only."},{"acceptance_criteria":["Bucket starts are exactly start+k*width for k >= 0 satisfying start+k*width < end.","Bucket membership includes its lower endpoint and excludes its upper endpoint; the final interval is clipped at end.","start=end produces no buckets and an empty output list.","The canonical arity-1 solve source universally refines these requirements and meets all seven specified source properties."],"dependencies":[{"id":"D1","relation":"uses_definition"},{"id":"A1","relation":"assumes"}],"id":"O3","kind":"postcondition","lifecycle":{"END_TO_END_VERIFIED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"FORMALIZED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"IMPLEMENTED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"INTERPRETED":{"evidence_refs":["provenance:tier2:tier2-source-facets-015:D21"],"outcome":"PASS","reason":"Recorded interpretation proposal; not mathematical proof.","scope":["recorded interpretation of the request"]},"LINKED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"PROVED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"TESTED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"TYPECHECKED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]}},"required":true,"revision":1,"role":"guarantee","scope":["all groups and every valid input"],"source_refs":[{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":561,"interpretation":"Bucket progression per group","origin":"explicit","start_byte":502},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":637,"interpretation":"Strict bound and half-open clipped intervals","origin":"explicit","start_byte":562},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":5288,"interpretation":"Source delivery","origin":"explicit","start_byte":5036},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":5654,"interpretation":"Universal refinement","origin":"explicit","start_byte":5459},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":8118,"interpretation":"O3 source and value facets","origin":"explicit","start_byte":5957}],"state":"INTERPRETED","statement":"For every group and valid input, emit exactly one bucket for every integer k >= 0 with b_k = start + k*width < end. Its interval is [b_k,min(b_k+width,end)). program.vscore.json's arity-1 solve must universally implement this formula while satisfying typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only."},{"acceptance_criteria":["count = length(M(g,b)); sum = sum of each non-null value in M(g,b), with sum of the empty list equal to 0.","All duplicate list occurrences are counted and summed independently.","All arithmetic uses unbounded mathematical integers without floating point.","The canonical arity-1 solve universally refines the formula and satisfies typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only."],"dependencies":[{"id":"D1","relation":"uses_definition"},{"id":"A1","relation":"assumes"}],"id":"O4","kind":"postcondition","lifecycle":{"END_TO_END_VERIFIED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"FORMALIZED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"IMPLEMENTED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"INTERPRETED":{"evidence_refs":["provenance:tier2:tier2-source-facets-015:D21"],"outcome":"PASS","reason":"Recorded interpretation proposal; not mathematical proof.","scope":["recorded interpretation of the request"]},"LINKED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"PROVED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"TESTED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"TYPECHECKED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]}},"required":true,"revision":1,"role":"guarantee","scope":["every emitted bucket on every valid input"],"source_refs":[{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":672,"interpretation":"Non-null in-range summation","origin":"explicit","start_byte":638},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":699,"interpretation":"Count domain","origin":"explicit","start_byte":673},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":1078,"interpretation":"Duplicate occurrences","origin":"explicit","start_byte":1020},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":1506,"interpretation":"Exact integer arithmetic","origin":"explicit","start_byte":1435},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":5288,"interpretation":"Canonical source delivery","origin":"explicit","start_byte":5036},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":5654,"interpretation":"Universal refinement","origin":"explicit","start_byte":5459},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":8118,"interpretation":"O4 source and value facets","origin":"explicit","start_byte":5957}],"state":"INTERPRETED","statement":"For each group g and emitted bucket b, let M(g,b) be the list of event occurrences whose group is g, value is non-null, and b <= time < min(b+width,end). The bucket count equals |M(g,b)| and its sum equals the mathematical integer sum of the values of M(g,b). Duplicate occurrences contribute separately; null and out-of-range events contribute neither to count nor sum. program.vscore.json's arity-1 solve universally implements this formula with all seven required source properties."},{"acceptance_criteria":["Nonempty means count>0, regardless of whether the sum is zero; its output is sum under either fill mode.","For an empty bucket with fill='previous', let j be the greatest earlier bucket index of the same group with count>0: value=sum_j when j exists and null otherwise.","For an empty bucket with fill='none', value=null.","Empty buckets retain previous; initial state is null for each group; no pre-start event or other group affects previous.","The canonical arity-1 solve universally refines the formula and satisfies typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only."],"dependencies":[{"id":"D1","relation":"uses_definition"},{"id":"A1","relation":"assumes"}],"id":"O5","kind":"postcondition","lifecycle":{"END_TO_END_VERIFIED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"FORMALIZED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"IMPLEMENTED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"INTERPRETED":{"evidence_refs":["provenance:tier2:tier2-source-facets-015:D21"],"outcome":"PASS","reason":"Recorded interpretation proposal; not mathematical proof.","scope":["recorded interpretation of the request"]},"LINKED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"PROVED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"TESTED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"TYPECHECKED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]}},"required":true,"revision":1,"role":"guarantee","scope":["all groups, buckets and both fill modes on every valid input"],"source_refs":[{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":759,"interpretation":"Nonempty bucket value and state update","origin":"explicit","start_byte":700},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":879,"interpretation":"Both empty-bucket fill branches and initial null","origin":"explicit","start_byte":760},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":915,"interpretation":"Empty buckets preserve previous","origin":"explicit","start_byte":880},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":956,"interpretation":"No pre-start seeding","origin":"explicit","start_byte":916},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":1078,"interpretation":"Zero is a valid carried sum","origin":"explicit","start_byte":1020},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":5288,"interpretation":"Canonical source requirements","origin":"explicit","start_byte":5036},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":5654,"interpretation":"Universal refinement","origin":"explicit","start_byte":5459},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":8118,"interpretation":"O5 source and value facets","origin":"explicit","start_byte":5957}],"state":"INTERPRETED","statement":"For each group independently, initialize previous to null before its first bucket. Process its buckets in increasing start order. If count>0, output value=sum and set previous=sum, including sum=0. If count=0, output null when fill='none', otherwise output previous when fill='previous', and leave previous unchanged. Thus previous is the sum of the latest earlier nonempty bucket or null when none exists; events before start cannot seed it. program.vscore.json's arity-1 solve universally implements this causal formula with all seven required source properties."},{"acceptance_criteria":["Result equals concat over G of the bucket records defined by O3, O4 and O5; there are no extra or missing records.","Each record preserves the specified group, start, count and integer-or-null value fields.","No groups or no bucket starts produces []; zero-valued counts and sums and null values serialize exactly.","The canonical arity-1 solve universally refines this formula and satisfies typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only."],"dependencies":[{"id":"D1","relation":"uses_definition"},{"id":"A1","relation":"assumes"}],"id":"O6","kind":"postcondition","lifecycle":{"END_TO_END_VERIFIED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"FORMALIZED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"IMPLEMENTED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"INTERPRETED":{"evidence_refs":["provenance:tier2:tier2-source-facets-015:D21"],"outcome":"PASS","reason":"Recorded interpretation proposal; not mathematical proof.","scope":["recorded interpretation of the request"]},"LINKED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"PROVED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"TESTED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"TYPECHECKED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]}},"required":true,"revision":1,"role":"guarantee","scope":["complete serialized result for every valid input"],"source_refs":[{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":1019,"interpretation":"Output schema and nesting order","origin":"explicit","start_byte":957},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":1227,"interpretation":"Serialization profile","origin":"explicit","start_byte":1080},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":1293,"interpretation":"Exact structure and ordering","origin":"explicit","start_byte":1228},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":5288,"interpretation":"Source delivery","origin":"explicit","start_byte":5036},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":5654,"interpretation":"Universal refinement","origin":"explicit","start_byte":5459},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":8118,"interpretation":"O6 source and value facets","origin":"explicit","start_byte":5957}],"state":"INTERPRETED","statement":"For every valid input, return exactly the concatenation, over G in scalar lexicographic order, of each group's bucket records in increasing bucket start order. Each record is {group:g,start:b,count:|M(g,b)|,value:the value defined by O5}. Preserve the specified JSON structure and exact order under data-pipeline/0.3. program.vscore.json's arity-1 solve universally implements this formula with all seven required source properties."},{"acceptance_criteria":["The first example returns exactly [{group:'a',start:0,count:2,value:0},{group:'a',start:2,count:0,value:0},{group:'a',start:4,count:0,value:0}].","The second example returns exactly [{group:'z',start:0,count:0,value:null}].","The actual canonical arity-1 solve universally implements O2 through O6, preserving example values, and satisfies typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only."],"dependencies":[{"id":"D1","relation":"uses_definition"},{"id":"A1","relation":"assumes"}],"id":"O7","kind":"postcondition","lifecycle":{"END_TO_END_VERIFIED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"FORMALIZED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"IMPLEMENTED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"INTERPRETED":{"evidence_refs":["provenance:tier2:tier2-source-facets-015:D21"],"outcome":"PASS","reason":"Recorded interpretation proposal; not mathematical proof.","scope":["recorded interpretation of the request"]},"LINKED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"PROVED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"TESTED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"TYPECHECKED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]}},"required":true,"revision":1,"role":"guarantee","scope":["both public examples and all valid inputs"],"source_refs":[{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":1734,"interpretation":"Preserved public examples","origin":"explicit","start_byte":1689},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":2282,"interpretation":"Exact example outputs and universal refinement","origin":"explicit","start_byte":1735},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":2801,"interpretation":"Examples do not replace complete functional guarantees","origin":"explicit","start_byte":2761},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":5288,"interpretation":"Source delivery","origin":"explicit","start_byte":5036},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":5654,"interpretation":"Universal refinement","origin":"explicit","start_byte":5459},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":8118,"interpretation":"O7 source and value facets","origin":"explicit","start_byte":5957}],"state":"INTERPRETED","statement":"The canonical arity-1 solve in program.vscore.json preserves both public example outputs exactly and universally refines the complete functional specification rather than only these examples. For events [(a,0,2),(a,1,-2)], start=0,end=5,width=2,fill='previous', return [(a,0,2,0),(a,2,0,0),(a,4,0,0)] as the specified records. For events [(z,-1,9)], start=0,end=1,width=2,fill='previous', return [{group:'z',start:0,count:0,value:null}]. The source meets all seven required source properties."}],"preconditions":[{"acceptance_criteria":["width > 0 and start <= end; all fields belong to D1's stated domains, with no additional restrictions."],"dependencies":[{"id":"D1","relation":"uses_definition"}],"id":"A1","kind":"precondition","lifecycle":{"END_TO_END_VERIFIED":{"evidence_refs":[],"outcome":"NOT_APPLICABLE","reason":"assumption is supplied by caller and discharged at solve invocation, by supplying the specified typed input with width>0 and start<=end","scope":[]},"FORMALIZED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"IMPLEMENTED":{"evidence_refs":[],"outcome":"NOT_APPLICABLE","reason":"assumption is supplied by caller and discharged at solve invocation, by supplying the specified typed input with width>0 and start<=end","scope":[]},"INTERPRETED":{"evidence_refs":["provenance:tier2:tier2-source-facets-015:D21"],"outcome":"PASS","reason":"Recorded interpretation proposal; not mathematical proof.","scope":["recorded interpretation of the request"]},"LINKED":{"evidence_refs":[],"outcome":"NOT_APPLICABLE","reason":"assumption is supplied by caller and discharged at solve invocation, by supplying the specified typed input with width>0 and start<=end","scope":[]},"PROVED":{"evidence_refs":[],"outcome":"NOT_APPLICABLE","reason":"an assumption is a hypothesis; it is not proved by the theorems that use it","scope":[]},"TESTED":{"evidence_refs":[],"outcome":"NOT_APPLICABLE","reason":"assumption is supplied by caller and discharged at solve invocation, by supplying the specified typed input with width>0 and start<=end","scope":[]},"TYPECHECKED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]}},"required":true,"revision":1,"role":"assumption","scope":["solve invocation"],"source_refs":[{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e