evious'}. Output is a list of records {group:string,start:int,count:int,value:int|null}. Integers are unbounded mathematical integers; strings are sequences of Unicode scalar values."}],"error_semantics":[],"explicit_non_goals":[],"invariants":[{"acceptance_criteria":["The actual canonical arity-1 solve source satisfies typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only.","Its execution never mutates input values, escapes the admitted runtime or uses floating point or external-effect constructors.","Source-only classification does not remove O5's nonempty update, retained previous, initial null, zero-sum or no-pre-start-seeding guarantees."],"dependencies":[{"id":"D1","relation":"uses_definition"},{"id":"A1","relation":"assumes"}],"id":"I1","kind":"invariant","lifecycle":{"END_TO_END_VERIFIED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"FORMALIZED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"IMPLEMENTED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"INTERPRETED":{"evidence_refs":["provenance:tier2:tier2-source-facets-015:D21"],"outcome":"PASS","reason":"Recorded interpretation proposal; not mathematical proof.","scope":["recorded interpretation of the request"]},"LINKED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"PROVED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"TESTED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"TYPECHECKED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]}},"required":true,"revision":1,"role":"guarantee","scope":["all admitted solve executions"],"source_refs":[{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":1352,"interpretation":"Total pure deterministic execution","origin":"explicit","start_byte":1294},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":1434,"interpretation":"Immutable input and effect restrictions","origin":"explicit","start_byte":1353},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":1506,"interpretation":"Exact non-floating-point arithmetic","origin":"explicit","start_byte":1435},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":5288,"interpretation":"Canonical entry and source properties","origin":"explicit","start_byte":5036},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":5869,"interpretation":"Operational source-only classification","origin":"explicit","start_byte":5716},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-015:D21","end_byte":8118,"interpretation":"I1 source-only required facets","origin":"explicit","start_byte":5957}],"state":"INTERPRETED","statement":"The canonical program.vscore.json arity-1 solve maintains the specified operational source restrictions throughout admitted execution: typed totality, determinism, immutable input preservation, no external I/O, no floating point, pure data and restricted-runtime-only execution under Lean vscore-semantics/0.3. This ID is source-only; causal filling's functional value behavior remains f