urce execution returns exactly the stated finite sum using floor toward negative infinity.","n=0 returns 0.","solve({a:-2,b:1,m:3,n:4}) returns -4 and solve({a:100,b:-99,m:7,n:0}) returns 0; these are instances of the universal contract.","O1 retains file program.vscore.json, entry solve, arity 1, all seven specified closed source properties and value_required=true.","The formal contract and universal implementation refinement cover both source facets and the complete value formula; equality or existence alone is insufficient."],"dependencies":[{"id":"A1","relation":"assumes"},{"id":"D1","relation":"uses_definition"}],"id":"O1","kind":"postcondition","lifecycle":{"END_TO_END_VERIFIED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"FORMALIZED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"IMPLEMENTED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"INTERPRETED":{"evidence_refs":["provenance:tier2:tier2-source-facets-008:A23"],"outcome":"PASS","reason":"Recorded interpretation proposal; not mathematical proof.","scope":["recorded interpretation of the request"]},"LINKED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"PROVED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"TESTED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"TYPECHECKED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]}},"required":true,"revision":1,"role":"guarantee","scope":["all inputs satisfying A1","source and value contract for O1"],"source_refs":[{"document_hash":"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b","document_ref":"tier2:tier2-source-facets-008:A23","end_byte":518,"interpretation":"complete floor-sum formula","origin":"explicit","start_byte":468},{"document_hash":"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b","document_ref":"tier2:tier2-source-facets-008:A23","end_byte":572,"interpretation":"negative-infinity floor","origin":"explicit","start_byte":519},{"document_hash":"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b","document_ref":"tier2:tier2-source-facets-008:A23","end_byte":591,"interpretation":"empty sum","origin":"explicit","start_byte":573},{"document_hash":"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b","document_ref":"tier2:tier2-source-facets-008:A23","end_byte":1269,"interpretation":"preserve public examples","origin":"explicit","start_byte":1224},{"document_hash":"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b","document_ref":"tier2:tier2-source-facets-008:A23","end_byte":1427,"interpretation":"example values and universal refinement","origin":"explicit","start_byte":1270},{"document_hash":"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b","document_ref":"tier2:tier2-source-facets-008:A23","end_byte":1985,"interpretation":"complete universal mathematical contract","origin":"explicit","start_byte":1874},{"document_hash":"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b","document_ref":"tier2:tier2-source-facets-008:A23","end_byte":2026,"interpretation":"examples cannot replace refinement","origin":"explicit","start_byte":1986},{"document_hash":"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b","document_ref":"tier2:tier2-source-facets-008:A23","end_byte":4264,"interpretation":"global source delivery facets","origin":"explicit","start_byte":4060},{"document_hash":"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b","document_ref":"tier2:tier2-source-facets-008:A23","end_byte":4326,"interpretation":"exact source requirements in contract","origin":"explicit","start_byte":4265},{"document_hash":"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b","document_ref":"tier2:tier2-source-facets-008:A23","end_byte":4496,"interpretation":"source identity and behavior cannot be replaced by equality","origin":"explicit","start_byte":4327},{"document_hash":"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b","document_ref":"tier2:tier2-source-facets-008:A23","end_byte":4713,"interpretation":"mixed source/value guarantee","origin":"explicit","start_byte":4497},{"document_hash":"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b","document_ref":"tier2:tier2-source-facets-008:A23","end_byte":4774,"interpretation":"value facets required","origin":"explicit","start_byte":4714},{"document_hash":"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b","document_ref":"tier2:tier2-source-facets-008:A23","end_byte":6207,"interpretation":"exact O1 source-policy row","origin":"explicit","start_byte":5156}],"state":"INTERPRETED","statement":"For every input satisfying A1, execution of the sole typed arity-1 entry solve in canonical program.vscore.json returns the JSON integer r = sum_{i=0}^{n-1} floor((a*i+b)/m), where each floor is the unique integer q satisfying m*q <= a*i+b < m*(q+1). For n=0, r=0. This requires universal refinement of the actual source implementation, not merely mathematical result existence or example agreement. Its formal contract must include the exact source facets typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only under normative Lean vscore-semantics/0.3 and data-pipeline/0.3."},{"acceptance_criteria":["The artifact has exactly one admitted typed solve entry of arity 1 in the prescribed source and serialization profiles.","For every valid input, typed execution and serialization preserve the specified structure and exact ordering and return the exact floor sum, including zero for n=0.","O2 retains file program.vscore.json, entry solve, arity 1, all seven closed source properties and value_required=true.","The formal contract establishes universal source implementation refinement and complete value behavior without adding preconditions."],"dependencies":[{"id":"D1","relation":"uses_definition"},{"id":"A1","relation":"assumes"}],"id":"O2","kind":"postcondition","lifecycle":{"END_TO_END_VERIFIED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"FORMALIZED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"IMPLEMENTED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"INTERPRETED":{"evidence_refs":["provenance:tier2:tier2-source-facets-008:A23"],"outcome":"PASS","reason":"Recorded interpretation proposal; not mathematical proof.","scope":["recorded interpretation of the request"]},"LINKED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"PROVED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"TESTED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"TYPECHECKED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]}},"required":true,"revision":1,"role":"guarantee","scope":["delivery artifact","all inputs satisfying A1","source and value contract for O2"],"source_refs":[{"document_hash":"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b","document_ref":"tier2:tier2-source-facets-008:A23","end_byte":137,"interpretation":"delivery and entry identity","origin":"explicit","star