t_byte":3850}],"state":"INTERPRETED","statement":"Runtime campaigns and machine-code, compiler, runtime or physical-resource assurance are excluded. The requested assurance boundary is normative restricted-source execution only, explicitly trusting natural-language correspondence, host tooling, the pinned Lean kernel, hashing and OS/hardware."}],"invariants":[],"liveness_properties":[],"postconditions":[{"acceptance_criteria":["For every valid input, actual admitted source execution returns the exact finite floor sum, with floor toward negative infinity.","For n=0, output is 0.","The public examples remain solve({a:-2,b:1,m:3,n:4})=-4 and solve({a:100,b:-99,m:7,n:0})=0.","The formal contract includes file program.vscore.json, entry solve, arity 1 and all seven exact source properties with value_required=true.","Universal implementation refinement covers the complete formula and source facets; illustrative examples do not replace it."],"dependencies":[{"id":"A1","relation":"assumes"},{"id":"D1","relation":"uses_definition"}],"id":"O1","kind":"postcondition","lifecycle":{"END_TO_END_VERIFIED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"FORMALIZED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"IMPLEMENTED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"INTERPRETED":{"evidence_refs":["provenance:tier2:tier2-source-facets-008:A23"],"outcome":"PASS","reason":"Recorded interpretation proposal; not mathematical proof.","scope":["recorded interpretation of the request"]},"LINKED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"PROVED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"TESTED":{"evidence_refs":[],"outcome":"PENDING","reason":"