xecution under normative Lean vscore-semantics/0.3 and data-pipeline/0.3. Every input satisfying A1 yields the specified result representation with exact structure and ordering, without additional input restrictions. Universal implementation refinement and delivery assurance are evaluated at the requested Tier 2 restricted_source vscore/0.3 boundary."}],"preconditions":[{"acceptance_criteria":["Each supplied input satisfies the specified schema, 0 <= n <= 500 and m > 0.","The assumption permits every signed integer a and b and adds no other restriction."],"dependencies":[{"id":"D1","relation":"uses_definition"}],"id":"A1","kind":"precondition","lifecycle":{"END_TO_END_VERIFIED":{"evidence_refs":[],"outcome":"NOT_APPLICABLE","reason":"assumption is supplied by input supplier and discharged at solve invocation, where supplied inputs satisfy the stated JSON schema and bounds","scope":[]},"FORMALIZED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"IMPLEMENTED":{"evidence_refs":[],"outcome":"NOT_APPLICABLE","reason":"assumption is supplied by input supplier and discharged at solve invocation, where supplied inputs satisfy the stated JSON schema and bounds","scope":[]},"INTERPRETED":{"evidence_refs":["provenance:tier2:tier2-source-facets-003:A23"],"outcome":"PASS","reason":"Recorded interpretation proposal; not mathematical proof.","scope":["recorded interpretation of the request"]},"LINKED":{"evidence_refs":[],"outcome":"NOT_APPLICABLE","reason":"assumption is supplied by input supplier and discharged at solve invocation, where supplied inputs satisfy the stated JSON schema and bounds","scope":[]},"PROVED":{"evidence_refs":[],"outcome":"NOT_APPLICABLE","reason":"an assumption is a hypothesis; it is not proved by the theorems that use it","scope":[]},"TESTED":{"evidence_refs":[],"outcome":"NOT_APPLICABLE","reason":"assumption is supplied by input supplier and discharged at solve invocation, where supplied