{"obligations":[{"id":"D1","kind":"entity","role":"declaration","statement":"Input is a JSON object with integer fields n, m, a, b, where 0 <= n <= 500, m > 0, and a and b are signed integers, including magnitudes of 10^30; output is one exact integer.","required":true,"scope":["input and output"],"dependencies":[],"acceptance_criteria":["The input schema is {n,m,a,b}.","Signed a and b and positive m are supported throughout the stated domain.","The result is a JSON-serializable integer."],"sources":[{"clause_id":"C8","origin":"explicit","interpretation":"Input structure and numeric domain."},{"clause_id":"C9","origin":"explicit","interpretation":"Scalar integer sum result."},{"clause_id":"C3","origin":"explicit","interpretation":"JSON compatibility."},{"clause_id":"C15","origin":"explicit","interpretation":"JSON input and serializable output."},{"clause_id":"C16","origin":"explicit","interpretation":"Preserve the specified object input and scalar output; the scalar result has no ordering dimension."}]},{"id":"A1","kind":"precondition","role":"assumption","statement":"The caller supplies inputs satisfying the specified schema and bounds.","required":true,"scope":["all supplied inputs"],"dependencies":[{"id":"D1","relation":"uses_definition"}],"acceptance_criteria":["Every supplied input satisfies D1's input schema and bounds."],"sources":[{"clause_id":"C6","origin":"explicit","interpretation":"Explicit guarantee about supplied inputs."},{"clause_id":"C8","origin":"explicit","interpretation":"Schema and bounds assumed by the function."}]},{"id":"O1","kind":"postcondition","role":"guarantee","statement":"For every valid input, return the exact integer sum of floor((a*i+b)/m) over integers i from 0 through n-1, using floor toward negative infinity; return zero when n is zero.","required":true,"scope":["all inputs satisfying A1"],"dependencies":[{"id":"D1","relation":"uses_definition"},{"id":"A1","relation":"assumes"}],"acceptance_criteria":["Result equals the mathematical sum for all valid inputs, including signed a and b and large integer magnitudes.","Each quotient is rounded toward negative infinity.","n = 0 yields 0."],"sources":[{"clause_id":"C9","origin":"explicit","interpretation":"Exact floor-sum behavior."},{"clause_id":"C10","origin":"explicit","interpretation":"Floor semantics for negative quotients."},{"clause_id":"C11","origin":"explicit","interpretation":"Empty-sum result."}]},{"id":"O2","kind":"postcondition","role":"guarantee","statement":"Provide solution.py with a single solve(data) function implemented in Python 3; the function is pure and deterministic.","required":true,"scope":["implementation and function invocations"],"dependencies":[],"acceptance_criteria":["solution.py exposes the single requested solve(data) function.","Repeated calls with equal input produce equal output.","Calling solve does not mutate its input or observable external state."],"sources":[{"clause_id":"C2","origin":"explicit","interpretation":"Required file and function interface."},{"clause_id":"C13","origin":"explicit","interpretation":"Python 3, purity, and determinism."}]},{"id":"S1","kind":"safety_property","role":"guarantee","statement":"Use only Python 3 standard-library facilities, perform no external I/O, and do not read benchmark files.","required":true,"scope":["implementation and execution"],"dependencies":[],"acceptance_criteria":["No third-party dependencies are used.","No external I/O is performed.","No benchmark files are read."],"sources":[{"clause_id":"C4","origin":"explicit","interpretation":"Standard-library restriction."},{"clause_id":"C5","origin":"explicit","interpretation":"I/O and benchmark-file restrictions."},{"clause_id":"C14","origin":"explicit","interpretation":"Repeated standard-library and I/O restrictions."}]},{"id":"S2","kind":"safety_property","role":"guarantee","statement":"Compute the result without floating-point arithmetic.","required":true,"scope":["floor-sum computation"],"dependencies":[],"acceptance_criteria":["No floating-point operations or conversions are used to compute the sum."],"sources":[{"clause_id":"C12","origin":"explicit","interpretation":"Explicit prohibition on floating point."}]},{"id":"O3","kind":"postcondition","role":"guarantee","statement":"The public examples return -4 for {a:-2,b:1,m:3,n:4} and 0 for {a:100,b:-99,m:7,n:0}.","required":true,"scope":["public example inputs"],"dependencies":[{"id":"O1","relation":"uses_proof"}],"acceptance_criteria":["solve({a:-2,b:1,m:3,n:4}) returns -4.","solve({a:100,b:-99,m:7,n:0}) returns 0."],"sources":[{"clause_id":"C17","origin":"explicit","interpretation":"Public examples are concrete behavioral requirements; held-out cases require the full stated domain."}]},{"id":"N1","kind":"explicit_non_goal","role":"exclusion","statement":"No behavior is required for malformed inputs.","required":true,"scope":["inputs outside the stated schema or bounds"],"dependencies":[],"acceptance_criteria":["The contract imposes no malformed-input validation or result requirement."],"sources":[{"clause_id":"C7","origin":"explicit","interpretation":"Malformed-input behavior is explicitly excluded."}]}],"category_review":{"entities":"JSON object containing n, m, a, b and a scalar exact integer result.","preconditions":"Caller supplies inputs satisfying the stated schema and bounds.","postconditions":"Exact signed floor sum, zero empty sum, public examples, and required pure deterministic solve interface.","invariants":"None separately stated.","safety_properties":"Standard library only; no external I/O or benchmark reads; no floating point.","liveness_properties":"None separately stated.","resource_constraints":"None stated beyond implementation restrictions.","error_semantics":"Malformed-input behavior is outside the contract.","explicit_non_goals":"Malformed-input behavior.","ambiguities":"None; the specified output is scalar, so ordering adds no additional observable requirement."},"clauses":[{"clause_id":"C1","disposition":"context","refs":[],"note":"Task title identifies the signed arithmetic floor-sum kernel."},{"clause_id":"C2","disposition":"obligations","refs":["O2"],"note":""},{"clause_id":"C3","disposition":"obligations","refs":["D1"],"note":""},{"clause_id":"C4","disposition":"obligations","refs":["S1"],"note":""},{"clause_id":"C5","disposition":"obligations","refs":["S1"],"note":""},{"clause_id":"C6","disposition":"obligations","refs":["A1"],"note":""},{"clause_id":"C7","disposition":"exclusion","refs":["N1"],"note":""},{"clause_id":"C8","disposition":"obligations","refs":["D1","A1"],"note":""},{"clause_id":"C9","disposition":"obligations","refs":["O1","D1"],"note":""},{"clause_id":"C10","disposition":"obligations","refs":["O1"],"note":""},{"clause_id":"C11","disposition":"obligations","refs":["O1"],"note":""},{"clause_id":"C12","disposition":"obligations","refs":["S2"],"note":""},{"clause_id":"C13","disposition":"obligations","refs":["O2"],"note":""},{"clause_id":"C14","disposition":"obligations","refs":["S1"],"note":""},{"clause_id":"C15","disposition":"obligations","refs":["D1"],"note":""},{"clause_id":"C16","disposition":"obligations","refs":["D1"],"note":"Preserve the object input and scalar integer output; no ordered collection is specified."},{"clause_id":"C17","disposition":"obligations","refs":["O3","O1"],"note":"Examples constrain results; held-out scoring emphasizes the entire valid domain."}],"assumptions":[{"id":"A1","supplied_by":"caller","discharged_at":"Each solve invocation, by supplying an object satisfying the stated schema and bounds."}],"ambiguities":[],"selected_defaults":[]}