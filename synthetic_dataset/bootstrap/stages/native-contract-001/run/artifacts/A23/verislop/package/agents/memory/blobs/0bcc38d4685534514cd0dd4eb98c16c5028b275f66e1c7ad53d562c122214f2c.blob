{"files":{"solution.py":"def solve(x):\n    if x[\"m\"] == 0:\n        return 0\n    total = 0\n    for i in range(x[\"n\"]):\n        total += (x[\"a\"] * i + x[\"b\"]) // x[\"m\"]\n    return total\n"},"bindings":{"schema_version":"0.1","artifact_kind":"implementation_bindings","target":"python","serialization_profile":"python-v0_2","bindings":[{"binding_id":"B-solve","symbol":"solve","object":{"file":"solution.py","qualname":"solve"},"obligations":["D1","O1","O2","S1","S2"]}],"helpers":[]}}