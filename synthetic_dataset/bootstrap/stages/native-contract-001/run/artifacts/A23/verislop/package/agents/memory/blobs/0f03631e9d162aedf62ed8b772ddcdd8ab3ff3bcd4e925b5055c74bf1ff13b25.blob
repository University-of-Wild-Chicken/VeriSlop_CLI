theorem «floor_sum_correct» : (∀ («_v0» : _root_.VeriSlopAST.«Input»), ((_root_.VeriSlopAST.«valid_input» «_v0») → ((_root_.VeriSlopAST.«solve» «_v0») = (_root_.List.sum (@_root_.List.map _root_.Nat _root_.Int (fun («_v1» : _root_.Nat) => (_root_.Int.fdiv (_root_.Int.add (_root_.Int.mul (_root_.VeriSlopAST.«Input».«a» «_v0») (_root_.Int.ofNat «_v1»)) (_root_.VeriSlopAST.«Input».«b» «_v0»)) (_root_.VeriSlopAST.«Input».«m» «_v0»))) (_root_.List.range (_root_.Int.toNat (_root_.VeriSlopAST.«Input».«n» «_v0»)))))))) := by sorry
theorem «integer_arithmetic» : (_root_.VeriSlop.Native.Contract _root_.VeriSlopAST.«IntegerArithmetic») := by sorry
