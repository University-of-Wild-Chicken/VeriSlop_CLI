      ]
    },
    {
      "id": "A1",
      "revision": 1,
      "kind": "precondition",
      "role": "assumption",
      "statement": "The input supplier provides an object {n,m,a,b} with integer n,m,a,b, 0<=n<=500 and m>0. The integers a and b may have either sign and arbitrary magnitude, including magnitude 10^30. No additional input bounds or preconditions apply.",
      "required": true,
      "scope": ["supplied input"],
      "dependencies": [{"id": "D1", "relation": "uses_definition"}],
      "acceptance_criteria": [
        "Each supplied input has the specified schema, 0<=n<=500 and m>0.",
        "No magnitude restriction is imposed on a or b.",
        "No additional caller precondition restricts the specified domain."
      ],
      "sources": [
        {"clause_id": "C5", "origin": "explicit", "interpretation": "supplier guarantees schema and bounds"},
        {"clause_id": "C7", "origin": "explicit", "interpretation": "complete input domain"},
