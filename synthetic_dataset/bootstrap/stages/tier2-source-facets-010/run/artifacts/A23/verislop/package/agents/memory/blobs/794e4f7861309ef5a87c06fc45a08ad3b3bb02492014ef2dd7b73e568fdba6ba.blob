{
  "obligations": [
    {
      "id": "D1",
      "revision": 1,
      "kind": "entity",
      "role": "declaration",
      "statement": "The deliverable is canonical program.vscore.json containing one admitted typed entry solve of arity 1 under vscore/0.3, normative Lean vscore-semantics/0.3 and data-pipeline/0.3. Its input represents the JSON object {n,m,a,b} of mathematical integers and its output represents one mathematical integer. Strings in the source language contain Unicode scalar values with lexicographic comparison by scalar codepoint.",
      "required": true,
      "scope": ["canonical source", "typed input and output", "normative language and serialization"],
      "dependencies": [],
      "acceptance_criteria": [
        "The canonical file is program.vscore.json and its sole admitted typed entry is solve with arity 1.",
        "The typed input represents the specified four integer fields and the typed result represents a JSON integer.",
        "The source and serialization conform to vscore/0.3, normative Lean vscore-semantics/0.3 and data-pipeline/0.3.",
        "Any string values use Unicode scalar semantics and scalar-codepoint lexicographic order."
      ],
      "sources": [
        {"clause_id": "C2", "origin": "explicit", "interpretation": "canonical deliverable and entry"},
