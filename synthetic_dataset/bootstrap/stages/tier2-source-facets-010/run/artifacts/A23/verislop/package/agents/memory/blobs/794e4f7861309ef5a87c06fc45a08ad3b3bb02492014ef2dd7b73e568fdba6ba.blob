        {"clause_id": "C29", "origin": "explicit", "interpretation": "preserved assumption identity"}
      ]
    },
    {
      "id": "N1",
      "revision": 1,
      "kind": "explicit_non_goal",
      "role": "exclusion",
      "statement": "No behavior is required for malformed input outside the stated schema and bounds.",
