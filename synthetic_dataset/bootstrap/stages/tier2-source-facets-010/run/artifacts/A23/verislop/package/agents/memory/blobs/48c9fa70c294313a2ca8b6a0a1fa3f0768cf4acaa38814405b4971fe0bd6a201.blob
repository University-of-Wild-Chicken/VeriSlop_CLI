olve» «_v0») = (_root_.List.sum (@_root_.List.map _root_.Nat _root_.Int (fun («_v1» : _root_.Nat) => (_root_.Int.fdiv (_root_.Int.add (_root_.Int.mul (_root_.VeriSlopAST.«Input».«a» «_v0») (_root_.Int.ofNat «_v1»)) (_root_.VeriSlopAST.«Input».«b» «_v0»)) (_root_.VeriSlopAST.«Input».«m» «_v0»))) (_root_.List.range (_root_.Int.toNat (_root_.VeriSlopAST.«Input».«n» «_v0»)))))))) ∧ (_root_.VeriSlop.Source.Contract _root_.VeriSlopAST.«SolveSource»)) := by sorry\ntheorem «_vs_value_complete_behavior» : (∀ («_v0» : _root_.VeriSlopAST.«Input»), ((_root_.VeriSlopAST.«valid_input» «_v0») → ((_root_.VeriSlopAST.«solve» «_v0») = (_root_.List.sum (@_root_.List.map _root_.Nat _root_.Int (fun («_v1» : _root_.Nat) => (_root_.Int.fdiv (_root_.Int.add (_root_.Int.mul (_root_.VeriSlopAST.«Input».«a» «_v0») (_root_.Int.ofNat «_v1»)) (_root_.VeriSlopAST.«Input».«b» «_v0»)) (_root_.VeriSlopAST.«Input».«m» «_v0»))) (_root_.List.range (_root_.Int.toNat (_root_.VeriSlopAST.«Input».«n» «_v0»)))))))) := by exact _root_.VeriSlopAST.«complete_behavior».1\ntheorem «operational_source» : (_root_.VeriSlop.Source.Contract _root_.VeriSlopAST.«SolveSource») := by sorry\ntheorem «valid_input_inhabited» : (∃ («_v0» : _root_.VeriSlopAST.«Input»), (_root_.VeriSlopAST.«valid_input» «_v0»)) := by sorry\nend VeriSlopAST\n","raw_response":"{\"encoding\":\"verislop.formalizer-ast/0.1\",\"records\":{\"Input\":{\"fields\":[{\"name\":\"n\",\"sort\":\"Int\"},{\"name\":\"m\",\"sort\":\"Int\"},{\"name\":\"a\",\"sort\":\"Int\"},{\"name\":\"b\",\"sort\":\"Int\"}]}},\"symbols\":{\"solve\":{\"args\":[{\"record\":\"Input\"}],\"result\":\"Int\",\"body\":{\"tag\":\"list_sum\",\"value\":{\"tag\":\"list_map\",\"value\":{\"tag\":\"list_range\",\"stop\":{\"tag\":\"int_to_nat\",\"value\":{\"tag\":\"field\",\"sort\":\"Input\",\"field\":\"n\",\"value\":{\"tag\":\"var\",\"index\":0}}}},\"function\":{\"sort\":\"Nat\",\"body\":{\"tag\":\"int_fdiv\",\"left\":{\"tag\":\"int_add\",\"left\":{\"tag\":\"int_mul\",\"left\":{\"tag\":\"fiel