irements cannot be replaced by equality" }, { documentRef := "tier2:tier2-source-facets-010:A23", documentHash := "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", startByte := 4775, endByte := 4928, origin := "explicit", interpretation := "operational source-only classification" }, { documentRef := "tier2:tier2-source-facets-010:A23", documentHash := "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", startByte := 5156, endByte := 6207, origin := "explicit", interpretation := "S2 exact seven facets and value_required=false" }],
