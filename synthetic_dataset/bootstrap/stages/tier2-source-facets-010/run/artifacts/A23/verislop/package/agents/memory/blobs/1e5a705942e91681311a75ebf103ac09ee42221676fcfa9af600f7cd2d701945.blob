 "lean_source": "import Std\n\n-- BEGIN VERISLOP REGISTRY\n-- Generated by `verislop formalize`. Typed obligation metadata: an index, never evidence.\nnamespace VeriSlop.Registry\n\nstructure SourceRef where\n  documentRef : String\n  documentHash : String\n  startByte : Nat\n  endByte : Nat\n  origin : String\n  interpretation : String\n\nstructure Dependency where\n  id : String\n  relation : String\n\nstructure Entry where\n  id : String\n  revision : Nat\n  kind : String\n  role : String\n  statement : String\n  required : Bool\n  sourceRefs : List SourceRef\n  scope : List String\n  dependencies : List Dependency\n  acceptanceCriteria : List String\n  bindings : List String\n\ndef «D1» : Entry := {\n  id := \"D1\",\n  revision := 1,\n  kind := \"entity\",\n  role := \"declaration\",\n  statement := \"The deliverable is canonical program.vscore.json with exactly one admitted typed entry solve of arity 1 under vscore/0.3, normative Lean vscore-semantics/0.3 and data-pipeline/0.3. Its typed input represents the JSON object {n,m,a,b} of mathematical integers and its result represents one JSON integer. Language strings contain Unicode scalar values and compare lexicographically by scalar codepoint.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 67, endByte := 137, origin := \"explicit\", interpretation := \"canonical file and entry\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 138, endByte := 222, origin := \"explicit\", interpretation := \"typed JSON representation\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 383, endByte := 467, origin := \"explicit\", interpretation := \"integer input fields\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 615, endByte := 762, origin := \"explicit\", interpretation := \"normative source and serialization\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1042, endByte := 1131, origin := \"explicit\", interpretation := \"string semantics\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 2085, endByte := 3628, origin := \"explicit\", interpretation := \"preserved declaration identity\" }],\n  scope := [\"canonical source\", \"typed input and result\", \"language and serialization semantics\"],\n  dependencies := [],\n  acceptanceCriteria := [\"The canonical filename is program.vscore.json and its sole admitted typed entry is solve of arity 1.\", \"The typed input represents the specified four integer fields and the result represents a JSON integer.\", \"Source and serialization conform to vscore/0.3, normative Lean vscore-semantics/0.3 and data-pipeline/0.3.\", \"Strings use Unicode scalar values and scalar-codepoint lexicographic comparison.\"],\n  bindings := [\"VeriSlopAST.Input\", \"VeriSlopAST.solve\"] }\n\ndef «A1» : Entry := {\n  id := \"A1\",\n  revision := 1,\n  kind := \"precondition\",\n  role := \"assumption\",\n  statement := \"The input supplier supplies the specified object {n,m,a,b} with integer fields, 0<=n<=500 and m>0. The integers a and b have arbitrary signs and magnitudes, including magnitude 10^30. No additional input bounds or preconditions apply.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 280, endByte := 337, origin := \"explicit\", interpretation := \"supplier assumption\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 383, endByte := 467, origin := \"explicit\", interpretation := \"complete input domain\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1132, endByte := 1222, origin := \"explicit\", interpretation := \"no additional preconditions\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 2085, endByte := 3628, origin := \"explicit\", interpretation := \"preserved assumption identity\" }],\n  scope := [\"supplied inputs\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }],\n  acceptanceCriteria := [\"Supplied inputs satisfy the specified schema, 0<=n<=500 and m>0.\", \"No magnitude restriction is imposed on a or b.\", \"No additional caller precondition restricts the specified domain.\"],\n  bindings := [\"VeriSlopAST.valid_input\"] }\n\ndef «O1» : Entry := {\n  id := \"O1\",\n  revision := 1,\n  kind := \"postcondition\",\n  role := \"guarantee\",\n  statement := \"For every input satisfying A1, the actual sole admitted typed arity-1 solve entry in canonical program.vscore.json returns exactly Σ_{i=0}^{n-1} floor((a*i+b)/m). Floor is toward negative infinity, including negative numerators, and the empty sum is zero. The formal contract requires universal refinement of this complete value proposition by the actual source under normative Lean vscore-semantics/0.3 and data-pipeline/0.3, together with typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only for that exact file and entry.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 468, endByte := 518, origin := \"explicit\", interpretation := \"complete floor-sum formula\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 519, endByte := 572, origin := \"explicit\", interpretation := \"signed floor semantics\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 573, endByte := 591, origin := \"explicit\", interpretation := \"empty sum\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1224, endByte := 1269, origin := \"explicit\", interpretation := \"preserved examples\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1270, endByte := 1427, origin := \"explicit\", interpretation := \"exact example values and universal refinement\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1874, endByte := 1985, origin := \"explicit\", interpretation := \"complete mathematical statement and universal refinement\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1986, endByte := 2026, origin := \"explicit\", interpretation := \"examples do not replace universal behavior\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 2085, endByte := 3628, origin := \"explicit\", interpretation := \"preserved O1 identity\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4060, endByte := 4264, origin := \"explicit\", interpretation := \"canonical source delivery\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4265, endByte := 4326, origin := \"explicit\", interpretation := \"source requirements in formal contract\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4327, endByte := 4496, origin := \"explicit\", interpretation := \"no replacement of source requirements by equality\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4497, endByte := 4713, origin := \"explicit\", interpretation := \"mixed source/value guarantee\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4714, endByte := 4774, origin := \"explicit\", interpretation := \"required value facet\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 5156, endByte := 6207, origin := \"explicit\", interpretation := \"O1 exact seven facets and value_required=true\" }],\n  scope := [\"every input satisfying A1\", \"actual canonical solve implementation\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }, { id := \"A1\", relation := \"assumes\" }],\n  acceptanceCriteria := [\"For every valid input, the decoded result equals Σ_{i=0}^{n-1} floor((a*i+b)/m).\", \"Each quotient rounds toward negative infinity and n=0 returns zero.\", \"Input {a:-2,b:1,m:3,n:4} returns -4; input {a:100,b:-99,m:7,n:0} returns 0.\", \"The formal contract binds program.vscore.json, solve, arity 1 and typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data, restricted_runtime_only.\", \"The complete value proposition and universal source implementation refinement are required alongside the source facets; examples or mathematical existence/equality alone do not replace them.\"],\n  bindings := [\"VeriSlopAST.complete_behavior\"] }\n\ndef «O2» : Entry := {\n  id := \"O2\",\n  revision := 1,\n  kind := \"postcondition\",\n  role := \"guarantee\",\n  statement := \"Canonical program.vscore.json supplies exactly one admitted typed solve entry of arity 1 whose typed and serialized input/result preserve the specified JSON structure and exact ordering under data-pipeline/0.3. For every input satisfying A1 the represented integer result equals Σ_{i=0}^{n-1} floor((a*i+b)/m), with floor toward negative infinity and zero for n=0. The formal contract requires universal refinement of this complete typed input/output behavior by the actual source under normative Lean vscore-semantics/0.3 and requires typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only for the exact file and entry.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 67, endByte := 137, origin := \"explicit\", interpretation := \"canonical typed entry\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 138, endByte := 222, origin := \"explicit\", interpretation := \"typed input/output structure\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 468, endByte := 518, origin := \"explicit\", interpretation := \"represented functional result\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 519, endByte := 572, origin := \"explicit\", interpretation := \"floor semantics\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 573, endByte := 591, origin := \"explicit\", interpretation := \"empty result\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 615, endByte := 762, origin := \"explicit\", interpretation := \"source and serialization semantics\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 763, endByte := 828, origin := \"explicit\", interpretation := \"structure and ordering preservation\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 829, endByte := 887, origin := \"explicit\", interpretation := \"total pure deterministic execution\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 888, endByte := 969, origin := \"explicit\", interpretation := \"input immutability and effect restrictions\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 970, endByte := 1041, origin := \"explicit\", interpretation := \"unbounded exact arithmetic\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 2085, endByte := 3628, origin := \"explicit\", interpretation := \"preserved O2 identity\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4060, endByte := 4264, origin := \"explicit\", interpretation := \"canonical source requirements\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4265, endByte := 4326, origin := \"explicit\", interpretation := \"formal source contract\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4327, endByte := 4496, origin := \"explicit\", interpretation := \"no substitution by equality alone\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4497, endByte := 4713, origin := \"explicit\", interpretation := \"mixed source/value refinement\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4714, endByte := 4774, origin := \"explicit\", interpretation := \"required value facet\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 5156, endByte := 6207, origin := \"explicit\", interpretation := \"O2 exact seven facets and value_required=true\" }],\n  scope := [\"canonical delivery\", \"typed and serialized input/output\", \"every input satisfying A1\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }, { id := \"A1\", relation := \"assumes\" }],\n  acceptanceCriteria := [\"The deliverable has filename program.vscore.json and one admitted typed solve entry of arity 1.\", \"Typed and serialized input/output preserve the specified object fields, integer result and exact ordering according to data-pipeline/0.3.\", \"For every input satisfying A1, the represented result equals Σ_{i=0}^{n-1} floor((a*i+b)/m), using negative-infinity floor and zero for n=0.\", \"The formal contract binds the exact file and entry to typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only.\", \"The complete value proposition and universal source implementation refinement are required alongside all source facets.\"],\n  bindings := [\"VeriSlopAST.complete_behavior\"] }\n\ndef «S1» : Entry := {\n  id := \"S1\",\n  revision := 1,\n  kind := \"safety_property\",\n  role := \"guarantee\",\n  statement := \"The sole admitted typed arity-1 solve entry in canonical program.vscore.json executes totally, purely and deterministically under normative restricted vscore/0.3 semantics, preserves immutable input values, performs no external I/O, never reads benchmark files and uses no external-effect constructors or floating-point operations. Its formal contract requires typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only. S1 is an operational source-only guarantee.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 223, endByte := 279, origin := \"explicit\", interpretation := \"no external I/O or benchmark reads\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 615, endByte := 762, origin := \"explicit\", interpretation := \"restricted normative source\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 829, endByte := 887, origin := \"explicit\", interpretation := \"totality, purity and determinism\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 888, endByte := 969, origin := \"explicit\", interpretation := \"immutable inputs and effect restrictions\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 2085, endByte := 3628, origin := \"explicit\", interpretation := \"preserved S1 identity\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4060, endByte := 4264, origin := \"explicit\", interpretation := \"canonical source requirements\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4265, endByte := 4326, origin := \"explicit\", interpretation := \"formal source contract\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4327, endByte := 4496, origin := \"explicit\", interpretation := \"source properties cannot be replaced by equality\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4775, endByte := 4928, origin := \"explicit\", interpretation := \"operational source-only classification\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 5156, endByte := 6207, origin := \"explicit\", interpretation := \"S1 exact seven facets and value_required=false\" }],\n  scope := [\"canonical solve source\", \"admitted typed execution\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }],\n  acceptanceCriteria := [\"The formal contract binds program.vscore.json, solve and arity 1 to typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only.\", \"Admitted typed execution is total, deterministic and pure, preserves inputs and cannot perform external effects.\", \"No external I/O or benchmark-file reads occur.\", \"Operational source requirements are retained and cannot be replaced by value equalities.\"],\n  bindings := [\"VeriSlopAST.operational_source\"] }\n\ndef «S2» : Entry := {\n  id := \"S2\",\n  revision := 1,\n  kind := \"safety_property\",\n  role := \"guarantee\",\n  statement := \"The sole admitted typed arity-1 solve entry in canonical program.vscore.json uses exact unbounded mathematical integers for signed multiplication, addition, division toward negative infinity and summation, without floating point or bounded-integer overflow. Its formal contract requires typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only under normative Lean vscore-semantics/0.3 and data-pipeline/0.3. S2 is an operational source-only guarantee.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 468, endByte := 518, origin := \"explicit\", interpretation := \"exact floor-sum arithmetic\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 519, endByte := 572, origin := \"explicit\", interpretation := \"negative-infinity division\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 592, endByte := 613, origin := \"explicit\", interpretation := \"no floating point\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 970, endByte := 1041, origin := \"explicit\", interpretation := \"unbounded integer semantics\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 2085, endByte := 3628, origin := \"explicit\", interpretation := \"preserved S2 identity\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4060, endByte := 4264, origin := \"explicit\", interpretation := \"canonical source requirements\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4265, endByte := 4326, origin := \"explicit\", interpretation := \"formal source contract\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4327, endByte := 4496, origin := \"explicit\", interpretation := \"source requirements cannot be replaced by equality\" }, { documentRef := \"tier2:tier2-source-facets-010:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4775, endByte := 4928, 