{
  "obligations": [
    {
      "id": "D1",
      "revision": 1,
      "kind": "entity",
      "role": "declaration",
      "statement": "The canonical artifact is program.vscore.json with one typed entry solve of arity 1. Its input represents {events:[{group:string,time:int,value:int|null}],start:int,end:int,width:positive int,fill:'none'|'previous'} and its result represents [{group:string,start:int,count:natural,value:int|null}] under the data-pipeline/0.3 serialization profile. Integers are unbounded mathematical integers; strings are sequences of Unicode scalar values ordered lexicographically by scalar codepoint.",
      "required": true,
      "scope": ["typed input, result and source artifact"],
      "dependencies": [],
      "acceptance_criteria": [
        "The declared input and result preserve all specified fields and their domains.",
        "Canonical source uses vscore/0.3 under normative Lean vscore-semantics/0.3 and data-pipeline/0.3.",
        "Define G as the scalar-codepoint-lexicographically sorted unique group names of all input events.",
        "Define B as the increasing sequence b_k=start+k*width for natural k with b_k<end.",
        "For g in G and k indexing B, define M(g,k) as the list of event occurrences with group=g, b_k<=time<min(b_k+width,end), and value non-null; define c(g,k)=length M(g,k) and s(g,k)=the mathematical integer sum of those values."
      ],
      "sources": [
        {"clause_id": "C2", "origin": "explicit", "interpretation": "source artifact and entry"},
        {"clause_id": "C3", "origin": "explicit", "interpretation": "typed representation"},
        {"clause_id": "C5", "origin": "explicit", "interpretation": "input domain"},
        {"clause_id": "C15", "origin": "explicit", "interpretation": "result fields"},
        {"clause_id": "C17", "origin": "explicit", "interpretation": "normative source and serialization"},
        {"clause_id": "C21", "origin": "explicit", "interpretation": "integer semantics"},
        {"clause_id": "C22", "origin": "explicit", "interpretation": "string semantics"}
      ]
    },
    {
      "id": "A1",
      "revision": 1,
      "kind": "precondition",
      "role": "assumption",
      "statement": "The caller supplies an input of the specified domain, with width a positive integer, start<=end, and fill equal to 'none' or 'previous'. There are no additional bounds or preconditions.",
      "required": true,
      "scope": ["caller input"],
      "dependencies": [{"id": "D1", "relation": "uses_definition"}],
      "acceptance_criteria": [
        "width>0 and start<=end.",
        "Every event has the stated group, time and nullable integer value types.",
        "No restriction is imposed on event ordering, duplicate occurrences, integer magnitude, group names, or whether events are in range."
      ],
      "sources": [
        {"clause_id": "C5", "origin": "explicit", "interpretation": "stated input preconditions"},
        {"clause_id": "C23", "origin": "explicit", "interpretation": "no additional preconditions"}
      ]
    },
    {
      "id": "I1",
      "revision": 1,
      "kind": "invariant",
      "role": "guarantee",
      "statement": "As the explicitly classified source-only operational invariant, program.vscore.json must contain the single typed solve entry of arity 1 whose admitted normative restricted-source execution is typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only. Its exact source requirements must remain in its formal contract; no value equality substitutes for them. The causal filling behavior associated with the original invariant is retained in O5.",
      "required": true,
      "scope": ["all admitted typed executions"],
      "dependencies": [{"id": "D1", "relation": "uses_definition"}],
      "acceptance_criteria": [
        "The contract for I1 requires file=program.vscore.json, entry=solve, arity=1 and all seven named closed source properties.",
        "I1 is source-only with value_required=false.",
        "Normative execution preserves immutable input and exact unbounded integer semantics without floating point."
      ],
      "sources": [
        {"clause_id": "C19", "origin": "explicit", "interpretation": "total pure deterministic execution"},
        {"clause_id": "C20", "origin": "explicit", "interpretation": "immutability and effect restrictions"},
        {"clause_id": "C21", "origin": "explicit", "interpretation": "exact arithmetic"},
        {"clause_id": "C34", "origin": "explicit", "interpretation": "preserved invariant identity"},
        {"clause_id": "C44", "origin": "explicit", "interpretation": "operational source-only classification"},
        {"clause_id": "C47", "origin": "explicit", "interpretation": "exact I1 source facets"}
      ]
    },
    {
      "id": "O1",
      "revision": 1,
      "kind": "postcondition",
      "role": "guarantee",
      "statement": "Deliver canonical program.vscore.json with exactly one admitted typed solve entry of arity 1 under normative Lean vscore-semantics/0.3 and data-pipeline/0.3. For every input satisfying A1 its normative evaluation must return precisely the grouped bucket aggregation defined by O2 through O6, preserving the specified JSON structure. This is universal source implementation refinement, together with typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only.",
      "required": true,
      "scope": ["canonical delivery and all inputs satisfying A1"],
      "dependencies": [{"id": "D1", "relation": "uses_definition"}, {"id": "A1", "relation": "assumes"}],
      "acceptance_criteria": [
        "The O1 contract requires file=program.vscore.json, entry=solve, arity=1 and all seven closed source properties.",
        "For every admissible input x, evaluating the delivered solve(x) produces exactly the ordered records specified by G, B, c, s and the causal value formula in O5.",
        "The complete value proposition and its universal refinement by the actual source are required; an existence theorem, True or reflexive equality is insufficient."
      ],
      "sources": [
        {"clause_id": "C2", "origin": "explicit", "interpretation": "delivery and entry"},
        {"clause_id": "C3", "origin": "explicit", "interpretation": "typed input and result"},
        {"clause_id": "C4", "origin": "explicit", "interpretation": "no external I/O"},
        {"clause_id": "C17", "origin": "explicit", "interpretation": "canonical normative implementation"},
        {"clause_id": "C23", "origin": "explicit", "interpretation": "unrestricted specified domain"},
        {"clause_id": "C31", "origin": "explicit", "interpretation": "universal refinement"},
        {"clause_id": "C39", "origin": "explicit", "interpretation": "source identity for each guarantee"},
        {"clause_id": "C40", "origin": "explicit", "interpretation": "formal source contract"},
        {"clause_id": "C41", "origin": "explicit", "interpretation": "value theorem cannot replace source requirements"},
        {"clause_id": "C42", "origin": "explicit", "interpretation": "mixed source/value guarantee"},
        {"clause_id": "C47", "origin": "explicit", "interpretation": "exact O1 source facets"}
      ]
    },
    {
      "id": "O2",
      "revision": 1,
      "kind": "postcondition",
      "role": "guarantee",
      "statement": "For every input satisfying A1, the group sequence used by the delivered solve is exactly G: every unique group name from all input events, including names represented only by out-of-range or null-valued events, once each in Unicode scalar-codepoint lexicographic order. Universally refine this formula with the single arity-1 solve in canonical program.vscore.json and require typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only in O2's contract.",
      "required": true,
      "scope": ["all inputs satisfying A1"],
      "dependencies": [{"id": "D1", "relation": "uses_definition"}, {"id": "A1", "relation": "assumes"}],
      "acceptance_criteria": [
        "G=sort_unique([event.group for every event occurrence]), using scalar-codepoint lexicographic order.",
        "No group is removed because its events are outside [start,end) or have null values.",
        "O2 requires both its complete group formula and universal source refinement, plus file=program.vscore.json, entry=solve, arity=1 and all seven closed source properties."
      ],
      "sources": [
        {"clause_id": "C6", "origin": "explicit", "interpretation": "group membership and ordering"},
        {"clause_id": "C22", "origin": "explicit", "interpretation": "Unicode ordering"},
        {"clause_id": "C42", "origin": "explicit", "interpretation": "mixed source/value refinement"},
        {"clause_id": "C47", "origin": "explicit", "interpretation": "exact O2 source facets"}
      ]
    },
    {
      "id": "O3",
      "revision": 1,
      "kind": "postcondition",
      "role": "guarantee",
      "statement": "For every input satisfying A1 and every g in G, the delivered solve emits exactly one bucket for each b_k=start+k*width<end, in increasing k, with membership interval [b_k,min(b_k+width,end)). No bucket starts at or beyond end. If start=end, no records are emitted. Universally refine this formula with the single arity-1 solve in canonical program.vscore.json and require typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only in O3's contract.",
      "required": true,
      "scope": ["all inputs satisfying A1 and all groups"],
      "dependencies": [{"id": "D1", "relation": "uses_definition"}, {"id": "A1", "relation": "assumes"}],
      "acceptance_criteria": [
        "Bucket starts are exactly B, with neither missing nor extra starts for any group.",
        "The left interval endpoint is inclusive and the right endpoint exclusive, including the clipped final bucket.",
        "O3 requires its complete bucket formula and universal source refinement, plus file=program.vscore.json, entry=solve, arity=1 and all seven closed source properties."
      ],
      "sources": [
        {"clause_id": "C7", "origin": "explicit", "interpretation": "bucket progression"},
        {"clause_id": "C8", "origin": "explicit", "interpretation": "strict endpoint and interval"},
        {"clause_id": "C42", "origin": "explicit", "interpretation": "mixed source/value refinement"},
        {"clause_id": "C47", "origin": "explicit", "interpretation": "exact O3 source facets"}
      ]
    },
    {
      "id": "O4",
      "revision": 1,
      "kind": "postcondition",
      "role": "guarantee",
      "statement": "For every input satisfying A1 and every emitted bucket (g,k), its count equals c(g,k) and its aggregate sum equals s(g,k), computed from exactly the non-null event occurrences belonging to that group's clipped bucket interval. Duplicate occurrences each contribute separately; null and out-of-range values do not contribute. All arithmetic is exact over unbounded integers. Universally refine this formula with the single arity-1 solve in canonical program.vscore.json and require typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only in O4's contract.",
      "required": true,
      "scope": ["all inputs satisfying A1 and all emitted buckets"],
      "dependencies": [{"id": "D1", "relation": "uses_definition"}, {"id": "A1", "relation": "assumes"}],
      "acceptance_criteria": [
        "count(g,k)=length M(g,k); sum(g,k)=sum of every occurrence's integer value in M(g,k).",
        "A bucket is nonempty exactly when c(g,k)>0, even if its sum is zero.",
        "O4 requires its complete aggregation formula and universal source refinement, plus file=program.vscore.json, entry=solve, arity=1 and all seven closed source properties."
      ],
      "sources": [
        {"clause_id": "C9", "origin": "explicit", "interpretation": "sum contributors"},
        {"clause_id": "C10", "origin": "explicit", "interpretation": "count contributors"},
        {"clause_id": "C16", "origin": "explicit", "interpretation": "duplicate multiplicity and zero sum"},
        {"clause_id": "C21", "origin": "explicit", "interpretation": "exact integer arithmetic"},
        {"clause_id": "C42", "origin": "explicit", "interpretation": "mixed source/value refinement"},
        {"clause_id": "C47", "origin": "explicit", "interpretation": "exact O4 source facets"}
      ]
    },
    {
      "id": "O5",
      "revision": 1,
      "kind": "postcondition",
      "role": "guarantee",
      "statement": "For every input satisfying A1 and emitted bucket (g,k), value is s(g,k) when c(g,k)>0. When c(g,k)=0, value is null if fill='none'; if fill='previous', value is s(g,j) for the greatest j<k with c(g,j)>0, or null if no such j exists. Previous state is independent for each group, starts absent, changes only upon a nonempty bucket, and retains a zero sum as a real value. Empty buckets never reset it, and events before start never seed it. Universally refine this formula with the single arity-1 solve in canonical program.vscore.json and require typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only in O5's contract.",
      "required": true,
      "scope": ["all inputs satisfying A1, both fill modes and all groups"],
      "dependencies": [{"id": "D1", "relation": "uses_definition"}, {"id": "A1", "relation": "assumes"}],
      "acceptance_criteria": [
        "Let p(g,0)=null; after bucket k, p(g,k+1)=s(g,k) if c(g,k)>0 and p(g,k+1)=p(g,k) otherwise.",
        "value(g,k)=s(g,k) if c(g,k)>0; otherwise null for fill='none' and p(g,k) for fill='previous'.",
        "Neither another group's history nor an event before start can initialize or update p(g,k).",
        "O5 requires the complete guarded value and state formulas and universal source refinement, plus file=program.vscore.json, entry=solve, arity=1 and all seven closed source properties."
      ],
      "sources": [
        {"clause_id": "C11", "origin": "explicit", "interpretation": "nonempty sum and previous update"},
        {"clause_id": "C12", "origin": "explicit", "interpretation": "both empty-bucket branches"},
        {"clause_id": "C13", "origin": "explicit", "interpretation": "empty buckets preserve previous"},
        {"clause_id": "C14", "origin": "explicit", "interpretation": "causal lower boundary"},
        {"clause_id": "C16", "origin": "explicit", "interpretation": "zero sum retained"},
        {"clause_id": "C42", "origin": "explicit", "interpretation": "complete mixed source/value refinement"},
        {"clause_id": "C47", "origin": "explicit", "interpretation": "exact O5 source facets"}
      ]
    },
    {
      "id": "O6",
      "revision": 1,
      "kind": "postcondition",
      "role": "guarantee",
      "statement": "For every input satisfying A1, the result of the delivered solve is exactly the list [{group:g,start:b_k,count:c(g,k),value:value(g,k)}] obtained by traversing G in order and, within each group, B in increasing order, using O5's value formula. Preserve this input/output structure and ordering under data-pipeline/0.3; return an empty list when G or B is empty. Universally refine this formula with the single arity-1 solve in canonical program.vscore.json and require typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only in O6's contract.",
      "required": true,
      "scope": ["all inputs satisfying A1 and serialized results"],
      "dependencies": [{"id": "D1", "relation": "uses_definition"}, {"id": "A1", "relation": "assumes"}],
      "acceptance_criteria": [
        "The result is exactly the group-major, bucket-minor sequence of records with the specified four fields.",
        "Result length equals length(G)*length(B), including groups with no contributing events.",
        "O6 requires the complete result-list formula and universal source refinement, plus file=program.vscore.json, entry=solve, arity=1 and all seven closed source properties."
      ],
      "sources": [
        {"clause_id": "C15", "origin": "explicit", "interpretation": "result shape and traversal order"},
        {"clause_id": "C17", "origin": "explicit", "interpretation": "serialization profile"},
        {"clause_id": "C18", "origin": "explicit", "interpretation": "exact structure and ordering"},
        {"clause_id": "C42", "origin": "explicit", "interpretation": "mixed source/value refinement"},
        {"clause_id": "C47", "origin": "explicit", "interpretation": "exact O6 source facets"}
      ]
    },
    {
      "id": "O7",
      "revision": 1,
      "kind": "postcondition",
      "role": "guarantee",
      "statement": "Preserve both original public example input/output pairs exactly, and require universal implementation refinement of the complete functional specification for every input satisfying A1; examples do not replace that universal proposition. For events a:(0,2),(1,-2), start=0,end=5,width=2,fill='previous', return [(a,0,2,0),(a,2,0,0),(a,4,0,0)] in the specified record structure. For event z:(-1,9), start=0,end=1,width=2,fill='previous', return [(z,0,0,null)]. Require canonical program.vscore.json's single typed solve entry of arity 1 with typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only as part of O7's mixed source/value contract.",
      "required": true,
      "scope": ["public examples and all inputs satisfying A1"],
      "dependencies": [{"id": "D1", "relation": "uses_definition"}, {"id": "A1", "relation": "assumes"}],
      "acceptance_criteria": [
        "Both public examples evaluate to their exact original output lists.",
        "For every admissible input, actual source evaluation equals the complete result formula in O2 through O6, rather than only matching examples.",
        "O7 requires file=program.vscore.json, entry=solve, arity=1 and all seven closed source properties alongside its value proposition."
      ],
      "sources": [
        {"clause_id": "C24", "origin": "explicit", "interpretation": "original examples preserved"},
        {"clause_id": "C25", "origin": "explicit", "interpretation": "exact examples and universal refinement"},
        {"clause_id": "C27", "origin": "explicit", "interpretation": "original functional meanings preserved"},
        {"clause_id": "C31", "origin": "explicit", "interpretation": "complete universal statements"},
        {"clause_id": "C32", "origin": "explicit", "interpretation": "examples cannot replace universality"},
        {"clause_id": "C47", "origin": "explicit", "interpretation": "exact O7 source facets"}
      ]
    },
    {
      "id": "S1",
      "revision": 1,
      "kind": "safety_property",
      "role": "guarantee",
      "statement": "As the explicitly classified source-only safety guarantee, the single typed arity-1 solve entry in canonical program.vscore.json must operate solely through admitted vscore/0.3 pure data constructors under normative Lean vscore-semantics/0.3. Its formal contract requires typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only, with immutable inputs, no external-effect constructors and exact unbounded integer arithmetic.",
      "required": true,
      "scope": ["canonical source and all admitted typed executions"],
      "dependencies": [{"id": "D1", "relation": "uses_definition"}],
      "acceptance_criteria": [
        "S1 requires file=program.vscore.json, entry=solve, arity=1 and all seven closed source properties.",
        "S1 has value_required=false and is not substituted with a mathematical equality or result-existence proposition.",
        "No external I/O, input mutation, floating-point arithmetic or execution outside the normative restricted-source boundary is admitted."
      ],
      "sources": [
        {"clause_id": "C4", "origin": "explicit", "interpretation": "external I/O restriction"},
        {"clause_id": "C19", "origin": "explicit", "interpretation": "execution properties"},
        {"clause_id": "C20", "origin": "explicit", "interpretation": "immutable pure effect-free language"},
        {"clause_id": "C21", "origin": "explicit", "interpretation": "non-floating exact arithmetic"},
        {"clause_id": "C44", "origin": "explicit", "interpretation": "source-only operational classification"},
        {"clause_id": "C47", "origin": "explicit", "interpretation": "exact S1 source facets"}
      ]
    },
    {
      "id": "O8",
      "revision": 1,
      "kind": "postcondition",
      "role": "guarantee",
      "statement": "The proposed formal contracts must retain all specified requirement IDs, kinds, roles and required flags, preserve every required guarantee's exact source facets, and include complete value formulas with universal source refinement for O1 through O7. I1 and S1 alone are source-only. The requested verification scope is Tier 2 restricted_source with backend vscore/0.3, limited to normative restricted-source execution and the explicitly stated trust boundary. Source facets must be independently checked against kernel-reconstructed contracts before proof, after acceptance and at closure; this proposal does not assert their discharge or any lifecycle state.",
      "required": true,
      "scope": ["contract formalization and requested verification boundary"],
      "dependencies": [],
      "acceptance_criteria": [
        "Retain D1, A1, I1, O1, O2, O3, O4, O5, O6, O7 and S1 with their stated kinds, roles and required=true.",
        "For each policy guarantee, require program.vscore.json, solve, arity 1 and the exact seven closed source properties in that guarantee's contract.",
        "Require mixed source/value contracts for every value_required=true row; classify only I1 and S1 as source-only.",
        "Do not treat frozen request constraints as accepted IR, proof evidence or established source discharge.",
        "Keep natural-language correspondence, host tooling, pinned Lean kernel, hashing and OS/hardware explicitly in the trusted boundary."
      ],
      "sources": [
        {"clause_id": "C28", "origin": "explicit", "interpretation": "identity preservation"},
        {"clause_id": "C29", "origin": "explicit", "interpretation": "revised typed pure source properties"},
        {"clause_id": "C30", "origin": "explicit", "interpretation": "preserved delivery assurance"},
        {"clause_id": "C34", "origin": "explicit", "interpretation": "required identities and endpoint"},
        {"clause_id": "C36", "origin": "explicit", "interpretation": "normative scope and trusted components"},
        {"clause_id": "C38", "origin": "explicit", "interpretation": "frozen constraint is not evidence"},
        {"clause_id": "C39", "origin": "explicit", "interpretation": "source facets on every policy guarantee"},
        {"clause_id": "C40", "origin": "explicit", "interpretation": "exact formal contract"},
        {"clause_id": "C41", "origin": "explicit", "interpretation": "source requirements not replaceable by value theorem"},
        {"clause_id": "C42", "origin": "explicit", "interpretation": "complete mixed source/value formulas"},
        {"clause_id": "C43", "origin": "explicit", "interpretation": "value facets required by default"},
        {"clause_id": "C44", "origin": "explicit", "interpretation": "only classified operational IDs source-only"},
        {"clause_id": "C45", "origin": "explicit", "interpretation": "assumptions exclusions and witnesses outside source policy"},
        {"clause_id": "C46", "origin": "explicit", "interpretation": "independent contract-facet checks"},
        {"clause_id": "C47", "origin": "explicit", "interpretation": "frozen exact facet policy"}
      ]
    },
    {
      "id": "N1",
      "revision": 1,
      "kind": "explicit_non_goal",
      "role": "exclusion",
      "statement": "Runtime campaigns and assurance about machine code, compilers, runtime systems or physical resources are outside the requested scope.",
      "required": true,
      "scope": ["assurance boundary"],
      "dependencies": [],
      "acceptance_criteria": ["No runtime campaign or machine-code, compiler, runtime or physical-resource assurance is required or claimed."],
      "sources": [
        {"clause_id": "C35", "origin": "explicit", "interpretation": "runtime campaigns excluded"},
        {"clause_id": "C37", "origin": "explicit", "interpretation": "excluded assurance layers"}
      ]
    }
  ],
  "category_review": {
    "entities": "D1 declares the canonical entry, typed JSON structures, mathematical integers, Unicode strings and aggregation notation.",
    "preconditions": "A1 contains only the stated input domain, positive width and start<=end.",
    "postconditions": "O1 through O7 require exact functional formulas, public examples and universal source refinement with all mandatory source facets; O8 retains contract and boundary requirements.",
    "invariants": "I1 is explicitly source-only; causal previous-value behavior remains fully specified in O5.",
    "safety_properties": "S1 requires the exact source-only purity, effects, immutability and arithmetic boundary.",
    "liveness_properties": "No separate temporal liveness property is stated; typed totality is required for every policy guarantee.",
    "resource_constraints": "No physical-resource assurance or additional input bounds are requested.",
    "error_semantics": "No behavior outside the stated typed input domain is specified.",
    "explicit_non_goals": "N1 excludes runtime campaigns and machine-code, compiler, runtime and physical-resource assurance.",
    "ambiguities": "None; the functional branches, numeric semantics, ordering and formal boundary are specified."
  },
