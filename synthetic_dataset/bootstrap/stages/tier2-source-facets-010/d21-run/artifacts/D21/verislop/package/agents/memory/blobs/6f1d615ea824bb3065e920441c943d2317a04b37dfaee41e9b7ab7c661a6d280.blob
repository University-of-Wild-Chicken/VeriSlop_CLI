  "dependencies": [
   {
    "id": "D1",
    "relation": "uses_definition"
   }
  ],
  "acceptance_criteria": [
   "width>0 and start<=end.",
   "Every event has the stated group, time and nullable integer value types.",
   "No restriction is imposed on event ordering, duplicate occurrences, integer magnitude, group names, or whether events are in range."
  ],
  "blocked_by": []
 },
