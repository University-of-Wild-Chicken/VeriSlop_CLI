FROZEN INTERPRETED OBLIGATIONS (data):
[
 {
  "id": "D1",
  "kind": "entity",
  "role": "declaration",
  "statement": "Input is an object containing events with string group, integer time and integer-or-null value, integer start and end, positive integer width, and fill equal to none or previous, with start <= end.",
  "required": true,
  "dependencies": [],
  "acceptance_criteria": [
   "The specified input schema and domain are represented without narrowing valid inputs."
  ],
  "blocked_by": []
 },
 {
  "id": "O1",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "Provide a pure deterministic Python 3 solve(data) function in solution.py receiving JSON-compatible Python input and returning a JSON-serializable value.",
  "required": true,
  "dependencies": [],
  "acceptance_criteria": [
   "solution.py exposes solve(data).",
   "Repeated calls with equal valid inputs yield equal outputs.",
   "Execution has no externally observable side effects.",
   "Input and output use JSON-compatible Python values."
  ],
  "blocked_by": []
 },
 {
  "id": "O2",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "Enumerate all distinct group names appearing anywhere in events in lexicographic order, including groups whose events are all outside the requested interval.",
  "required": true,
  "dependencies": [
   {
    "id": "D1",
    "relation": "uses_definition"
   }
  ],
  "acceptance_criteria": [
   "Groups equal sorted unique event group names.",
   "Out-of-range-only groups remain represented whenever buckets exist.",
   "No events implies no groups and an empty output."
  ],
  "blocked_by": []
 },
 {
  "id": "O3",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "For every enumerated group emit bucket starts start+k*width for nonnegative integers k with bucket start strictly below end; each bucket covers [bucketStart,min(bucketStart+width,end)).",
  "required": true,
  "dependencies": [
   {
    "id": "D1",
    "relation": "uses_definition"
   },
   {
    "id": "O2",
    "relation": "uses_proof"
   }
  ],
  "acceptance_criteria": [
   "Every group has exactly the specified increasing bucket starts.",
   "The last bucket may be shorter than width.",
   "Events on a bucket's left boundary belong to it; events on its right boundary do not.",
   "When start equals end, output is empty."
  ],
  "blocked_by": []
 },
 {
  "id": "O4",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "For each group bucket, count and sum precisely all occurrences of events of that group whose time belongs to the bucket and whose value is non-null; duplicate occurrences each contribute independently.",
  "required": true,
  "dependencies": [
   {
    "id": "O3",
    "relation": "uses_proof"
   }
  ],
  "acceptance_criteria": [
   "count equals the number of qualifying non-null event occurrences.",
   "sum equals the exact integer sum of qualifying values.",
   "Null events contribute neither count nor sum.",
   "Out-of-range events contribute neither count nor sum.",
   "Duplicate qualifying events each increase count and contribute their value."
  ],
  "blocked_by": []
 },
 {
  "id": "O5",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "A bucket with positive count has value equal to its sum. An empty bucket has null value for fill none; for fill previous it has the most recent earlier nonempty bucket sum for that same group, or null if no such bucket exists.",
  "required": true,
  "dependencies": [
   {
    "id": "O4",
    "relation": "uses_proof"
   }
  ],
  "acceptance_criteria": [
   "Positive-count buckets return their sum in either fill mode.",
   "Zero-count buckets return null in fill none.",
   "Zero-count buckets in fill previous return the latest earlier nonempty sum within the same group.",
   "A bucket containing only null-valued events is empty for filling purposes.",
   "Before the first nonempty bucket, fill previous returns null."
  ],
  "blocked_by": []
 },
 {
  "id": "O6",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "Return a list of objects with group, start, count and value fields in lexicographic group order, then increasing bucket-start order, preserving the specified input/output structure.",
  "required": true,
  "dependencies": [
   {
    "id": "O2",
    "relation": "uses_proof"
   },
   {
    "id": "O3",
    "relation": "uses_proof"
   },
   {
    "id": "O5",
    "relation": "uses_proof"
   }
  ],
  "acceptance_criteria": [
   "Each output object contains the specified group, start, count and value fields.",
   "Rows are ordered first by group and then by increasing bucket start.",
   "There is exactly one row for every enumerated group bucket."
  ],
  "blocked_by": []
 },
 {
  "id": "O7",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "Reproduce both public examples exactly, including propagation of a zero sum and null filling for a group with only a pre-start event.",
  "required": true,
  "dependencies": [
   {
    "id": "O6",
    "relation": "uses_proof"
   },
   {
    "id": "I1",
    "relation": "uses_proof"
   }
  ],
  "acceptance_criteria": [
   "The first example returns group a rows at starts 0, 2 and 4 with counts 2, 0 and 0 and values 0, 0 and 0.",
   "The second example returns a single group z row at start 0 with count 0 and value null."
  ],
  "blocked_by": []
 },
 {
  "id": "I1",
  "kind": "invariant",
  "role": "guarantee",
  "statement": "For each group, previous begins absent and is updated only by nonempty emitted buckets to their sum, including zero sums; empty buckets preserve it and events before start never seed it.",
  "required": true,
  "dependencies": [
   {
    "id": "O4",
    "relation": "uses_proof"
   }
  ],
  "acceptance_criteria": [
   "Previous is isolated between groups.",
   "After processing a nonempty bucket, previous equals that bucket's sum even when zero.",
   "Processing any empty bucket leaves previous unchanged.",
   "Pre-start events never initialize or update previous."
  ],
  "blocked_by": []
 },
 {
  "id": "R1",
  "kind": "resource_constraint",
  "role": "guarantee",
  "statement": "Use only Python standard-library facilities and perform no external I/O.",
  "required": true,
  "dependencies": [],
  "acceptance_criteria": [
   "No third-party libraries are required.",
   "No external I/O occurs."
  ],
  "blocked_by": []
 }
]
