pretation := \"no additional preconditions\" }],\n  scope := [\"caller input\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }],\n  acceptanceCriteria := [\"width is a positive integer and start <= end.\", \"No restrictions are imposed on event ordering, duplicates, group names, event times, integer magnitudes or nullable values beyond the specified types.\"],\n  bindings := [\"VeriSlopAST.valid_input\"] }\n\ndef «O1» : Entry := {\n  id := \"O1\",\n  revision := 1,\n  kind := \"postcondition\",\n  role := \"guarantee\",\n  statement := \"Deliver canonical program.vscore.json containing exactly one admitted typed entry solve of arity 1, implementing the specified typed input/result representation under canonical vscore/0.3, normative Lean vscore-semantics/0.3 and data-pipeline/0.3. For every A1 input its admitted execution returns the specified result, is total and deterministic, preserves input values, performs no external I/O, uses exact unbounded integer arithmetic without floating point, operates on pure data and uses only the restricted runtime with no external-effect constructors.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 79, endByte := 154, origin := \"explicit\", interpretation := \"canonical file and entry\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 155, endByte := 239, origin := \"explicit\", interpretation := \"typed representation\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 240, endByte := 264, origin := \"explicit\", interpretation := \"no external I/O\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1080, endByte := 1227, origin := \"explicit\", interpretation := \"normative source and serialization\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1294, endByte := 1352, origin := \"explicit\", interpretation := \"execution properties\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1353, endByte := 1434, origin := \"explicit\", interpretation := \"immutability and effect restriction\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1435, endByte := 1506, origin := \"explicit\", interpretation := \"exact arithmetic\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1597, endByte := 1687, origin := \"explicit\", interpretation := \"complete valid-input domain\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5036, endByte := 5288, origin := \"explicit\", interpretation := \"mandatory source facets\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5289, endByte := 5458, origin := \"explicit\", interpretation := \"source identity cannot be replaced\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5957, endByte := 8118, origin := \"explicit\", interpretation := \"O1 source and value policy\" }],\n  scope := [\"delivered source\", \"every specified input\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }, { id := \"A1\", relation := \"assumes\" }],\n  acceptanceCriteria := [\"The actual canonical unary solve source implements the requested behavior for all valid inputs.\", \"The entry satisfies typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only.\", \"An existence theorem or unrelated entry does not substitute for source implementation refinement.\"],\n  bindings := [\"VeriSlopAST.complete_behavior\"] }\n\ndef «O2» : Entry := {\n  id := \"O2\",\n  revision := 1,\n  kind := \"postcondition\",\n  role := \"guarantee\",\n  statement := \"For every A1 input, the groups used for output are exactly the distinct group names appearing anywhere in events, sorted lexicographically by Unicode scalar codepoints, including names whose events all lie outside [start,end). This behavior is universally implemented by canonical program.vscore.json's unary solve under the normative source and serialization semantics; that entry is typed-total, deterministic, input-preserving, free of external I/O and floating point, pure-data and restricted-runtime-only.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 394, endByte := 501, origin := \"explicit\", interpretation := \"complete distinct group set\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1507, endByte := 1596, origin := \"explicit\", interpretation := \"codepoint ordering\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5036, endByte := 5288, origin := \"explicit\", interpretation := \"canonical source facets\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5459, endByte := 5654, origin := \"explicit\", interpretation := \"universal implementation refinement\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5957, endByte := 8118, origin := \"explicit\", interpretation := \"O2 policy row\" }],\n  scope := [\"all specified inputs\", \"group selection and ordering\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }, { id := \"A1\", relation := \"assumes\" }],\n  acceptanceCriteria := [\"Group sequence = scalar-codepoint lexicographic sort of the set of all event group names.\", \"No name is omitted because it has no in-range event; no extra group is introduced.\", \"All seven required source properties hold for the actual unary solve entry.\"],\n  bindings := [\"VeriSlopAST.complete_behavior\"] }\n\ndef «O3» : Entry := {\n  id := \"O3\",\n  revision := 1,\n  kind := \"postcondition\",\n  role := \"guarantee\",\n  statement := \"For every selected group and each natural k with b_k = start + k*width < end, emit exactly one bucket covering [b_k,min(b_k+width,end)). Emit no other buckets. When start=end there are no buckets. This formula is universally implemented by canonical program.vscore.json's unary solve under vscore/0.3, Lean vscore-semantics/0.3 and data-pipeline/0.3, with typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 502, endByte := 561, origin := \"explicit\", interpretation := \"bucket progression\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 562, endByte := 637, origin := \"explicit\", interpretation := \"strict terminal guard and clipped intervals\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5036, endByte := 5288, origin := \"explicit\", interpretation := \"source delivery properties\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5459, endByte := 5654, origin := \"explicit\", interpretation := \"universal formula refinement\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5957, endByte := 8118, origin := \"explicit\", interpretation := \"O3 policy row\" }],\n  scope := [\"all specified inputs\", \"bucket construction\"],\n  dependencies := [{ id := \"A1\", relation := \"assumes\" }, { id := \"D1\", relation := \"uses_definition\" }],\n  acceptanceCriteria := [\"Bucket starts are exactly start+k*width for natural k satisfying start+k*width<end.\", \"Intervals are left-inclusive, right-exclusive and clipped at end.\", \"Universal source refinement and all seven source properties hold for the actual unary solve.\"],\n  bindings := [\"VeriSlopAST.complete_behavior\"] }\n\ndef «O4» : Entry := {\n  id := \"O4\",\n  revision := 1,\n  kind := \"postcondition\",\n  role := \"guarantee\",\n  statement := \"For each emitted group g and bucket start b, let M be the multiset of event occurrences with group=g, b<=time<min(b+width,end), and value not null. The bucket count is |M| and its sum is the exact mathematical sum of their values. Null values and out-of-range events contribute neither count nor sum; duplicate occurrences each contribute separately. Canonical program.vscore.json's unary solve universally implements this formula under the specified normative semantics with all seven required source properties: typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 638, endByte := 672, origin := \"explicit\", interpretation := \"non-null in-range sum\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 673, endByte := 699, origin := \"explicit\", interpretation := \"count domain\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1020, endByte := 1078, origin := \"explicit\", interpretation := \"duplicate multiplicity\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1435, endByte := 1506, origin := \"explicit\", interpretation := \"exact mathematical arithmetic\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5036, endByte := 5288, origin := \"explicit\", interpretation := \"source properties\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5459, endByte := 5654, origin := \"explicit\", interpretation := \"universal source refinement\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5957, endByte := 8118, origin := \"explicit\", interpretation := \"O4 policy row\" }],\n  scope := [\"all specified inputs\", \"bucket aggregation\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }, { id := \"A1\", relation := \"assumes\" }],\n  acceptanceCriteria := [\"count equals the number of matching non-null event occurrences.\", \"sum equals their exact unbounded integer sum, including negative values and cancellation.\", \"Duplicates are counted with multiplicity.\", \"The actual canonical unary solve refines this formula universally and satisfies every required source property.\"],\n  bindings := [\"VeriSlopAST.complete_behavior\"] }\n\ndef «O5» : Entry := {\n  id := \"O5\",\n  revision := 1,\n  kind := \"postcondition\",\n  role := \"guarantee\",\n  statement := \"For every group, scan its emitted buckets in increasing start order with previous initially null. If count>0, value equals that bucket's sum and previous becomes that sum, including zero. If count=0, value is null when fill='none'; when fill='previous', value is the sum of the latest earlier bucket of the same group with count>0, or null if none exists. Empty buckets leave previous unchanged. Events before start never initialize previous. Canonical program.vscore.json's unary solve universally implements these branches under the specified normative semantics and has typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 700, endByte := 759, origin := \"explicit\", interpretation := \"nonempty update\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 760, endByte := 879, origin := \"explicit\", interpretation := \"empty fill branches\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 880, endByte := 915, origin := \"explicit\", interpretation := \"empty retention\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 916, endByte := 956, origin := \"explicit\", interpretation := \"causal initialization\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1020, endByte := 1078, origin := \"explicit\", interpretation := \"zero is a real previous sum\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5036, endByte := 5288, origin := \"explicit\", interpretation := \"source facets\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5459, endByte := 5654, origin := \"explicit\", interpretation := \"universal branch refinement\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5957, endByte := 8118, origin := \"explicit\", interpretation := \"O5 policy row\" }],\n  scope := [\"all specified inputs\", \"causal filling\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }, { id := \"A1\", relation := \"assumes\" }],\n  acceptanceCriteria := [\"Nonempty means count>0, regardless of whether sum is zero.\", \"Empty fill-none buckets return null.\", \"Empty fill-previous buckets use only the latest earlier nonempty bucket in the same group.\", \"Before the first nonempty bucket value is null; empty buckets never reset previous and pre-start events never seed it.\", \"The actual source universally refines every branch and satisfies all seven source properties.\"],\n  bindings := [\"VeriSlopAST.complete_behavior\"] }\n\ndef «O6» : Entry := {\n  id := \"O6\",\n  revision := 1,\n  kind := \"postcondition\",\n  role := \"guarantee\",\n  statement := \"For every valid input, return exactly the list of {group,start,count,value} records prescribed by O2-O5, ordered first by scalar-codepoint lexicographic group order and then by increasing bucket start, with the exact requested JSON structure. Empty events or start=end yield an empty list. This result is universally implemented by canonical program.vscore.json's unary solve under vscore/0.3, Lean vscore-semantics/0.3 and data-pipeline/0.3, satisfying typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 957, endByte := 1019, origin := \"explicit\", interpretation := \"result structure and ordering\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1228, endByte := 1293, origin := \"explicit\", interpretation := \"exact structure preservation\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1080, endByte := 1227, origin := \"explicit\", interpretation := \"serialization semantics\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5036, endByte := 5288, origin := \"explicit\", interpretation := \"source facets\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5459, endByte := 5654, origin := \"explicit\", interpretation := \"universal result refinement\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5957, endByte := 8118, origin := \"explicit\", interpretation := \"O6 policy row\" }],\n  scope := [\"all specified inputs\", \"serialized output\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }, { id := \"A1\", relation := \"assumes\" }, { id := \"O2\", relation := \"uses_proof\" }, { id := \"O3\", relation := \"uses_proof\" }, { id := \"O4\", relation := \"uses_proof\" }, { id := \"O5\", relation := \"uses_proof\" }],\n  acceptanceCriteria := [\"Output is exactly the group-major, bucket-minor concatenation of the specified records.\", \"No extra or missing records or altered fields occur.\", \"Empty group or bucket domains yield [].\", \"The actual unary source and serialization universally implement this result with all seven source properties.\"],\n  bindings := [\"VeriSlopAST.complete_behavior\"] }\n\ndef «O7» : Entry := {\n  id := \"O7\",\n  revision := 1,\n  kind := \"postcondition\",\n  role := \"guarantee\",\n  statement := \"The actual canonical program.vscore.json unary solve preserves both public examples exactly: for group a with values 2 at time 0 and -2 at time 1, start=0,end=5,width=2,fill='previous', return records (a,0,2,0),(a,2,0,0),(a,4,0,0); for group z with value 9 at time -1, start=0,end=1,width=2,fill='previous', return (z,0,0,null). These examples accompany universal implementation refinement of the complete O2-O6 formulas for every valid input, rather than replacing it. The entry satisfies typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only under the specified normative source and serialization semantics.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1689, endByte := 1734, origin := \"explicit\", interpretation := \"preserved public examples\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1735, endByte := 2282, origin := \"explicit\", interpretation := \"exact example results and universal refinement\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5036, endByte := 5288, origin := \"explicit\", interpretation := \"source facets\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5459, endByte := 5654, origin := \"explicit\", interpretation := \"complete universal value formulas\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5957, endByte := 8118, origin := \"explicit\", interpretation := \"O7 policy row\" }],\n  scope := [\"public examples\", \"all specified inputs\"],\n  dependencies := [{ id := \"A1\", relation := \"assumes\" }, { id := \"O6\", relation := \"uses_proof\" }],\n  acceptanceCriteria := [\"Both example JSON outputs match exactly.\", \"Universal functional refinement remains required beyond the examples.\", \"Canonical unary solve satisfies all seven source properties.\"],\n  bindings := [\"VeriSlopAST.complete_behavior\"] }\n\ndef «I1» : Entry := {\n  id := \"I1\",\n  revision := 1,\n  kind := \"invariant\",\n  role := \"guarantee\",\n  statement := \"The canonical program.vscore.json entry solve of arity 1 maintains immutable input values throughout admitted typed execution and satisfies typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only under canonical vscore/0.3, normative Lean vscore-semantics/0.3 and data-pipeline/0.3. I1 is explicitly source-only; the functional previous-value invariants are retained as universally implemented requirements in O5.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1294, endByte := 1352, origin := \"explicit\", interpretation := \"total deterministic pure execution\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1353, endByte := 1434, origin := \"explicit\", interpretation := \"input immutability\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1435, endByte := 1506, origin := \"explicit\", interpretation := \"no floating point\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5036, endByte := 5288, origin := \"explicit\", interpretation := \"mandatory canonical source\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5716, endByte := 5869, origin := \"explicit\", interpretation := \"operational source-only classification\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5957, endByte := 8118, origin := \"explicit\", interpretation := \"I1 source policy\" }],\n  scope := [\"all admitted typed executions\", \"source-only operational invariant\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }],\n  acceptanceCriteria := [\"The actual unary solve source satisfies every listed closed source property.\", \"Input values remain unchanged throughout execution.\", \"The source-only classification does not remove causal filling, zero-sum or empty-bucket requirements from O5.\"],\n  bindings := [\"VeriSlopAST.source_behavior\"] }\n\ndef «S1» : Entry := {\n  id := \"S1\",\n  revision := 1,\n  kind := \"safety_property\",\n  role := \"guarantee\",\n  statement := \"Canonical program.vscore.json's sole typed entry solve of arity 1 executes exclusively within the admitted restricted vscore/0.3 runtime under Lean vscore-semantics/0.3 and data-pipeline/0.3, with no external I/O or external-effect constructors, immutable input, pure data and exact unbounded integer arithmetic without floating point. It satisfies all seven closed properties typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only. S1 is source-only.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 79, endByte := 154, origin := \"explicit\", interpretation := \"typed pure entry\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 240, endByte := 264, origin := \"explicit\", interpretation := \"I/O prohibition\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1080, endByte := 1227, origin := \"explicit\", interpretation := \"restricted normative runtime\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1294, endByte := 1352, origin := \"explicit\", interpretation := \"total pure deterministic execution\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1353, endByte := 1434, origin := \"explicit\", interpretation := \"effect and mutation restriction\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1435, endByte := 1506, origin := \"explicit\", interpretation := \"exact integer semantics\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5036, endByte := 5288, origin := \"explicit\", interpretation := \"closed source properties\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5289, endByte := 5458, origin := \"explicit\", interpretation := \"source identity remains necessary\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5716, endByte := 5869, origin := \"explicit\", interpretation := \"source-only operational classification\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5957, endByte := 8118, origin := \"explicit\", interpretation := \"S1 policy row\" }],\n  scope := [\"all admitted typed executions\", \"source-only operational safety\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }],\n  acceptanceCriteria := [\"No external effects, input mutation or floating-point operations occur.\", \"The actual canonical unary solve source satisfies every required source property.\", \"Source requirements are not replaced by a mathematical equality or existence statement.\"],\n  bindings := [\"VeriSlopAST.source_behavior\"] }\n\ndef «valid_domain_witness» : Entry := {\n  id := \"valid_domain_witness\",\n  revision := 1,\n  kind := \"non_vacuity\",\n  role := \"guarantee\",\n  statement := \"Non-vacuity: An input with events=[], start=0, end=0, width=1 and fill='none' satisfies valid_input. (witnesses A1)\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 265, endByte := 393, origin := \"inferred\", interpretation := \"derived by registered rule verislop.non-vacuity/0.1 from assumption A1\" }, { documentRef := \"tier2:tier2-source-facets-013:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1597, endByte := 1687, origin := \"inferred\", interpretation := \"derived by registered rule verislop.non-vacuity/0.1 from assumption A1\" }],\n  scope := [\"caller input\"],\n  dependencies := [{ id := \"A1\", relation := \"uses_definition\" }],\n  acceptanceCriteria := [\"Prove the existential theorem with concrete witnesses extractable by bounded kernel head-normalisation.\"],\n  bindings := [\"VeriSlopAST.valid_input_inhabited\"] }\n\ndef entries : List Entry := [«D1», «A1», «O1», «O2», «O3», «O4», «O5», «O6», «O7», «I1», «S1», «valid_domain_witness»]\n\nend VeriSlop.Registry\n-- END VERISLOP REGISTRY\n\n/-!\nNormative restricted-source boundary requirement model, v0.1. These rules prove\nchecking soundness and inhabitation of an abstract fact model. They do not assert\nfacts about a delivered program, its evaluator, or a host runtime. The source\nbridge must derive every fact from the exact admitted source and semantic laws.\nThis algebra is independent of the Python NativeBoundary model.\n-/\nnamespace VeriSlop.Source\n\ninductive SourceRequirement where\n  | entry (file id : String) (arity : Nat)\n  | typedTotal\n  | deterministic\n  | inputPreserved\n  | noExternalIO\n  | noFloatingPoint\n  | pureData\n  | restrictedRuntimeOnly\n  deriving DecidableEq\n\nstructure Entry where\n  file : String\n  id : String\n  arity : Nat\n  deriving DecidableEq\n\nstructure ModuleFacts where\n  entries : List Entry\n  uniqueEntries : Bool\n  typedTotal : Bool\n  deterministic : Bool\n  inputPreserved : Bool\n  noExternalIO : Bool\n  noFloatingPoint : Bool\n  pureData : Bool\n  restrictedRuntimeOnly : Bool\n\ndef checkRequirement (r : SourceRequirement) (m : ModuleFacts) : Bool :=\n  match r with\n  | .entry f n a => m.uniqueEntries && decide (Entry.mk f n a ∈ m.entries)\n  | .typedTotal => m.typedTotal\n  | .deterministic => m.deterministic\n  | .inputPreserved => m.inputPreserved\n  | .noExternalIO => m.noExternalIO\n  | .noFloatingPoint => m.noFloatingPoint\n  | .pureData => m.pureData\n  | .restrictedRuntimeOnly => m.restrictedRuntimeOnly\n\ndef HoldsRequirement (r : SourceRequirement) (m : ModuleFacts) : Prop :=\n  match r with\n  | .entry f n a => m.uniqueEntries = true ∧ Entry.mk f n a ∈ m.entries\n  | .typedTotal => m.typedTotal = true\n  | .deterministic => m.deterministic = true\n  | .inputPreserved => m.inputPreserved = true\n  | .noExternalIO => m.noExternalIO = true\n  | .noFloatingPoint => m.noFloatingPoint = true\n  | .pureData => m.pureData = true\n  | .restrictedRuntimeOnly => m.restrictedRuntimeOnly = true\n\ndef checkBoundary (rs : List SourceRequirement) (m : ModuleFacts) : Bool :=\n  rs.all (fun r => checkRequirement r m)\n\ndef HoldsBoundary (rs : List SourceRequirement) (m : ModuleFacts) : Prop :=\n  ∀ r ∈ rs, HoldsRequirement r m\n\ndef Transfer (rs : List SourceRequirement) : Prop :=\n  ∀ m, checkBoundary rs m = true → HoldsBoundary rs m\n\ndef AdmissionInhabited (rs : List SourceRequirement) : Prop :=\n  ∃ m, checkBoundary rs m = true\n\n/-- Closed accepted data identifies the endpoint; Contract supplies only abstract\nchecking rules and does not establish implementation refinement. -/\nstructure SourceDefinition (τ : Type) where\n  endpoint : τ\n  requirements : List SourceRequirement\n\ndef Contract {τ : Type} (d : SourceDefinition τ) : Prop :=\n  Transfer d.requirements ∧ AdmissionInhabited d.requirements\n\ntheorem checkRequirement_sound (r : SourceRequirement) (m : ModuleFacts) :\n    checkRequirement r m = true → HoldsRequirement r m := by\n  cases r <;> simp [checkRequirement, HoldsRequirement, Bool.and_eq_true]\n\ntheorem transfer_sound (rs : List SourceRequirement) : Transfer rs := by\n  intro m h r hr\n  exact checkRequirement_sound r m ((List.all_eq_true.mp h) r hr)\n\ndef witnessEntries : List SourceRequirement → List Entry\n  | [] => []\n  | .entry f n a :: rs => Entry.mk f n a :: witnessEntries rs\n  | _ :: rs => witnessEntries rs\n\ndef modelWitness (rs : List SourceRequirement) : ModuleFacts :=\n  ⟨witnessEntries rs, true, true, true, true, true, true, true, true⟩\n\ntheorem entry_in_witness (f n : String) (a : Nat) (rs : List SourceRequirement)\n    (h : SourceRequirement.entry f n a ∈ rs) : Entry.mk f n a ∈ witnessEntries rs := by\n  induction rs with\n  | nil => simp at h\n  | cons r rs ih => cases r <;> simp_all [witnessEntries] <;> grind\n\ntheorem admission_inhabited (rs : List SourceRequirement) : AdmissionInhabited rs := by\n  refine ⟨modelWitness rs, List.all_eq_true.mpr ?_⟩\n  intro r hr\n  cases r with\n  | entry f n a =>\n    simp [checkRequirement, modelWitness, entry_in_witness f n a rs hr]\n  | typedTotal => rfl\n  | deterministic => rfl\n  | inputPreserved => rfl\n  | noExternalIO => rfl\n  | noFloatingPoint => rfl\n  | pureData => rfl\n  | restrictedRuntimeOnly => rfl\n\ntheorem contract_sound {τ : Type} (d : SourceDefinition τ) : Contract d :=\n  ⟨transfer_sound d.requirements, admission_inhabited d.requirements⟩\n\nend VeriSlop.Source\n\nnamespace VeriSlopAST\nstructure «Bucket» where\n  «group» : _root_.String\n  «start» : _root_.Int\n  «count» : _root_.Nat\n  «value» : (_root_.Option _root_.Int)\nstructure «Event» where\n  «group» : _root_.String\n  «time» : _root_.Int\n  «value» : (_root_.Option _root_.Int)\nstructure «Input» where\n  «events» : (_root_.List _root_.VeriSlopAST.«Event»)\n  «start» : _root_.Int\n  «end» : _root_.Int\n  «width» : _root_.Int\n  «fill» : _root_.String\nstructure «Scan» where\n  «previous» : (_root_.Option _root_.Int)\n  «rows» : (_root_.List _root_.VeriSlopAST.«Bucket»)\ndef «aggregate» («_v0» : _root_.VeriSlopAST.«Input») («_v1» : _root_.String) («_v2» : _root_.Nat) : _root_.VeriSlopAST.«Bucket» := (@_root_.List.foldl _root_.VeriSlopAST.«Bucket» _root_.VeriSlopAST.«Event» (fun («_v3» : _root_.VeriSlopAST.«Bucket») («_v4» : _root_.VeriSlopAST.«Event») => (@_root_.cond _root_.VeriSlopAST.«Bucket» (_root_.Bool.and (_root_.Decidable.decide ((_root_.VeriSlopAST.«Event».«group» «_v4») = «_v1»)) (_root_.Bool.and (@_root_.Option.isSome _root_.Int (_root_.VeriSlopAST.«Event».«value» «_v4»)) (_root_.Decidable.decide (((_root_.VeriSlopAST.«Bucket».«start» «_v3») ≤ (_root_.VeriSlopAST.«Event».«time» «_v4»)) ∧ (((_root_.VeriSlopAST.«Event».«time» «_v4») < (_root_.Int.add (_root_.VeriSlopAST.«Bucket».«start» «_v3») (_root_.VeriSlopAST.«Input».«width» «_v0»))) ∧ ((_root_.VeriSlopAST.«Event».«time» «_v4») < (_root_.VeriSlopAST.«Input».«end» «_v0»))))))) (_root_.VeriSlopAST.«Bucket».«mk» (_root_.VeriSlopAST.«Bucket».«group» «_v3») (_root_.VeriSlopAST.«Bucket».«start» «_v3») (_root_.Nat.add (_root_.VeriSlopAST.«Bucket».«count» «_v3») (1 : _root_.Nat)) (@_root_.Option.some _root_.Int (_root_.Int.add (@_root_.Option.getD _root_.Int (_r