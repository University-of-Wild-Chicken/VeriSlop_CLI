{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:verislop:schema:implementation-bindings:0.1",
  "title": "Untrusted binding proposal: implementation objects for profile symbols and obligations",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "0.1" },
    "artifact_kind": { "const": "implementation_bindings" },
    "target": { "const": "python" },
    "serialization_profile": { "enum": ["python-v0_1", "python-v0_2"] },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "binding_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$" },
          "symbol": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$" },
          "object": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "file": { "type": "string", "pattern": "^[A-Za-z0-9_/.-]+\\.py$" },
              "qualname": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
            },
            "required": ["file", "qualname"]
          },
          "obligations": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        },
        "required": ["binding_id", "symbol", "object", "obligations"]
      }
    },
    "helpers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "qualname": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "required": ["file", "qualname", "reason"]
      }
    }
  },
  "required": ["schema_version", "artifact_kind", "target", "serialization_profile", "bindings", "helpers"]
}
