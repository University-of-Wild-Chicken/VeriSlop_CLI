ref": "tier2:tier2-source-facets-006:A23", "end_byte": 3628, "interpretation": "Required O1 guarantee and requested assurance endpoint.", "origin": "explicit", "start_byte": 2085}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 4264, "interpretation": "Exact source delivery.", "origin": "explicit", "start_byte": 4060}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 4326, "interpretation": "Source facets in the formal contract.", "origin": "explicit", "start_byte": 4265}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 4496, "interpretation": "Equality cannot replace source properties.", "origin": "explicit", "start_byte": 4327}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 4713, "interpretation": "Mixed source/value refinement.", "origin": "explicit", "start_byte": 4497}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 4774, "interpretation": "Required value facets.", "origin": "explicit", "start_byte": 4714}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 6207, "interpretation": "Exact O1 source-facet policy.", "origin": "explicit", "start_byte": 5156}], "scope": ["all inputs satisfying A1", "actual canonical solve source"], "dependencies": [{"id": "D1", "relation": "uses_definition"}, {"id": "A1", "relation": "assumes"}], "acceptance_criteria": ["For every valid input, execution returns sum_{i=0}^{n-1} floor((a*i+b)/m).", "Each summand is the unique integer q satisfying m*q <= a*i+b < m*(q+1).", "Every valid input with n=0 returns 0.", "The public examples return -4 for {a:-2,b:1,m:3,n:4} and 0 for {a:100,b:-99,m:7,n:0}; these examples do not replace universal refinement.", "The formal contract binds program.vscore.json, solve, arity 1 and all seven properties typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data, restricted_runtime_only.", "A mathematical existence theorem, reflexive equality or unrelated entry cannot replace the complete mixed source/value guarantee."], "origin": "interpreted", "record_digest": "sha256:89501808abaeb9744bff421ca2a80ef5eaab83edb606ff730f12cdf8a7f1256e", "blocked_by": []}, {"id": "O2", "revision": 1, "kind": "postcondition", "role": "guarantee", "statement": "For every input satisfying A1, canonical program.vscore.json contains exactly one admitted typed entry solve of arity 1 accepting the typed representation of JSON {n,m,a,b} and returning the data-pipeline/0.3 representation of the exact JSON integer sum_{i=0}^{n-1} floor((a*i+b)/m), with floor toward negative infinity and empty sum 0. Preserve specified input/output structure and exact ordering. Under normative Lean vscore-semantics/0.3, execution is total, pure, deterministic, preserves immutable inputs, has no external effects and uses unbounded mathematical integers without floating point. The mixed source/value contract requires universal implementation refinement and all seven exact properties typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only.", "required": true, "source_refs": [{"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 137, "interpretation": "Typed entry delivery.", "origin": "explicit", "start_byte": 67}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 222, "interpretation": "JSON structure representation.", "origin": "explicit", "start_byte": 138}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 518, "interpretation": "Complete functional result.", "origin": "explicit", "start_byte": 468}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 572, "interpretation": "Signed floor semantics.", "origin": "explicit", "start_byte": 519}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 591, "interpretation": "Empty-sum output.", "origin": "explicit", "start_byte": 573}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 762, "interpretation": "Source and serialization profiles.", "origin": "explicit", "start_byte": 615}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 828, "interpretation": "Structure and ordering preservation.", "origin": "explicit", "start_byte": 763}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 887, "interpretation": "Total pure deterministic execution.", "origin": "explicit", "start_byte": 829}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 969, "interpretation": "Input immutability and effect restrictions.", "origin": "explicit", "start_byte": 888}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 1041, "interpretation": "Unbounded integer arithmetic.", "origin": "explicit", "start_byte": 970}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 1733, "interpretation": "Preserve O2 identity.", "origin": "explicit", "start_byte": 1654}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 1825, "interpretation": "Revised typed pure source properties.", "origin": "explicit", "start_byte": 1734}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 1873, "interpretation": "Unchanged delivery assurance.", "origin": "explicit", "start_byte": 1826}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 1985, "interpretation": "Universal implementation refinement.", "origin": "explicit", "start_byte": 1874}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 3628, "interpretation": "Required O2 and requested endpoint.", "origin": "explicit", "start_byte": 2085}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 4264, "interpretation": "Exact source delivery.", "origin": "explicit", "start_byte": 4060}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 4326, "interpretation": "Formal source contract.", "origin": "explicit", "start_byte": 4265}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 4496, "interpretation": "Source properties cannot be replaced by equality.", "origin": "explicit", "start_byte": 4327}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 4713, "interpretation": "Mixed source/value guarantee.", "origin": "explicit", "start_byte": 4497}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 4774, "interpretation": "Required value facets.", "origin": "explicit", "start_byte": 4714}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 6207, "interpretation": "Exact O2 source policy.", "origin": "explicit", "start_byte": 5156}], "scope": ["typed serialization", "all inputs satisfying A1", "canonical source delivery"], "dependencies": [{"id": "D1", "relation": "uses_definition"}, {"id": "A1", "relation": "assumes"}], "acceptance_criteria": ["Canonical vscore/0.3 file program.vscore.json contains exactly one admitted typed entry solve of arity 1.", "For every valid input, typed execution and data-pipeline/0.3 serialization return the exact JSON integer floor sum.", "For each summand q, m*q <= a*i+b < m*(q+1); when n=0 the output is 0.", "Specified input/output structure and exact ordering are preserved without changing input values.", "The formal contract binds the actual file, entry, arity and all seven required closed source properties.", "Universal refinement covers the complete functional value and source requirements; existence or equality alone cannot replace them."], "origin": "interpreted", "record_digest": "sha256:0082de4b58911fca3dd4440aff1c5ca12b7b68ab9503d4c6abdeb9a1e9aef04d", "blocked_by": []}, {"id": "S1", "revision": 1, "kind": "safety_property", "role": "guarantee", "statement": "Canonical program.vscore.json contains exactly one admitted typed entry solve of arity 1 whose normative restricted-source execution is total, deterministic, input-preserving, free of external I/O and floating point, and pure data. It does not read benchmark files, leaves input values immutable and uses no external-effect constructors. Its source-only formal contract retains typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only under normative Lean vscore-semantics/0.3 and data-pipeline/0.3.", "required": true, "source_refs": [{"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 279, "interpretation": "No external I/O or benchmark reads.", "origin": "explicit", "start_byte": 223}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 762, "interpretation": "Canonical restricted source.", "origin": "explicit", "start_byte": 615}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 887, "interpretation": "Total pure deterministic execution.", "origin": "explicit", "start_byte": 829}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 969, "interpretation": "Input preservation and effect restrictions.", "origin": "explicit", "start_byte": 888}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 1733, "interpretation": "Preserve S1 identity.", "origin": "explicit", "start_byte": 1654}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 1825, "interpretation": "Revised source properties.", "origin": "explicit", "start_byte": 1734}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 1873, "interpretation": "Preserved delivery assurance.", "origin": "explicit", "start_byte": 1826}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 3628, "interpretation": "Required S1 guarantee.", "origin": "explicit", "start_byte": 2085}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 4264, "interpretation": "Exact source delivery.", "origin": "explicit", "start_byte": 4060}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 4326, "interpretation": "Formal source contract.", "origin": "explicit", "start_byte": 4265}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 4496, "interpretation": "Source requirements cannot be replaced by equality.", "origin": "explicit", "start_byte": 4327}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 4928, "interpretation": "S1 is source-only.", "origin": "explicit", "start_byte": 4775}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 6207, "interpretation": "Exact S1 policy.", "origin": "explicit", "start_byte": 5156}], "scope": ["canonical solve source", "all admitted typed execution"], "dependencies": [{"id": "D1", "relation": "uses_definition"}], "acceptance_criteria": ["The source contract binds program.vscore.json, solve, arity 1 and all seven exact required properties.", "No external I/O or benchmark reads occur, inputs remain immutable and no external-effect constructors are used.", "S1 remains a required source-only operational guarantee; replacement value equalities do not discharge its source requirements."], "origin": "interpreted", "record_digest": "sha256:a5d59d5932dd18b8a1e8791f0cbec1dc8cb706c596b041dc564b48d06f332819", "blocked_by": []}, {"id": "S2", "revision": 1, "kind": "safety_property", "role": "guarantee", "statement": "Canonical program.vscore.json, with exactly one admitted typed entry solve of arity 1, uses exact unbounded mathematical integer arithmetic without floating point throughout signed floor-sum execution, including intermediate values. Its source-only formal contract requires typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only under normative Lean vscore-semantics/0.3 and data-pipeline/0.3.", "required": true, "source_refs": [{"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 518, "interpretation": "Exact sum arithmetic.", "origin": "explicit", "start_byte": 468}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 613, "interpretation": "Avoid floating point.", "origin": "explicit", "start_byte": 592}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 1041, "interpretation": "Unbounded mathematical integers.", "origin": "explicit", "start_byte": 970}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 1733, "interpretation": "Preserve S2 identity.", "origin": "explicit", "start_byte": 1654}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 3628, "interpretation": "Required S2 guarantee.", "origin": "explicit", "start_byte": 2085}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 4264, "interpretation": "Exact canonical source delivery.", "origin": "explicit", "start_byte": 4060}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 4326, "interpretation": "Formal source contract.", "origin": "explicit", "start_byte": 4265}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 4496, "interpretation": "Retain exact non-floating-point source semantics.", "origin": "explicit", "start_byte": 4327}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 4928, "interpretation": "S2 is source-only.", "origin": "explicit", "start_byte": 4775}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 6207, "interpretation": "Exact S2 policy.", "origin": "explicit", "start_byte": 5156}], "scope": ["all arithmetic in canonical solve", "normative restricted-source execution"], "dependencies": [{"id": "D1", "relation": "uses_definition"}], "acceptance_criteria": ["No floating-point representation or operation is used.", "All arithmetic, including intermediate values, uses unbounded mathematical integers.", "The source contract binds program.vscore.json, solve, arity 1 and all seven exact required properties.", "S2 remains a required source-only operational guarantee and is not replaced by a value equality."], "origin": "interpreted", "record_digest": "sha256:dd5ad8a37922182ee32c483b41e9eaf4970f904243f90e65ad6b0df730010c3e", "blocked_by": []}, {"id": "N1", "revision": 1, "kind": "explicit_non_goal", "role": "exclusion", "statement": "No behavior is required for malformed input.", "required": true, "source_refs": [{"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 382, "interpretation": "Malformed-input exclusion.", "origin": "explicit", "start_byte": 338}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 1733, "interpretation": "Preserve N1 identity and exclusion role.", "origin": "explicit", "start_byte": 1654}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 3628, "interpretation": "Required exclusion N1.", "origin": "explicit", "start_byte": 2085}], "scope": ["inputs violating the specified schema or bounds"], "dependencies": [], "acceptance_criteria": ["Malformed-input behavior is outside the required functional contract."], "origin": "interpreted", "record_digest": "sha256:4a6c1f65480f7401290d06f84ed56a807a3f89237886a4e89c9d927a1183c935", "blocked_by": []}, {"id": "N2", "revision": 1, "kind": "explicit_non_goal", "role": "exclusion", "statement": "Runtime campaigns and machine-code, compiler, runtime or physical-resource assurance are outside scope. The assurance boundary is normative restricted-source execution only, explicitly trusting natural-language correspondence, host tooling, the pinned Lean kernel, hashing and OS/hardware.", "required": true, "source_refs": [{"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 3665, "interpretation": "Runtime campaigns excluded.", "origin": "explicit", "start_byte": 3629}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 3849, "interpretation": "Normative source boundary and explicit trust.", "origin": "explicit", "start_byte": 3666}, {"document_hash": "sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b", "document_ref": "tier2:tier2-source-facets-006:A23", "end_byte": 3927, "interpretation": "Downstream assurance excluded.", "origin": "explicit", "start_byte": 3850}], "scope": ["assurance boundary"], "dependencies": [], "acceptance_criteria": ["No runtime campaign is required.", "No machine-code, compiler, runtime or physical-resource assurance is claimed.", "The named trusted components remain outside the restricted-source proof boundary."], "origin": "interpreted", "record_digest": "sha256:53773673b233012732cc06f585d738e9fff29ce94c567265849cd9772d4dd80b", "blocked_by": []}], "lean_source": "import Std\n\n-- BEGIN VERISLOP REGISTRY\n-- Generated by `verislop formalize`. Typed obligation metadata: an index, never evidence.\nnamespace VeriSlop.Registry\n\nstructure SourceRef where\n  documentRef : String\n  documentHash : String\n  startByte : Nat\n  endByte : Nat\n  origin : String\n  interpretation : String\n\nstructure Dependency where\n  id : String\n  relation : String\n\nstructure Entry where\n  id : String\n  revision : Nat\n  kind : String\n  role : String\n  statement : String\n  required : Bool\n  sourceRefs : List SourceRef\n  scope : List String\n  dependencies : List Dependency\n  acceptanceCriteria : List String\n  bindings : List String\n\ndef «D1» : Entry := {\n  id := \"D1\",\n  revision := 1,\n  kind := \"entity\",\n  role := \"declaration\",\n  statement := \"The deliverable is canonical program.vscore.json in vscore/0.3 under normative Lean vscore-semantics/0.3 and data-pipeline/0.3, containing exactly one admitted typed entry solve of arity 1. Its typed input represents JSON {n,m,a,b} with integer fields and its result represents a JSON integer. Integers are unbounded mathematical integers. Strings contain Unicode scalar values and lexicographic comparison uses scalar codepoints.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 67, endByte := 137, origin := \"explicit\", interpretation := \"File and entry identity.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 138, endByte := 222, origin := \"explicit\", interpretation := \"Typed JSON representation.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 383, endByte := 467, origin := \"explicit\", interpretation := \"Integer input fields.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 615, endByte := 762, origin := \"explicit\", interpretation := \"Normative source and serialization profiles.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 970, endByte := 1041, origin := \"explicit\", interpretation := \"Unbounded integer semantics.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1042, endByte := 1131, origin := \"explicit\", interpretation := \"Unicode scalar string semantics.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1654, endByte := 1733, origin := \"explicit\", interpretation := \"Preserve D1 identity.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 2085, endByte := 3628, origin := \"explicit\", interpretation := \"Required declaration D1.\" }],\n  scope := [\"deliverable\", \"typed input and result\", \"normative source semantics\"],\n  dependencies := [],\n  acceptanceCriteria := [\"The canonical file has exactly one admitted typed entry named solve with arity 1.\", \"Input and result types represent the specified JSON object and integer result under data-pipeline/0.3.\", \"Source semantics follow normative Lean vscore-semantics/0.3, including unbounded integers and Unicode scalar string semantics.\"],\n  bindings := [\"VeriSlopAST.Input\", \"VeriSlopAST.solve\"] }\n\ndef «A1» : Entry := {\n  id := \"A1\",\n  revision := 1,\n  kind := \"precondition\",\n  role := \"assumption\",\n  statement := \"Supplied inputs satisfy the specified JSON schema: n,m,a,b are integers, 0 <= n <= 500 and m > 0. The signed integers a and b have no additional magnitude bound; magnitude 10^30 is permitted. No additional input preconditions apply.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 280, endByte := 337, origin := \"explicit\", interpretation := \"Supplier guarantees valid inputs.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 383, endByte := 467, origin := \"explicit\", interpretation := \"Exact input domain.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1132, endByte := 1222, origin := \"explicit\", interpretation := \"No extra preconditions.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1654, endByte := 1733, origin := \"explicit\", interpretation := \"Preserve A1 identity.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 2085, endByte := 3628, origin := \"explicit\", interpretation := \"Required assumption A1.\" }],\n  scope := [\"supplied input\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }],\n  acceptanceCriteria := [\"Every supplied input has the specified integer fields, 0 <= n <= 500 and m > 0.\", \"No additional magnitude bound or sign restriction is imposed on a or b.\", \"No additional precondition restricts the functional domain.\"],\n  bindings := [\"VeriSlopAST.valid_input\"] }\n\ndef «O1» : Entry := {\n  id := \"O1\",\n  revision := 1,\n  kind := \"postcondition\",\n  role := \"guarantee\",\n  statement := \"For every input satisfying A1, the actual admitted solve entry of arity 1 in canonical program.vscore.json returns the exact integer sum_{i=0}^{n-1} floor((a*i+b)/m), with floor toward negative infinity and empty sum 0. Universal source implementation refinement must connect this complete formula to that entry under normative Lean vscore-semantics/0.3 and data-pipeline/0.3. Its mixed source/value formal contract requires typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only for that exact file and entry.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 468, endByte := 518, origin := \"explicit\", interpretation := \"Universal floor-sum formula.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 519, endByte := 572, origin := \"explicit\", interpretation := \"Negative-infinity floor.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 573, endByte := 591, origin := \"explicit\", interpretation := \"Empty sum is zero.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1224, endByte := 1269, origin := \"explicit\", interpretation := \"Preserved examples.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1270, endByte := 1427, origin := \"explicit\", interpretation := \"Example values and universal refinement.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1552, endByte := 1653, origin := \"explicit\", interpretation := \"Unchanged functional meaning.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1654, endByte := 1733, origin := \"explicit\", interpretation := \"Preserve O1 identity.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1874, endByte := 1985, origin := \"explicit\", interpretation := \"Complete mathematical statement and universal refinement.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1986, endByte := 2026, origin := \"explicit\", interpretation := \"Examples cannot replace universal guarantees.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 2085, endByte := 3628, origin := \"explicit\", interpretation := \"Required O1 guarantee and requested assurance endpoint.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4060, endByte := 4264, origin := \"explicit\", interpretation := \"Exact source delivery.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4265, endByte := 4326, origin := \"explicit\", interpretation := \"Source facets in the formal contract.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4327, endByte := 4496, origin := \"explicit\", interpretation := \"Equality cannot replace source properties.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4497, endByte := 4713, origin := \"explicit\", interpretation := \"Mixed source/value refinement.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4714, endByte := 4774, origin := \"explicit\", interpretation := \"Required value facets.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 5156, endByte := 6207, origin := \"explicit\", interpretation := \"Exact O1 source-facet policy.\" }],\n  scope := [\"all inputs satisfying A1\", \"actual canonical solve source\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }, { id := \"A1\", relation := \"assumes\" }],\n  acceptanceCriteria := [\"For every valid input, execution returns sum_{i=0}^{n-1} floor((a*i+b)/m).\", \"Each summand is the unique integer q satisfying m*q <= a*i+b < m*(q+1).\", \"Every valid input with n=0 returns 0.\", \"The public examples return -4 for {a:-2,b:1,m:3,n:4} and 0 for {a:100,b:-99,m:7,n:0}; these examples do not replace universal refinement.\", \"The formal contract binds program.vscore.json, solve, arity 1 and all seven properties typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data, restricted_runtime_only.\", \"A mathematical existence theorem, reflexive equality or unrelated entry cannot replace the complete mixed source/value guarantee.\"],\n  bindings := [\"VeriSlopAST.floor_sum_contract\"] }\n\ndef «O2» : Entry := {\n  id := \"O2\",\n  revision := 1,\n  kind := \"postcondition\",\n  role := \"guarantee\",\n  statement := \"For every input satisfying A1, canonical program.vscore.json contains exactly one admitted typed entry solve of arity 1 accepting the typed representation of JSON {n,m,a,b} and returning the data-pipeline/0.3 representation of the exact JSON integer sum_{i=0}^{n-1} floor((a*i+b)/m), with floor toward negative infinity and empty sum 0. Preserve specified input/output structure and exact ordering. Under normative Lean vscore-semantics/0.3, execution is total, pure, deterministic, preserves immutable inputs, has no external effects and uses unbounded mathematical integers without floating point. The mixed source/value contract requires universal implementation refinement and all seven exact properties typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 67, endByte := 137, origin := \"explicit\", interpretation := \"Typed entry delivery.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 138, endByte := 222, origin := \"explicit\", interpretation := \"JSON structure representation.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 468, endByte := 518, origin := \"explicit\", interpretation := \"Complete functional result.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 519, endByte := 572, origin := \"explicit\", interpretation := \"Signed floor semantics.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 573, endByte := 591, origin := \"explicit\", interpretation := \"Empty-sum output.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 615, endByte := 762, origin := \"explicit\", interpretation := \"Source and serialization profiles.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 763, endByte := 828, origin := \"explicit\", interpretation := \"Structure and ordering preservation.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 829, endByte := 887, origin := \"explicit\", interpretation := \"Total pure deterministic execution.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 888, endByte := 969, origin := \"explicit\", interpretation := \"Input immutability and effect restrictions.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 970, endByte := 1041, origin := \"explicit\", interpretation := \"Unbounded integer arithmetic.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1654, endByte := 1733, origin := \"explicit\", interpretation := \"Preserve O2 identity.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1734, endByte := 1825, origin := \"explicit\", interpretation := \"Revised typed pure source properties.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1826, endByte := 1873, origin := \"explicit\", interpretation := \"Unchanged delivery assurance.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1874, endByte := 1985, origin := \"explicit\", interpretation := \"Universal implementation refinement.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 2085, endByte := 3628, origin := \"explicit\", interpretation := \"Required O2 and requested endpoint.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4060, endByte := 4264, origin := \"explicit\", interpretation := \"Exact source delivery.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4265, endByte := 4326, origin := \"explicit\", interpretation := \"Formal source contract.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4327, endByte := 4496, origin := \"explicit\", interpretation := \"Source properties cannot be replaced by equality.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4497, endByte := 4713, origin := \"explicit\", interpretation := \"Mixed source/value guarantee.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4714, endByte := 4774, origin := \"explicit\", interpretation := \"Required value facets.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 5156, endByte := 6207, origin := \"explicit\", interpretation := \"Exact O2 source policy.\" }],\n  scope := [\"typed serialization\", \"all inputs satisfying A1\", \"canonical source delivery\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }, { id := \"A1\", relation := \"assumes\" }],\n  acceptanceCriteria := [\"Canonical vscore/0.3 file program.vscore.json contains exactly one admitted typed entry solve of arity 1.\", \"For every valid input, typed execution and data-pipeline/0.3 serialization return the exact JSON integer floor sum.\", \"For each summand q, m*q <= a*i+b < m*(q+1); when n=0 the output is 0.\", \"Specified input/output structure and exact ordering are preserved without changing input values.\", \"The formal contract binds the actual file, entry, arity and all seven required closed source properties.\", \"Universal refinement covers the complete functional value and source requirements; existence or equality alone cannot replace them.\"],\n  bindings := [\"VeriSlopAST.floor_sum_contract\"] }\n\ndef «S1» : Entry := {\n  id := \"S1\",\n  revision := 1,\n  kind := \"safety_property\",\n  role := \"guarantee\",\n  statement := \"Canonical program.vscore.json contains exactly one admitted typed entry solve of arity 1 whose normative restricted-source execution is total, deterministic, input-preserving, free of external I/O and floating point, and pure data. It does not read benchmark files, leaves input values immutable and uses no external-effect constructors. Its source-only formal contract retains typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only under normative Lean vscore-semantics/0.3 and data-pipeline/0.3.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 223, endByte := 279, origin := \"explicit\", interpretation := \"No external I/O or benchmark reads.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 615, endByte := 762, origin := \"explicit\", interpretation := \"Canonical restricted source.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 829, endByte := 887, origin := \"explicit\", interpretation := \"Total pure deterministic execution.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 888, endByte := 969, origin := \"explicit\", interpretation := \"Input preservation and effect restrictions.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1654, endByte := 1733, origin := \"explicit\", interpretation := \"Preserve S1 identity.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1734, endByte := 1825, origin := \"explicit\", interpretation := \"Revised source properties.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1826, endByte := 1873, origin := \"explicit\", interpretation := \"Preserved delivery assurance.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 2085, endByte := 3628, origin := \"explicit\", interpretation := \"Required S1 guarantee.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4060, endByte := 4264, origin := \"explicit\", interpretation := \"Exact source delivery.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4265, endByte := 4326, origin := \"explicit\", interpretation := \"Formal source contract.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4327, endByte := 4496, origin := \"explicit\", interpretation := \"Source requirements cannot be replaced by equality.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4775, endByte := 4928, origin := \"explicit\", interpretation := \"S1 is source-only.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 5156, endByte := 6207, origin := \"explicit\", interpretation := \"Exact S1 policy.\" }],\n  scope := [\"canonical solve source\", \"all admitted typed execution\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }],\n  acceptanceCriteria := [\"The source contract binds program.vscore.json, solve, arity 1 and all seven exact required properties.\", \"No external I/O or benchmark reads occur, inputs remain immutable and no external-effect constructors are used.\", \"S1 remains a required source-only operational guarantee; replacement value equalities do not discharge its source requirements.\"],\n  bindings := [\"VeriSlopAST.source_safety\"] }\n\ndef «S2» : Entry := {\n  id := \"S2\",\n  revision := 1,\n  kind := \"safety_property\",\n  role := \"guarantee\",\n  statement := \"Canonical program.vscore.json, with exactly one admitted typed entry solve of arity 1, uses exact unbounded mathematical integer arithmetic without floating point throughout signed floor-sum execution, including intermediate values. Its source-only formal contract requires typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only under normative Lean vscore-semantics/0.3 and data-pipeline/0.3.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 468, endByte := 518, origin := \"explicit\", interpretation := \"Exact sum arithmetic.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 592, endByte := 613, origin := \"explicit\", interpretation := \"Avoid floating point.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 970, endByte := 1041, origin := \"explicit\", interpretation := \"Unbounded mathematical integers.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1654, endByte := 1733, origin := \"explicit\", interpretation := \"Preserve S2 identity.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 2085, endByte := 3628, origin := \"explicit\", interpretation := \"Required S2 guarantee.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4060, endByte := 4264, origin := \"explicit\", interpretation := \"Exact canonical source delivery.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4265, endByte := 4326, origin := \"explicit\", interpretation := \"Formal source contract.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4327, endByte := 4496, origin := \"explicit\", interpretation := \"Retain exact non-floating-point source semantics.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4775, endByte := 4928, origin := \"explicit\", interpretation := \"S2 is source-only.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 5156, endByte := 6207, origin := \"explicit\", interpretation := \"Exact S2 policy.\" }],\n  scope := [\"all arithmetic in canonical solve\", \"normative restricted-source execution\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }],\n  acceptanceCriteria := [\"No floating-point representation or operation is used.\", \"All arithmetic, including intermediate values, uses unbounded mathematical integers.\", \"The source contract binds program.vscore.json, solve, arity 1 and all seven exact required properties.\", \"S2 remains a required source-only operational guarantee and is not replaced by a value equality.\"],\n  bindings := [\"VeriSlopAST.source_safety\"] }\n\ndef «N1» : Entry := {\n  id := \"N1\",\n  revision := 1,\n  kind := \"explicit_non_goal\",\n  role := \"exclusion\",\n  statement := \"No behavior is required for malformed input.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 338, endByte := 382, origin := \"explicit\", interpretation := \"Malformed-input exclusion.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1654, endByte := 1733, origin := \"explicit\", interpretation := \"Preserve N1 identity and exclusion role.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 2085, endByte := 3628, origin := \"explicit\", interpretation := \"Required exclusion N1.\" }],\n  scope := [\"inputs violating the specified schema or bounds\"],\n  dependencies := [],\n  acceptanceCriteria := [\"Malformed-input behavior is outside the required functional contract.\"],\n  bindings := [] }\n\ndef «N2» : Entry := {\n  id := \"N2\",\n  revision := 1,\n  kind := \"explicit_non_goal\",\n  role := \"exclusion\",\n  statement := \"Runtime campaigns and machine-code, compiler, runtime or physical-resource assurance are outside scope. The assurance boundary is normative restricted-source execution only, explicitly trusting natural-language correspondence, host tooling, the pinned Lean kernel, hashing and OS/hardware.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 3629, endByte := 3665, origin := \"explicit\", interpretation := \"Runtime campaigns excluded.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 3666, endByte := 3849, origin := \"explicit\", interpretation := \"Normative source boundary and explicit trust.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 3850, endByte := 3927, origin := \"explicit\", interpretation := \"Downstream assurance excluded.\" }],\n  scope := [\"assurance boundary\"],\n  dependencies := [],\n  acceptanceCriteria := [\"No runtime campaign is required.\", \"No machine-code, compiler, runtime or physical-resource assurance is claimed.\", \"The named trusted components remain outside the restricted-source proof boundary.\"],\n  bindings := [] }\n\ndef «valid_input_witness» : Entry := {\n  id := \"valid_input_witness\",\n  revision := 1,\n  kind := \"non_vacuity\",\n  role := \"guarantee\",\n  statement := \"Non-vacuity: The Input record with n=0, m=1, a=0 and b=0 satisfies the exact input predicate. (witnesses A1)\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 280, endByte := 337, origin := \"inferred\", interpretation := \"derived by registered rule verislop.non-vacuity/0.1 from assumption A1\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 383, endByte := 467, origin := \"inferred\", interpretation := \"derived by registered rule verislop.non-vacuity/0.1 from assumption A1\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1132, endByte := 1222, origin := \"inferred\", interpretation := \"derived by registered rule verislop.non-vacuity/0.1 from assumption A1\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1654, endByte := 1733, origin := \"inferred\", interpretation := \"derived by registered rule verislop.non-vacuity/0.1 from assumption A1\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a5