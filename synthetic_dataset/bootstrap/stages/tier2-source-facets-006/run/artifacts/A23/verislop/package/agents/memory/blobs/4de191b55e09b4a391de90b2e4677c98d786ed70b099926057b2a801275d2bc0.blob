ed as metadata and prohibits stronger claims","scope":[]},"FORMALIZED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"IMPLEMENTED":{"evidence_refs":[],"outcome":"NOT_APPLICABLE","reason":"an explicit exclusion is retained as metadata and prohibits stronger claims","scope":[]},"INTERPRETED":{"evidence_refs":["provenance:tier2:tier2-source-facets-006:A23"],"outcome":"PASS","reason":"Recorded interpretation proposal; not mathematical proof.","scope":["recorded interpretation of the request"]},"LINKED":{"evidence_refs":[],"outcome":"NOT_APPLICABLE","reason":"an explicit exclusion is retained as metadata and prohibits stronger claims","scope":[]},"PROVED":{"evidence_refs":[],"outcome":"NOT_APPLICABLE","reason":"an explicit exclusion is retained as metadata and prohibits stronger claims","scope":[]},"TESTED":{"evidence_refs":[],"outcome":"NOT_APPLICABLE","reason":"an explicit exclusion is retained as metadata and prohibits stronger claims","scope":[]},"TYPECHECKED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]}},"required":true,"revision":1,"role":"exclusion","scope":["assurance boundary"],"source_refs":[{"document_hash":"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b","document_ref":"tier2:tier2-source-facets-006:A23","end_byte":3665,"interpretation":"Runtime campaigns excluded.","origin":"explicit","start_byte":3629},{"document_hash":"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b","document_ref":"tier2:tier2-source-facets-006:A23","end_byte":3849,"interpretation":"Normative source boundary and explicit trust.","origin":"explicit","start_byte":3666},{"document_hash":"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b","document_ref":"tier2:tier2-source-facets-006:A23","end_byte":3927,"interpretation":"Downstream assurance excluded.","origin":"explicit","start_byte":3850}],"state":"INTERPRETED","statement":"Runtime campaigns and machine-code, compiler, runtime or physical-resource assurance are outside scope. The assurance boundary is normative restricted-source execution only, explicitly trusting natural-language correspondence, host tooling, the pinned Lean kernel, hashing and OS/hardware."}],"invariants":[],"liveness_properties":[],"postconditions":[{"acceptance_criteria":["For every valid input, execution returns sum_{i=0}^{n-1} floor((a*i+b)/m).","Each summand is the unique integer q satisfying m*q <= a*i+b < m*(q+1).","Every valid input with n=0 returns 0.","The public examples return -4 for {a:-2,b:1,m:3,n:4} and 0 for {a:100,b:-99,m:7,n:0}; these examples do not replace universal refinement.","The formal contract binds program.vscore.json, solve, arity 1 and all seven properties typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data, restricted_runtime_only.","A mathematical existence theorem, reflexive equality or unrelated entry cannot replace the complete mixed source/value guarantee."],"dependencies":[{"id":"D1","relation":"uses_definition"},{"id":"A1","relation":"assumes"}],"id":"O1","kind":"postcondition","lifecycle":{"END_TO_END_VERIFIED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"FORMALIZED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"IMPLEMENTED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"INTERPRETED":{"evidence_refs":["provenance:tier2:tier2-source-facets-006:A23"],"outcome":"PASS","reason":"Recorded interpretation proposal; not mathematical proof.","scope":["recorded interpretation of the request"]},"LINKED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"PROVED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"TESTED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"TYPECHECKED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]}},"required":true,"revision":1,"role":"guarantee","scope":["all inputs satisfying A1","actual canonical solve source"],"source_refs":[{"document_hash":"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b","document_ref":"tier2:tier2-source-facets-006:A23","end_byte":518,"interpretation":"Universal floor-sum formula.","origin":"explicit","start_byte":468},{"document_hash":"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b","document_ref":"tier2:tier2-source-facets-006:A23","end_byte":572,"interpretation":"Negative-infinity floor.","origin":"explicit","start_byte":519},{"document_hash":"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b","document_ref":"tier2:tier2-source-facets-006:A23","end_byte":591,"interpretation":"Empty sum is zero.","origin":"explicit","start_byte":573},{"document_hash":"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b","document_ref":"tier2:tier2-source-facets-006:A23","end_byte":1269,"interpretation":"Preserved examples.","origin":"explicit","start_byte":1224},{"document_hash":"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b","document_ref":"tier2:tier2-source-facets-006:A23","end_byte":1427,"interpretation":"Example values and universal refinement.","origin":"explicit","start_byte":1270},{"document_hash":"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b","document_ref":"tier2:tier2-source-facets-006:A23","end_byte":1653,"interpretation":"Unchanged functional meaning.","origin":"explicit","start_byte":1552},{"document_hash":"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b","document_ref":"tier2:tier2-source-facets-006:A23","end_byte":1733,"interpretation":"Preserve O1 identity.","origin":"explicit","start_byte":1654},{"document_hash":"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b","document_ref":"tier2:tier2-source-facets-006:A23","end_byte":1985,"interpretation":"Complete mathematical statement and universal refinement.","origin":"explicit","start_byte":1874},{"document_hash":"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b","document_ref":"tier2:tier2-source-facets-006:A23","end_byte":2026,"interpretation":"Examples cannot replace universal guarantees.","origin":"explicit","start_byte":1986},{"document_hash":"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b","document_ref":"tier2:tier2-source-facets-006:A23","end_byte":3628,"interpretation":"Required O1 guarantee and requested assurance endpoint.","origin":"explicit","start_byte":2085},{"document_hash":"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b","document_ref":"tier2:tier2-source-facets-006:A23","end_byte":4264,"interpretation":"Exact source delivery.","origin":"explicit","start_byte":4060},{"document_hash":"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b","document_ref":"tier2:tier2-source-facets-006:A23","end_byte":4326,"interpretation":"Source facets in the formal contract.","origin":"explicit","start_byte":4265},{"document_hash":"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b","document_ref":"tier2:tier2-source-facets-006:A23","end_byte":4496,"interpretation":"Equality cannot replace source properties.","origin":"explicit","start_byte":4327},{"document_hash":"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b","document_ref":"tier2:tier2-source-facets-006:A23","end_byte":4713,"interpretation":"Mixed source/value refinement.","origin":"explicit","start_byte":4497},{"document_hash":"sha256:7e8c0d17e78afc9