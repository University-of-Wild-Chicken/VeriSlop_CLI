 \"Mixed source/value guarantee.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4714, endByte := 4774, origin := \"explicit\", interpretation := \"Required value facets.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 5156, endByte := 6207, origin := \"explicit\", interpretation := \"Exact O2 source policy.\" }],\n  scope := [\"typed serialization\", \"all inputs satisfying A1\", \"canonical source delivery\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }, { id := \"A1\", relation := \"assumes\" }],\n  acceptanceCriteria := [\"Canonical vscore/0.3 file program.vscore.json contains exactly one admitted typed entry solve of arity 1.\", \"For every valid input, typed execution and data-pipeline/0.3 serialization return the exact JSON integer floor sum.\", \"For each summand q, m*q <= a*i+b < m*(q+1); when n=0 the output is 0.\", \"Specified input/output structure and exact ordering are preserved without changing input values.\", \"The formal contract binds the actual file, entry, arity and all seven required closed source properties.\", \"Universal refinement covers the complete functional value and source requirements; existence or equality alone cannot replace them.\"],\n  bindings := [\"VeriSlopAST.floor_sum_contract\"] }\n\ndef «S1» : Entry := {\n  id := \"S1\",\n  revision := 1,\n  kind := \"safety_property\",\n  role := \"guarantee\",\n  statement := \"Canonical program.vscore.json contains exactly one admitted typed entry solve of arity 1 whose normative restricted-source execution is total, deterministic, input-preserving, free of external I/O and floating point, and pure data. It does not read benchmark files, leaves input values immutable and uses no external-effect constructors. Its source-only formal contract retains typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only under normative Lean vscore-semantics/0.3 and data-pipeline/0.3.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 223, endByte := 279, origin := \"explicit\", interpretation := \"No external I/O or benchmark reads.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 615, endByte := 762, origin := \"explicit\", interpretation := \"Canonical restricted source.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 829, endByte := 887, origin := \"explicit\", interpretation := \"Total pure deterministic execution.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 888, endByte := 969, origin := \"explicit\", interpretation := \"Input preservation and effect restrictions.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1654, endByte := 1733, origin := \"explicit\", interpretation := \"Preserve S1 identity.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1734, endByte := 1825, origin := \"explicit\", interpretation := \"Revised source properties.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1826, endByte := 1873, origin := \"explicit\", interpretation := \"Preserved delivery assurance.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 2085, endByte := 3628, origin := \"explicit\", interpretation := \"Required S1 guarantee.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4060, endByte := 4264, origin := \"explicit\", interpretation := \"Exact source delivery.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4265, endByte := 4326, origin := \"explicit\", interpretation := \"Formal source contract.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4327, endByte := 4496, origin := \"explicit\", interpretation := \"Source requirements cannot be replaced by equality.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4775, endByte := 4928, origin := \"explicit\", interpretation := \"S1 is source-only.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 5156, endByte := 6207, origin := \"explicit\", interpretation := \"Exact S1 policy.\" }],\n  scope := [\"canonical solve source\", \"all admitted typed execution\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }],\n  acceptanceCriteria := [\"The source contract binds program.vscore.json, solve, arity 1 and all seven exact required properties.\", \"No external I/O or benchmark reads occur, inputs remain immutable and no external-effect constructors are used.\", \"S1 remains a required source-only operational guarantee; replacement value equalities do not discharge its source requirements.\"],\n  bindings := [\"VeriSlopAST.source_safety\"] }\n\ndef «S2» : Entry := {\n  id := \"S2\",\n  revision := 1,\n  kind := \"safety_property\",\n  role := \"guarantee\",\n  statement := \"Canonical program.vscore.json, with exactly one admitted typed entry solve of arity 1, uses exact unbounded mathematical integer arithmetic without floating point throughout signed floor-sum execution, including intermediate values. Its source-only formal contract requires typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only under normative Lean vscore-semantics/0.3 and data-pipeline/0.3.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 468, endByte := 518, origin := \"explicit\", interpretation := \"Exact sum arithmetic.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 592, endByte := 613, origin := \"explicit\", interpretation := \"Avoid floating point.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 970, endByte := 1041, origin := \"explicit\", interpretation := \"Unbounded mathematical integers.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1654, endByte := 1733, origin := \"explicit\", interpretation := \"Preserve S2 identity.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 2085, endByte := 3628, origin := \"explicit\", interpretation := \"Required S2 guarantee.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4060, endByte := 4264, origin := \"explicit\", interpretation := \"Exact canonical source delivery.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4265, endByte := 4326, origin := \"explicit\", interpretation := \"Formal source contract.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4327, endByte := 4496, origin := \"explicit\", interpretation := \"Retain exact non-floating-point source semantics.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4775, endByte := 4928, origin := \"explicit\", interpretation := \"S2 is source-only.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 5156, endByte := 6207, origin := \"explicit\", interpretation := \"Exact S2 policy.\" }],\n  scope := [\"all arithmetic in canonical solve\", \"normative restricted-source execution\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }],\n  acceptanceCriteria := [\"No floating-point representation or operation is used.\", \"All arithmetic, including intermediate values, uses unbounded mathematical integers.\", \"The source contract binds program.vscore.json, solve, arity 1 and all seven exact required properties.\", \"S2 remains a required source-only operational guarantee and is not replaced by a value equality.\"],\n  bindings := [\"VeriSlopAST.source_safety\"] }\n\ndef «N1» : Entry := {\n  id := \"N1\",\n  revision := 1,\n  kind := \"explicit_non_goal\",\n  role := \"exclusion\",\n  statement := \"No behavior is required for malformed input.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 338, endByte := 382, origin := \"explicit\", interpretation := \"Malformed-input exclusion.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1654, endByte := 1733, origin := \"explicit\", interpretation := \"Preserve N1 identity and exclusion role.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 2085, endByte := 3628, origin := \"explicit\", interpretation := \"Required exclusion N1.\" }],\n  scope := [\"inputs violating the specified schema or bounds\"],\n  dependencies := [],\n  acceptanceCriteria := [\"Malformed-input behavior is outside the required functional contract.\"],\n  bindings := [] }\n\ndef «N2» : Entry := {\n  id := \"N2\",\n  revision := 1,\n  kind := \"explicit_non_goal\",\n  role := \"exclusion\",\n  statement := \"Runtime campaigns and machine-code, compiler, runtime or physical-resource assurance are outside scope. The assurance boundary is normative restricted-source execution only, explicitly trusting natural-language correspondence, host tooling, the pinned Lean kernel, hashing and OS/hardware.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 3629, endByte := 3665, origin := \"explicit\", interpretation := \"Runtime campaigns excluded.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 3666, endByte := 3849, origin := \"explicit\", interpretation := \"Normative source boundary and explicit trust.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 3850, endByte := 3927, origin := \"explicit\", interpretation := \"Downstream assurance excluded.\" }],\n  scope := [\"assurance boundary\"],\n  dependencies := [],\n  acceptanceCriteria := [\"No runtime campaign is required.\", \"No machine-code, compiler, runtime or physical-resource assurance is claimed.\", \"The named trusted components remain outside the restricted-source proof boundary.\"],\n  bindings := [] }\n\ndef «valid_input_witness» : Entry := {\n  id := \"valid_input_witness\",\n  revision := 1,\n  kind := \"non_vacuity\",\n  role := \"guarantee\",\n  statement := \"Non-vacuity: The Input record with n=0, m=1, a=0 and b=0 satisfies the exact input predicate. (witnesses A1)\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 280, endByte := 337, origin := \"inferred\", interpretation := \"derived by registered rule verislop.non-vacuity/0.1 from assumption A1\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 383, endByte := 467, origin := \"inferred\", interpretation := \"derived by registered rule verislop.non-vacuity/0.1 from assumption A1\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1132, endByte := 1222, origin := \"inferred\", interpretation := \"derived by registered rule verislop.non-vacuity/0.1 from assumption A1\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1654, endByte := 1733, origin := \"inferred\", interpretation := \"derived by registered rule verislop.non-vacuity/0.1 from assumption A1\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 2085, endByte := 3628, origin := \"inferred\", interpretation := \"derived by registered rule verislop.non-vacuity/0.1 from assumption A1\" }],\n  scope := [\"supplied input\"],\n  dependencies := [{ id := \"A1\", relation := \"uses_definition\" }],\n  acceptanceCriteria := [\"Prove the existential theorem with concrete witnesses extractable by bounded kernel head-normalisation.\"],\n  bindings := [\"VeriSlopAST.valid_input_inhabited\"] }\n\ndef entries : List Entry := [«D1», «A1», «O1», «O2», «S1», «S2», «N1», «N2», «valid_input_witness»]\n\nend VeriSlop.Registry\n-- END VERISLOP REGISTRY\n\n/-!\nNormative restricted-source boundary requirement model, v0.1. These rules prove\nchecking soundness and inhabitation of an abstract fact model. They do not assert\nfacts about a delivered program, its evaluator, or a host runtime. The source\nbridge must derive every fact from the exact admitted source and semantic laws.\nThis algebra is independent of the Python NativeBoundary model.\n-/\nnamespace VeriSlop.Source\n\ninductive SourceRequirement where\n  | entry (file id : String) (arity : Nat)\n  | typedTotal\n  | deterministic\n  | inputPreserved\n  | noExternalIO\n  | noFloatingPoint\n  | pureData\n  | restrictedRuntimeOnly\n  deriving DecidableEq\n\nstructure Entry where\n  file : String\n  id : String\n  arity : Nat\n  deriving DecidableEq\n\nstructure ModuleFacts where\n  entries : List Entry\n  uniqueEntries : Bool\n  typedTotal : Bool\n  deterministic : Bool\n  inputPreserved : Bool\n  noExternalIO : Bool\n  noFloatingPoint : Bool\n  pureData : Bool\n  restrictedRuntimeOnly : Bool\n\ndef checkRequirement (r : SourceRequirement) (m : ModuleFacts) : Bool :=\n  match r with\n  | .entry f n a => m.uniqueEntries && decide (Entry.mk f n a ∈ m.entries)\n  | .typedTotal => m.typedTotal\n  | .deterministic => m.deterministic\n  | .inputPreserved => m.inputPreserved\n  | .noExternalIO => m.noExternalIO\n  | .noFloatingPoint => m.noFloatingPoint\n  | .pureData => m.pureData\n  | .restrictedRuntimeOnly => m.restrictedRuntimeOnly\n\ndef HoldsRequirement (r : SourceRequirement) (m : ModuleFacts) : Prop :=\n  match r with\n  | .entry f n a => m.uniqueEntries = true ∧ Entry.mk f n a ∈ m.entries\n  | .typedTotal => m.typedTotal = true\n  | .deterministic => m.deterministic = true\n  | .inputPreserved => m.inputPreserved = true\n  | .noExternalIO => m.noExternalIO = true\n  | .noFloatingPoint => m.noFloatingPoint = true\n  | .pureData => m.pureData = true\n  | .restrictedRuntimeOnly => m.restrictedRuntimeOnly = true\n\ndef checkBoundary (rs : List SourceRequirement) (m : ModuleFacts) : Bool :=\n  rs.all (fun r => checkRequirement r m)\n\ndef HoldsBoundary (rs : List SourceRequirement) (m : ModuleFacts) : Prop :=\n  ∀ r ∈ rs, HoldsRequirement r m\n\ndef Transfer (rs : List SourceRequirement) : Prop :=\n  ∀ m, checkBoundary rs m = true → HoldsBoundary rs m\n\ndef AdmissionInhabited (rs : List SourceRequirement) : Prop :=\n  ∃ m, checkBoundary rs m = true\n\n/-- Closed accepted data identifies the endpoint; Contract supplies only abstract\nchecking rules and does not establish implementation refinement. -/\nstructure SourceDefinition (τ : Type) where\n  endpoint : τ\n  requirements : List SourceRequirement\n\ndef Contract {τ : Type} (d : SourceDefinition τ) : Prop :=\n  Transfer d.requirements ∧ AdmissionInhabited d.requirements\n\ntheorem checkRequirement_sound (r : SourceRequirement) (m : ModuleFacts) :\n    checkRequirement r m = true → HoldsRequirement r m := by\n  cases r <;> simp [checkRequirement, HoldsRequirement, Bool.and_eq_true]\n\ntheorem transfer_sound (rs : List SourceRequirement) : Transfer rs := by\n  intro m h r hr\n  exact checkRequirement_sound r m ((List.all_eq_true.mp h) r hr)\n\ndef witnessEntries : List SourceRequirement → List Entry\n  | [] => []\n  | .entry f n a :: rs => Entry.mk f n a :: witnessEntries rs\n  | _ :: rs => witnessEntries rs\n\ndef modelWitness (rs : List SourceRequirement) : ModuleFacts :=\n  ⟨witnessEntries rs, true, true, true, true, true, true, true, true⟩\n\ntheorem entry_in_witness (f n : String) (a : Nat) (rs : List SourceRequirement)\n    (h : SourceRequirement.entry f n a ∈ rs) : Entry.mk f n a ∈ witnessEntries rs := by\n  induction rs with\n  | nil => simp at h\n  | cons r rs ih => cases r <;> simp_all [witnessEntries] <;> grind\n\ntheorem admission_inhabited (rs : List SourceRequirement) : AdmissionInhabited rs := by\n  refine ⟨modelWitness rs, List.all_eq_true.mpr ?_⟩\n  intro r hr\n  cases r with\n  | entry f n a =>\n    simp [checkRequirement, modelWitness, entry_in_witness f n a rs hr]\n  | typedTotal => rfl\n  | deterministic => rfl\n  | inputPreserved => rfl\n  | noExternalIO => rfl\n  | noFloatingPoint => rfl\n  | pureData => rfl\n  | restrictedRuntimeOnly => rfl\n\ntheorem contract_sound {τ : Type} (d : SourceDefinition τ) : Contract d :=\n  ⟨transfer_sound d.requirements, admission_inhabited d.requirements⟩\n\nend VeriSlop.Source\n\nnamespace VeriSlopAST\nstructure «Input» where\n  «n» : _root_.Int\n  «m» : _root_.Int\n  «a» : _root_.Int\n  «b» : _root_.Int\ndef «solve» («_v0» : _root_.VeriSlopAST.«Input») : _root_.Int := (_root_.List.sum (@_root_.List.map _root_.Nat _root_.Int (fun («_v1» : _root_.Nat) => (_root_.Int.fdiv (_root_.Int.add (_root_.Int.mul (_root_.VeriSlopAST.«Input».«a» «_v0») (_root_.Int.ofNat «_v1»)) (_root_.VeriSlopAST.«Input».«b» «_v0»)) (_root_.VeriSlopAST.«Input».«m» «_v0»))) (_root_.List.range (_root_.Int.toNat (_root_.VeriSlopAST.«Input».«n» «_v0»)))))\ntheorem «_vs_body_solve» : (∀ («_v0» : _root_.VeriSlopAST.«Input»), ((_root_.VeriSlopAST.«solve» «_v0») = (_root_.List.sum (@_root_.List.map _root_.Nat _root_.Int (fun («_v1» : _root_.Nat) => (_root_.Int.fdiv (_root_.Int.add (_root_.Int.mul (_root_.VeriSlopAST.«Input».«a» «_v0») (_root_.Int.ofNat «_v1»)) (_root_.VeriSlopAST.«Input».«b» «_v0»)) (_root_.VeriSlopAST.«Input».«m» «_v0»))) (_root_.List.range (_root_.Int.toNat (_root_.VeriSlopAST.«Input».«n» «_v0»))))))) := by intros; rfl\n@[reducible] def «valid_input» («_v0» : _root_.VeriSlopAST.«Input») : Prop := ((((_root_.Int.ofNat 0) ≤ (_root_.VeriSlopAST.«Input».«n» «_v0»)) ∧ ((_root_.VeriSlopAST.«Input».«n» «_v0») ≤ (_root_.Int.ofNat 500))) ∧ ((_root_.Int.ofNat 0) < (_root_.VeriSlopAST.«Input».«m» «_v0»)))\ntheorem «_vs_predicate_valid_input» («_v0» : _root_.VeriSlopAST.«Input») : ((_root_.VeriSlopAST.«valid_input» «_v0») ↔ ((((_root_.Int.ofNat 0) ≤ (_root_.VeriSlopAST.«Input».«n» «_v0»)) ∧ ((_root_.VeriSlopAST.«Input».«n» «_v0») ≤ (_root_.Int.ofNat 500))) ∧ ((_root_.Int.ofNat 0) < (_root_.VeriSlopAST.«Input».«m» «_v0»)))) := by rfl\ndef «SolveSource» : _root_.VeriSlop.Source.SourceDefinition (_root_.VeriSlopAST.«Input» → _root_.Int) := ⟨_root_.VeriSlopAST.«solve», [(_root_.VeriSlop.Source.SourceRequirement.entry \"program.vscore.json\" \"solve\" 1), _root_.VeriSlop.Source.SourceRequirement.typedTotal, _root_.VeriSlop.Source.SourceRequirement.deterministic, _root_.VeriSlop.Source.SourceRequirement.inputPreserved, _root_.VeriSlop.Source.SourceRequirement.noExternalIO, _root_.VeriSlop.Source.SourceRequirement.noFloatingPoint, _root_.VeriSlop.Source.SourceRequirement.pureData, _root_.VeriSlop.Source.SourceRequirement.restrictedRuntimeOnly]⟩\ntheorem «floor_sum_contract» : ((∀ («_v0» : _root_.VeriSlopAST.«Input»), ((_root_.VeriSlopAST.«valid_input» «_v0») → ((_root_.VeriSlopAST.«solve» «_v0») = (_root_.List.sum (@_root_.List.map _root_.Nat _root_.Int (fun («_v1» : _root_.Nat) => (_root_.Int.fdiv (_root_.Int.add (_root_.Int.mul (_root_.VeriSlopAST.«Input».«a» «_v0») (_root_.Int.ofNat «_v1»)) (_root_.VeriSlopAST.«Input».«b» «_v0»)) (_root_.VeriSlopAST.«Input».«m» «_v0»))) (_root_.List.range (_root_.Int.toNat (_root_.VeriSlopAST.«Input».«n» «_v0»)))))))) ∧ (_root_.VeriSlop.Source.Contract _root_.VeriSlopAST.«SolveSource»)) := by\n  constructor\n  · intro x hx\n    rfl\n  · exact VeriSlop.Source.contract_sound VeriSlopAST.SolveSource\ntheorem «_vs_value_floor_sum_contract» : (∀ («_v0» : _root_.VeriSlopAST.«Input»), ((_root_.VeriSlopAST.«valid_input» «_v0») → ((_root_.VeriSlopAST.«solve» «_v0») = (_root_.List.sum (@_root_.List.map _root_.Nat _root_.Int (fun («_v1» : _root_.Nat) => (_root_.Int.fdiv (_root_.Int.add (_root_.Int.mul (_root_.VeriSlopAST.«Input».«a» «_v0») (_root_.Int.ofNat «_v1»)) (_root_.VeriSlopAST.«Input».«b» «_v0»)) (_root_.VeriSlopAST.«Input».«m» «_v0»))) (_root_.List.range (_root_.Int.toNat (_root_.VeriSlopAST.«Input».«n» «_v0»)))))))) := by exact _root_.VeriSlopAST.«floor_sum_contract».1\ntheorem «source_safety» : (_root_.VeriSlop.Source.Contract _root_.VeriSlopAST.«SolveSource») := by\n  exact VeriSlop.Source.contract_sound VeriSlopAST.SolveSource\ntheorem «valid_input_inhabited» : (∃ («_v0» : _root_.VeriSlopAST.«Input»), (_root_.VeriSlopAST.«valid_input» «_v0»)) := by\n  refine ⟨{ «n» := 0, «m» := 1, «a» := 0, «b» := 0 }, ?_⟩\n  decide\nend VeriSlopAST\n\n","candidate":"import Std\n\n-- BEGIN VERISLOP REGISTRY\n-- Generated by `verislop formalize`. Typed obligation metadata: an index, never evidence.\nnamespace VeriSlop.Registry\n\nstructure SourceRef where\n  documentRef : String\n  documentHash : String\n  startByte : Nat\n  endByte : Nat\n  origin : String\n  interpretation : String\n\nstructure Dependency where\n  id : String\n  relation : String\n\nstructure Entry where\n  id : String\n  revision : Nat\n  kind : String\n  role : String\n  statement : String\n  required : Bool\n  sourceRefs : List SourceRef\n  scope : List String\n  dependencies : List Dependency\n  acceptanceCriteria : List String\n  bindings : List String\n\ndef «D1» : Entry := {\n  id := \"D1\",\n  revision := 1,\n  kind := \"entity\",\n  role := \"declaration\",\n  statement := \"The deliverable is canonical program.vscore.json in vscore/0.3 under normative Lean vscore-semantics/0.3 and data-pipeline/0.3, containing exactly one admitted typed entry solve of arity 1. Its typed input represents JSON {n,m,a,b} with integer fields and its result represents a JSON integer. Integers are unbounded mathematical integers. Strings contain Unicode scalar values and lexicographic comparison uses scalar codepoints.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 67, endByte := 137, origin := \"explicit\", interpretation := \"File and entry identity.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 138, endByte := 222, origin := \"explicit\", interpretation := \"Typed JSON representation.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 383, endByte := 467, origin := \"explicit\", interpretation := \"Integer input fields.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 615, endByte := 762, origin := \"explicit\", interpretation := \"Normative source and serialization profiles.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 9