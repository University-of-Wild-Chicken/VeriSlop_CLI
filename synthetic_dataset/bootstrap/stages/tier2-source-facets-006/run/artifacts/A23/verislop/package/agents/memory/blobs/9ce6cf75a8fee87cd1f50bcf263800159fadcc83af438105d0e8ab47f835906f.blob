{"agent_attempt":1,"best":"import Std\n\n-- BEGIN VERISLOP REGISTRY\n-- Generated by `verislop formalize`. Typed obligation metadata: an index, never evidence.\nnamespace VeriSlop.Registry\n\nstructure SourceRef where\n  documentRef : String\n  documentHash : String\n  startByte : Nat\n  endByte : Nat\n  origin : String\n  interpretation : String\n\nstructure Dependency where\n  id : String\n  relation : String\n\nstructure Entry where\n  id : String\n  revision : Nat\n  kind : String\n  role : String\n  statement : String\n  required : Bool\n  sourceRefs : List SourceRef\n  scope : List String\n  dependencies : List Dependency\n  acceptanceCriteria : List String\n  bindings : List String\n\ndef «D1» : Entry := {\n  id := \"D1\",\n  revision := 1,\n  kind := \"entity\",\n  role := \"declaration\",\n  statement := \"The deliverable is canonical program.vscore.json in vscore/0.3 under normative Lean vscore-semantics/0.3 and data-pipeline/0.3, containing exactly one admitted typed entry solve of arity 1. Its typed input represents JSON {n,m,a,b} with integer fields and its result represents a JSON integer. Integers are unbounded mathematical integers. Strings contain Unicode scalar values and lexicographic comparison uses scalar codepoints.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 67, endByte := 137, origin := \"explicit\", interpretation := \"File and entry identity.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 138, endByte := 222, origin := \"explicit\", interpretation := \"Typed JSON representation.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 383, endByte := 467, origin := \"explicit\", interpretation := \"Integer input fields.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 615, endByte := 762, origin := \"explicit\", interpretation := \"Normative source and serialization profiles.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 970, endByte := 1041, origin := \"explicit\", interpretation := \"Unbounded integer semantics.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1042, endByte := 1131, origin := \"explicit\", interpretation := \"Unicode scalar string semantics.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1654, endByte := 1733, origin := \"explicit\", interpretation := \"Preserve D1 identity.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 2085, endByte := 3628, origin := \"explicit\", interpretation := \"Required declaration D1.\" }],\n  scope := [\"deliverable\", \"typed input and result\", \"normative source semantics\"],\n  dependencies := [],\n  acceptanceCriteria := [\"The canonical file has exactly one admitted typed entry named solve with arity 1.\", \"Input and result types represent the specified JSON object and integer result under data-pipeline/0.3.\", \"Source semantics follow normative Lean vscore-semantics/0.3, including unbounded integers and Unicode scalar string semantics.\"],\n  bindings := [\"VeriSlopAST.Input\", \"VeriSlopAST.solve\"] }\n\ndef «A1» : Entry := {\n  id := \"A1\",\n  revision := 1,\n  kind := \"precondition\",\n  role := \"assumption\",\n  statement := \"Supplied inputs satisfy the specified JSON schema: n,m,a,b are integers, 0 <= n <= 500 and m > 0. The signed integers a and b have no additional magnitude bound; magnitude 10^30 is permitted. No additional input preconditions apply.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 280, endByte := 337, origin := \"explicit\", interpretation := \"Supplier guarantees valid inputs.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 383, endByte := 467, origin := \"explicit\", interpretation := \"Exact input domain.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1132, endByte := 1222, origin := \"explicit\", interpretation := \"No extra preconditions.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1654, endByte := 1733, origin := \"explicit\", interpretation := \"Preserve A1 identity.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 2085, endByte := 3628, origin := \"explicit\", interpretation := \"Required assumption A1.\" }],\n  scope := [\"supplied input\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }],\n  acceptanceCriteria := [\"Every supplied input has the specified integer fields, 0 <= n <= 500 and m > 0.\", \"No additional magnitude bound or sign restriction is imposed on a or b.\", \"No additional precondition restricts the functional domain.\"],\n  bindings := [\"VeriSlopAST.valid_input\"] }\n\ndef «O1» : Entry := {\n  id := \"O1\",\n  revision := 1,\n  kind := \"postcondition\",\n  role := \"guarantee\",\n  statement := \"For every input satisfying A1, the actual admitted solve entry of arity 1 in canonical program.vscore.json returns the exact integer sum_{i=0}^{n-1} floor((a*i+b)/m), with floor toward negative infinity and empty sum 0. Universal source implementation refinement must connect this complete formula to that entry under normative Lean vscore-semantics/0.3 and data-pipeline/0.3. Its mixed source/value formal contract requires typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only for that exact file and entry.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 468, endByte := 518, origin := \"explicit\", interpretation := \"Universal floor-sum formula.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 519, endByte := 572, origin := \"explicit\", interpretation := \"Negative-infinity floor.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 573, endByte := 591, origin := \"explicit\", interpretation := \"Empty sum is zero.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1224, endByte := 1269, origin := \"explicit\", interpretation := \"Preserved examples.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1270, endByte := 1427, origin := \"explicit\", interpretation := \"Example values and universal refinement.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1552, endByte := 1653, origin := \"explicit\", interpretation := \"Unchanged functional meaning.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1654, endByte := 1733, origin := \"explicit\", interpretation := \"Preserve O1 identity.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1874, endByte := 1985, origin := \"explicit\", interpretation := \"Complete mathematical statement and universal refinement.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1986, endByte := 2026, origin := \"explicit\", interpretation := \"Examples cannot replace universal guarantees.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 2085, endByte := 3628, origin := \"explicit\", interpretation := \"Required O1 guarantee and requested assurance endpoint.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4060, endByte := 4264, origin := \"explicit\", interpretation := \"Exact source delivery.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4265, endByte := 4326, origin := \"explicit\", interpretation := \"Source facets in the formal contract.\" }, { documentR