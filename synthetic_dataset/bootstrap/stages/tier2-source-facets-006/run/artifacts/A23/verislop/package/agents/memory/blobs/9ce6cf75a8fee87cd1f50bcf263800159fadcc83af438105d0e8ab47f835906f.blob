tics/0.3 and data-pipeline/0.3. Its mixed source/value formal contract requires typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only for that exact file and entry.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 468, endByte := 518, origin := \"explicit\", interpretation := \"Universal floor-sum formula.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 519, endByte := 572, origin := \"explicit\", interpretation := \"Negative-infinity floor.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 573, endByte := 591, origin := \"explicit\", interpretation := \"Empty sum is zero.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1224, endByte := 1269, origin := \"explicit\", interpretation := \"Preserved examples.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1270, endByte := 1427, origin := \"explicit\", interpretation := \"Example values and universal refinement.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1552, endByte := 1653, origin := \"explicit\", interpretation := \"Unchanged functional meaning.\" }, { documentRef := \"tier2:tier2-source-facets-006:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1654,