import Std

-- BEGIN VERISLOP REGISTRY
-- Generated by `verislop formalize`. Typed obligation metadata: an index, never evidence.
namespace VeriSlop.Registry

structure SourceRef where
  documentRef : String
  documentHash : String
  startByte : Nat
  endByte : Nat
  origin : String
  interpretation : String

structure Dependency where
  id : String
  relation : String

structure Entry where
  id : String
  revision : Nat
  kind : String
  role : String
  statement : String
  required : Bool
  sourceRefs : List SourceRef
  scope : List String
  dependencies : List Dependency
  acceptanceCriteria : List String
  bindings : List String

def «D1» : Entry := {
  id := "D1",
  revision := 1,
  kind := "entity",
  role := "declaration",
  statement := "The solve input represents {events:[{group:string,time:int,value:int|null}],start:int,end:int,width:positive int,fill:'none'|'previous'}. Its result represents an array of {group:string,start:int,count:nonnegative int,value:int|null}. Integers are unbounded mathematical integers and strings are sequences of Unicode scalar values.",
  required := true,
  sourceRefs := [{ documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 155, endByte := 239, origin := "explicit", interpretation := "Typed JSON structure" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 265, endByte := 393, origin := "explicit", interpretation := "Input domain" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 957, endByte := 1019, origin := "explicit", interpretation := "Result structure" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 1435, endByte := 1506, origin := "explicit", interpretation := "Integer semantics" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 1507, endByte := 1596, origin := "explicit", interpretation := "String domain" }],
  scope := ["typed input and result"],
  dependencies := [],
  acceptanceCriteria := ["Typed representations preserve every specified field, array, nullable value and fill alternative under data-pipeline/0.3."],
  bindings := ["VeriSlopAST.Fill", "VeriSlopAST.Event", "VeriSlopAST.Input", "VeriSlopAST.Row", "VeriSlopAST.Stats", "VeriSlopAST.State", "VeriSlopAST.bucket_stats", "VeriSlopAST.group_rows", "VeriSlopAST.solve"] }

def «A1» : Entry := {
  id := "A1",
  revision := 1,
  kind := "precondition",
  role := "assumption",
  statement := "The caller supplies the specified typed input with width > 0 and start <= end; fill is either none or previous. There are no further input bounds or preconditions.",
  required := true,
  sourceRefs := [{ documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 265, endByte := 393, origin := "explicit", interpretation := "Specified input restrictions" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 1597, endByte := 1687, origin := "explicit", interpretation := "No additional restrictions" }],
  scope := ["caller input"],
  dependencies := [{ id := "D1", relation := "uses_definition" }],
  acceptanceCriteria := ["The invocation satisfies the declared input structure, width > 0 and start <= end, without additional restrictions on event multiplicity, integer magnitudes, times, values or Unicode strings."],
  bindings := ["VeriSlopAST.valid_input"] }

def «O1» : Entry := {
  id := "O1",
  revision := 1,
  kind := "postcondition",
  role := "guarantee",
  statement := "Deliver canonical program.vscore.json containing exactly one admitted typed entry solve of arity 1 under vscore/0.3, normative Lean vscore-semantics/0.3 and data-pipeline/0.3. For every input satisfying A1, its actual execution returns the complete grouped bucket aggregation defined by O2 through O6, preserving the specified typed input/output structure. This source implements that function universally and is typed-total, deterministic, input-preserving, without external I/O or floating point, pure data and restricted-runtime-only.",
  required := true,
  sourceRefs := [{ documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 79, endByte := 154, origin := "explicit", interpretation := "Canonical delivery and entry identity" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 155, endByte := 239, origin := "explicit", interpretation := "Typed interface" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 1080, endByte := 1227, origin := "explicit", interpretation := "Normative source and serialization" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 1228, endByte := 1293, origin := "explicit", interpretation := "Exact structure and ordering" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 1294, endByte := 1352, origin := "explicit", interpretation := "Execution properties" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 1353, endByte := 1434, origin := "explicit", interpretation := "Input preservation and effect restrictions" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 1435, endByte := 1506, origin := "explicit", interpretation := "Exact arithmetic" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 1597, endByte := 1687, origin := "explicit", interpretation := "Complete input domain" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 2649, endByte := 2760, origin := "explicit", interpretation := "Universal implementation refinement" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 5036, endByte := 5288, origin := "explicit", interpretation := "Source requirements apply to each guarantee" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 5289, endByte := 5458, origin := "explicit", interpretation := "Value theorems cannot replace source properties" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 5459, endByte := 5654, origin := "explicit", interpretation := "Complete functional source implementation" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 5655, endByte := 5715, origin := "explicit", interpretation := "Value facets required" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 5957, endByte := 8118, origin := "explicit", interpretation := "O1 source-facet policy" }],
  scope := ["delivered source", "every input satisfying A1"],
  dependencies := [{ id := "D1", relation := "uses_definition" }, { id := "A1", relation := "assumes" }],
  acceptanceCriteria := ["The canonical source has exactly one admitted entry named solve with arity 1 and the requested typed interface and serialization profile.", "For every allowed input, execution produces exactly the finite array specified by O2 through O6; examples alone do not establish universal refinement.", "For this guarantee the actual solve source satisfies typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only."],
  bindings := ["VeriSlopAST.complete_behavior"] }

def «O2» : Entry := {
  id := "O2",
  revision := 1,
  kind := "postcondition",
  role := "guarantee",
  statement := "For every allowed input, the group sequence used by solve is exactly the distinct group names from all input events, sorted lexicographically by Unicode scalar codepoints, including names whose events are all outside [start,end). The implementation of this formula is the arity-1 solve entry in canonical program.vscore.json and satisfies typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only.",
  required := true,
  sourceRefs := [{ documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 394, endByte := 501, origin := "explicit", interpretation := "Complete sorted group set" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 1507, endByte := 1596, origin := "explicit", interpretation := "Unicode comparison semantics" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 5036, endByte := 5288, origin := "explicit", interpretation := "Canonical source requirements" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 5459, endByte := 5654, origin := "explicit", interpretation := "Universal value implementation" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 5957, endByte := 8118, origin := "explicit", interpretation := "O2 source-facet policy" }],
  scope := ["every input satisfying A1", "group selection and ordering"],
  dependencies := [{ id := "D1", relation := "uses_definition" }, { id := "A1", relation := "assumes" }],
  acceptanceCriteria := ["The group sequence equals scalar-codepoint-lexicographic sort of the set of all event group names.", "No group is added, duplicated or omitted because its events are out of range.", "The actual specified solve source universally implements this formula with all seven required source properties."],
  bindings := ["VeriSlopAST.complete_behavior"] }

def «O3» : Entry := {
  id := "O3",
  revision := 1,
  kind := "postcondition",
  role := "guarantee",
  statement := "For every allowed input and every selected group, bucket starts are exactly b_k=start+k*width for natural k with b_k<end, in increasing k order. Bucket k covers [b_k,min(b_k+width,end)). No buckets exist when start=end. The arity-1 solve in canonical program.vscore.json universally implements this formula with typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only.",
  required := true,
  sourceRefs := [{ documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 502, endByte := 561, origin := "explicit", interpretation := "Bucket progression" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 562, endByte := 637, origin := "explicit", interpretation := "Strict upper bound and half-open clipped intervals" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 1435, endByte := 1506, origin := "explicit", interpretation := "Exact arithmetic" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 5036, endByte := 5288, origin := "explicit", interpretation := "Canonical source requirements" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 5459, endByte := 5654, origin := "explicit", interpretation := "Universal value implementation" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 5957, endByte := 8118, origin := "explicit", interpretation := "O3 source-facet policy" }],
  scope := ["every input satisfying A1", "every selected group"],
  dependencies := [{ id := "D1", relation := "uses_definition" }, { id := "A1", relation := "assumes" }],
  acceptanceCriteria := ["Each group has exactly one row for every natural k satisfying start+k*width<end and no other bucket starts.", "Intervals are left-inclusive and right-exclusive, with the final interval clipped at end.", "The actual specified solve source implements the formula universally with all seven source properties and exact unbounded integer arithmetic."],
  bindings := ["VeriSlopAST.complete_behavior"] }

def «O4» : Entry := {
  id := "O4",
  revision := 1,
  kind := "postcondition",
  role := "guarantee",
  statement := "For every allowed input, group g and bucket k, let M(g,k) be the multiset of input event occurrences with group=g, b_k<=time<min(b_k+width,end) and value non-null. The row count equals |M(g,k)| and its bucket sum equals the mathematical sum of their integer values. Null and out-of-range events contribute neither count nor sum; duplicate occurrences contribute separately. The arity-1 solve in canonical program.vscore.json universally implements these formulas with typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only.",
  required := true,
  sourceRefs := [{ documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 638, endByte := 672, origin := "explicit", interpretation := "Qualifying values and sum" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 673, endByte := 699, origin := "explicit", interpretation := "Count semantics" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 1020, endByte := 1078, origin := "explicit", interpretation := "Duplicate multiplicity" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 1435, endByte := 1506, origin := "explicit", interpretation := "Unbounded exact sums" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 5036, endByte := 5288, origin := "explicit", interpretation := "Canonical source requirements" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 5459, endByte := 5654, origin := "explicit", interpretation := "Universal value implementation" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 5957, endByte := 8118, origin := "explicit", interpretation := "O4 source-facet policy" }],
  scope := ["every input satisfying A1", "every emitted bucket"],
  dependencies := [{ id := "D1", relation := "uses_definition" }, { id := "A1", relation := "assumes" }],
  acceptanceCriteria := ["count is exactly the number of qualifying non-null occurrences and sum is their exact integer sum.", "Repeated identical events are counted and summed with their full multiplicity.", "A bucket with only null values has count zero.", "The actual specified solve source universally implements both formulas with all seven required source properties."],
  bindings := ["VeriSlopAST.complete_behavior"] }

def «O5» : Entry := {
  id := "O5",
  revision := 1,
  kind := "postcondition",
  role := "guarantee",
  statement := "For every allowed input and row (g,k), if count(g,k)>0 then value(g,k)=sum(g,k). If count(g,k)=0 and fill=none then value(g,k)=null. If count(g,k)=0 and fill=previous, let j be the greatest index less than k with count(g,j)>0: value(g,k)=sum(g,j) if such j exists, otherwise null. Previous state is group-local, initially null, updated by every nonempty bucket including a zero sum, unchanged by empty buckets, and never seeded by events before start. The arity-1 solve in canonical program.vscore.json universally implements these formulas with typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only.",
  required := true,
  sourceRefs := [{ documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 700, endByte := 759, origin := "explicit", interpretation := "Nonempty bucket and previous update" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 760, endByte := 879, origin := "explicit", interpretation := "Both empty-bucket branches" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 880, endByte := 915, origin := "explicit", interpretation := "Previous state persistence" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 916, endByte := 956, origin := "explicit", interpretation := "No pre-start seeding" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 1020, endByte := 1078, origin := "explicit", interpretation := "Zero sum remains a previous value" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 5036, endByte := 5288, origin := "explicit", interpretation := "Canonical source requirements" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 5459, endByte := 5654, origin := "explicit", interpretation := "Universal value implementation" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 5957, endByte := 8118, origin := "explicit", interpretation := "O5 source-facet policy" }],
  scope := ["every input satisfying A1", "both fill modes", "every emitted bucket"],
  dependencies := [{ id := "D1", relation := "uses_definition" }, { id := "A1", relation := "assumes" }],
  acceptanceCriteria := ["Nonempty buckets return their sum in either fill mode.", "Empty buckets follow exactly the none and previous branches, including null before the first nonempty bucket.", "Empty buckets do not reset the remembered sum; zero is remembered as a value; prior groups and pre-start events cannot seed it.", "The actual specified solve source universally implements the complete causal filling formula with all seven required source properties."],
  bindings := ["VeriSlopAST.complete_behavior"] }

def «O6» : Entry := {
  id := "O6",
  revision := 1,
  kind := "postcondition",
  role := "guarantee",
  statement := "For every allowed input, solve returns exactly the concatenation, over the O2 group sequence, of the O3 bucket sequence for that group, with each row {group:g,start:b_k,count:count(g,k),value:value(g,k)} as defined by O4 and O5. There are no extra or omitted rows or fields. The arity-1 solve in canonical program.vscore.json preserves this typed structure and exact order under data-pipeline/0.3 and universally implements the formula with typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only.",
  required := true,
  sourceRefs := [{ documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 957, endByte := 1019, origin := "explicit", interpretation := "Exact row structure and ordering" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 1228, endByte := 1293, origin := "explicit", interpretation := "Structure and order preservation" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 5036, endByte := 5288, origin := "explicit", interpretation := "Canonical source requirements" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 5459, endByte := 5654, origin := "explicit", interpretation := "Universal value implementation" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 5957, endByte := 8118, origin := "explicit", interpretation := "O6 source-facet policy" }],
  scope := ["every input satisfying A1", "complete output array"],
  dependencies := [{ id := "D1", relation := "uses_definition" }, { id := "A1", relation := "assumes" }],
  acceptanceCriteria := ["Rows are in Unicode scalar lexicographic group order, then increasing bucket start order.", "Every row has the specified group, start, count and nullable integer value.", "Empty event arrays and start=end produce empty output arrays.", "The actual specified solve source implements the complete output formula universally with all seven required source properties."],
  bindings := ["VeriSlopAST.complete_behavior"] }

def «O7» : Entry := {
  id := "O7",
  revision := 1,
  kind := "postcondition",
  role := "guarantee",
  statement := "The universally refining arity-1 solve in canonical program.vscore.json preserves both public examples exactly: events (a,0,2),(a,1,-2), start=0,end=5,width=2,fill=previous return rows (a,0,2,0),(a,2,0,0),(a,4,0,0); event (z,-1,9), start=0,end=1,width=2,fill=previous returns (z,0,0,null). These examples supplement the complete universal functional specification. This source satisfies typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only.",
  required := true,
  sourceRefs := [{ documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 1689, endByte := 1734, origin := "explicit", interpretation := "Preserved public examples" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 1735, endByte := 2282, origin := "explicit", interpretation := "Exact example results and universal refinement" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 2761, endByte := 2801, origin := "explicit", interpretation := "Examples do not replace universal guarantees" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 5036, endByte := 5288, origin := "explicit", interpretation := "Canonical source requirements" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 5459, endByte := 5654, origin := "explicit", interpretation := "Universal value implementation" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 5957, endByte := 8118, origin := "explicit", interpretation := "O7 source-facet policy" }],
  scope := ["public examples", "universal source refinement"],
  dependencies := [{ id := "D1", relation := "uses_definition" }, { id := "A1", relation := "assumes" }],
  acceptanceCriteria := ["Both example inputs return exactly the original ordered JSON output arrays.", "Universal implementation refinement covers all allowed inputs rather than only these examples.", "The actual specified solve source satisfies all seven required source properties for this guarantee."],
  bindings := ["VeriSlopAST.complete_behavior"] }

def «I1» : Entry := {
  id := "I1",
  revision := 1,
  kind := "invariant",
  role := "guarantee",
  statement := "The canonical arity-1 solve source in program.vscore.json maintains typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only throughout admitted execution under vscore/0.3 and its normative semantics. The causal aggregation requirements remain preserved by O4 and O5: previous is the latest same-group nonempty bucket sum, empty buckets never reset it, pre-start events never seed it, zero sums remain values, and duplicates retain multiplicity. I1 is a source-only operational policy row; no separate value equality substitutes for its source requirements.",
  required := true,
  sourceRefs := [{ documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 700, endByte := 759, origin := "explicit", interpretation := "Causal update" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 880, endByte := 915, origin := "explicit", interpretation := "State persistence" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 916, endByte := 956, origin := "explicit", interpretation := "Causal boundary" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 1020, endByte := 1078, origin := "explicit", interpretation := "Zero and duplicate behavior" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 1294, endByte := 1352, origin := "explicit", interpretation := "Total pure deterministic execution" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 1353, endByte := 1434, origin := "explicit", interpretation := "Immutable input and effect restrictions" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 1435, endByte := 1506, origin := "explicit", interpretation := "Exact integer semantics" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 5716, endByte := 5869, origin := "explicit", interpretation := "Source-only operational classification" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 5957, endByte := 8118, origin := "explicit", interpretation := "I1 canonical source-facet policy" }],
  scope := ["entire admitted solve execution"],
  dependencies := [{ id := "D1", relation := "uses_definition" }],
  acceptanceCriteria := ["The specified source and entry maintain all seven closed source properties under the normative admitted execution semantics.", "Input data remain unchanged throughout execution.", "Causal value behavior remains required under O4 and O5 rather than being discarded through the source-only classification."],
  bindings := ["VeriSlopAST.source_properties"] }

def «S1» : Entry := {
  id := "S1",
  revision := 1,
  kind := "safety_property",
  role := "guarantee",
  statement := "The delivered program.vscore.json has the specified admitted typed arity-1 solve entry, executed solely within canonical vscore/0.3 under normative Lean vscore-semantics/0.3 and data-pipeline/0.3. It is typed-total and deterministic, preserves input, performs no external I/O, uses no external-effect constructors or floating point, operates on pure data and uses only the restricted runtime. All arithmetic is unbounded mathematical integer arithmetic. S1 is a source-only operational guarantee.",
  required := true,
  sourceRefs := [{ documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 79, endByte := 154, origin := "explicit", interpretation := "Pure admitted typed entry" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 240, endByte := 264, origin := "explicit", interpretation := "No external I/O" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 1080, endByte := 1227, origin := "explicit", interpretation := "Restricted normative runtime" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 1294, endByte := 1352, origin := "explicit", interpretation := "Execution properties" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 1353, endByte := 1434, origin := "explicit", interpretation := "Input and effect safety" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 1435, endByte := 1506, origin := "explicit", interpretation := "Exact non-floating arithmetic" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 5289, endByte := 5458, origin := "explicit", interpretation := "Source safety cannot be replaced by value equalities" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 5716, endByte := 5869, origin := "explicit", interpretation := "Source-only classification" }, { documentRef := "tier2:tier2-source-facets-016:D21", documentHash := "sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2", startByte := 5957, endByte := 8118, origin := "explicit", interpretation := "S1 source-facet policy" }],
  scope := ["delivered source and every admitted execution"],
  dependencies := [{ id := "D1", relation := "uses_definition" }],
  acceptanceCriteria := ["The actual canonical solve source satisfies typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only.", "Execution has no external effects and cannot mutate its input.", "Arithmetic preserves exact mathematical integer semantics without overflow or floating-point conversion.", "A value equality or result-existence theorem does not replace these source requirements."],
  bindings := ["VeriSlopAST.source_properties"] }

