{"obligations":[{"id":"D1","revision":1,"kind":"entity","role":"declaration","statement":"The input is an object with events, start, end, width and fill; each event has a string group, integer time and integer or null value. start and end are integers, width is a positive integer, fill is 'none' or 'previous', and start <= end.","required":true,"scope":["specified input domain"],"dependencies":[],"acceptance_criteria":["The declared input domain matches the specified field names, types and bounds."],"sources":[{"clause_id":"C5","origin":"explicit","interpretation":"Specified input structure and domain."}]},{"id":"O1","revision":1,"kind":"postcondition","role":"guarantee","statement":"Provide a pure deterministic Python 3 solve(data) function in solution.py accepting JSON-compatible Python input and returning a JSON-serializable value.","required":true,"scope":["function interface and execution"],"dependencies":[],"acceptance_criteria":["solution.py exposes solve(data).","Repeated calls with equivalent inputs produce identical results without observable side effects.","The result is JSON-serializable."],"sources":[{"clause_id":"C2","origin":"explicit","interpretation":"Function location, name and purity."},{"clause_id":"C3","origin":"explicit","interpretation":"JSON-compatible interface."},{"clause_id":"C17","origin":"explicit","interpretation":"Python 3, purity and determinism."},{"clause_id":"C19","origin":"explicit","interpretation":"JSON input and serializable output."}]},{"id":"S1","revision":1,"kind":"safety_property","role":"guarantee","statement":"Use only the Python standard library and perform no external I/O.","required":true,"scope":["implementation and all solve executions"],"dependencies":[],"acceptance_criteria":["No third-party library is required.","Execution performs no external I/O."],"sources":[{"clause_id":"C4","origin":"explicit","interpretation":"Library and I/O restrictions."},{"clause_id":"C18","origin":"explicit","interpretation":"Repeated library and I/O restrictions."}]},{"id":"O2","revision":1,"kind":"postcondition","role":"guarantee","statement":"Determine groups from every event's group name, deduplicate names and sort them lexicographically, retaining groups whose events are all outside the requested range.","required":true,"scope":["all input events"],"dependencies":[{"id":"D1","relation":"uses_definition"}],"acceptance_criteria":["Groups equal the lexicographically sorted set of group names in events.","Out-of-range events still contribute group names.","An empty events list yields no groups and an empty result."],"sources":[{"clause_id":"C6","origin":"explicit","interpretation":"Group membership and ordering."}]},{"id":"O3","revision":1,"kind":"postcondition","role":"guarantee","statement":"For each group generate bucket starts start + k*width for all nonnegative integers k whose starts are strictly below end. Each bucket covers [bucketStart,min(bucketStart+width,end)).","required":true,"scope":["each group and requested interval"],"dependencies":[{"id":"D1","relation":"uses_definition"},{"id":"O2","relation":"uses_proof"}],"acceptance_criteria":["Every group has exactly the specified ascending bucket starts.","The final bucket is clipped at end.","start = end yields no buckets.","A time at a bucket's upper endpoint belongs to the following bucket if present; a time equal to end belongs to no bucket."],"sources":[{"clause_id":"C7","origin":"explicit","interpretation":"Bucket start progression for each group."},{"clause_id":"C8","origin":"explicit","interpretation":"Strict endpoint limit and half-open bucket coverage."}]},{"id":"O4","revision":1,"kind":"postcondition","role":"guarantee","statement":"For each bucket sum and count all events of its group whose times fall in the bucket and whose values are non-null. Count each duplicate event occurrence separately.","required":true,"scope":["each generated bucket"],"dependencies":[{"id":"O3","relation":"uses_proof"},{"id":"D1","relation":"uses_definition"}],"acceptance_criteria":["count equals the number of qualifying event occurrences.","sum equals the exact integer sum of qualifying values.","Null values and times outside [start,end) contribute neither sum nor count.","Duplicate occurrences contribute independently.","A bucket containing only null-valued events has count zero."],"sources":[{"clause_id":"C9","origin":"explicit","interpretation":"Non-null in-range aggregation."},{"clause_id":"C10","origin":"explicit","interpretation":"Count uses the same qualifying values."},{"clause_id":"C16","origin":"explicit","interpretation":"Duplicates are counted."}]},{"id":"I1","revision":1,"kind":"invariant","role":"guarantee","statement":"Within each group, previous begins unset and tracks the sum of the latest earlier bucket with count greater than zero. Processing a nonempty bucket sets its value and previous to its sum, including zero; empty buckets preserve previous. Events before start never initialize previous.","required":true,"scope":["ascending bucket processing within each group"],"dependencies":[{"id":"O4","relation":"uses_proof"}],"acceptance_criteria":["previous is initially unset independently for each group.","A count-positive bucket outputs its sum and updates previous even when its sum is zero.","A count-zero bucket leaves previous unchanged.","Pre-start events cannot seed previous."],"sources":[{"clause_id":"C11","origin":"explicit","interpretation":"Nonempty bucket value and previous update."},{"clause_id":"C13","origin":"explicit","interpretation":"Empty buckets preserve previous."},{"clause_id":"C14","origin":"explicit","interpretation":"Pre-start events cannot seed previous."},{"clause_id":"C16","origin":"explicit","interpretation":"Zero is a valid previous sum."}]},{"id":"O5","revision":1,"kind":"postcondition","role":"guarantee","statement":"An empty bucket outputs null under fill 'none'. Under fill 'previous', it outputs the latest previous nonempty bucket sum for the same group, or null if none exists.","required":true,"scope":["buckets with count zero"],"dependencies":[{"id":"D1","relation":"uses_definition"},{"id":"I1","relation":"uses_proof"}],"acceptance_criteria":["fill 'none' produces null for every empty bucket.","fill 'previous' uses the latest preceding nonempty bucket sum.","Empty buckets before the first nonempty bucket output null.","A preceding sum of zero fills subsequent empty buckets with zero."],"sources":[{"clause_id":"C12","origin":"explicit","interpretation":"Fill modes and initial null behavior."}]},{"id":"O6","revision":1,"kind":"postcondition","role":"guarantee","statement":"Return a list of objects with exactly group, start, count and value fields, one per generated group bucket, ordered first by lexicographic group and then ascending bucket start.","required":true,"scope":["returned value"],"dependencies":[{"id":"O2","relation":"uses_proof"},{"id":"O3","relation":"uses_proof"},{"id":"O4","relation":"uses_proof"},{"id":"I1","relation":"uses_proof"},{"id":"O5","relation":"uses_proof"}],"acceptance_criteria":["Each record has the specified group name, bucket start, qualifying count and computed value.","The list preserves group then bucket ordering.","The specified input and output structures are preserved."],"sources":[{"clause_id":"C15","origin":"explicit","interpretation":"Output record structure and ordering."},{"clause_id":"C20","origin":"explicit","interpretation":"Exact structure and ordering preservation."}]},{"id":"O7","revision":1,"kind":"postcondition","role":"guarantee","statement":"Match both public examples: the a-group zero-sum bucket has count 2 and value 0 followed by empty buckets at starts 2 and 4 with value 0; the z-group with only a pre-start event has a single bucket at start 0 with count 0 and value null.","required":true,"scope":["public example inputs"],"dependencies":[{"id":"O6","relation":"uses_proof"}],"acceptance_criteria":["The first example returns exactly the three specified a-group records.","The second example returns exactly the specified z-group record."],"sources":[{"clause_id":"C21","origin":"explicit","interpretation":"Concrete zero-sum carry-forward and pre-start exclusion examples."}]}],"category_review":{"entities":"Specified event input domain and output bucket records.","preconditions":"No separate caller assumptions stated; the input domain is declared in D1.","postconditions":"Pure deterministic solve interface, complete group and bucket generation, aggregation, filling, output order and examples.","invariants":"Per-group causal previous value persists across empty buckets and includes zero sums.","safety_properties":"Standard library only and no external I/O.","liveness_properties":"None stated.","resource_constraints":"No quantitative resource constraints stated.","error_semantics":"No behavior outside the specified input domain stated.","explicit_non_goals":"None stated.","ambiguities":"None within the specified domain."},"clauses":[{"clause_id":"C1","disposition":"context","refs":[],"note":"Task title identifies grouped aggregation with causal filling."},{"clause_id":"C2","disposition":"obligations","refs":["O1"],"note":""},{"clause_id":"C3","disposition":"obligations","refs":["O1"],"note":""},{"clause_id":"C4","disposition":"obligations","refs":["S1"],"note":""},{"clause_id":"C5","disposition":"obligations","refs":["D1"],"note":""},{"clause_id":"C6","disposition":"obligations","refs":["O2"],"note":""},{"clause_id":"C7","disposition":"obligations","refs":["O3"],"note":""},{"clause_id":"C8","disposition":"obligations","refs":["O3"],"note":""},{"clause_id":"C9","disposition":"obligations","refs":["O4"],"note":""},{"clause_id":"C10","disposition":"obligations","refs":["O4"],"note":""},{"clause_id":"C11","disposition":"obligations","refs":["I1"],"note":""},{"clause_id":"C12","disposition":"obligations","refs":["O5"],"note":""},{"clause_id":"C13","disposition":"obligations","refs":["I1"],"note":""},{"clause_id":"C14","disposition":"obligations","refs":["I1"],"note":""},{"clause_id":"C15","disposition":"obligations","refs":["O6"],"note":""},{"clause_id":"C16","disposition":"obligations","refs":["O4","I1"],"note":""},{"clause_id":"C17","disposition":"obligations","refs":["O1"],"note":""},{"clause_id":"C18","disposition":"obligations","refs":["S1"],"note":""},{"clause_id":"C19","disposition":"obligations","refs":["O1"],"note":""},{"clause_id":"C20","disposition":"obligations","refs":["O6"],"note":""},{"clause_id":"C21","disposition":"obligations","refs":["O7"],"note":""}],"assumptions":[],"ambiguities":[],"selected_defaults":[]}