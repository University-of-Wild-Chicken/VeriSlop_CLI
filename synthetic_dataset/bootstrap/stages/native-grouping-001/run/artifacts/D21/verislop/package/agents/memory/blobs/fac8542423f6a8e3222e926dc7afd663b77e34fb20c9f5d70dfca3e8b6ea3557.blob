FROZEN INTERPRETED OBLIGATIONS (data):
[
 {
  "id": "D1",
  "kind": "entity",
  "role": "declaration",
  "statement": "The input is an object with events, start, end, width and fill; each event has a string group, integer time and integer or null value. start and end are integers, width is a positive integer, fill is 'none' or 'previous', and start <= end.",
  "required": true,
  "dependencies": [],
  "acceptance_criteria": [
   "The declared input domain matches the specified field names, types and bounds."
  ],
  "blocked_by": []
 },
 {
  "id": "O1",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "Provide a pure deterministic Python 3 solve(data) function in solution.py accepting JSON-compatible Python input and returning a JSON-serializable value.",
  "required": true,
  "dependencies": [],
  "acceptance_criteria": [
   "solution.py exposes solve(data).",
   "Repeated calls with equivalent inputs produce identical results without observable side effects.",
   "The result is JSON-serializable."
  ],
  "blocked_by": []
 },
 {
  "id": "O2",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "Determine groups from every event's group name, deduplicate names and sort them lexicographically, retaining groups whose events are all outside the requested range.",
  "required": true,
  "dependencies": [
   {
    "id": "D1",
    "relation": "uses_definition"
   }
  ],
  "acceptance_criteria": [
   "Groups equal the lexicographically sorted set of group names in events.",
   "Out-of-range events still contribute group names.",
   "An empty events list yields no groups and an empty result."
  ],
  "blocked_by": []
 },
 {
  "id": "O3",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "For each group generate bucket starts start + k*width for all nonnegative integers k whose starts are strictly below end. Each bucket covers [bucketStart,min(bucketStart+width,end)).",
  "required": true,
  "dependencies": [
   {
    "id": "D1",
    "relation": "uses_definition"
   },
   {
    "id": "O2",
    "relation": "uses_proof"
   }
  ],
  "acceptance_criteria": [
   "Every group has exactly the specified ascending bucket starts.",
   "The final bucket is clipped at end.",
   "start = end yields no buckets.",
   "A time at a bucket's upper endpoint belongs to the following bucket if present; a time equal to end belongs to no bucket."
  ],
  "blocked_by": []
 },
 {
  "id": "O4",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "For each bucket sum and count all events of its group whose times fall in the bucket and whose values are non-null. Count each duplicate event occurrence separately.",
  "required": true,
  "dependencies": [
   {
    "id": "O3",
    "relation": "uses_proof"
   },
   {
    "id": "D1",
    "relation": "uses_definition"
   }
  ],
  "acceptance_criteria": [
   "count equals the number of qualifying event occurrences.",
   "sum equals the exact integer sum of qualifying values.",
   "Null values and times outside [start,end) contribute neither sum nor count.",
   "Duplicate occurrences contribute independently.",
   "A bucket containing only null-valued events has count zero."
  ],
  "blocked_by": []
 },
 {
  "id": "O5",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "An empty bucket outputs null under fill 'none'. Under fill 'previous', it outputs the latest previous nonempty bucket sum for the same group, or null if none exists.",
  "required": true,
  "dependencies": [
   {
    "id": "D1",
    "relation": "uses_definition"
   },
   {
    "id": "I1",
    "relation": "uses_proof"
   }
  ],
  "acceptance_criteria": [
   "fill 'none' produces null for every empty bucket.",
   "fill 'previous' uses the latest preceding nonempty bucket sum.",
   "Empty buckets before the first nonempty bucket output null.",
   "A preceding sum of zero fills subsequent empty buckets with zero."
  ],
  "blocked_by": []
 },
 {
  "id": "O6",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "Return a list of objects with exactly group, start, count and value fields, one per generated group bucket, ordered first by lexicographic group and then ascending bucket start.",
  "required": true,
  "dependencies": [
   {
    "id": "O2",
    "relation": "uses_proof"
   },
   {
    "id": "O3",
    "relation": "uses_proof"
   },
   {
    "id": "O4",
    "relation": "uses_proof"
   },
   {
    "id": "I1",
    "relation": "uses_proof"
   },
   {
    "id": "O5",
    "relation": "uses_proof"
   }
  ],
  "acceptance_criteria": [
   "Each record has the specified group name, bucket start, qualifying count and computed value.",
   "The list preserves group then bucket ordering.",
   "The specified input and output structures are preserved."
  ],
  "blocked_by": []
 },
 {
  "id": "O7",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "Match both public examples: the a-group zero-sum bucket has count 2 and value 0 followed by empty buckets at starts 2 and 4 with value 0; the z-group with only a pre-start event has a single bucket at start 0 with count 0 and value null.",
  "required": true,
  "dependencies": [
   {
    "id": "O6",
    "relation": "uses_proof"
   }
  ],
  "acceptance_criteria": [
   "The first example returns exactly the three specified a-group records.",
   "The second example returns exactly the specified z-group record."
  ],
  "blocked_by": []
 },
 {
  "id": "I1",
  "kind": "invariant",
  "role": "guarantee",
  "statement": "Within each group, previous begins unset and tracks the sum of the latest earlier bucket with count greater than zero. Processing a nonempty bucket sets its value and previous to its sum, including zero; empty buckets preserve previous. Events before start never initialize previous.",
  "required": true,
  "dependencies": [
   {
    "id": "O4",
    "relation": "uses_proof"
   }
  ],
  "acceptance_criteria": [
   "previous is initially unset independently for each group.",
   "A count-positive bucket outputs its sum and updates previous even when its sum is zero.",
   "A count-zero bucket leaves previous unchanged.",
   "Pre-start events cannot seed previous."
  ],
  "blocked_by": []
 },
 {
  "id": "S1",
  "kind": "safety_property",
  "role": "guarantee",
  "statement": "Use only the Python standard library and perform no external I/O.",
  "required": true,
  "dependencies": [],
  "acceptance_criteria": [
   "No third-party library is required.",
   "Execution performs no external I/O."
  ],
  "blocked_by": []
 }
]
