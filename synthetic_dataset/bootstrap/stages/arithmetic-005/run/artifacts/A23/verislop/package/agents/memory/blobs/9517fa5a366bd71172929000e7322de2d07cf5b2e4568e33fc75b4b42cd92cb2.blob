inism and Python 3 implementation\" }],\n  scope := [\"implementation and function invocations\"],\n  dependencies := [],\n  acceptanceCriteria := [\"solution.py exposes the single requested solve(data) function.\", \"Repeated calls with equal inputs return equal results.\", \"The function has no observable side effects.\"],\n  bindings := [\"VeriSlopAST.solve_contract\"] }\n\ndef «O3» : Entry := {\n  id := \"O3\",\n  revision := 1,\n  kind := \"postcondition\",\n  role := \"guarantee\",\n  statement := \"The public examples return -4 for {a:-2,b:1,m:3,n:4} and 0 for {a:100,b:-99,m:7,n:0}; the same specified behavior applies to held-out valid inputs.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 870, endByte := 1052, origin := \"explicit\", interpretation := \"Public example results and additional held-out cases\" }],\n  scope := [\"public examples and held-out valid inputs\"],\n  dependencies := [{ id := \"O1\", relation := \"uses_proof\" }],\n  acceptanceCriteria := [\"solve({\\\"a\\\":-2,\\\"b\\\":1,\\\"m\\\":3,\\\"n\\\":4}) returns -4.\", \"solve({\\\"a\\\":100,\\\"b\\\":-99,\\\"m\\\":7,\\\"n\\\":0}) returns 0.\", \"Implementation satisfies the formula beyond the public examples.\"],\n  bindings := [\"VeriSlopAST.public_examples\"] }\n\ndef «S1» : Entry := {\n  id := \"S1\",\n  revision := 1,\n  kind := \"safety_property\",\n  role := \"guarantee\",\n  statement := \"Use only the Python 3 standard library, perform no external I/O, and do not read benchmark files.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 176, endByte := 211, origin := \"explicit\", interpretation := \"Standard-library restriction\" }, { documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b