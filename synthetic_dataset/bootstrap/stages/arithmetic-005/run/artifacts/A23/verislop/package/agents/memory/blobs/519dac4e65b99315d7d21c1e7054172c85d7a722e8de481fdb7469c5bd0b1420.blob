{"obligations":[{"id":"D1","revision":1,"kind":"entity","role":"declaration","statement":"The input is a JSON object with integer fields n, m, a, b; the output is a JSON-serializable integer scalar.","required":true,"scope":["input and output"],"dependencies":[],"acceptance_criteria":["Input fields represent n, m, a and b.","Output is the integer sum itself, without an additional wrapper."],"sources":[{"clause_id":"C3","origin":"explicit","interpretation":"JSON-compatible interface"},{"clause_id":"C8","origin":"explicit","interpretation":"Named integer input fields"},{"clause_id":"C15","origin":"explicit","interpretation":"JSON-serializable return value"},{"clause_id":"C16","origin":"explicit","interpretation":"Preserve the specified object input and scalar output structure"}]},{"id":"A1","revision":1,"kind":"precondition","role":"assumption","statement":"Supplied inputs satisfy the schema: integer n with 0<=n<=500, positive integer m, and arbitrary signed integers a and b, including magnitudes of 10^30.","required":true,"scope":["supplied inputs"],"dependencies":[{"id":"D1","relation":"uses_definition"}],"acceptance_criteria":["Each supplied input has the stated integer fields and satisfies 0<=n<=500 and m>0.","No additional restriction is imposed on the sign or magnitude of a and b."],"sources":[{"clause_id":"C6","origin":"explicit","interpretation":"Supplier guarantees schema and bounds"},{"clause_id":"C8","origin":"explicit","interpretation":"Specified numeric domain"}]},{"id":"O1","revision":1,"kind":"postcondition","role":"guarantee","statement":"For every valid input, return exactly the sum over i=0 through n-1 of floor((a*i+b)/m), where floor rounds toward negative infinity; return zero when n=0.","required":true,"scope":["all inputs satisfying A1"],"dependencies":[{"id":"D1","relation":"uses_definition"},{"id":"A1","relation":"assumes"}],"acceptance_criteria":["The returned integer equals the mathematical sum for every valid input.","Negative quotients are rounded toward negative infinity rather than truncated toward zero.","For n=0 the returned integer is 0.","Terms correspond to indices 0,1,...,n-1 in the specified order."],"sources":[{"clause_id":"C9","origin":"explicit","interpretation":"Exact floor-sum formula and index range"},{"clause_id":"C10","origin":"explicit","interpretation":"Signed floor semantics"},{"clause_id":"C11","origin":"explicit","interpretation":"Empty sum"},{"clause_id":"C16","origin":"explicit","interpretation":"Specified ordering"}]},{"id":"O2","revision":1,"kind":"postcondition","role":"guarantee","statement":"Provide a single pure deterministic Python 3 function solve(data) in solution.py.","required":true,"scope":["implementation and function invocations"],"dependencies":[],"acceptance_criteria":["solution.py exposes the single requested solve(data) function.","Repeated calls with equal inputs return equal results.","The function has no observable side effects."],"sources":[{"clause_id":"C2","origin":"explicit","interpretation":"Required file and single function interface"},{"clause_id":"C13","origin":"explicit","interpretation":"Purity, determinism and Python 3 implementation"}]},{"id":"S1","revision":1,"kind":"safety_property","role":"guarantee","statement":"Use only the Python 3 standard library, perform no external I/O, and do not read benchmark files.","required":true,"scope":["implementation and execution"],"dependencies":[],"acceptance_criteria":["No dependency outside the Python 3 standard library is used.","Execution performs no external input or output.","Benchmark files are never read."],"sources":[{"clause_id":"C4","origin":"explicit","interpretation":"Standard-library restriction"},{"clause_id":"C5","origin":"explicit","interpretation":"External I/O and benchmark access prohibitions"},{"clause_id":"C14","origin":"explicit","interpretation":"Repeated library and I/O restrictions"}]},{"id":"S2","revision":1,"kind":"safety_property","role":"guarantee","statement":"Compute the result without floating-point arithmetic.","required":true,"scope":["numeric computation"],"dependencies":[],"acceptance_criteria":["No floating-point conversion or arithmetic is used to evaluate the sum or its terms.","Large signed integer inputs retain exact arithmetic semantics."],"sources":[{"clause_id":"C12","origin":"explicit","interpretation":"Floating-point prohibition"},{"clause_id":"C9","origin":"explicit","interpretation":"Exact result requirement"}]},{"id":"N1","revision":1,"kind":"explicit_non_goal","role":"exclusion","statement":"Behavior for malformed inputs is outside the required scope.","required":true,"scope":["inputs violating the specified schema or bounds"],"dependencies":[],"acceptance_criteria":["No validation or result behavior is required for malformed inputs."],"sources":[{"clause_id":"C7","origin":"explicit","interpretation":"Explicit malformed-input exclusion"}]},{"id":"O3","revision":1,"kind":"postcondition","role":"guarantee","statement":"The public examples return -4 for {a:-2,b:1,m:3,n:4} and 0 for {a:100,b:-99,m:7,n:0}; the same specified behavior applies to held-out valid inputs.","required":true,"scope":["public examples and held-out valid inputs"],"dependencies":[{"id":"O1","relation":"uses_proof"}],"acceptance_criteria":["solve({\"a\":-2,\"b\":1,\"m\":3,\"n\":4}) returns -4.","solve({\"a\":100,\"b\":-99,\"m\":7,\"n\":0}) returns 0.","Implementation satisfies the formula beyond the public examples."],"sources":[{"clause_id":"C17","origin":"explicit","interpretation":"Public example results and additional held-out cases"}]}],"category_review":{"entities":"Object input with four integer fields and integer scalar output.","preconditions":"Explicit supplier guarantee of schema and bounds.","postconditions":"Exact signed floor sum, zero empty sum, specified interface, purity, determinism and public examples.","invariants":"None separately stated.","safety_properties":"Standard library only, no external I/O or benchmark reads, no floating-point arithmetic.","liveness_properties":"None separately stated.","resource_constraints":"None stated.","error_semantics":"Malformed-input behavior explicitly excluded.","explicit_non_goals":"Malformed-input behavior.","ambiguities":"None; scalar output makes collection ordering inapplicable."},"clauses":[{"clause_id":"C1","disposition":"context","refs":[],"note":"Task title identifies the signed arithmetic floor-sum kernel."},{"clause_id":"C2","disposition":"obligations","refs":["O2"],"note":""},{"clause_id":"C3","disposition":"obligations","refs":["D1"],"note":""},{"clause_id":"C4","disposition":"obligations","refs":["S1"],"note":""},{"clause_id":"C5","disposition":"obligations","refs":["S1"],"note":""},{"clause_id":"C6","disposition":"obligations","refs":["A1"],"note":""},{"clause_id":"C7","disposition":"exclusion","refs":["N1"],"note":""},{"clause_id":"C8","disposition":"obligations","refs":["D1","A1"],"note":""},{"clause_id":"C9","disposition":"obligations","refs":["O1"],"note":""},{"clause_id":"C10","disposition":"obligations","refs":["O1"],"note":""},{"clause_id":"C11","disposition":"obligations","refs":["O1"],"note":""},{"clause_id":"C12","disposition":"obligations","refs":["S2"],"note":""},{"clause_id":"C13","disposition":"obligations","refs":["O2"],"note":""},{"clause_id":"C14","disposition":"obligations","refs":["S1"],"note":""},{"clause_id":"C15","disposition":"obligations","refs":["D1"],"note":""},{"clause_id":"C16","disposition":"obligations","refs":["D1","O1"],"note":""},{"clause_id":"C17","disposition":"obligations","refs":["O3"],"note":""}],"assumptions":[{"id":"A1","supplied_by":"input supplier","discharged_at":"Each solve(data) invocation, by supplying inputs satisfying the stated schema and bounds."}],"ambiguities":[],"selected_defaults":[]}