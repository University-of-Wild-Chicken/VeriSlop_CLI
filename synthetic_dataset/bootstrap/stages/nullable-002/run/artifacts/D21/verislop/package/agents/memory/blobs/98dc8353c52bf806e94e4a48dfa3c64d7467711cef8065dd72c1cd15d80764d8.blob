 {
  "id": "O1",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "Provide a pure deterministic Python 3 solve(data) function in solution.py receiving JSON-compatible Python values and returning a JSON-serializable value.",
  "required": true,
  "dependencies": [],
  "acceptance_criteria": [
   "solution.py exposes solve(data) in Python 3.",
   "Repeated calls with identical input yield identical results.",
   "The function is pure and returns JSON-serializable output."
  ],
  "blocked_by": []
 },
 {
  "id": "O2",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "Enumerate all distinct event group names lexicographically, including groups having no in-range events.",
  "required": true,
  "dependencies": [
   {
    "id": "D1",
    "relation": "uses_definition"
   }
  ],
  "acceptance_criteria": [
   "Groups equal sorted distinct names from all events.",
   "Null-valued and out-of-range events still establish group membership."
  ],
  "blocked_by": []
 },
 {
  "id": "O3",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "For every group emit buckets starting start+k*width for nonnegative integers k while strictly below end, covering [bucketStart,min(bucketStart+width,end)).",
  "required": true,
  "dependencies": [
   {
    "id": "D1",
    "relation": "uses_definition"
   },
   {
    "id": "O2",
    "relation": "uses_proof"
   }
  ],
  "acceptance_criteria": [
   "Bucket starts are exactly start,start+width,... below end.",
   "Intervals include their lower endpoint and exclude their upper endpoint.",
   "The final interval is truncated at end.",
   "start=end yields no buckets."
  ],
  "blocked_by": []
 },
 {
  "id": "O4",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "For each group and bucket, sum and count precisely the non-null event values within its interval, counting duplicate occurrences separately.",
  "required": true,
  "dependencies": [
   {
    "id": "O3",
    "relation": "uses_proof"
   }
  ],
  "acceptance_criteria": [
   "count equals the number of eligible event occurrences.",
   "sum equals their integer sum.",
   "Null values and out-of-range events contribute neither sum nor count.",
   "Duplicates contribute separately."
  ],
  "blocked_by": []
 },
 {
  "id": "O5",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "A bucket with positive count returns its sum. A bucket with zero count returns null for fill none, or the latest previous nonempty bucket sum for fill previous, with null before the first nonempty bucket.",
  "required": true,
  "dependencies": [
   {
    "id": "O4",
    "relation": "uses_proof"
   },
   {
    "id": "I1",
    "relation": "uses_proof"
   }
  ],
  "acceptance_criteria": [
   "Positive count yields value=sum.",
   "Zero count with fill none yields null.",
   "Zero count with fill previous yields previous when present, otherwise null.",
   "Filling leaves count at zero."
  ],
  "blocked_by": []
 },
 {
  "id": "O6",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "Return a list of records containing group,start,count,value, ordered by lexicographic group then increasing bucket start, preserving the specified structure.",
  "required": true,
  "dependencies": [
   {
    "id": "O2",
    "relation": "uses_proof"
   },
   {
    "id": "O3",
    "relation": "uses_proof"
   },
   {
    "id": "O5",
    "relation": "uses_proof"
   }
  ],
  "acceptance_criteria": [
   "Each emitted bucket produces exactly one record with group,start,count,value.",
   "Records follow group then bucket order.",
   "Empty events or start=end produce an empty list."
  ],
  "blocked_by": []
 },
 {
  "id": "O7",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "Reproduce both public examples: the a example returns count 2 and value 0 at start 0, then count 0 and value 0 at starts 2 and 4; the z example returns count 0 and null at start 0.",
  "required": true,
  "dependencies": [
   {
    "id": "O6",
    "relation": "uses_proof"
   }
  ],
  "acceptance_criteria": [
   "The first example returns exactly its three specified records.",
   "The second example returns exactly its single specified record."
  ],
  "blocked_by": []
 },
 {
  "id": "I1",
  "kind": "invariant",
  "role": "guarantee",
  "statement": "Each group independently starts with no previous sum. Processing a nonempty bucket sets previous to its sum, including zero; processing an empty bucket preserves previous. Events before start never initialize previous.",
  "required": true,
  "dependencies": [
   {
    "id": "O4",
    "relation": "uses_proof"
   }
  ],
  "acceptance_criteria": [
   "Before a bucket, previous is the latest earlier nonempty bucket sum or absent.",
   "After a nonempty bucket, previous equals that bucket's sum.",
   "Empty buckets preserve previous.",
   "Zero is retained as a valid previous value.",
   "Pre-start events cannot seed previous."
  ],
  "blocked_by": []
 },
 {
  "id": "R1",
