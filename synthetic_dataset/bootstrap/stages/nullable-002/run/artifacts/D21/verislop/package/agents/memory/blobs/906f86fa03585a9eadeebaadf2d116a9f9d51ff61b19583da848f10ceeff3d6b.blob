{"obligations":[{"id":"D1","revision":1,"kind":"entity","role":"declaration","statement":"Input contains events with string group, integer time and integer-or-null value; integer start and end with start<=end; positive integer width; and fill equal to none or previous.","required":true,"scope":["input domain"],"dependencies":[],"acceptance_criteria":["Represent the specified input domain without additional restrictions."],"sources":[{"quote":"Input {events:[{group:string,time:int,value:int|null}],start:int,end:int,width:positive int,fill:'none'|'previous'}, start<=end.","origin":"explicit","interpretation":"Input schema and domain."}]},{"id":"O1","revision":1,"kind":"postcondition","role":"guarantee","statement":"Provide a pure deterministic Python 3 solve(data) function in solution.py receiving JSON-compatible Python values and returning a JSON-serializable value.","required":true,"scope":["function interface"],"dependencies":[],"acceptance_criteria":["solution.py exposes solve(data) in Python 3.","Repeated calls with identical input yield identical results.","The function is pure and returns JSON-serializable output."],"sources":[{"quote":"Implement solution.py with a pure solve(data) function.","origin":"explicit","interpretation":"File and interface."},{"quote":"Input and output are JSON-compatible Python values.","origin":"explicit","interpretation":"Value compatibility."},{"quote":"Implement a pure deterministic Python 3 function solve(data) in solution.py.","origin":"explicit","interpretation":"Language, purity and determinism."},{"quote":"The function receives a JSON value and returns a JSON-serializable value.","origin":"explicit","interpretation":"Serialization contract."}]},{"id":"R1","revision":1,"kind":"resource_constraint","role":"guarantee","statement":"Use only the Python standard library and perform no external I/O.","required":true,"scope":["implementation and invocation"],"dependencies":[],"acceptance_criteria":["No third-party dependencies.","No external I/O."],"sources":[{"quote":"Use Python standard library only, no external I/O.","origin":"explicit","interpretation":"Dependency and I/O constraints."},{"quote":"Use only the standard library, no external I/O.","origin":"explicit","interpretation":"Repeated constraints."}]},{"id":"O2","revision":1,"kind":"postcondition","role":"guarantee","statement":"Enumerate all distinct event group names lexicographically, including groups having no in-range events.","required":true,"scope":["group enumeration"],"dependencies":[{"id":"D1","relation":"uses_definition"}],"acceptance_criteria":["Groups equal sorted distinct names from all events.","Null-valued and out-of-range events still establish group membership."],"sources":[{"quote":"Groups are all unique event group names sorted lexicographically, including groups with no in-range events.","origin":"explicit","interpretation":"Complete ordered group enumeration."}]},{"id":"O3","revision":1,"kind":"postcondition","role":"guarantee","statement":"For every group emit buckets starting start+k*width for nonnegative integers k while strictly below end, covering [bucketStart,min(bucketStart+width,end)).","required":true,"scope":["bucket enumeration and membership"],"dependencies":[{"id":"D1","relation":"uses_definition"},{"id":"O2","relation":"uses_proof"}],"acceptance_criteria":["Bucket starts are exactly start,start+width,... below end.","Intervals include their lower endpoint and exclude their upper endpoint.","The final interval is truncated at end.","start=end yields no buckets."],"sources":[{"quote":"For each group, emit buckets starting start,start+width,...","origin":"explicit","interpretation":"Bucket progression."},{"quote":"strictly below end, each covering [bucketStart,min(bucketStart+width,end)).","origin":"explicit","interpretation":"Half-open intervals and end boundary."}]},{"id":"O4","revision":1,"kind":"postcondition","role":"guarantee","statement":"For each group and bucket, sum and count precisely the non-null event values within its interval, counting duplicate occurrences separately.","required":true,"scope":["aggregation"],"dependencies":[{"id":"O3","relation":"uses_proof"}],"acceptance_criteria":["count equals the number of eligible event occurrences.","sum equals their integer sum.","Null values and out-of-range events contribute neither sum nor count.","Duplicates contribute separately."],"sources":[{"quote":"Sum only non-null in-range values;","origin":"explicit","interpretation":"Sum eligibility."},{"quote":"count counts these values.","origin":"explicit","interpretation":"Count eligibility."},{"quote":"Zero sum is a real previous value, duplicates are counted.","origin":"explicit","interpretation":"Duplicate multiplicity."}]},{"id":"I1","revision":1,"kind":"invariant","role":"guarantee","statement":"Each group independently starts with no previous sum. Processing a nonempty bucket sets previous to its sum, including zero; processing an empty bucket preserves previous. Events before start never initialize previous.","required":true,"scope":["per-group causal fill state"],"dependencies":[{"id":"O4","relation":"uses_proof"}],"acceptance_criteria":["Before a bucket, previous is the latest earlier nonempty bucket sum or absent.","After a nonempty bucket, previous equals that bucket's sum.","Empty buckets preserve previous.","Zero is retained as a valid previous value.","Pre-start events cannot seed previous."],"sources":[{"quote":"A nonempty bucket has value=sum and becomes previous value.","origin":"explicit","interpretation":"Previous update."},{"quote":"empty buckets never reset previous.","origin":"explicit","interpretation":"State persistence."},{"quote":"Events before start never seed previous.","origin":"explicit","interpretation":"Initial causal boundary."},{"quote":"Zero sum is a real previous value, duplicates are counted.","origin":"explicit","interpretation":"Zero is valid state."}]},{"id":"O5","revision":1,"kind":"postcondition","role":"guarantee","statement":"A bucket with positive count returns its sum. A bucket with zero count returns null for fill none, or the latest previous nonempty bucket sum for fill previous, with null before the first nonempty bucket.","required":true,"scope":["bucket output values"],"dependencies":[{"id":"O4","relation":"uses_proof"},{"id":"I1","relation":"uses_proof"}],"acceptance_criteria":["Positive count yields value=sum.","Zero count with fill none yields null.","Zero count with fill previous yields previous when present, otherwise null.","Filling leaves count at zero."],"sources":[{"quote":"A nonempty bucket has value=sum and becomes previous value.","origin":"explicit","interpretation":"Nonempty value."},{"quote":"Empty bucket value is null for fill none, or latest previous nonempty bucket sum for fill previous (null before first);","origin":"explicit","interpretation":"Empty value by fill mode."}]},{"id":"O6","revision":1,"kind":"postcondition","role":"guarantee","statement":"Return a list of records containing group,start,count,value, ordered by lexicographic group then increasing bucket start, preserving the specified structure.","required":true,"scope":["output structure and ordering"],"dependencies":[{"id":"O2","relation":"uses_proof"},{"id":"O3","relation":"uses_proof"},{"id":"O5","relation":"uses_proof"}],"acceptance_criteria":["Each emitted bucket produces exactly one record with group,start,count,value.","Records follow group then bucket order.","Empty events or start=end produce an empty list."],"sources":[{"quote":"Return [{group,start,count,value}] in group then bucket order.","origin":"explicit","interpretation":"Output records and ordering."},{"quote":"Preserve the specified input/output structure and exact ordering.","origin":"explicit","interpretation":"Structural fidelity."}]},{"id":"O7","revision":1,"kind":"postcondition","role":"guarantee","statement":"Reproduce both public examples: the a example returns count 2 and value 0 at start 0, then count 0 and value 0 at starts 2 and 4; the z example returns count 0 and null at start 0.","required":true,"scope":["public examples"],"dependencies":[{"id":"O6","relation":"uses_proof"}],"acceptance_criteria":["The first example returns exactly its three specified records.","The second example returns exactly its single specified record."],"sources":[{"quote":"Public examples (additional held-out cases will be scored):\n[{\"input\": {\"end\": 5, \"events\": [{\"group\": \"a\", \"time\": 0, \"value\": 2}, {\"group\": \"a\", \"time\": 1, \"value\": -2}], \"fill\": \"previous\", \"start\": 0, \"width\": 2}, \"output\": [{\"count\": 2, \"group\": \"a\", \"start\": 0, \"value\": 0}, {\"count\": 0, \"group\": \"a\", \"start\": 2, \"value\": 0}, {\"count\": 0, \"group\": \"a\", \"start\": 4, \"value\": 0}]}, {\"input\": {\"end\": 1, \"events\": [{\"group\": \"z\", \"time\": -1, \"value\": 9}], \"fill\": \"previous\", \"start\": 0, \"width\": 2}, \"output\": [{\"count\": 0, \"group\": \"z\", \"start\": 0, \"value\": null}]}]","origin":"explicit","interpretation":"Required public example outputs; held-out scoring is evaluation context."}]}],"category_review":{"entities":"Event input schema, bucket records and per-group previous sum.","preconditions":"No separate caller assumptions; specified valid input domain.","postconditions":"Pure deterministic interface, complete groups and buckets, aggregation, filling, ordered output and public examples.","invariants":"Each group's previous state tracks its latest nonempty in-range bucket sum, including zero.","safety_properties":"None separately stated.","liveness_properties":"None separately stated.","resource_constraints":"Standard library only and no external I/O.","error_semantics":"Invalid-input behavior is not specified.","explicit_non_goals":"None stated.","ambiguities":"None affecting specified valid-input behavior."},"clauses":[{"clause_id":"C1","quote":"Software engineering task D21: Grouped bucket aggregation with causal filling","disposition":"context","refs":[],"note":"Task title."},{"clause_id":"C2","quote":"Implement solution.py with a pure solve(data) function.","disposition":"obligations","refs":["O1"],"note":""},{"clause_id":"C3","quote":"Input and output are JSON-compatible Python values.","disposition":"obligations","refs":["O1"],"note":""},{"clause_id":"C4","quote":"Use Python standard library only, no external I/O.","disposition":"obligations","refs":["R1"],"note":""},{"clause_id":"C5","quote":"Input {events:[{group:string,time:int,value:int|null}],start:int,end:int,width:positive int,fill:'none'|'previous'}, start<=end.","disposition":"obligations","refs":["D1"],"note":""},{"clause_id":"C6","quote":"Groups are all unique event group names sorted lexicographically, including groups with no in-range events.","disposition":"obligations","refs":["O2"],"note":""},{"clause_id":"C7","quote":"For each group, emit buckets starting start,start+width,...","disposition":"obligations","refs":["O3"],"note":""},{"clause_id":"C8","quote":"strictly below end, each covering [bucketStart,min(bucketStart+width,end)).","disposition":"obligations","refs":["O3"],"note":""},{"clause_id":"C9","quote":"Sum only non-null in-range values;","disposition":"obligations","refs":["O4"],"note":""},{"clause_id":"C10","quote":"count counts these values.","disposition":"obligations","refs":["O4"],"note":""},{"clause_id":"C11","quote":"A nonempty bucket has value=sum and becomes previous value.","disposition":"obligations","refs":["I1","O5"],"note":""},{"clause_id":"C12","quote":"Empty bucket value is null for fill none, or latest previous nonempty bucket sum for fill previous (null before first);","disposition":"obligations","refs":["O5"],"note":""},{"clause_id":"C13","quote":"empty buckets never reset previous.","disposition":"obligations","refs":["I1"],"note":""},{"clause_id":"C14","quote":"Events before start never seed previous.","disposition":"obligations","refs":["I1"],"note":""},{"clause_id":"C15","quote":"Return [{group,start,count,value}] in group then bucket order.","disposition":"obligations","refs":["O6"],"note":""},{"clause_id":"C16","quote":"Zero sum is a real previous value, duplicates are counted.","disposition":"obligations","refs":["I1","O4"],"note":""},{"clause_id":"C17","quote":"Implement a pure deterministic Python 3 function solve(data) in solution.py.","disposition":"obligations","refs":["O1"],"note":""},{"clause_id":"C18","quote":"Use only the standard library, no external I/O.","disposition":"obligations","refs":["R1"],"note":""},{"clause_id":"C19","quote":"The function receives a JSON value and returns a JSON-serializable value.","disposition":"obligations","refs":["O1"],"note":""},{"clause_id":"C20","quote":"Preserve the specified input/output structure and exact ordering.","disposition":"obligations","refs":["O6"],"note":""},{"clause_id":"C21","quote":"Public examples (additional held-out cases will be scored):\n[{\"input\": {\"end\": 5, \"events\": [{\"group\": \"a\", \"time\": 0, \"value\": 2}, {\"group\": \"a\", \"time\": 1, \"value\": -2}], \"fill\": \"previous\", \"start\": 0, \"width\": 2}, \"output\": [{\"count\": 2, \"group\": \"a\", \"start\": 0, \"value\": 0}, {\"count\": 0, \"group\": \"a\", \"start\": 2, \"value\": 0}, {\"count\": 0, \"group\": \"a\", \"start\": 4, \"value\": 0}]}, {\"input\": {\"end\": 1, \"events\": [{\"group\": \"z\", \"time\": -1, \"value\": 9}], \"fill\": \"previous\", \"start\": 0, \"width\": 2}, \"output\": [{\"count\": 0, \"group\": \"z\", \"start\": 0, \"value\": null}]}]","disposition":"obligations","refs":["O7"],"note":"Both public cases are required behavioral examples; held-out scoring is evaluation context."}],"assumptions":[],"ambiguities":[],"selected_defaults":[]}