 below end, covering [bucketStart,min(bucketStart+width,end))."},{"acceptance_criteria":["count equals the number of eligible event occurrences.","sum equals their integer sum.","Null values and out-of-range events contribute neither sum nor count.","Duplicates contribute separately."],"dependencies":[{"id":"O3","relation":"uses_proof"}],"id":"O4","kind":"postcondition","lifecycle":{"END_TO_END_VERIFIED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"FORMALIZED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"IMPLEMENTED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"INTERPRETED":{"evidence_refs":["provenance:tasks/D21/prompt.txt"],"outcome":"PASS","reason":"Recorded interpretation proposal; not mathematical proof.","scope":["recorded interpretation of the request"]},"LINKED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"PROVED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"TESTED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"TYPECHECKED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]}},"required":true,"revision":1,"role":"guarantee","scope":["aggregation"],"source_refs":[{"document_hash":"sha256:1e1a8ccb008420489eab50ddfe73e1632b674ccb2202aeced608a233f7ac3296","document_ref":"tasks/D21/prompt.txt","end_byte":645,"interpretation":"Sum eligibility.","origin":"explicit","start_byte":611},{"document_hash":"sha256:1e1a8ccb008420489eab50ddfe73e1632b674ccb2202aeced608a233f7ac3296","document_ref":"tasks/D21/prompt.txt","end_byte":672,"interpretation":"Count eligibility.","origin":"explicit","start_byte":