{
  "obligations": [
    {
      "id": "D1",
      "revision": 1,
      "kind": "entity",
      "role": "declaration",
      "required": true,
      "statement": "The deliverable is canonical program.vscore.json containing exactly one admitted typed entry solve of arity 1, under normative Lean vscore-semantics/0.3 and data-pipeline/0.3 serialization. Its input represents the JSON object {n,m,a,b} with integer fields, and its result represents one exact JSON integer. The arithmetic domain is unbounded mathematical integers; strings, if present in source serialization, contain Unicode scalar values with scalar-codepoint lexicographic ordering.",
      "scope": ["source artifact", "typed input and output", "normative semantics and serialization"],
      "dependencies": [],
      "acceptance_criteria": [
        "The canonical file is program.vscore.json and its sole admitted typed entry is solve with arity 1.",
        "Typed input represents {n,m,a,b}; typed output represents an exact integer.",
        "Source and serialization conform to vscore/0.3, Lean vscore-semantics/0.3 and data-pipeline/0.3.",
        "Integer semantics are unbounded; applicable string semantics use Unicode scalar values and scalar-codepoint order."
      ],
      "sources": [
