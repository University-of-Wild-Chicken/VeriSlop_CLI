.","No additional caller restriction is introduced."],"dependencies":[{"id":"D1","relation":"uses_definition"}],"id":"A1","kind":"precondition","lifecycle":{"END_TO_END_VERIFIED":{"evidence_refs":[],"outcome":"NOT_APPLICABLE","reason":"assumption is supplied by input supplier and discharged at solve invocation, where supplied input satisfies the stated JSON schema, 0 <= n <= 500 and m > 0 with arbitrary signed integer a and b","scope":[]},"FORMALIZED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"IMPLEMENTED":{"evidence_refs":[],"outcome":"NOT_APPLICABLE","reason":"assumption is supplied by input supplier and discharged at solve invocation, where supplied input satisfies the stated JSON schema, 0 <= n <= 500 and m > 0 with arbitrary signed integer a and b","scope":[]},"INTERPRETED":{"evidence_refs":["provenance:tier2:tier2-source-facets-004:A23"],"outcome":"PASS","reason":"Recorded interpretation proposal; not mathematical proof.","scope":["recorded interpretation of the request"]},"LINKED":{"evidence_refs":[],"outcome":"NOT_APPLICABLE","reason":"assumption is supplied by input supplier and discharged at solve invocation, where supplied input satisfies the stated JSON schema, 0 <= n <= 500 and m > 0 with arbitrary signed integer a and b","scope":[]},"PROVED":{"evidence_refs":[],"outcome":"NOT_APPLICABLE","reason":"an assumption is a hypothesis; it is not proved by the theorems that use it","scope":[]},"TESTED":{"evidence_refs":[],"outcome":"NOT_APPLICABLE","reason":"assumption is supplied by input supplier and discharged at solve invocation, where supplied input satisfies the stated JSON schema, 0 <= n <= 500 and m > 0 with arbitrary signed integer a and b","scope":[]},"TYPECHECKED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]}},"required":true,"revision":1,"role":"assumption","scope":["supplied inputs"],"source_refs":[{"document_h