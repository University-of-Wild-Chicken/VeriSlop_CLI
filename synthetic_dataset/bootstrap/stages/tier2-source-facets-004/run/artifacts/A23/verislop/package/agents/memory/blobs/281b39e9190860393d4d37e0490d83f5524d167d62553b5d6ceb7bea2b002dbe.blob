39a551f7fe20ff302cecbf8fcd83b","document_ref":"tier2:tier2-source-facets-004:A23","end_byte":2026,"interpretation":"examples do not replace universal behavior","origin":"explicit","start_byte":1986},{"document_hash":"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b","document_ref":"tier2:tier2-source-facets-004:A23","end_byte":3628,"interpretation":"preserved guarantee identity","origin":"explicit","start_byte":2085},{"document_hash":"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b","document_ref":"tier2:tier2-source-facets-004:A23","end_byte":4264,"interpretation":"mandatory canonical source delivery","origin":"explicit","start_byte":4060},{"document_hash":"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b","document_ref":"tier2:tier2-source-facets-004:A23","end_byte":4326,"interpretation":"source requirements belong in formal contract","origin":"explicit","start_byte":4265},{"document_hash":"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b","document_ref":"tier2:tier2-source-facets-004:A23","end_byte":4496,"interpretation":"value theorem cannot replace source properties","origin":"explicit","start_byte":4327},{"document_hash":"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b","document_ref":"tier2:tier2-source-facets-004:A23","end_byte":4713,"interpretation":"mixed source and value guarantee","origin":"explicit","start_byte":4497},{"document_hash":"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b","document_ref":"tier2:tier2-source-facets-004:A23","end_byte":4774,"interpretation":"value facets required","origin":"explicit","start_byte":4714},{"document_hash":"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b","document_ref":"tier2:tier2-source-facets-004:A23","end_byte":6207,"interpretation":"exact O1 source facets and value_required=true","origin":"explicit","start_byte":5156}],"state":"INTERPRETED","statement":"For every input satisfying A1, execution of the arity-1 typed entry solve in canonical program.vscore.json returns the exact integer sum Σ_{i=0}^{n-1} floor((a*i+b)/m). Each floor is the unique integer q satisfying q*m <= a*i+b < (q+1)*m, including negative numerators; n=0 yields zero. Universal refinement must relate this actual source execution to the complete formula. The same contract requires typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only under normative Lean vscore-semantics/0.3 and data-pipeline/0.3."},{"acceptance_criteria":["The delivered canonical file contains exactly one admitted typed solve entry with arity 1 under the stated source semantics and serialization profile.","For every valid JSON object {n,m,a,b}, typed decoding and result serialization preserve the specified input/output structure and exact ordering.","For every valid input, the serialized result is a JSON integer equal to Σ_{i=0}^{n-1} floor((a*i+b)/m), using mathematical floor and zero for n=0.","The formal contract includes the exact file, entry, arity and all seven properties: typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data, restricted_runtime_only.","The complete value proposition and universal refinement of actual source execution are retained alongside the source facets."],"dependencies":[{"id":"D1","relation":"uses_definition"},{"id":"A1","relation":"assumes"}],"id":"O2","kind":"postcondition","lifecycle":{"END_TO_END_VERIFIED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"FORMALIZED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"IMPLEMENTED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"INTERPRETED":{"evidence_refs":["provenance:tier2:tier2-source-facets-004:A2