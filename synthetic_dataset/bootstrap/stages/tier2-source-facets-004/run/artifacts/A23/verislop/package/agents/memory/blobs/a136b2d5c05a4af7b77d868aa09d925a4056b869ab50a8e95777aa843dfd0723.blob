{"agent_attempt":1,"best":"import Std\n\n-- BEGIN VERISLOP REGISTRY\n-- Generated by `verislop formalize`. Typed obligation metadata: an index, never evidence.\nnamespace VeriSlop.Registry\n\nstructure SourceRef where\n  documentRef : String\n  documentHash : String\n  startByte : Nat\n  endByte : Nat\n  origin : String\n  interpretation : String\n\nstructure Dependency where\n  id : String\n  relation : String\n\nstructure Entry where\n  id : String\n  revision : Nat\n  kind : String\n  role : String\n  statement : String\n  required : Bool\n  sourceRefs : List SourceRef\n  scope : List String\n  dependencies : List Dependency\n  acceptanceCriteria : List String\n  bindings : List String\n\ndef «D1» : Entry := {\n  id := \"D1\",\n  revision := 1,\n  kind := \"entity\",\n  role := \"declaration\",\n  statement := \"The deliverable is canonical program.vscore.json with exactly one admitted typed entry solve of arity 1, using vscore/0.3 under normative Lean vscore-semantics/0.3 and data-pipeline/0.3 serialization. Input represents the JSON object {n,m,a,b} with integer fields; output represents an exact JSON integer. Integers are unbounded mathematical integers. Strings contain Unicode scalar values and lexicographic ordering compares scalar codepoints.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-004:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 67, endByte := 137, origin := \"explicit\", interpretation := \"Artifact and entry identity.\" }, { documentRef := \"tier2:tier2-source-facets-004:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 138, endByte := 222, origin := \"explicit\", interpretation := \"Typed JSON representation.\" }, { documentRef := \"tier2:tier2-source-facets-004:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 383, 