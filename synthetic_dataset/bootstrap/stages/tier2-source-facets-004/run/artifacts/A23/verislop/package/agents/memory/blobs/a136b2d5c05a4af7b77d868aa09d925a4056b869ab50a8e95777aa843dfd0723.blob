, origin := \"explicit\", interpretation := \"Source facets in formal contract.\" }, { documentRef := \"tier2:tier2-source-facets-004:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4327, endByte := 4496, origin := \"explicit\", interpretation := \"Equality cannot replace source properties.\" }, { documentRef := \"tier2:tier2-source-facets-004:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4497, endByte := 4713, origin := \"explicit\", interpretation := \"Complete mixed source/value guarantee.\" }, { documentRef := \"tier2:tier2-source-facets-004:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4714, endByte := 4774, origin := \"explicit\", interpretation := \"Value facets required.\" }, { documentRef := \"tier2:tier2-source-facets-004:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 5156, endByte := 6207, origin := \"explicit\", interpretation := \"Exact O2 facets and value_required=true.\" }],\n  scope := [\"canonical source delivery\", \"all valid typed and serialized input/output pairs\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }, { id := \"A1\", relation := \"assumes\" }],\n  acceptanceCriteria := [\"The canonical file contains exactly one admitted typed solve entry of arity 1 under the specified normative source and serialization profiles.\", \"Typed representation and serialization preserve specified JSON structure and exact ordering for every valid input.\", \"For every valid input, serialized output is the exact JSON integer Σ_{i=0}^{n-1} floor((a*i+b)/m), with mathematical floor toward negative infinity and empty sum zero.\", \"The formal contract includes the exact file, entry, arity and all seven closed source properties.\", \"The complete value formula and universal refinement of actual source execution remain required alongside all source facets.\"],\n  bindings := [\"VeriSlopAST.solve_contract\"] }\n\ndef «S1» : Entry := {\n  id := \"S1\",\n  revision := 1,\n  kind := \"safety_property\",\n  role := \"guarantee\",\n  statement := \"The formal source contract for canonical program.vscore.json, entry solve, arity 1 must require typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only under normative Lean vscore-semantics/0.3 and data-pipeline/0.3. Admitted typed execution must be total, pure and deterministic, preserve immutable input values, perform no external I/O and read no benchmark files. The source language has no external-effect constructors. S1 retains these operational source requirements as a source-only guarantee with value_required=false.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-004:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 223, endByte := 279, origin := \"explicit\", interpretation := \"No external I/O or benchmark reads.\" }, { documentRef := \"tier2:tier2-source-facets-004:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 829, endByte := 887, origin := \"explicit\", interpretation := \"Total pure deterministic execution.\" }, { documentRef := \"tier2:tier2-source-facets-004:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 888, endByte := 969, origin := \"explicit\", interpretation := \"Input immutability and effect restrictions.\" }, { documentRef := \"tier2:tier2-source-facets-004:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 2085, endByte := 3628, origin := \"explicit\", interpretation := \"Preserved S1 identity.\" }, { documentRef := \"tier2:tier2-source-facets-004:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4060, endByte := 4264, origin := \"explicit\", interpretation := \"Canonical delivery and source facets.\" }, { documentRef := \"tier2:tier2-source-facets-004:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4265, endByte := 4326, origin := \"explicit\", interpretation := \"Formal source contract.\" }, { documentRef := \"tier2:tier2-source-facets-004:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4327, endByte := 4496, origin := \"explicit\", interpretation := \"Source facets cannot be replaced.\" }, { documentRef := \"tier2:tier2-source-facets-004:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4775, endByte := 4928, origin := \"explicit\", interpretation := \"Operational source-only classification.\" }, { documentRef := \"tier2:tier2-source-facets-004:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 5156, endByte := 6207, origin := \"explicit\", interpretation := \"Exact S1 facets and value_required=false.\" }],\n  scope := [\"canonical solve source\", \"all admitted typed executions\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }],\n  acceptanceCriteria := [\"The formal contract binds program.vscore.json, solve, arity 1 and all seven closed source properties.\", \"All admitted typed executions are total, pure and deterministic and preserve input values.\", \"No external I/O, benchmark-file reads or external-effect constructors occur.\", \"Source-only operational requirements cannot be replaced by a value equality.\"],\n  bindings := [\"VeriSlopAST.solve_operational\"] }\n\ndef «S2» : Entry := {\n  id := \"S2\",\n  revision := 1,\n  kind := \"safety_property\",\n  role := \"guarantee\",\n  statement := \"Canonical program.vscore.json, entry solve of arity 1 must use exact unbounded mathematical integer arithmetic without floating point or bounded-integer overflow, including arbitrarily large signed a and b. Its formal source contract must require typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only under normative Lean vscore-semantics/0.3 and data-pipeline/0.3. S2 is operational and source-only with value_required=false; O1 and O2 separately retain the complete functional formula and universal source implementation refinement.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-004:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 383, endByte := 467, origin := \"explicit\", interpretation := \"Arbitrary signed integer magnitudes.\" }, { documentRef := \"tier2:tier2-source-facets-004:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 468, endByte := 518, origin := \"explicit\", interpretation := \"Exact computation.\" }, { documentRef := \"tier2:tier2-source-facets-004:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 592, endByte := 613, origin := \"explicit\", interpretation := \"Avoid floating point.\" }, { documentRef := \"tier2:tier2-source-facets-004:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 970, endByte := 1041, origin := \"explicit\", interpretation := \"Unbounded mathematical integers.\" }, { documentRef := \"tier2:tier2-source-facets-004:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 2085, endByte := 3628, origin := \"explicit\", interpretation := \"Preserved S2 identity.\" }, { documentRef := \"tier2:tier2-source-facets-004:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4060, endByte := 4264, origin := \"explicit\", interpretation := \"Canonical source delivery.\" }, { documentRef := \"tier2:tier2-source-facets-004:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4265, endByte := 4326, origin := \"explicit\", interpretation := \"Formal source contract.\" }, { documentRef := \"tier2:tier2-source-facets-004:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4327, endByte := 4496, origin := \"explicit\", interpretation := \"Exact source semantics cannot be replaced.\" }, { documentRef := \"tier2:tier2-source-facets-004:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 4775, endByte := 4928, origin := \"explicit\", interpretation := \"Operational source-only classification.\" }, { documentRef := \"tier2:tier2-source-facets-004:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 5156, endByte := 6207, origin := \"explicit\", interpretation := \"Exact S2 facets and value_required=false.\" }],\n  scope := [\"canonical solve source\", \"arithmetic throughout admitted typed execution\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }],\n  acceptanceCriteria := [\"Arithmetic uses unbounded mathematical integers without floating-point operations or bounded-integer overflow.\", \"The formal contract binds program.vscore.json, solve, arity 1 and all seven closed source properties.\", \"S2 retains its source-only operational requirements.\"],\n  bindings := [\"VeriSlopAST.solve_operational\"] }\n\ndef «N1» : Entry := {\n  id := \"N1\",\n  revision := 1,\n  kind := \"explicit_non_goal\",\n  role := \"exclusion\",\n  statement := \"No functional result or error behavior is required for malformed input outside the supplied schema and bounds.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-004:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 338, endByte := 382, origin := \"explicit\", interpretation := \"Malformed-input exclusion.\" }, { documentRef := \"tier2:tier2-source-facets-004:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1654, endByte := 1733, origin := \"explicit\", interpretation := \"Preserve the exclusion ID, role and required flag.\" }, { documentRef := \"tier2:tier2-source-facets-004:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 2085, endByte := 3628, origin := \"explicit\", interpretation := \"Preserved N1 exclusion identity.\" }],\n  scope := [\"malformed inputs\"],\n  dependencies := [],\n  acceptanceCriteria := [\"Functional correctness requirements prescribe no behavior for malformed input.\"],\n  bindings := [] }\n\ndef «N2» : Entry := {\n  id := \"N2\",\n  revision := 1,\n  kind := \"explicit_non_goal\",\n  role := \"exclusion\",\n  statement := \"Runtime campaigns and machine-code, compiler, runtime or physical-resource assurance are outside the requested endpoint. The assurance boundary is normative restricted-source execution with natural-language correspondence, host tooling, the pinned Lean kernel, hashing and OS/hardware explicitly trusted.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-004:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 3629, endByte := 3665, origin := \"explicit\", interpretation := \"Runtime campaigns excluded.\" }, { documentRef := \"tier2:tier2-source-facets-004:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 3666, endByte := 3849, origin := \"explicit\", interpretation := \"Restricted-source boundary and explicit trust.\" }, { documentRef := \"tier2:tier2-source-facets-004:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 3850, endByte := 3927, origin := \"explicit\", interpretation := \"Excluded assurance levels.\" }],\n  scope := [\"assurance boundary\"],\n  dependencies := [],\n  acceptanceCriteria := [\"No runtime campaign is required.\", \"Machine-code, compiler, runtime and physical-resource assurance are excluded.\", \"The explicitly trusted components remain stated at the restricted-source boundary.\"],\n  bindings := [] }\n\ndef «valid_input_witness» : Entry := {\n  id := \"valid_input_witness\",\n  revision := 1,\n  kind := \"non_vacuity\",\n  role := \"guarantee\",\n  statement := \"Non-vacuity: The input with n=0, m=1, a=0 and b=0 satisfies exactly the supplied bounds. (witnesses A1)\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-004:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 280, endByte := 337, origin := \"inferred\", interpretation := \"derived by registered rule verislop.non-vacuity/0.1 from assumption A1\" }, { documentRef := \"tier2:tier2-source-facets-004:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 383, endByte := 467, origin := \"inferred\", interpretation := \"derived by registered rule verislop.non-vacuity/0.1 from assumption A1\" }, { documentRef := \"tier2:tier2-source-facets-004:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 1132, endByte := 1222, origin := \"inferred\", interpretation := \"derived by registered rule verislop.non-vacuity/0.1 from assumption A1\" }, { documentRef := \"tier2:tier2-source-facets-004:A23\", documentHash := \"sha256:7e8c0d17e78afc93ed267ed2738c4d8d2f739a551f7fe20ff302cecbf8fcd83b\", startByte := 2085, endByte := 3628, origin := \"inferred\", interpretation := \"derived by registered rule verislop.non-vacuity/0.1 from assumption A1\" }],\n  scope := [\"supplied inputs\"],\n  dependencies := [{ id := \"A1\", relation := \"uses_definition\" }],\n  acceptanceCriteria := [\"Prove the existential theorem with concrete witnesses extractable by bounded kernel head-normalisation.\"],\n  bindings := [\"VeriSlopAST.valid_input_inhabited\"] }\n\ndef entries : List Entry := [«D1», «A1», «O1», «O2», «S1», «S2», «N1», «N2», «valid_input_witness»]\n\nend VeriSlop.Registry\n-- END VERISLOP REGISTRY\n\n/-!\nNormative restricted-source boundary requirement model, v0.1. These rules prove\nchecking soundness and inhabitation of an abstract fact model. They do not assert\nfacts about a delivered program, its evaluator, or a host runtime. The source\nbridge must derive every fact from the exact admitted source and semantic laws.\nThis algebra is independent of the Python NativeBoundary model.\n-/\nnamespace VeriSlop.Source\n\ninductive SourceRequirement where\n  | entry (file id : String) (arity : Nat)\n  | typedTotal\n  | deterministic\n  | inputPreserved\n  | noExternalIO\n  | noFloatingPoint\n  | pureData\n  | restrictedRuntimeOnly\n  deriving DecidableEq\n\nstructure Entry where\n  file : String\n  id : String\n  arity : Nat\n  deriving DecidableEq\n\nstructure ModuleFacts where\n  entries : List Entry\n  uniqueEntries : Bool\n  typedTotal : Bool\n  deterministic : Bool\n  inputPreserved : Bool\n  noExternalIO : Bool\n  noFloatingPoint : Bool\n  pureData : Bool\n  restrictedRuntimeOnly : Bool\n\ndef checkRequirement (r : SourceRequirement) (m : ModuleFacts) : Bool :=\n  match r with\n  | .entry f n a => m.uniqueEntries && decide (Entry.mk f n a ∈ m.entries)\n  | .typedTotal => m.typedTotal\n  | .deterministic => m.deterministic\n  | .inputPreserved => m.inputPreserved\n  | .noExternalIO => m.noExternalIO\n  | .noFloatingPoint => m.noFloatingPoint\n  | .pureData => m.pureData\n  | .restrictedRuntimeOnly => m.restrictedRuntimeOnly\n\ndef HoldsRequirement (r : SourceRequirement) (m : ModuleFacts) : Prop :=\n  match r with\n  | .entry f n a => m.uniqueEntries = true ∧ Entry.mk f n a ∈ m.entries\n  | .typedTotal => m.typedTotal = true\n  | .deterministic => m.deterministic = true\n  | .inputPreserved => m.inputPreserved = true\n  | .noExternalIO => m.noExternalIO = true\n  | .noFloatingPoint => m.noFloatingPoint = true\n  | .pureData => m.pureData = true\n  | .restrictedRuntimeOnly => m.restrictedRuntimeOnly = true\n\ndef checkBoundary (rs : List SourceRequirement) (m : ModuleFacts) : Bool :=\n  rs.all (fun r => checkRequirement r m)\n\ndef HoldsBoundary (rs : List SourceRequirement) (m : ModuleFacts) : Prop :=\n  ∀ r ∈ rs, HoldsRequirement r m\n\ndef Transfer (rs : List SourceRequirement) : Prop :=\n  ∀ m, checkBoundary rs m = true → HoldsBoundary rs m\n\ndef AdmissionInhabited (rs : List SourceRequirement) : Prop :=\n  ∃ m, checkBoundary rs m = true\n\n/-- Closed accepted data identifies the endpoint; Contract supplies only abstract\nchecking rules and does not establish implementation refinement. -/\nstructure SourceDefinition (τ : Type) where\n  endpoint : τ\n  requirements : List SourceRequirement\n\ndef Contract {τ : Type} (d : SourceDefinition τ) : Prop :=\n  Transfer d.requirements ∧ AdmissionInhabited d.requirements\n\ntheorem checkRequirement_sound (r : SourceRequirement) (m : ModuleFacts) :\n    checkRequirement r m = true → HoldsRequirement r m := by\n  cases r <;> simp [checkRequirement, HoldsRequirement, Bool.and_eq_true]\n\ntheorem transfer_sound (rs : List SourceRequirement) : Transfer rs := by\n  intro m h r hr\n  exact checkRequirement_sound r m ((List.all_eq_true.mp h) r hr)\n\ndef witnessEntries : List SourceRequirement → List Entry\n  | [] => []\n  | .entry f n a :: rs => Entry.mk f n a :: witnessEntries rs\n  | _ :: rs => witnessEntries rs\n\ndef modelWitness (rs : List SourceRequirement) : ModuleFacts :=\n  ⟨witnessEntries rs, true, true, true, true, true, true, true, true⟩\n\ntheorem entry_in_witness (f n : String) (a : Nat) (rs : List SourceRequirement)\n    (h : SourceRequirement.entry f n a ∈ rs) : Entry.mk f n a ∈ witnessEntries rs := by\n  induction rs with\n  | nil => simp at h\n  | cons r rs ih => cases r <;> simp_all [witnessEntries] <;> grind\n\ntheorem admission_inhabited (rs : List SourceRequirement) : AdmissionInhabited rs := by\n  refine ⟨modelWitness rs, List.all_eq_true.mpr ?_⟩\n  intro r hr\n  cases r with\n  | entry f n a =>\n    simp [checkRequirement, modelWitness, entry_in_witness f n a rs hr]\n  | typedTotal => rfl\n  | deterministic => rfl\n  | inputPreserved => rfl\n  | noExternalIO => rfl\n  | noFloatingPoint => rfl\n  | pureData => rfl\n  | restrictedRuntimeOnly => rfl\n\ntheorem contract_sound {τ : Type} (d : SourceDefinition τ) : Contract d :=\n  ⟨transfer_sound d.requirements, admission_inhabited d.requirements⟩\n\nend VeriSlop.Source\n\nnamespace VeriSlopAST\nstructure «Input» where\n  «n» : _root_.Int\n  «m» : _root_.Int\n  «a» : _root_.Int\n  «b» : _root_.Int\ndef «solve» («_v0» : _root_.VeriSlopAST.«Input») : _root_.Int := (_root_.List.sum (@_root_.List.map _root_.Nat _root_.Int (fun («_v1» : _root_.Nat) => (_root_.Int.fdiv (_root_.Int.add (_root_.Int.mul (_root_.VeriSlopAST.«Input».«a» «_v0») (_root_.Int.ofNat «_v1»)) (_root_.VeriSlopAST.«Input».«b» «_v0»)) (_root_.VeriSlopAST.«Input».«m» «_v0»))) (_root_.List.range (_root_.Int.toNat (_root_.VeriSlopAST.«Input».«n» «_v0»)))))\ntheorem «_vs_body_solve» : (∀ («_v0» : _root_.VeriSlopAST.«Input»), ((_root_.VeriSlopAST.«solve» «_v0») = (_root_.List.sum (@_root_.List.map _root_.Nat _root_.Int (fun («_v1» : _root_.Nat) => (_root_.Int.fdiv (_root_.Int.add (_root_.Int.mul (_root_.VeriSlopAST.«Input».«a» «_v0») (_root_.Int.ofNat «_v1»)) (_root_.VeriSlopAST.«Input».«b» «_v0»)) (_root_.VeriSlopAST.«Input».«m» «_v0»))) (_root_.List.range (_root_.Int.toNat (_root_.VeriSlopAST.«Input».«n» «_v0»))))))) := by intros; rfl\n@[reducible] def «valid_input» («_v0» : _root_.VeriSlopAST.«Input») : Prop := ((((_root_.Int.ofNat 0) ≤ (_root_.VeriSlopAST.«Input».«n» «_v0»)) ∧ ((_root_.VeriSlopAST.«Input».«n» «_v0») ≤ (_root_.Int.ofNat 500))) ∧ ((_root_.Int.ofNat 0) < (_root_.VeriSlopAST.«Input».«m» «_v0»)))\ntheorem «_vs_predicate_valid_input» («_v0» : _root_.VeriSlopAST.«Input») : ((_root_.VeriSlopAST.«valid_input» «_v0») ↔ ((((_root_.Int.ofNat 0) ≤ (_root_.VeriSlopAST.«Input».«n» «_v0»)) ∧ ((_root_.VeriSlopAST.«Input».«n» «_v0») ≤ (_root_.Int.ofNat 500))) ∧ ((_root_.Int.ofNat 0) < (_root_.VeriSlopAST.«Input».«m» «_v0»)))) := by rfl\ndef «solve_source» : _root_.VeriSlop.Source.SourceDefinition (_root_.VeriSlopAST.«Input» → _root_.Int) := ⟨_root_.VeriSlopAST.«solve», [(_root_.VeriSlop.Source.SourceRequirement.entry \"program.vscore.json\" \"solve\" 1), _root_.VeriSlop.Source.SourceRequirement.typedTotal, _root_.VeriSlop.Source.SourceRequirement.deterministic, _root_.VeriSlop.Source.SourceRequirement.inputPreserved, _root_.VeriSlop.Source.SourceRequirement.noExternalIO, _root_.VeriSlop.Source.SourceRequirement.noFloatingPoint, _root_.VeriSlop.Source.SourceRequirement.pureData, _root_.VeriSlop.Source.SourceRequirement.restrictedRuntimeOnly]⟩\ntheorem «solve_contract» : ((∀ («_v0» : _root_.VeriSlopAST.«Input»), ((_root_.VeriSlopAST.«valid_input» «_v0») → ((_root_.VeriSlopAST.«solve» «_v0») = (_root_.List.sum (@_root_.List.map _root_.Nat _root_.Int (fun («_v1» : _root_.Nat) => (_root_.Int.fdiv (_root_.Int.add (_root_.Int.mul (_root_.VeriSlopAST.«Input».«a» «_v0») (_root_.Int.ofNat «_v1»)) (_root_.VeriSlopAST.«Input».«b» «_v0»)) (_root_.VeriSlopAST.«Input».«m» «_v0»))) (_root_.List.range (_root_.Int.toNat (_root_.VeriSlopAST.«Input».«n» «_v0»)))))))) ∧ (_root_.VeriSlop.Source.Contract _root_.VeriSlopAST.«solve_source»)) := by\n  constructor\n  ·