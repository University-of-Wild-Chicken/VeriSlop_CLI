        {"clause_id": "C29", "origin": "explicit", "interpretation": "Preserved declaration identity."}
      ]
    },
    {
      "id": "A1",
      "revision": 1,
      "kind": "precondition",
      "role": "assumption",
      "required": true,
      "statement": "The input supplier provides schema-conforming integer fields {n,m,a,b} satisfying 0 <= n <= 500 and m > 0. The values a and b are arbitrary signed integers without a magnitude bound, including magnitude 10^30. No additional input bounds or preconditions apply.",
      "scope": ["supplied inputs"],
      "dependencies": [{"id": "D1", "relation": "uses_definition"}],
      "acceptance_criteria": [
        "Supplied inputs satisfy the specified object schema, 0 <= n <= 500 and m > 0.",
