{
  "obligations": [
    {
      "id": "D1",
      "revision": 1,
      "kind": "entity",
      "role": "declaration",
      "required": true,
      "statement": "The deliverable is canonical program.vscore.json with exactly one admitted typed entry solve of arity 1, using vscore/0.3 under normative Lean vscore-semantics/0.3 and data-pipeline/0.3 serialization. Input represents the JSON object {n,m,a,b} with integer fields; output represents an exact JSON integer. Integers are unbounded mathematical integers. Strings contain Unicode scalar values and lexicographic ordering compares scalar codepoints.",
      "scope": ["source artifact", "typed input and output", "normative semantics and serialization"],
      "dependencies": [],
      "acceptance_criteria": [
        "The canonical file is program.vscore.json with exactly one admitted typed entry solve of arity 1.",
        "Typed input represents {n,m,a,b} and typed output represents an exact JSON integer.",
        "Source and serialization follow vscore/0.3, normative Lean vscore-semantics/0.3 and data-pipeline/0.3.",
        "Integer and string semantics match the stated mathematical and Unicode domains."
      ],
      "sources": [
        {"clause_id": "C2", "origin": "explicit", "interpretation": "Artifact and entry identity."},
        {"clause_id": "C3", "origin": "explicit", "interpretation": "Typed JSON representation."},
