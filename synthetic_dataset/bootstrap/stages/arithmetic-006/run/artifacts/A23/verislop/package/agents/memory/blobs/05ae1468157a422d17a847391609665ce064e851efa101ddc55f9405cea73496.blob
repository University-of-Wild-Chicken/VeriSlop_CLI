{"lean_source":"import Std\n\n-- BEGIN VERISLOP REGISTRY\n-- Generated by `verislop formalize`. Typed obligation metadata: an index, never evidence.\nnamespace VeriSlop.Registry\n\nstructure SourceRef where\n  documentRef : String\n  documentHash : String\n  startByte : Nat\n  endByte : Nat\n  origin : String\n  interpretation : String\n\nstructure Dependency where\n  id : String\n  relation : String\n\nstructure Entry where\n  id : String\n  revision : Nat\n  kind : String\n  role : String\n  statement : String\n  required : Bool\n  sourceRefs : List SourceRef\n  scope : List String\n  dependencies : List Dependency\n  acceptanceCriteria : List String\n  bindings : List String\n\ndef «D1» : Entry := {\n  id := \"D1\",\n  revision := 1,\n  kind := \"entity\",\n  role := \"declaration\",\n  statement := \"Input is a JSON object with integer fields n, m, a and b; output is a JSON-serializable integer.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 125, endByte := 175, origin := \"explicit\", interpretation := \"JSON compatibility\" }, { documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 372, endByte := 456, origin := \"explicit\", interpretation := \"Input schema and numeric domain\" }, { documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 729, endByte := 802, origin := \"explicit\", interpretation := \"JSON interface\" }, { documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 803, endByte := 868, origin := \"explicit\", interpretation := \"Preserve object input and scalar output structure; summation indices follow the specified order\" }],\n  scope := [\"input and output\"],\n  dependencies := [],\n  acceptanceCriteria := [\"Input structure is {n,m,a,b}; output is a scalar integer.\", \"The domain has 0<=n<=500, m>0, and arbitrary signed integers a and b, including magnitudes of 10^30.\"],\n  bindings := [\"VeriSlopAST.Input\", \"VeriSlopAST.solve\"] }\n\ndef «A1» : Entry := {\n  id := \"A1\",\n  revision := 1,\n  kind := \"precondition\",\n  role := \"assumption\",\n  statement := \"All supplied inputs satisfy the stated schema and bounds.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 269, endByte := 326, origin := \"explicit\", interpretation := \"Explicit supplied-input validity assumption\" }, { documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 372, endByte := 456, origin := \"explicit\", interpretation := \"Schema and bounds covered by the assumption\" }],\n  scope := [\"supplied inputs\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }],\n  acceptanceCriteria := [\"Supplied input contains integer n,m,a,b with 0<=n<=500 and m>0.\"],\n  bindings := [\"VeriSlopAST.valid_input\"] }\n\ndef «O1» : Entry := {\n  id := \"O1\",\n  revision := 1,\n  kind := \"postcondition\",\n  role := \"guarantee\",\n  statement := \"For every valid input, return the exact integer sum of floor((a*i+b)/m) over i=0 through n-1, with floor directed toward negative infinity.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 457, endByte := 507, origin := \"explicit\", interpretation := \"Exact floor-sum result\" }, { documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 508, endByte := 561, origin := \"explicit\", interpretation := \"Negative-infinity floor semantics\" }, { documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 562, endByte := 580, origin := \"explicit\", interpretation := \"Empty-sum behavior\" }, { documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 870, endByte := 1052, origin := \"explicit\", interpretation := \"Required public examples and full-domain applicability\" }],\n  scope := [\"all valid inputs\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }, { id := \"A1\", relation := \"assumes\" }],\n  acceptanceCriteria := [\"Result equals sum_{i=0}^{n-1} floor((a*i+b)/m).\", \"For each term q=floor((a*i+b)/m), q*m<=a*i+b<(q+1)*m, including negative numerators.\", \"For n=0, return 0.\", \"Input {a:-2,b:1,m:3,n:4} returns -4.\", \"Input {a:100,b:-99,m:7,n:0} returns 0.\", \"Correctness holds across the entire stated domain, including held-out cases and large signed operands.\"],\n  bindings := [\"VeriSlopAST.floor_sum_correct\"] }\n\ndef «O2» : Entry := {\n  id := \"O2\",\n  revision := 1,\n  kind := \"postcondition\",\n  role := \"guarantee\",\n  statement := \"Implement solution.py with a single pure deterministic Python 3 function solve(data).\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 67, endByte := 124, origin := \"explicit\", interpretation := \"Required file and function\" }, { documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 604, endByte := 680, origin := \"explicit\", interpretation := \"Python 3, purity and determinism\" }],\n  scope := [\"solution.py\", \"solve(data)\"],\n  dependencies := [],\n  acceptanceCriteria := [\"solution.py exposes the requested single solve(data) function.\", \"Repeated calls with the same input produce the same result.\", \"The function has no externally observable side effects.\"],\n  bindings := [\"VeriSlopAST.pure_integer_computation\"] }\n\ndef «S1» : Entry := {\n  id := \"S1\",\n  revision := 1,\n  kind := \"safety_property\",\n  role := \"guarantee\",\n  statement := \"Use only the Python 3 standard library, perform no external I/O, and do not read benchmark files.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 176, endByte := 211, origin := \"explicit\", interpretation := \"Standard-library restriction\" }, { documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 212, endByte := 268, origin := \"explicit\", interpretation := \"External I/O and benchmark-reading prohibition\" }, { documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 681, endByte := 728, origin := \"explicit\", interpretation := \"Repeated library and I/O restrictions\" }],\n  scope := [\"implementation and execution\"],\n  dependencies := [],\n  acceptanceCriteria := [\"No third-party libraries are used.\", \"Execution performs no external I/O.\", \"Benchmark files are never read.\"],\n  bindings := [\"VeriSlopAST.pure_integer_computation\"] }\n\ndef «S2» : Entry := {\n  id := \"S2\",\n  revision := 1,\n  kind := \"safety_property\",\n  role := \"guarantee\",\n  statement := \"Compute the result without floating-point arithmetic.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 581, endByte := 602, origin := \"explicit\", interpretation := \"Avoid floating point\" }, { documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 457, endByte := 507, origin := \"explicit\", interpretation := \"Exact computation\" }],\n  scope := [\"numeric computation\"],\n  dependencies := [],\n  acceptanceCriteria := [\"No floating-point arithmetic or conversions are used to calculate the sum.\", \"Large signed operands retain exact integer precision.\"],\n  bindings := [\"VeriSlopAST.pure_integer_computation\"] }\n\ndef «N1» : Entry := {\n  id := \"N1\",\n  revision := 1,\n  kind := \"explicit_non_goal\",\n  role := \"exclusion\",\n  statement := \"No behavior is required for malformed input.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 327, endByte := 371, origin := \"explicit\", interpretation := \"Explicit exclusion of malformed-input behavior\" }],\n  scope := [\"inputs outside the stated schema or bounds\"],\n  dependencies := [],\n  acceptanceCriteria := [\"Malformed-input validation and error behavior are outside the required contract.\"],\n  bindings := [] }\n\ndef «valid_input_witness» : Entry := {\n  id := \"valid_input_witness\",\n  revision := 1,\n  kind := \"non_vacuity\",\n  role := \"guarantee\",\n  statement := \"Non-vacuity: The concrete input n=0, m=1, a=0, b=0 satisfies the supplied schema and bounds. (witnesses A1)\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 269, endByte := 326, origin := \"inferred\", interpretation := \"derived by registered rule verislop.non-vacuity/0.1 from assumption A1\" }, { documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 372, endByte := 456, origin := \"inferred\", interpretation := \"derived by registered rule verislop.non-vacuity/0.1 from assumption A1\" }],\n  scope := [\"supplied inputs\"],\n  dependencies := [{ id := \"A1\", relation := \"uses_definition\" }],\n  acceptanceCriteria := [\"Prove the existential theorem with concrete witnesses extractable by bounded kernel head-normalisation.\"],\n  bindings := [\"VeriSlopAST.valid_input_exists\"] }\n\ndef entries : List Entry := [«D1», «A1», «O1», «O2», «S1», «S2», «N1», «valid_input_witness»]\n\nend VeriSlop.Registry\n-- END VERISLOP REGISTRY\n\nnamespace VeriSlopAST\nstructure «Input» where\n  «n» : _root_.Int\n  «m» : _root_.Int\n  «a» : _root_.Int\n  «b» : _root_.Int\ndef «solve» («_v0» : _root_.VeriSlopAST.«Input») : _root_.Int := (_root_.List.sum (@_root_.List.map _root_.Nat _root_.Int (fun («_v1» : _root_.Nat) => (_root_.Int.fdiv (_root_.Int.add (_root_.Int.mul (_root_.VeriSlopAST.«Input».«a» «_v0») (_root_.Int.ofNat «_v1»)) (_root_.VeriSlopAST.«Input».«b» «_v0»)) (_root_.VeriSlopAST.«Input».«m» «_v0»))) (_root_.List.range (_root_.Int.toNat (_root_.VeriSlopAST.«Input».«n» «_v0»)))))\ntheorem «_vs_body_solve» : (∀ («_v0» : _root_.VeriSlopAST.«Input»), ((_root_.VeriSlopAST.«solve» «_v0») = (_root_.List.sum (@_root_.List.map _root_.Nat _root_.Int (fun («_v1» : _root_.Nat) => (_root_.Int.fdiv (_root_.Int.add (_root_.Int.mul (_root_.VeriSlopAST.«Input».«a» «_v0») (_root_.Int.ofNat «_v1»)) (_root_.VeriSlopAST.«Input».«b» «_v0»)) (_root_.VeriSlopAST.«Input».«m» «_v0»))) (_root_.List.range (_root_.Int.toNat (_root_.VeriSlopAST.«Input».«n» «_v0»))))))) := by intros; rfl\n@[reducible] def «valid_input» («_v0» : _root_.VeriSlopAST.«Input») : Prop := ((((_root_.Int.ofNat 0) ≤ (_root_.VeriSlopAST.«Input».«n» «_v0»)) ∧ ((_root_.VeriSlopAST.«Input».«n» «_v0») ≤ (_root_.Int.ofNat 500))) ∧ ((_root_.Int.ofNat 0) < (_root_.VeriSlopAST.«Input».«m» «_v0»)))\ntheorem «_vs_predicate_valid_input» («_v0» : _root_.VeriSlopAST.«Input») : ((_root_.VeriSlopAST.«valid_input» «_v0») ↔ ((((_root_.Int.ofNat 0) ≤ (_root_.VeriSlopAST.«Input».«n» «_v0»)) ∧ ((_root_.VeriSlopAST.«Input».«n» «_v0») ≤ (_root_.Int.ofNat 500))) ∧ ((_root_.Int.ofNat 0) < (_root_.VeriSlopAST.«Input».«m» «_v0»)))) := by rfl\ntheorem «floor_sum_correct» : (∀ («_v0» : _root_.VeriSlopAST.«Input»), ((_root_.VeriSlopAST.«valid_input» «_v0») → ((_root_.VeriSlopAST.«solve» «_v0») = (_root_.List.sum (@_root_.List.map _root_.Nat _root_.Int (fun («_v1» : _root_.Nat) => (_root_.Int.fdiv (_root_.Int.add (_root_.Int.mul (_root_.VeriSlopAST.«Input».«a» «_v0») (_root_.Int.ofNat «_v1»)) (_root_.VeriSlopAST.«Input».«b» «_v0»)) (_root_.VeriSlopAST.«Input».«m» «_v0»))) (_root_.List.range (_root_.Int.toNat (_root_.VeriSlopAST.«Input».«n» «_v0»)))))))) := by intro x hx; rfl\ntheorem «pure_integer_computation» : (∀ («_v0» : _root_.VeriSlopAST.«Input»), ((_root_.VeriSlopAST.«solve» «_v0») = (_root_.List.sum (@_root_.List.map _root_.Nat _root_.Int (fun («_v1» : _root_.Nat) => (_root_.Int.fdiv (_root_.Int.add (_root_.Int.mul (_root_.VeriSlopAST.«Input».«a» «_v0») (_root_.Int.ofNat «_v1»)) (_root_.VeriSlopAST.«Input».«b» «_v0»)) (_root_.VeriSlopAST.«Input».«m» «_v0»))) (_root_.List.range (_root_.Int.toNat (_root_.VeriSlopAST.«Input».«n» «_v0»))))))) := by intro x; rfl\ntheorem «valid_input_exists» : (∃ («_v0» : _root_.VeriSlopAST.«Input»), ((«_v0» = (_root_.VeriSlopAST.«Input».«mk» (_root_.Int.ofNat 0) (_root_.Int.ofNat 1) (_root_.Int.ofNat 0) (_root_.Int.ofNat 0))) ∧ (_root_.VeriSlopAST.«valid_input» «_v0»))) := by\n  refine ⟨({ «n» := 0, «m» := 1, «a» := 0, «b» := 0 } : _root_.VeriSlopAST.«Input»), ?_⟩\n  constructor\n  · rfl\n  · decide\nend VeriSlopAST\n\n"}