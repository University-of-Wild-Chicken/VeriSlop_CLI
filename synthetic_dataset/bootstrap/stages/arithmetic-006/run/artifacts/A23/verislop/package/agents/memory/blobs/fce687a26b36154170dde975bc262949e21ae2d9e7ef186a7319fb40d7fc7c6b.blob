{"obligations":[{"id":"D1","kind":"entity","role":"declaration","statement":"Input is a JSON object with integer fields n, m, a and b; output is a JSON-serializable integer.","required":true,"scope":["input and output"],"dependencies":[],"acceptance_criteria":["Input structure is {n,m,a,b}; output is a scalar integer.","The domain has 0<=n<=500, m>0, and arbitrary signed integers a and b, including magnitudes of 10^30."],"sources":[{"clause_id":"C3","origin":"explicit","interpretation":"JSON compatibility"},{"clause_id":"C8","origin":"explicit","interpretation":"Input schema and numeric domain"},{"clause_id":"C15","origin":"explicit","interpretation":"JSON interface"},{"clause_id":"C16","origin":"explicit","interpretation":"Preserve object input and scalar output structure; summation indices follow the specified order"}]},{"id":"A1","kind":"precondition","role":"assumption","statement":"All supplied inputs satisfy the stated schema and bounds.","required":true,"scope":["supplied inputs"],"dependencies":[{"id":"D1","relation":"uses_definition"}],"acceptance_criteria":["Supplied input contains integer n,m,a,b with 0<=n<=500 and m>0."],"sources":[{"clause_id":"C6","origin":"explicit","interpretation":"Explicit supplied-input validity assumption"},{"clause_id":"C8","origin":"explicit","interpretation":"Schema and bounds covered by the assumption"}]},{"id":"O1","kind":"postcondition","role":"guarantee","statement":"For every valid input, return the exact integer sum of floor((a*i+b)/m) over i=0 through n-1, with floor directed toward negative infinity.","required":true,"scope":["all valid inputs"],"dependencies":[{"id":"D1","relation":"uses_definition"},{"id":"A1","relation":"assumes"}],"acceptance_criteria":["Result equals sum_{i=0}^{n-1} floor((a*i+b)/m).","For each term q=floor((a*i+b)/m), q*m<=a*i+b<(q+1)*m, including negative numerators.","For n=0, return 0.","Input {a:-2,b:1,m:3,n:4} returns -4.","Input {a:100,b:-99,m:7,n:0} returns 0.","Correctness holds across the entire stated domain, including held-out cases and large signed operands."],"sources":[{"clause_id":"C9","origin":"explicit","interpretation":"Exact floor-sum result"},{"clause_id":"C10","origin":"explicit","interpretation":"Negative-infinity floor semantics"},{"clause_id":"C11","origin":"explicit","interpretation":"Empty-sum behavior"},{"clause_id":"C17","origin":"explicit","interpretation":"Required public examples and full-domain applicability"}]},{"id":"O2","kind":"postcondition","role":"guarantee","statement":"Implement solution.py with a single pure deterministic Python 3 function solve(data).","required":true,"scope":["solution.py","solve(data)"],"dependencies":[],"acceptance_criteria":["solution.py exposes the requested single solve(data) function.","Repeated calls with the same input produce the same result.","The function has no externally observable side effects."],"sources":[{"clause_id":"C2","origin":"explicit","interpretation":"Required file and function"},{"clause_id":"C13","origin":"explicit","interpretation":"Python 3, purity and determinism"}]},{"id":"S1","kind":"safety_property","role":"guarantee","statement":"Use only the Python 3 standard library, perform no external I/O, and do not read benchmark files.","required":true,"scope":["implementation and execution"],"dependencies":[],"acceptance_criteria":["No third-party libraries are used.","Execution performs no external I/O.","Benchmark files are never read."],"sources":[{"clause_id":"C4","origin":"explicit","interpretation":"Standard-library restriction"},{"clause_id":"C5","origin":"explicit","interpretation":"External I/O and benchmark-reading prohibition"},{"clause_id":"C14","origin":"explicit","interpretation":"Repeated library and I/O restrictions"}]},{"id":"S2","kind":"safety_property","role":"guarantee","statement":"Compute the result without floating-point arithmetic.","required":true,"scope":["numeric computation"],"dependencies":[],"acceptance_criteria":["No floating-point arithmetic or conversions are used to calculate the sum.","Large signed operands retain exact integer precision."],"sources":[{"clause_id":"C12","origin":"explicit","interpretation":"Avoid floating point"},{"clause_id":"C9","origin":"explicit","interpretation":"Exact computation"}]},{"id":"N1","kind":"explicit_non_goal","role":"exclusion","statement":"No behavior is required for malformed input.","required":true,"scope":["inputs outside the stated schema or bounds"],"dependencies":[],"acceptance_criteria":["Malformed-input validation and error behavior are outside the required contract."],"sources":[{"clause_id":"C7","origin":"explicit","interpretation":"Explicit exclusion of malformed-input behavior"}]}],"category_review":{"entities":"JSON object containing integer n,m,a,b and scalar integer output","preconditions":"Supplied inputs satisfy the stated schema and bounds","postconditions":"Exact signed floor sum, empty-sum and example behavior, and the specified pure deterministic solve interface","invariants":"None stated","safety_properties":"Standard library only; no external I/O, benchmark reads or floating-point computation","liveness_properties":"None stated","resource_constraints":"None stated","error_semantics":"Malformed-input behavior explicitly excluded","explicit_non_goals":"Malformed-input behavior","ambiguities":"None; scalar output has no ordering ambiguity"},"clauses":[{"clause_id":"C1","disposition":"context","refs":[],"note":"Task title identifies the signed arithmetic floor-sum kernel."},{"clause_id":"C2","disposition":"obligations","refs":["O2"],"note":""},{"clause_id":"C3","disposition":"obligations","refs":["D1"],"note":""},{"clause_id":"C4","disposition":"obligations","refs":["S1"],"note":""},{"clause_id":"C5","disposition":"obligations","refs":["S1"],"note":""},{"clause_id":"C6","disposition":"obligations","refs":["A1"],"note":""},{"clause_id":"C7","disposition":"exclusion","refs":["N1"],"note":""},{"clause_id":"C8","disposition":"obligations","refs":["D1","A1"],"note":""},{"clause_id":"C9","disposition":"obligations","refs":["O1"],"note":""},{"clause_id":"C10","disposition":"obligations","refs":["O1"],"note":""},{"clause_id":"C11","disposition":"obligations","refs":["O1"],"note":""},{"clause_id":"C12","disposition":"obligations","refs":["S2"],"note":""},{"clause_id":"C13","disposition":"obligations","refs":["O2"],"note":""},{"clause_id":"C14","disposition":"obligations","refs":["S1"],"note":""},{"clause_id":"C15","disposition":"obligations","refs":["D1"],"note":""},{"clause_id":"C16","disposition":"obligations","refs":["D1","O1"],"note":""},{"clause_id":"C17","disposition":"obligations","refs":["O1"],"note":""}],"assumptions":[{"id":"A1","supplied_by":"caller or input provider","discharged_at":"Each solve invocation by supplying an input satisfying the stated schema and bounds"}],"ambiguities":[],"selected_defaults":[]}