{"obligations":[{"id":"D1","revision":1,"kind":"entity","role":"declaration","statement":"solution.py exposes a single Python 3 solve(data) function receiving a JSON-compatible object with integer fields n, m, a, b and returning a JSON-serializable integer.","required":true,"scope":["implementation interface","input and output"],"dependencies":[],"acceptance_criteria":["solution.py exposes a single solve(data) function","Input structure is {n,m,a,b}","Output is a JSON-serializable scalar integer"],"sources":[{"quote":"Implement solution.py with a single solve(data) function.","origin":"explicit","interpretation":"Required interface"},{"quote":"data and the return value must be JSON-compatible.","origin":"explicit","interpretation":"JSON compatibility"},{"quote":"Input {n,m,a,b}: 0<=n<=500, m>0, a/b any signed integers (possibly magnitude 10^30).","origin":"explicit","interpretation":"Input fields and domain"},{"quote":"The function receives a JSON value and returns a JSON-serializable value.","origin":"explicit","interpretation":"Serialization interface"}]},{"id":"A1","revision":1,"kind":"precondition","role":"assumption","statement":"The input supplier supplies the stated schema and bounds: integer n between 0 and 500 inclusive, positive integer m, and arbitrary signed integers a and b, including magnitudes of 10^30.","required":true,"scope":["supplied inputs"],"dependencies":[{"id":"D1","relation":"uses_definition"}],"acceptance_criteria":["Inputs contain integer fields n,m,a,b","0<=n<=500 and m>0","a and b may be any signed integers; magnitude 10^30 is supported"],"sources":[{"quote":"All supplied inputs satisfy the stated schema and bounds;","origin":"explicit","interpretation":"Supplier assumption"},{"quote":"Input {n,m,a,b}: 0<=n<=500, m>0, a/b any signed integers (possibly magnitude 10^30).","origin":"explicit","interpretation":"Schema and bounds without an added upper bound on a or b"}]},{"id":"O1","revision":1,"kind":"postcondition","role":"guarantee","statement":"For every valid input, return the exact integer sum of floor((a*i+b)/m) over i=0..n-1, with floor toward negative infinity and zero for an empty sum; preserve the specified interface and index ordering.","required":true,"scope":["all inputs satisfying A1"],"dependencies":[{"id":"D1","relation":"uses_definition"},{"id":"A1","relation":"assumes"}],"acceptance_criteria":["Output equals the exact mathematical floor sum for every valid input","Each quotient is rounded toward negative infinity, including negative quotients","n=0 returns 0","The input object and scalar integer output structure are preserved","The specified index sequence is i=0..n-1"],"sources":[{"quote":"Return exact sum of floor((a*i+b)/m) for i=0..n-1.","origin":"explicit","interpretation":"Exact sum and index sequence"},{"quote":"Floor means toward negative infinity, not truncation.","origin":"explicit","interpretation":"Signed floor semantics"},{"quote":"Empty sum is zero;","origin":"explicit","interpretation":"Zero-length behavior"},{"quote":"Preserve the specified input/output structure and exact ordering.","origin":"explicit","interpretation":"Preserved interface and specified ordering"}]},{"id":"S1","revision":1,"kind":"safety_property","role":"guarantee","statement":"solve is pure and deterministic, performs no external I/O, and does not read benchmark files.","required":true,"scope":["solve execution"],"dependencies":[{"id":"D1","relation":"uses_definition"}],"acceptance_criteria":["Equal inputs produce equal outputs","Execution has no externally observable side effects and does not mutate the supplied input","No external I/O or benchmark-file reads occur"],"sources":[{"quote":"Implement a pure deterministic Python 3 function solve(data) in solution.py.","origin":"explicit","interpretation":"Purity and determinism"},{"quote":"perform no external I/O and do not read benchmark files.","origin":"explicit","interpretation":"I/O and benchmark access prohibition"},{"quote":"Use only the standard library, no external I/O.","origin":"explicit","interpretation":"Repeated I/O restriction"}]},{"id":"R1","revision":1,"kind":"resource_constraint","role":"guarantee","statement":"Use Python 3 and only its standard library; calculate the sum without floating point.","required":true,"scope":["implementation","arithmetic"],"dependencies":[{"id":"D1","relation":"uses_definition"}],"acceptance_criteria":["Implementation runs under Python 3","Only standard-library dependencies are used","No floating-point arithmetic is used to calculate the sum"],"sources":[{"quote":"Use Python 3 standard library only;","origin":"explicit","interpretation":"Runtime and library restriction"},{"quote":"Use only the standard library, no external I/O.","origin":"explicit","interpretation":"Repeated library restriction"},{"quote":"avoid floating point.","origin":"explicit","interpretation":"Arithmetic restriction"}]},{"id":"N1","revision":1,"kind":"explicit_non_goal","role":"exclusion","statement":"Behavior for malformed inputs is outside the required scope.","required":true,"scope":["inputs violating the stated schema or bounds"],"dependencies":[],"acceptance_criteria":["No validation or error behavior is required for malformed input"],"sources":[{"quote":"no behavior is required for malformed input.","origin":"explicit","interpretation":"Explicit exclusion"}]},{"id":"O2","revision":1,"kind":"postcondition","role":"guarantee","statement":"The public examples return -4 for {a:-2,b:1,m:3,n:4} and 0 for {a:100,b:-99,m:7,n:0}.","required":true,"scope":["public examples"],"dependencies":[{"id":"O1","relation":"uses_proof"}],"acceptance_criteria":["solve({a:-2,b:1,m:3,n:4}) returns -4","solve({a:100,b:-99,m:7,n:0}) returns 0"],"sources":[{"quote":"Public examples (additional held-out cases will be scored):\n[{\"input\": {\"a\": -2, \"b\": 1, \"m\": 3, \"n\": 4}, \"output\": -4}, {\"input\": {\"a\": 100, \"b\": -99, \"m\": 7, \"n\": 0}, \"output\": 0}]","origin":"explicit","interpretation":"Required example outputs; held-out scoring does not limit the universal guarantee"}]}],"category_review":{"entities":"Python 3 solution.py, single solve(data), JSON object input and integer output","preconditions":"Explicit supplier guarantee of schema and bounds","postconditions":"Exact signed floor sum, empty sum zero, preserved structure and ordering, public examples","invariants":"None separately stated","safety_properties":"Purity, determinism, no external I/O or benchmark-file reads","liveness_properties":"None separately stated","resource_constraints":"Python 3 standard library only; no floating point","error_semantics":"Malformed-input behavior excluded","explicit_non_goals":"Malformed inputs","ambiguities":"None requiring resolution"},"clauses":[{"clause_id":"C1","quote":"Software engineering task A23: Signed arithmetic floor-sum kernel","disposition":"context","refs":[],"note":"Task identifier and title"},{"clause_id":"C2","quote":"Implement solution.py with a single solve(data) function.","disposition":"obligations","refs":["D1"],"note":""},{"clause_id":"C3","quote":"data and the return value must be JSON-compatible.","disposition":"obligations","refs":["D1"],"note":""},{"clause_id":"C4","quote":"Use Python 3 standard library only;","disposition":"obligations","refs":["R1"],"note":""},{"clause_id":"C5","quote":"perform no external I/O and do not read benchmark files.","disposition":"obligations","refs":["S1"],"note":""},{"clause_id":"C6","quote":"All supplied inputs satisfy the stated schema and bounds;","disposition":"obligations","refs":["A1"],"note":""},{"clause_id":"C7","quote":"no behavior is required for malformed input.","disposition":"exclusion","refs":["N1"],"note":""},{"clause_id":"C8","quote":"Input {n,m,a,b}: 0<=n<=500, m>0, a/b any signed integers (possibly magnitude 10^30).","disposition":"obligations","refs":["D1","A1"],"note":""},{"clause_id":"C9","quote":"Return exact sum of floor((a*i+b)/m) for i=0..n-1.","disposition":"obligations","refs":["O1"],"note":""},{"clause_id":"C10","quote":"Floor means toward negative infinity, not truncation.","disposition":"obligations","refs":["O1"],"note":""},{"clause_id":"C11","quote":"Empty sum is zero;","disposition":"obligations","refs":["O1"],"note":""},{"clause_id":"C12","quote":"avoid floating point.","disposition":"obligations","refs":["R1"],"note":""},{"clause_id":"C13","quote":"Implement a pure deterministic Python 3 function solve(data) in solution.py.","disposition":"obligations","refs":["D1","S1","R1"],"note":""},{"clause_id":"C14","quote":"Use only the standard library, no external I/O.","disposition":"obligations","refs":["R1","S1"],"note":""},{"clause_id":"C15","quote":"The function receives a JSON value and returns a JSON-serializable value.","disposition":"obligations","refs":["D1"],"note":""},{"clause_id":"C16","quote":"Preserve the specified input/output structure and exact ordering.","disposition":"obligations","refs":["D1","O1"],"note":""},{"clause_id":"C17","quote":"Public examples (additional held-out cases will be scored):\n[{\"input\": {\"a\": -2, \"b\": 1, \"m\": 3, \"n\": 4}, \"output\": -4}, {\"input\": {\"a\": 100, \"b\": -99, \"m\": 7, \"n\": 0}, \"output\": 0}]","disposition":"obligations","refs":["O2"],"note":"Example outputs constrain behavior; held-out scoring is evaluation context."}],"assumptions":[{"id":"A1","supplied_by":"input supplier","discharged_at":"function invocation by supplying an input satisfying the stated schema and bounds"}],"ambiguities":[],"selected_defaults":[]}