{"files":{"implementation.py":"def solve(x):\n    if x['m'] == 0 or x['n'] <= 0:\n        return 0\n    total = 0\n    for i in range(x['n']):\n        total += (x['a'] * i + x['b']) // x['m']\n    return total\n"},"bindings":{"schema_version":"0.1","artifact_kind":"implementation_bindings","target":"python","serialization_profile":"python-v0_2","bindings":[{"binding_id":"B-solve","symbol":"solve","object":{"file":"implementation.py","qualname":"solve"},"obligations":["D1","O1","O2","R1","S1"]}],"helpers":[]}}