, origin := \"explicit\", interpretation := \"I/O and benchmark access prohibition\" }, { documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 681, endByte := 728, origin := \"explicit\", interpretation := \"Repeated I/O restriction\" }],\n  scope := [\"solve execution\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }],\n  acceptanceCriteria := [\"Equal inputs produce equal outputs\", \"Execution has no externally observable side effects and does not mutate the supplied input\", \"No external I/O or benchmark-file reads occur\"],\n  bindings := [\"VeriSlopAST.exact_behavior\"] }\n\ndef «R1» : Entry := {\n  id := \"R1\",\n  revision := 1,\n  kind := \"resource_constraint\",\n  role := \"guarantee\",\n  statement := \"Use Python 3 and only its standard library; calculate the sum without floating point.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 176, endByte := 211, origin := \"explicit\", interpretation := \"Runtime and library restriction\" }, { documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 681, endByte := 728, origin := \"explicit\", interpretation := \"Repeated library restriction\" }, { documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 581, endByte := 602, origin := \"explicit\", interpretation := \"Arithmetic restriction\" }],\n  scope := [\"implementation\", \"arithmetic\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }],\n  acceptanceCriteria := [\"Implementation runs under Python 3\", \"Only standard-library dependencies are used\", \"No floating-point arithmetic is used to calculate the sum\"],\n  bindings := [\"VeriSlopAST.exact_behavior\"] }\n\ndef «N1» : Entry := {\n  id := \"N1\",\n  revision := 1,\n  kind := \"explicit_non_goal\",\n  role := \"exclusion\",\n  statement := \"Behavior for malformed inputs is outside the required scope.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 327, endByte := 371, origin := \"explicit\", interpretation := \"Explicit exclusion\" }],\n  scope := [\"inputs violating the stated schema or bounds\"],\n  dependencies := [],\n  acceptanceCriteria := [\"No validation or error behavior is required for malformed input\"],\n  bindings := [] }\n\ndef «input_satisfiability» : Entry := {\n  id := \"input_satisfiability\",\n  revision := 1,\n  kind := \"non_vacuity\",\n  role := \"guarantee\",\n  statement := \"Non-vacuity: The Input record with n=0, m=1, a=0 and b=0 satisfies valid_input. (witnesses A1)\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 269, endByte := 326, origin := \"inferred\", interpretation := \"derived by registered rule verislop.non-vacuity/0.1 from assumption A1\" }, { documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 372, endByte := 456, origin := \"inferred\", interpretation := \"derived by registered rule verislop.non-vacuity/0.1 from assumption A1\" }],\n  scope := [\"supplied inputs\"],\n  dependencies := [{ id := \"A1\", relation := \"uses_definition\" }],\n  acceptanceCriteria := [\"Prove the existential theorem with concrete witnesses extractable by bounded kernel head-normalisation.\"],\n  bindings := [\"VeriSlopAST.valid_input_exists\"] }\n\ndef entries : List Entry := [«D1», «A1», «O1», «O2», «S1», «R1», «