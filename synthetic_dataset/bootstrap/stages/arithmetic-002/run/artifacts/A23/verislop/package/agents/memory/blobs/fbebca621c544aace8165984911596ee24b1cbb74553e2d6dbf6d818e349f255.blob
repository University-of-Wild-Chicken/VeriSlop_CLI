{"agent_attempt":0,"best":"import Std\n\n-- BEGIN VERISLOP REGISTRY\n-- Generated by `verislop formalize`. Typed obligation metadata: an index, never evidence.\nnamespace VeriSlop.Registry\n\nstructure SourceRef where\n  documentRef : String\n  documentHash : String\n  startByte : Nat\n  endByte : Nat\n  origin : String\n  interpretation : String\n\nstructure Dependency where\n  id : String\n  relation : String\n\nstructure Entry where\n  id : String\n  revision : Nat\n  kind : String\n  role : String\n  statement : String\n  required : Bool\n  sourceRefs : List SourceRef\n  scope : List String\n  dependencies : List Dependency\n  acceptanceCriteria : List String\n  bindings : List String\n\ndef «D1» : Entry := {\n  id := \"D1\",\n  revision := 1,\n  kind := \"entity\",\n  role := \"declaration\",\n  statement := \"solution.py exposes a single Python 3 solve(data) function receiving a JSON-compatible object with integer fields n, m, a, b and returning a JSON-serializable integer.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 67, endByte := 124, origin := \"explicit\", interpretation := \"Required interface\" }, { documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 125, endByte := 175, origin := \"explicit\", interpretation := \"JSON compatibility\" }, { documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 372, endByte := 456, origin := \"explicit\", interpretation := \"Input fields and domain\" }, { documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 729, endByte := 802, origin := \"explicit\", interpretation := \"Serialization interface\" }],\n  scope := [\"implementation interface\", \"input and output\"],\n  dependencies := [],\n  acceptanceCriteria := [\"solution.py exposes a single solve(data) function\", \"Input structure is {n,m,a,b}\", \"Output is a JSON-serializable scalar integer\"],\n  bindings := [\"VeriSlopAST.Input\", \"VeriSlopAST.solve\"] }\n\ndef «A1» : Entry := {\n  id := \"A1\",\n  revision := 1,\n  kind := \"precondition\",\n  role := \"assumption\",\n  statement := \"The input supplier supplies the stated schema and bounds: integer n between 0 and 500 inclusive, positive integer m, and arbitrary signed integers a and b, including magnitudes of 10^30.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 269, endByte := 326, origin := \"explicit\", interpretation := \"Supplier assumption\" }, { documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 372, endByte := 456, origin := \"explicit\", interpretation := \"Schema and bounds without an added upper bound on a or b\" }],\n  scope := [\"supplied inputs\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }],\n  acceptanceCriteria := [\"Inputs contain integer fields n,m,a,b\", \"0<=n<=500 and m>0\", \"a and b may be any signed integers; magnitude 10^30 is supported\"],\n  bindings := [\"VeriSlopAST.valid_input\"] }\n\ndef «O1» : Entry := {\n  id := \"O1\",\n  revision := 1,\n  kind := \"postcondition\",\n  role := \"guarantee\",\n  statement := \"For every valid input, return the exact integer sum of floor((a*i+b)/m) over i=0..n-1, with floor toward negative infinity and zero for an empty sum; preserve the specified interface and index ordering.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 457, endByte := 507, origin := \"explicit\", interpretation := \"Exact sum and index sequence\" }, { documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 508, endByte := 561, origin := \"explicit\", interpretation := \"Signed floor semantics\" }, { documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 562, endByte := 580, origin := \"explicit\", interpretation := \"Zero-length behavior\" }, { documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 803, endByte := 868, origin := \"explicit\", interpretation := \"Preserved interface and specified ordering\" }],\n  scope := [\"all inputs satisfying A1\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }, { id := \"A1\", relation := \"assumes\" }],\n  acceptanceCriteria := [\"Output equals the exact mathematical floor sum for every valid input\", \"Each quotient is rounded toward negative infinity, including negative quotients\", \"n=0 returns 0\", \"The input object and scalar integer output structure are preserved\", \"The specified index sequence is i=0..n-1\"],\n  bindings := [\"VeriSlopAST.exact_behavior\"] }\n\ndef «O2» : Entry := {\n  id := \"O2\",\n  revision := 1,\n  kind := \"postcondition\",\n  role := \"guarantee\",\n  statement := \"The public examples return -4 for {a:-2,b:1,m:3,n:4} and 0 for {a:100,b:-99,m:7,n:0}.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 870, endByte := 1052, origin := \"explicit\", interpretation := \"Required example outputs; held-out scoring does not limit the universal guarantee\" }],\n  scope := [\"public examples\"],\n  dependencies := [{ id := \"O1\", relation := \"uses_proof\" }],\n  acceptanceCriteria := [\"solve({a:-2,b:1,m:3,n:4}) returns -4\", \"solve({a:100,b:-99,m:7,n:0}) returns 0\"],\n  bindings := [\"VeriSlopAST.public_examples\"] }\n\ndef «S1» : Entry := {\n  id := \"S1\",\n  revision := 1,\n  kind := \"safety_property\",\n  role := \"guarantee\",\n  statement := \"solve is pure and deterministic, performs no external I/O, and does not read benchmark files.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 604, endByte := 680, origin := \"explicit\", interpretation := \"Purity and determinism\" }, { documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 212, endByte := 268, origin := \"explicit\", interpretation := \"I/O and benchmark access prohibition\" }, { documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 681, endByte := 728, origin := \"explicit\", interpretation := \"Repeated I/O restriction\" }],\n  scope := [\"solve execution\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }],\n  acceptanceCriteria := [\"Equal inputs produce equal outputs\", \"Execution has no externally observable side effects and does not mutate the supplied input\", \"No external I/O or benchmark-file reads occur\"],\n  bindings := [\"VeriSlopAST.exact_behavior\"] }\n\ndef «R1» : Entry := {\n  id := \"R1\",\n  revision := 1,\n  kind := \"resource_constraint\",\n  role := \"guarantee\",\n  statement := \"Use Python 3 and only its standard library; calculate the sum without floating point.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 176, endByte := 211, origin := \"explicit\", interpretation := \"Runtime and library restriction\" }, { documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 681, endByte := 728, origin := \"explicit\", interpretation := \"Repeated library restriction\" }, { documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 581, endByte := 602, origin := \"explicit\", interpretation := \"Arithmetic restriction\" }],\n  scope := [\"implementation\", \"arithmetic\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }],\n  acceptanceCriteria := [\"Implementation runs under Python 3\", \"Only standard-library dependencies are used\", \"No floating-point arithmetic is used to calculate the sum\"],\n  bindings := [\"VeriSlopAST.exact_behavior\"] }\n\ndef «N1» : Entry := {\n  id := \"N1\",\n  revision := 1,\n  kind := \"explicit_non_goal\",\n  role := \"exclusion\",\n  statement := \"Behavior for malformed inputs is outside the required scope.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tasks/A23/prompt.txt\", documentHash := \"sha256:4210b881ec112b3ceaf86658d8a931f6d4dea05689a85d3e7e72aed9da3911dd\", startByte := 327, endByte := 371, origin := \"explicit\", interpretation := \"Explicit exclusion\" }],\n  scope := [\"inputs violating the stated schema or bounds\"],\n  dependencies := [],\n  acceptanceCriteria := [\"No validation or error behavior is required for malformed input\"],\n  bindings := [] }\n\ndef «input_satisfiability» : Entry := {\n  id := \"input_satisfiability\",\n  revision := 1,\n  kind := \"non_vacuity\",\n  role := \"guarantee\",\n  statement := \"Non-vacuity: The Input record with n=0, m=1, a=0 and b=0 satisfies valid_input. (witnesses A1)\",\n  required := true,\n  sourceRefs := [{ documentRef :=