{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:verislop:schema:formalization-candidate:0.1",
  "title": "Untrusted formalization proposal: obligation-to-Lean bindings for a candidate Lean file",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "artifact_kind": {
      "const": "formalization_candidate"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
    },
    "lean_toolchain": {
      "type": "string",
      "minLength": 1
    },
    "lean_file": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+\\.lean$"
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "obligation": {
            "type": "string",
            "minLength": 1
          },
          "theorem": {
            "type": "string",
            "minLength": 1
          },
          "predicate": {
            "type": "string",
            "minLength": 1
          },
          "declarations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "native_requirements": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "value_projection": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "obligation"
        ]
      }
    },
    "internal_obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "kind": {
            "const": "non_vacuity"
          },
          "theorem": {
            "type": "string",
            "minLength": 1
          },
          "witnesses_for": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "theorem",
          "witnesses_for",
          "description"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "artifact_kind",
    "profile_id",
    "lean_toolchain",
    "lean_file",
    "bindings",
    "internal_obligations"
  ]
}
