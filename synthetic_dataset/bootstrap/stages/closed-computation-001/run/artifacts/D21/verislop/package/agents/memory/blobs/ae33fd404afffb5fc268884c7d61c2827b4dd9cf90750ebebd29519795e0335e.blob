"origin":"explicit","start_byte":367}],"state":"INTERPRETED","statement":"Derive groups from all unique event group names and sort them lexicographically, including groups whose events all fall outside the requested interval."},{"acceptance_criteria":["Each group has exactly the specified bucket starts in ascending order.","Bucket lower boundaries are inclusive and upper boundaries are exclusive.","The last bucket is clipped at end.","start = end yields an empty result."],"dependencies":[{"id":"D1","relation":"uses_definition"},{"id":"O2","relation":"uses_proof"}],"id":"O3","kind":"postcondition","lifecycle":{"END_TO_END_VERIFIED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"FORMALIZED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"IMPLEMENTED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"INTERPRETED":{"evidence_refs":["provenance:tasks/D21/prompt.txt"],"outcome":"PASS","reason":"Recorded interpretation proposal; not mathematical proof.","scope":["recorded interpretation of the request"]},"LINKED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"PROVED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"TESTED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"TYPECHECKED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]}},"required":true,"revision":1,"role":"guarantee","scope":["bucket enumeration and boundaries"],"source_refs":[{"document_hash":"sha256:1e1a8ccb008420489eab50ddfe73e1632b674ccb2202aeced608a233f7ac3296","document_ref":"tasks/D21/prompt.txt","end_byte":534,"interpretation":"Bucket start sequence for each group.","origin":"explicit","start_byte":475},{"document_hash":"sha256:1e1a8ccb008420489eab50ddfe73e1632b674ccb2202aeced608a233f7ac3296","document_ref":"tasks/D21/prompt.txt","end_byte":610,"interpretation":"Strict stopping boundary and half-open bucket intervals.","origin":"explicit","start_byte":535}],"state":"INTERPRETED","statement":"For every group emit one bucket for each start + k*width with integer k >= 0 and bucket start strictly below end; its interval is [bucketStart, min(bucketStart + width, end))."},{"acceptance_criteria":["count equals the number of non-null matching event occurrences in the bucket.","sum equals the integer sum of those occurrences.","Null values contribute neither to count nor sum.","Events outside [start,end) contribute neither to count nor sum.","Duplicate occurrences each contribute independently."],"dependencies":[{"id":"D1","relation":"uses_definition"},{"id":"O3","relation":"uses_proof"}],"id":"O4","kind":"postcondition","lifecycle":{"END_TO_END_VERIFIED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"FORMALIZED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"IMPLEMENTED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"INTERPRETED":{"evidence_refs":["provenance:tasks/D21/prompt.txt"],"outcome":"PASS","reason":"Recorded interpretation proposal; not mathematical proof.","scope":["recorded interpretation of the request"]},"LINKED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"PROVED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"TESTED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"TYPECHECKED":{"evidence_refs":[],"o