FROZEN INTERPRETED OBLIGATIONS (data):
[
 {
  "id": "D1",
  "kind": "entity",
  "role": "declaration",
  "statement": "Input is an object containing events, start, end, width and fill. Each event has a string group, integer time and integer or null value; start and end are integers, width is a positive integer, fill is 'none' or 'previous', and start <= end.",
  "required": true,
  "dependencies": [],
  "acceptance_criteria": [
   "The specified input fields and types define the supported domain, including empty events and start = end."
  ],
  "blocked_by": []
 },
 {
  "id": "O1",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "Provide a pure deterministic Python 3 solve(data) function in solution.py accepting JSON-compatible Python input and returning a JSON-serializable result.",
  "required": true,
  "dependencies": [
   {
    "id": "D1",
    "relation": "uses_definition"
   }
  ],
  "acceptance_criteria": [
   "solution.py exposes solve(data).",
   "Repeated calls with equal input return equal results.",
   "The function has no externally observable side effects and does not mutate its input.",
   "The result is JSON-serializable."
  ],
  "blocked_by": []
 },
 {
  "id": "O2",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "Derive groups from all unique event group names and sort them lexicographically, including groups whose events all fall outside the requested interval.",
  "required": true,
  "dependencies": [
   {
    "id": "D1",
    "relation": "uses_definition"
   }
  ],
  "acceptance_criteria": [
   "Groups equal the lexicographically sorted set of group names across all input events.",
   "Out-of-range events still establish group membership.",
   "An empty event list yields no groups."
  ],
  "blocked_by": []
 },
 {
  "id": "O3",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "For every group emit one bucket for each start + k*width with integer k >= 0 and bucket start strictly below end; its interval is [bucketStart, min(bucketStart + width, end)).",
  "required": true,
  "dependencies": [
   {
    "id": "D1",
    "relation": "uses_definition"
   },
   {
    "id": "O2",
    "relation": "uses_proof"
   }
  ],
  "acceptance_criteria": [
   "Each group has exactly the specified bucket starts in ascending order.",
   "Bucket lower boundaries are inclusive and upper boundaries are exclusive.",
   "The last bucket is clipped at end.",
   "start = end yields an empty result."
  ],
  "blocked_by": []
 },
 {
  "id": "O4",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "For each group and bucket, count and sum every matching event with non-null value whose time lies in that bucket; preserve duplicate event contributions.",
  "required": true,
  "dependencies": [
   {
    "id": "D1",
    "relation": "uses_definition"
   },
   {
    "id": "O3",
    "relation": "uses_proof"
   }
  ],
  "acceptance_criteria": [
   "count equals the number of non-null matching event occurrences in the bucket.",
   "sum equals the integer sum of those occurrences.",
   "Null values contribute neither to count nor sum.",
   "Events outside [start,end) contribute neither to count nor sum.",
   "Duplicate occurrences each contribute independently."
  ],
  "blocked_by": []
 },
 {
  "id": "O5",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "A bucket with count > 0 returns its sum as value. A bucket with count = 0 returns null for fill 'none'; for fill 'previous' it returns the sum of the latest earlier bucket of the same group with count > 0, or null if no such bucket exists.",
  "required": true,
  "dependencies": [
   {
    "id": "D1",
    "relation": "uses_definition"
   },
   {
    "id": "O4",
    "relation": "uses_proof"
   }
  ],
  "acceptance_criteria": [
   "Nonempty buckets return their sum for either fill mode.",
   "Empty buckets return null in fill 'none' mode.",
   "Empty buckets in fill 'previous' mode use only the latest earlier nonempty bucket of their own group.",
   "Before the first nonempty bucket, previous-filled values are null."
  ],
  "blocked_by": []
 },
 {
  "id": "O6",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "Return a list of records with group, start, count and value fields, ordered first by lexicographically sorted group and then by ascending bucket start, preserving the specified interface structure.",
  "required": true,
  "dependencies": [
   {
    "id": "O2",
    "relation": "uses_proof"
   },
   {
    "id": "O3",
    "relation": "uses_proof"
   },
   {
    "id": "O4",
    "relation": "uses_proof"
   },
   {
    "id": "O5",
    "relation": "uses_proof"
   }
  ],
  "acceptance_criteria": [
   "Each emitted record contains exactly group, start, count and value.",
   "Records follow group order and then bucket order.",
   "Record fields contain the group name, bucket start, contributing count and specified filled or summed value."
  ],
  "blocked_by": []
 },
 {
  "id": "O7",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "Match both supplied public example outputs exactly.",
  "required": true,
  "dependencies": [
   {
    "id": "O6",
    "relation": "uses_proof"
   },
   {
    "id": "I1",
    "relation": "uses_proof"
   }
  ],
  "acceptance_criteria": [
   "For group a with values 2 and -2 in the first bucket, return records at starts 0, 2 and 4 with counts 2, 0 and 0 and values 0, 0 and 0.",
   "For group z with its only event at time -1 and start 0, return one record at start 0 with count 0 and value null."
  ],
  "blocked_by": []
 },
 {
  "id": "I1",
  "kind": "invariant",
  "role": "guarantee",
  "statement": "During each group's ascending bucket traversal, previous is initially absent and changes only upon a bucket with count > 0, to that bucket's sum including zero. Empty buckets retain previous, and events before start never initialize it.",
  "required": true,
  "dependencies": [
   {
    "id": "O4",
    "relation": "uses_proof"
   }
  ],
  "acceptance_criteria": [
   "Previous state is independent for each group.",
   "Empty buckets never reset previous.",
   "A nonempty bucket with sum zero establishes previous = 0.",
   "Events before start cannot seed previous."
  ],
  "blocked_by": []
 },
 {
  "id": "R1",
  "kind": "resource_constraint",
  "role": "guarantee",
  "statement": "Use only Python standard-library facilities and perform no external I/O.",
  "required": true,
  "dependencies": [],
  "acceptance_criteria": [
   "No non-standard-library dependencies are required.",
   "Execution performs no external I/O."
  ],
  "blocked_by": []
 }
]
