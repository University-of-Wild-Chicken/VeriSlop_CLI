{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:verislop:schema:vscore-relation:0.3",
  "title": "Untrusted VSCore reference-refinement relation descriptor",
  "$comment": "Names the registered template and binds accepted symbols to program entries one-to-one. The registered checker derives the goal, adapters, refinement and transfer statements from the accepted IR; nothing here is a proposition or proof.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.3"
    },
    "format": {
      "const": "verislop.vscore-relation/0.3"
    },
    "template": {
      "const": "vscore.reference_refinement/0.3"
    },
    "source_slot": {
      "$ref": "urn:verislop:schema:bridge-plan:0.1#/$defs/id"
    },
    "proof_slot": {
      "$ref": "urn:verislop:schema:bridge-plan:0.1#/$defs/id"
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "symbol": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*(?![\\s\\S])",
            "minLength": 1,
            "maxLength": 128
          },
          "entry": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*(?![\\s\\S])",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "symbol",
          "entry"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "format",
    "template",
    "source_slot",
    "proof_slot",
    "bindings"
  ]
}
