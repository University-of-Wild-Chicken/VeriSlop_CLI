{"agent_attempt":0,"best":"import Std\n\n-- BEGIN VERISLOP REGISTRY\n-- Generated by `verislop formalize`. Typed obligation metadata: an index, never evidence.\nnamespace VeriSlop.Registry\n\nstructure SourceRef where\n  documentRef : String\n  documentHash : String\n  startByte : Nat\n  endByte : Nat\n  origin : String\n  interpretation : String\n\nstructure Dependency where\n  id : String\n  relation : String\n\nstructure Entry where\n  id : String\n  revision : Nat\n  kind : String\n  role : String\n  statement : String\n  required : Bool\n  sourceRefs : List SourceRef\n  scope : List String\n  dependencies : List Dependency\n  acceptanceCriteria : List String\n  bindings : List String\n\ndef «D1» : Entry := {\n  id := \"D1\",\n  revision := 1,\n  kind := \"entity\",\n  role := \"declaration\",\n  statement := \"The delivery is program.vscore.json with one typed entry solve of arity 1. Its input represents {events:[{group:string,time:int,value:int|null}],start:int,end:int,width:positive int,fill:'none'|'previous'} and its result represents an array of {group:string,start:int,count:natural,value:int|null}. Integers are unbounded mathematical integers, and strings consist of Unicode scalar values.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 79, endByte := 154, origin := \"explicit\", interpretation := \"delivery and entry identity\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 155, endByte := 239, origin := \"explicit\", interpretation := \"typed JSON structure\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 265, endByte := 393, origin := \"explicit\", interpretation := \"input domain\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 957, endByte := 1019, origin := \"explicit\", interpretation := \"result fields\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1080, endByte := 1227, origin := \"explicit\", interpretation := \"source and serialization standards\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1435, endByte := 1506, origin := \"explicit\", interpretation := \"integer domain\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1507, endByte := 1596, origin := \"explicit\", interpretation := \"string domain\" }],\n  scope := [\"typed input, result and canonical source\"],\n  dependencies := [],\n  acceptanceCriteria := [\"Input and result types preserve every specified field, array, nullable value and fill alternative under data-pipeline/0.3.\", \"The declared entry is solve with exactly one argument.\", \"Integer and string domains have the specified mathematical and Unicode meanings.\"],\n  bindings := [\"VeriSlopAST.Fill\", \"VeriSlopAST.Event\", \"VeriSlopAST.Input\", \"VeriSlopAST.Row\", \"VeriSlopAST.State\", \"VeriSlopAST.step\", \"VeriSlopAST.group_rows\", \"VeriSlopAST.solve\"] }\n\ndef «A1» : Entry := {\n  id := \"A1\",\n  revision := 1,\n  kind := \"precondition\",\n  role := \"assumption\",\n  statement := \"The caller supplies the specified structured input, with width a positive integer, start<=end, and fill equal to 'none' or 'previous'. No further size, magnitude, ordering, uniqueness or non-nullness precondition applies.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 265, endByte := 393, origin := \"explicit\", interpretation := \"stated input precondition\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1597, endByte := 1687, origin := \"explicit\", interpretation := \"no additional preconditions\" }],\n  scope := [\"caller input\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }],\n  acceptanceCriteria := [\"The input inhabits the specified type, width>0 and start<=end.\", \"The permitted domain includes empty event arrays, duplicate events, null values, arbitrary integer magnitudes and arbitrary Unicode scalar strings.\"],\n  bindings := [\"VeriSlopAST.valid\"] }\n\ndef «O1» : Entry := {\n  id := \"O1\",\n  revision := 1,\n  kind := \"postcondition\",\n  role := \"guarantee\",\n  statement := \"For every input satisfying A1, the admitted solve entry returns the complete specified grouped bucket aggregation. Let G be the sorted distinct event group names and B=[start+k*width | k is natural and start+k*width<end]. For g in G and b in B, let V(g,b) be the list of non-null event values with group g and b<=time<min(b+width,end), retaining duplicates; c(g,b)=length(V(g,b)) and s(g,b)=sum(V(g,b)). Each output row is {group:g,start:b,count:c(g,b),value:v(g,b)}, where v is s when c>0, null when c=0 and fill='none', and otherwise the sum of the latest earlier bucket of the same group with positive count, or null if none exists. Rows occur in group then bucket order. The implementation is canonical vscore/0.3 under normative Lean vscore-semantics/0.3 and data-pipeline/0.3.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 79, endByte := 154, origin := \"explicit\", interpretation := \"canonical delivered entry\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 155, endByte := 239, origin := \"explicit\", interpretation := \"typed input and result\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 394, endByte := 501, origin := \"explicit\", interpretation := \"group domain\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 502, endByte := 561, origin := \"explicit\", interpretation := \"bucket starts\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 562, endByte := 637, origin := \"explicit\", interpretation := \"bucket bounds\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 638, endByte := 672, origin := \"explicit\", interpretation := \"summation domain\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 673, endByte := 699, origin := \"explicit\", interpretation := \"count\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 700, endByte := 759, origin := \"explicit\", interpretation := \"nonempty bucket\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 760, endByte := 879, origin := \"explicit\", interpretation := \"fill branches\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 880, endByte := 915, origin := \"explicit\", interpretation := \"previous persistence\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 916, endByte := 956, origin := \"explicit\", interpretation := \"causal initialization\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 957, endByte := 1019, origin := \"explicit\", interpretation := \"output ordering\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1020, endByte := 1078, origin := \"explicit\", interpretation := \"zero and duplicates\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1080, endByte := 1227, origin := \"explicit\", interpretation := \"normative source semantics\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1294, endByte := 1352, origin := \"explicit\", interpretation := \"total pure deterministic execution\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1353, endByte := 1434, origin := \"explicit\", interpretation := \"immutable input and effect restrictions\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1435, endByte := 1506, origin := \"explicit\", interpretation := \"exact arithmetic\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1597, endByte := 1687, origin := \"explicit\", interpretation := \"entire domain\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 2649, endByte := 2760, origin := \"explicit\", interpretation := \"complete universal refinement\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5036, endByte := 5288, origin := \"explicit\", interpretation := \"mandatory source facets\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5289, endByte := 5458, origin := \"explicit\", interpretation := \"source properties cannot be replaced\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5459, endByte := 5654, origin := \"explicit\", interpretation := \"complete value proposition\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5957, endByte := 8118, origin := \"explicit\", interpretation := \"O1 policy row\" }],\n  scope := [\"every input satisfying A1\", \"complete source implementation and result\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }, { id := \"A1\", relation := \"assumes\" }],\n  acceptanceCriteria := [\"Universal implementation refinement establishes precisely the stated output formula over the entire specified domain, including end=start and empty events.\", \"For this obligation, program.vscore.json has one admitted typed entry solve of arity 1 and satisfies typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only.\", \"Source identity and all seven source properties require their own discharge; result existence or equality alone does not replace them.\", \"Arithmetic is exact and unbounded; no extra input bounds or preconditions restrict refinement.\"],\n  bindings := [\"VeriSlopAST.aggregation_contract\"] }\n\ndef «O2» : Entry := {\n  id := \"O2\",\n  revision := 1,\n  kind := \"postcondition\",\n  role := \"guarantee\",\n  statement := \"For every input satisfying A1, the groups used to construct output are exactly the distinct group names of all events, ordered lexicographically by Unicode scalar codepoints. Events outside [start,end) still contribute their group names. No group is introduced or omitted from this group sequence.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 394, endByte := 501, origin := \"explicit\", interpretation := \"complete sorted group set\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1507, endByte := 1596, origin := \"explicit\", interpretation := \"Unicode comparison\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 2649, endByte := 2760, origin := \"explicit\", interpretation := \"universal refinement\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5036, endByte := 5288, origin := \"explicit\", interpretation := \"source delivery\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5957, endByte := 8118, origin := \"explicit\", interpretation := \"O2 source and value facets\" }],\n  scope := [\"all event groups\", \"every input satisfying A1\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }, { id := \"A1\", relation := \"assumes\" }],\n  acceptanceCriteria := [\"The group sequence equals sort(distinct(map group events)) using scalar-codepoint lexicographic comparison.\", \"Groups having no in-range events receive the same prescribed bucket sequence as other groups; with no buckets the result remains empty.\", \"Universal source implementation refinement establishes the group formula.\", \"For O2, program.vscore.json contains one admitted typed solve entry of arity 1 satisfying typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only.\"],\n  bindings := [\"VeriSlopAST.aggregation_contract\"] }\n\ndef «O3» : Entry := {\n  id := \"O3\",\n  revision := 1,\n  kind := \"postcondition\",\n  role := \"guarantee\",\n  statement := \"For every input satisfying A1 and every group, output has exactly one bucket at each start+k*width for natural k with start+k*width<end, in increasing k order. Its interval is [start+k*width,min(start+(k+1)*width,end)). No other bucket exists.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 502, endByte := 561, origin := \"explicit\", interpretation := \"bucket progression\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 562, endByte := 637, origin := \"explicit\", interpretation := \"strict end and half-open intervals\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1435, endByte := 1506, origin := \"explicit\", interpretation := \"unbounded arithmetic\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 2649, endByte := 2760, origin := \"explicit\", interpretation := \"universal refinement\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5036, endByte := 5288, origin := \"explicit\", interpretation := \"source delivery\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5957, endByte := 8118, origin := \"explicit\", interpretation := \"O3 source and value facets\" }],\n  scope := [\"all groups and bucket positions\", \"every input satisfying A1\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }, { id := \"A1\", relation := \"assumes\" }],\n  acceptanceCriteria := [\"Bucket starts are exactly the stated arithmetic progression strictly below end.\", \"Every interval is half-open and the final interval is clipped to end.\", \"When start=end there are no output rows.\", \"Universal source implementation refinement establishes these formulas without integer overflow.\", \"For O3, program.vscore.json contains one admitted typed solve entry of arity 1 satisfying typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only.\"],\n  bindings := [\"VeriSlopAST.aggregation_contract\"] }\n\ndef «O4» : Entry := {\n  id := \"O4\",\n  revision := 1,\n  kind := \"postcondition\",\n  role := \"guarantee\",\n  statement := \"For every input satisfying A1, group g and emitted bucket start b, the count equals the number of event occurrences with group g, non-null value and b<=time<min(b+width,end); the sum equals the exact mathematical sum of their values. Duplicate occurrences each contribute independently. Null values and events outside the interval contribute neither count nor sum.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 638, endByte := 672, origin := \"explicit\", interpretation := \"non-null interval filtering\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 673, endByte := 699, origin := \"explicit\", interpretation := \"count formula\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1020, endByte := 1078, origin := \"explicit\", interpretation := \"duplicate multiplicity and zero sum\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1435, endByte := 1506, origin := \"explicit\", interpretation := \"exact integer summation\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 2649, endByte := 2760, origin := \"explicit\", interpretation := \"universal refinement\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5036, endByte := 5288, origin := \"explicit\", interpretation := \"source delivery\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5957, endByte := 8118, origin := \"explicit\", interpretation := \"O4 source and value facets\" }],\n  scope := [\"every emitted bucket\", \"all event occurrences\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }, { id := \"A1\", relation := \"assumes\" }],\n  acceptanceCriteria := [\"Count and sum equal the length and integer sum of the filtered event-value list, retaining multiplicity.\", \"A bucket with events but only null values has count zero.\", \"Negative and zero values contribute normally; cancellation does not make a positive-count bucket empty.\", \"Universal source implementation refinement establishes the complete filtering, count and sum formulas.\", \"For O4, program.vscore.json contains one admitted typed solve entry of arity 1 satisfying typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only.\"],\n  bindings := [\"VeriSlopAST.aggregation_contract\"] }\n\ndef «O5» : Entry := {\n  id := \"O5\",\n  revision := 1,\n  kind := \"postcondition\",\n  role := \"guarantee\",\n  statement := \"For every input satisfying A1, a bucket with positive count returns its sum regardless of fill and makes that sum the previous value for its group. For a zero-count bucket, fill='none' returns null; fill='previous' returns the sum of the latest earlier positive-count bucket of that group, or null when none exists. Empty buckets preserve previous, pre-start events never initialize it, and a previous sum of zero remains a present value.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 700, endByte := 759, origin := \"explicit\", interpretation := \"positive-count value and update\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 760, endByte := 879, origin := \"explicit\", interpretation := \"empty-bucket branches\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 880, endByte := 915, origin := \"explicit\", interpretation := \"previous persistence\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 916, endByte := 956, origin := \"explicit\", interpretation := \"no pre-start seed\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1020, endByte := 1078, origin := \"explicit\", interpretation := \"zero is present\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 2649, endByte := 2760, origin := \"explicit\", interpretation := \"universal refinement\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5036, endByte := 5288, origin := \"explicit\", interpretation := \"source delivery\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5957, endByte := 8118, origin := \"explicit\", interpretation := \"O5 source and value facets\" }],\n  scope := [\"all groups\", \"every bucket\", \"both fill alternatives\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }, { id := \"A1\", relation := \"assumes\" }],\n  acceptanceCriteria := [\"Before each group's first bucket, previous is absent.\", \"Positive count selects the current sum and updates previous, including sum zero.\", \"Zero count selects exactly the requested fill branch and never updates previous.\", \"Previous refers only to earlier emitted nonempty buckets of the same group.\", \"Universal source implementation refinement establishes every branch over the entire domain.\", \"For O5, program.vscore.json contains one admitted typed solve entry of arity 1 satisfying typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only.\"],\n  bindings := [\"VeriSlopAST.aggregation_contract\"] }\n\ndef «O6» : Entry := {\n  id := \"O6\",\n  revision := 1,\n  kind := \"postcondition\",\n  role := \"guarantee\",\n  statement := \"For every input satisfying A1, the returned JSON-compatible array contains exactly the rows prescribed by O1, each with group, start, count and value, ordered first by scalar-codepoint lexicographic group order and then increasing bucket start. Typed representation and serialization preserve these fields, nulls, exact integer values and array ordering.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 155, endByte := 239, origin := \"explicit\", interpretation := \"typed result structure\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 957, endByte := 1019, origin := \"explicit\", interpretation := \"row fields and ordering\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1080, endByte := 1227, origin := \"explicit\", interpretation := \"serialization profile\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1228, endByte := 1293, origin := \"explicit\", interpretation := \"exact structure and ordering\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1507, endByte := 1596, origin := \"explicit\", interpretation := \"scalar comparison\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 2649, endByte := 2760, origin := \"explicit\", interpretation := \"universal refinement\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5036, endByte := 5288, origin := \"explicit\", interpretation := \"source delivery\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5957, endByte := 8118, origin := \"explicit\", interpretation := \"O6 source and value facets\" }],\n  scope := [\"complete returned array\", \"typed representation and serialization\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }, { id := \"A1\", relation := \"assumes\" }],\n  acceptanceCriteria := [\"Output equals the concatenation, in sorted group order, of each group's increasing bucket rows.\", \"There are no extra, missing or reordered rows.\", \"data-pipeline/0.3 serialization preserves the specified structure and values.\", \"Universal source implementation refinement establishes structure and ordering.\", \"For O6, program.vscore.json contains one admitted typed solve entry of arity 1 satisfying typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only.\"],\n  bindings := [\"VeriSlopAST.aggregation_contract\"] }\n\ndef «O7» : Entry := {\n  id := \"O7\",\n  revision := 1,\n  kind := \"postcondition\",\n  role := \"guarantee\",\n  statement := \"The implementation universally refines the complete functional specification and preserves both public examples exactly: events (a,0,2) and (a,1,-2), start=0,end=5,width=2,fill='previous' yield rows (a,0,2,0),(a,2,0,0),(a,4,0,0); event (z,-1,9), start=0,end=1,width=2,fill='previous' yields (z,0,0,null), with tuple fields group,start,count,value.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1689, endByte := 1734, origin := \"explicit\", interpretation := \"public examples retained\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1735, endByte := 2282, origin := \"explicit\", interpretation := \"exact examples and universal refinement\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 2407, endByte := 2508, origin := \"explicit\", interpretation := \"unchanged functional meanings\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 2649, endByte := 2760, origin := \"explicit\", interpretation := \"complete universal refinement\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 2761, endByte := 2801, origin := \"explicit\", interpretation := \"examples are insufficient alone\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5036, endByte := 5288, origin := \"explicit\", interpretation := \"source delivery\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5957, endByte := 8118, origin := \"explicit\", interpretation := \"O7 source and value facets\" }],\n  scope := [\"both supplied public examples\", \"all inputs satisfying A1\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }, { id := \"A1\", relation := \"assumes\" }],\n  acceptanceCriteria := [\"The two concrete inputs produce precisely the supplied output arrays, including row order, counts, zeros and null.\", \"Examples supplement, and do not replace, universal implementation refinement of the complete O1 aggregation formula.\", \"For O7, program.vscore.json contains one admitted typed solve entry of arity 1 satisfying typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only.\"],\n  bindings := [\"VeriSlopAST.aggregation_contract\"] }\n\ndef «I1» : Entry := {\n  id := \"I1\",\n  revision := 1,\n  kind := \"invariant\",\n  role := \"guarantee\",\n  statement := \"Throughout each group's bucket traversal, previous is absent exactly when no earlier emitted bucket has positive count; otherwise it is the sum of the latest such bucket. A positive-count bucket replaces it with its sum, including zero; an empty bucket preserves it. Events before start never seed it. The admitted implementation preserves its input and has the required closed source properties.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 700, endByte := 759, origin := \"explicit\", interpretation := \"previous update\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 880, endByte := 915, origin := \"explicit\", interpretation := \"empty buckets preserve previous\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 916, endByte := 956, origin := \"explicit\", interpretation := \"causal initialization\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1020, endByte := 1078, origin := \"explicit\", interpretation := \"zero and duplicates\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1353, endByte := 1434, origin := \"explicit\", interpretation := \"input preservation\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5036, endByte := 5288, origin := \"explicit\", interpretation := \"mandatory source properties\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5716, endByte := 5869, origin := \"explicit\", interpretation := \"source-only operational classification\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5957, endByte := 8118, origin := \"explicit\", interpretation := \"I1 source policy\" }],\n  scope := [\"each group's complete traversal\", \"canonical source execution\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }, { id := \"A1\", relation := \"assumes\" }],\n  acceptanceCriteria := [\"The causal previous-value invariant holds initially and after every bucket, with no cross-group carry.\", \"Duplicate non-null occurrences contribute to count and sum; zero sum remains a real previous value.\", \"For I1, program.vscore.json contains one admitted typed solve entry of arity 1 satisfying typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only.\", \"I1 is classified source-only by the policy: its required source discharge is not replaced by a value-equality theorem, and its requested causal behavior remains specified.\"],\n  bindings := [\"VeriSlopAST.source_properties\"] }\n\ndef «S1» : Entry := {\n  id := \"S1\",\n  revision := 1,\n  kind := \"safety_property\",\n  role := \"guarantee\",\n  statement := \"The delivered program.vscore.json has exactly one admitted typed entry solve of arity 1 executing only canonical vscore/0.3 under normative Lean vscore-semantics/0.3 and data-pipeline/0.3. Execution is total, deterministic and pure over the specified domain, preserves immutable input, performs no external I/O, uses no external-effect constructors or floating point, and uses unbounded mathematical integer arithmetic.\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 79, endByte := 154, origin := \"explicit\", interpretation := \"pure admitted typed entry\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 240, endByte := 264, origin := \"explicit\", interpretation := \"no external I/O\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1080, endByte := 1227, origin := \"explicit\", interpretation := \"restricted normative source\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1294, endByte := 1352, origin := \"explicit\", interpretation := \"total pure deterministic execution\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1353, endByte := 1434, origin := \"explicit\", interpretation := \"immutable input and effect restrictions\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1435, endByte := 1506, origin := \"explicit\", interpretation := \"non-floating exact arithmetic\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1597, endByte := 1687, origin := \"explicit\", interpretation := \"no extra bounds\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5036, endByte := 5288, origin := \"explicit\", interpretation := \"mandatory source delivery\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5289, endByte := 5458, origin := \"explicit\", interpretation := \"independent source requirements\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5716, endByte := 5869, origin := \"explicit\", interpretation := \"source-only classification\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 5957, endByte := 8118, origin := \"explicit\", interpretation := \"S1 source policy\" }],\n  scope := [\"canonical source\", \"every admitted execution on the specified domain\"],\n  dependencies := [{ id := \"D1\", relation := \"uses_definition\" }, { id := \"A1\", relation := \"assumes\" }],\n  acceptanceCriteria := [\"For S1, the fixed file, entry and arity satisfy typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only.\", \"No execution modifies input or produces external effects.\", \"All admitted specified inputs terminate with a typed result and repeated execution gives the same result.\", \"All arithmetic uses exact unbounded integers; no additional domain restrictions apply.\", \"S1 is source-only, requiring source-property discharge rather than replacement by result existence or value equality.\"],\n  bindings := [\"VeriSlopAST.source_properties\"] }\n\ndef «inhabited» : Entry := {\n  id := \"inhabited\",\n  revision := 1,\n  kind := \"non_vacuity\",\n  role := \"guarantee\",\n  statement := \"Non-vacuity: Empty events, start zero, end zero, width one and fill none satisfy valid. (witnesses A1)\",\n  required := true,\n  sourceRefs := [{ documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 265, endByte := 393, origin := \"inferred\", interpretation := \"derived by registered rule verislop.non-vacuity/0.1 from assumption A1\" }, { documentRef := \"tier2:tier2-source-facets-018:D21\", documentHash := \"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2\", startByte := 1597, endByte := 1687, origin := \"inferred\", interpretation := \"derived by registered rule verislop.non-vacuity/0.1 from assumption A1\" }],\n  scope := [\"caller input\"],\n  dependencies := [{ id := \"A1\", relation := \"uses_definition\" }],\n  acceptanceCriteria := [\"Prove the existential theorem with concrete witnesses extractable by bounded kernel head-normalisation.\"],\n  bindings := [\"VeriSlopAST.nonvacuity\"] }\n\ndef entries : List Entry := [«D1», «A1», «O1», «O2», «O3», «O4», «O5», «O6», «O7», «I1», «S1», «inhabited»]\n\nend VeriSlop.Registry\n-- END VERISLOP REGISTRY\n\n/-!\nNormative restricted-source boundary requirement model, v0.1. These rules prove\nchecking soundness and inhabitation of an abstract fact model. They do not assert\nfacts about a delivered program, its evaluator, or a host runtime. The source\nbridge must derive every fact from the exact admitted source and semantic laws.\nThis algebra is independent of the Python NativeBoundary model.\n-/\nnamespace VeriSlop.Source\n\ninductive SourceRequirement where\n  | entry (file id : String) (arity : Nat)\n  | typedTotal\n  | deterministic\n  | inputPreserved\n  | noExternalIO\n  | noFloatingPoint\n  | pureData\n  | restrictedRuntimeOnly\n  deriving DecidableEq\n\nstructure Entry where\n  file : String\n  id : String\n  arity : Nat\n  deriving DecidableEq\n\nstructure ModuleFacts where\n  entries : List Entry\n  uniqueEntries : Bool\n  typedTotal : Bool\n  deterministic : Bool\n  inputPreserved : Bool\n  noExternalIO : Bool\n  noFloatingPoint : Bool\n  pureData : Bool\n  restrictedRuntimeOnly : Bool\n\ndef checkRequirement (r : SourceRequirement) (m : ModuleFacts) : Bool :=\n  match r with\n  | .entry f n a => m.uniqueEntries && decide (Entry.mk f n a ∈ m.entries)\n  | .typedTotal => m.typedTotal\n  | .deterministic => m.deterministic\n  | .inputPreserved => m.inputPreserved\n  | .noExternalIO => m.noExternalIO\n  | .noFloatingPoint => m.noFloatingPoint\n  | .pureData => m.pureData\n  | .restrictedRuntimeOnly => m.restrictedRuntimeOnly\n\ndef HoldsRequirement (r : SourceRequirement) (m : ModuleFacts) : Prop :=\n  match r with\n  | .entry f n a => m.uniqueEntries = true ∧ Entry.mk f n a ∈ m.entries\n  | .typedTotal => m.typedTotal = true\n  | .deterministic => m.deterministic = true\n  | .inputPreserved => m.inputPreserved = true\n  | .noExternalIO => m.noExternalIO = true\n  | .noFloatingPoint => m.noFloatingPoint = true\n  | .pureData => m.pureData = true\n  | .restrictedRuntimeOnly => m.restrictedRuntimeOnly = true\n\ndef checkBoundary (rs : List SourceRequirement) (m : ModuleFacts) : Bool :=\n  rs.all (fun r => checkRequirement r m)\n\ndef HoldsBoundary (rs : List SourceRequirement) (m : ModuleFacts) : Prop :=\n  ∀ r ∈ rs, HoldsRequirement r m\n\ndef Transfer (rs : List SourceRequirement) : Prop :=\n  ∀ m, checkBoundary rs m = true → HoldsBoundary rs m\n\ndef AdmissionInhabited (rs : List SourceRequirement) : Prop :=\n  ∃ m, checkBoundary rs m = true\n\n/-- Closed accepted data identifies the endpoint; Contract supplies only abstract\nchecking rules and does not establish implementation refinement. -/\nstructure SourceDefinition (τ : Type) where\n  endpoint : τ\n  requirements : List SourceRequirement\n\ndef Contract {τ : Type} (d : SourceDefinition τ) : Prop :=\n  Transfer d.requirements ∧ AdmissionInhabited d.requirements\n\ntheorem checkRequirement_sound (r : SourceRequirement) (m : ModuleFacts) :\n    checkRequirement r m = true → HoldsRequirement r m := by\n  cases r <;> simp [checkRequirement, HoldsRequirement, Bool.and_eq_true]\n\ntheorem transfer_sound (rs : List SourceRequirement) : Transfer rs := by\n  intro m h r hr\n  exact checkRequirement_sound r m ((List.all_eq_true.mp h) r hr)\n\ndef witnessEntries : List SourceRequirement → List Entry\n  | [] => []\n  | .entry f n a :: rs => Entry.mk f n a :: witnessEntries rs\n  | _ :: rs => witnessEntries rs\n\ndef modelWitness (rs : List SourceRequirement) : ModuleFacts :=\n  ⟨witnessEntries rs, true, true, true, true, true, true, true, true⟩\n\ntheorem entry_in_witness (f n : String) (a : Nat) (rs : List SourceRequirement)\n    (h : SourceRequirement.entry f n a ∈ rs) : Entry.mk f n a ∈ witnessEntries rs := by\n  induction rs with\n  | nil => simp at h\n  | cons r rs ih => cases r <;> simp_all [witnessEntries] <;> grind\n\ntheorem admission_inhabited (rs : List SourceRequirement) : AdmissionInhabited rs := by\n  refine ⟨modelWitness rs, List.all_eq_true.mpr ?_⟩\n  intro r hr\n  cases r with\n  | entry f n a =>\n    simp [checkRequirement, modelWitness, entry_in_witness f n a rs hr]\n  | typedTotal => rfl\n  | deterministic => rfl\n  | inputPreserved => rfl\n  | noExternalIO => rfl\n  | noFloatingPoint => rfl\n  | pureData => rfl\n  | restrictedRuntimeOnly => rfl\n\ntheorem contract_sound {τ : Type} (d : SourceDefinition τ) : Contract d :=\n  ⟨transfer_sound d.requirements, admission_inhabited d.requirements⟩\n\nend VeriSlop.Source\n\nnamespace VeriSlopAST\ninductive «Fill» where\n  | «none»\n  | «previous»\n  deriving _root_.DecidableEq\nstructure «Event» where\n  «group» : _root_.String\n  «time» : _root_.Int\n  «value» : (_root_.Option _root_.Int)\nstructure «Input» where\n  «events» : (_root_.List _root_.VeriSlopAST.«Event»)\n  «start» : _root_.Int\n  «end» : _root_.Int\n  «width» : _root_.Int\n  «fill» : _root_.VeriSlopAST.«Fill»\nstructure «Row» where\n  «group» : _root_.String\n  «start» : _root_.Int\n  «count» : _root_.Nat\n  «value» : (_root_.Option _root_.Int)\nstructure «State» where\n  «rows» : (_root_.List _root_.VeriSlopAST.«Row»)\n  «previous» : (_root_.Option _root_.Int)\ndef «step» («_v0» : _root_.VeriSlopAST.«Input») («_v1» : _root_.String) («_v2» : _root_.VeriSlopAST.«State») («_v3» : _root_.Int) : _root_.VeriSlopAST.«State» := (@_root_.List.foldl _root_.VeriSlopAST.«State» (_root_.List _root_.Int) (fun («_v4» : _root_.VeriSlopAST.«State») («_v5» : (_root_.List _root_.Int)) => (_root_.VeriSlopAST.«State».«mk» (@_root_.List.append _root_.VeriSlopAST.«Row» (_root_.VeriSlopAST.«State».«rows» «_v4») ([(_root_.VeriSlopAST.«Row».«mk» «_v1» «_v3» (@_root_.List.length _root_.Int «_v5») (@_root_.cond (_root_.Option _root_.Int) (@_roo