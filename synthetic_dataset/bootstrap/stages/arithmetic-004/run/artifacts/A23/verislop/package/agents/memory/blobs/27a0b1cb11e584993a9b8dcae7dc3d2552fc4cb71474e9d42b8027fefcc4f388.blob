{"obligations":[{"id":"D1","revision":1,"kind":"entity","role":"declaration","statement":"solution.py exposes a single Python 3 solve(data) function receiving a JSON-compatible object with integer fields n, m, a, b and returning a JSON-serializable integer.","required":true,"scope":["function interface"],"dependencies":[],"acceptance_criteria":["The callable is solve(data) in solution.py.","Input structure is {n,m,a,b}; output is the scalar integer sum."],"sources":[{"quote":"Implement solution.py with a single solve(data) function.","origin":"explicit","interpretation":"required module and callable"},{"quote":"data and the return value must be JSON-compatible.","origin":"explicit","interpretation":"serialization contract"},{"quote":"Input {n,m,a,b}: 0<=n<=500, m>0, a/b any signed integers (possibly magnitude 10^30).","origin":"explicit","interpretation":"integer input fields"},{"quote":"The function receives a JSON value and returns a JSON-serializable value.","origin":"explicit","interpretation":"JSON interface"},{"quote":"Preserve the specified input/output structure and exact ordering.","origin":"explicit","interpretation":"retain object input and scalar output; summation indices follow the specified order"}]},{"id":"A1","revision":1,"kind":"precondition","role":"assumption","statement":"The input supplier provides inputs satisfying the specified schema: integer n with 0<=n<=500, positive integer m, and arbitrary signed integers a and b, including magnitudes of 10^30.","required":true,"scope":["supplied inputs"],"dependencies":[{"id":"D1","relation":"uses_definition"}],"acceptance_criteria":["Supplied inputs satisfy the field schema and bounds.","No extra positivity or magnitude restriction is imposed on a or b."],"sources":[{"quote":"All supplied inputs satisfy the stated schema and bounds;","origin":"explicit","interpretation":"input supplier guarantee"},{"quote":"Input {n,m,a,b}: 0<=n<=500, m>0, a/b any signed integers (possibly magnitude 10^30).","origin":"explicit","interpretation":"specified valid domain"}]},{"id":"O1","revision":1,"kind":"postcondition","role":"guarantee","statement":"For every valid input, return the exact integer sum of floor((a*i+b)/m) over indices i=0 through n-1, using floor toward negative infinity; return zero when n=0.","required":true,"scope":["all valid inputs"],"dependencies":[{"id":"A1","relation":"assumes"},{"id":"D1","relation":"uses_definition"}],"acceptance_criteria":["Output equals the mathematical sum for every valid input.","Negative nonintegral quotients round toward negative infinity.","n=0 returns integer zero.","For {a:-2,b:1,m:3,n:4}, output is -4.","For {a:100,b:-99,m:7,n:0}, output is 0."],"sources":[{"quote":"Return exact sum of floor((a*i+b)/m) for i=0..n-1.","origin":"explicit","interpretation":"exact summation"},{"quote":"Floor means toward negative infinity, not truncation.","origin":"explicit","interpretation":"signed rounding semantics"},{"quote":"Empty sum is zero;","origin":"explicit","interpretation":"empty domain result"},{"quote":"[{\"input\": {\"a\": -2, \"b\": 1, \"m\": 3, \"n\": 4}, \"output\": -4}, {\"input\": {\"a\": 100, \"b\": -99, \"m\": 7, \"n\": 0}, \"output\": 0}]","origin":"explicit","interpretation":"required example outputs"},{"quote":"Preserve the specified input/output structure and exact ordering.","origin":"explicit","interpretation":"specified index sequence and scalar result"}]},{"id":"O2","revision":1,"kind":"safety_property","role":"guarantee","statement":"The implementation uses only Python 3 and its standard library, performs no external I/O, does not read benchmark files, and avoids floating-point arithmetic.","required":true,"scope":["implementation and execution"],"dependencies":[],"acceptance_criteria":["No non-standard-library dependency is used.","No external I/O or benchmark-file reads occur.","Sum computation uses no floating-point arithmetic."],"sources":[{"quote":"Use Python 3 standard library only;","origin":"explicit","interpretation":"implementation restrictions"},{"quote":"perform no external I/O and do not read benchmark files.","origin":"explicit","interpretation":"prohibited effects"},{"quote":"avoid floating point.","origin":"explicit","interpretation":"numeric implementation restriction"},{"quote":"Use only the standard library, no external I/O.","origin":"explicit","interpretation":"repeated restrictions"}]},{"id":"O3","revision":1,"kind":"postcondition","role":"guarantee","statement":"solve(data) is pure and deterministic: the same valid input yields the same output without observable side effects or input mutation.","required":true,"scope":["all valid invocations"],"dependencies":[{"id":"A1","relation":"assumes"}],"acceptance_criteria":["Repeated invocations on equal valid inputs produce equal results.","Invocation does not mutate its input or produce observable side effects."],"sources":[{"quote":"Implement a pure deterministic Python 3 function solve(data) in solution.py.","origin":"explicit","interpretation":"purity and determinism"}]},{"id":"N1","revision":1,"kind":"explicit_non_goal","role":"exclusion","statement":"Behavior for malformed input is outside the required contract.","required":true,"scope":["malformed inputs"],"dependencies":[],"acceptance_criteria":["No validation or error-response obligation is imposed for malformed input."],"sources":[{"quote":"no behavior is required for malformed input.","origin":"explicit","interpretation":"explicit exclusion"}]}],"category_review":{"entities":"Python 3 solution.py, solve(data), integer-field input object, scalar integer output","preconditions":"Supplier guarantees schema and bounds","postconditions":"Exact signed floor sum, zero empty sum, example results, purity and determinism","invariants":"none stated","safety_properties":"Standard library only; no external I/O, benchmark-file reads, or floating point","liveness_properties":"none stated","resource_constraints":"none stated","error_semantics":"Malformed inputs explicitly excluded","explicit_non_goals":"Malformed-input behavior","ambiguities":"none"},"clauses":[{"clause_id":"C1","quote":"Software engineering task A23: Signed arithmetic floor-sum kernel","disposition":"context","refs":[],"note":"Task identifier and descriptive title."},{"clause_id":"C2","quote":"Implement solution.py with a single solve(data) function.","disposition":"obligations","refs":["D1"],"note":""},{"clause_id":"C3","quote":"data and the return value must be JSON-compatible.","disposition":"obligations","refs":["D1"],"note":""},{"clause_id":"C4","quote":"Use Python 3 standard library only;","disposition":"obligations","refs":["O2"],"note":""},{"clause_id":"C5","quote":"perform no external I/O and do not read benchmark files.","disposition":"obligations","refs":["O2"],"note":""},{"clause_id":"C6","quote":"All supplied inputs satisfy the stated schema and bounds;","disposition":"obligations","refs":["A1"],"note":""},{"clause_id":"C7","quote":"no behavior is required for malformed input.","disposition":"exclusion","refs":["N1"],"note":""},{"clause_id":"C8","quote":"Input {n,m,a,b}: 0<=n<=500, m>0, a/b any signed integers (possibly magnitude 10^30).","disposition":"obligations","refs":["D1","A1"],"note":""},{"clause_id":"C9","quote":"Return exact sum of floor((a*i+b)/m) for i=0..n-1.","disposition":"obligations","refs":["O1"],"note":""},{"clause_id":"C10","quote":"Floor means toward negative infinity, not truncation.","disposition":"obligations","refs":["O1"],"note":""},{"clause_id":"C11","quote":"Empty sum is zero;","disposition":"obligations","refs":["O1"],"note":""},{"clause_id":"C12","quote":"avoid floating point.","disposition":"obligations","refs":["O2"],"note":""},{"clause_id":"C13","quote":"Implement a pure deterministic Python 3 function solve(data) in solution.py.","disposition":"obligations","refs":["D1","O3"],"note":""},{"clause_id":"C14","quote":"Use only the standard library, no external I/O.","disposition":"obligations","refs":["O2"],"note":""},{"clause_id":"C15","quote":"The function receives a JSON value and returns a JSON-serializable value.","disposition":"obligations","refs":["D1"],"note":""},{"clause_id":"C16","quote":"Preserve the specified input/output structure and exact ordering.","disposition":"obligations","refs":["D1","O1"],"note":""},{"clause_id":"C17","quote":"Public examples (additional held-out cases will be scored):\\n[{\\\"input\\\": {\\\"a\\\": -2, \\\"b\\\": 1, \\\"m\\\": 3, \\\"n\\\": 4}, \\\"output\\\": -4}, {\\\"input\\\": {\\\"a\\\": 100, \\\"b\\\": -99, \\\"m\\\": 7, \\\"n\\\": 0}, \\\"output\\\": 0}]","disposition":"obligations","refs":["O1"],"note":"Examples constrain observable outputs; held-out scoring provides evaluation context."}],"assumptions":[{"id":"A1","supplied_by":"input supplier","discharged_at":"Each solve(data) invocation, by supplied input satisfying the stated schema and bounds"}],"ambiguities":[],"selected_defaults":[]}