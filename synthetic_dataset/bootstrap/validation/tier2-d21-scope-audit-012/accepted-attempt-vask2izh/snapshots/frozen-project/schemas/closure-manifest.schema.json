{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:verislop:schema:closure-manifest:0.2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "format": {
      "const": "verislop.closure-manifest/0.2"
    },
    "closure_id": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "role",
          "size",
          "sha256"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "format",
    "closure_id",
    "entries"
  ]
}
