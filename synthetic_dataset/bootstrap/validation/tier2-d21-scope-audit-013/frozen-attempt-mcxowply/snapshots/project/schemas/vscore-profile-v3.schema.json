{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:verislop:schema:vscore-profile:0.3",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.3"
    },
    "format": {
      "const": "verislop.vscore-profile/0.3"
    },
    "language": {
      "const": "vscore/0.3"
    },
    "accepted_profile": {
      "type": "string"
    },
    "accepted_profile_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "enums": {
      "type": "object"
    },
    "records": {
      "type": "object"
    },
    "symbols": {
      "type": "object"
    },
    "representation": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "format",
    "language",
    "accepted_profile",
    "accepted_profile_hash",
    "enums",
    "records",
    "symbols",
    "representation"
  ]
}
