input satisfying A1, the groups used by solve are exactly the distinct group names occurring anywhere in events, sorted lexicographically by Unicode scalar codepoints, including names whose events all lie outside [start,end). This behavior must be universally refined by the arity-1 solve entry in canonical program.vscore.json, with typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only."},{"acceptance_criteria":["Every permitted bucket start appears once per group and no other start appears; intervals are half-open and the last interval is clipped to end; the exact canonical source universally implements this formula and all seven source properties."],"dependencies":[{"id":"A1","relation":"assumes"},{"id":"D1","relation":"uses_definition"}],"id":"O3","kind":"postcondition","lifecycle":{"END_TO_END_VERIFIED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"FORMALIZED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"IMPLEMENTED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"INTERPRETED":{"evidence_refs":["provenance:tier2:tier2-source-facets-011:D21"],"outcome":"PASS","reason":"Recorded interpretation proposal; not mathematical proof.","scope":["recorded interpretation of the request"]},"LINKED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"PROVED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"TESTED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"TYPECHECKED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]}},"required":true,"revision":1,"role":"guarantee","scope":["all groups and all specified intervals"],"source_refs":[{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-011:D21","end_byte":561,"interpretation":"bucket progression","origin":"explicit","start_byte":502},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-011:D21","end_byte":637,"interpretation":"strict endpoint and clipped half-open intervals","origin":"explicit","start_byte":562},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-011:D21","end_byte":5288,"interpretation":"required canonical source delivery","origin":"explicit","start_byte":5036},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-011:D21","end_byte":5654,"interpretation":"universal functional refinement","origin":"explicit","start_byte":5459},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-011:D21","end_byte":8118,"interpretation":"O3 source and value facets","origin":"explicit","start_byte":5957}],"state":"INTERPRETED","statement":"For every group and every input satisfying A1, emit exactly the buckets with starts b_k = start + k*width for natural k satisfying b_k < end. Bucket k covers [b_k,min(b_k+width,end)). When start=end there are no buckets. The arity-1 solve entry in canonical program.vscore.json must universally refine this behavior and satisfy typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only."},{"acceptance_criteria":["Counts equal the multiplicity-sensitive number of eligible non-null events and sums equal their exact integer sum; the exact canonical source universally implements this behavior and all seven source properties."],"dependencies":[{"id":"D1","relation":"uses_definition"},{"id":"A1","relation":"assumes"}],"id":"O4","kind":"postcondition","lifecycle":{"END_TO_END_VERIFIED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"FORMALIZED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"IMPLEMENTED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"INTERPRETED":{"evidence_refs":["provenance:tier2:tier2-source-facets-011:D21"],"outcome":"PASS","reason":"Recorded interpretation proposal; not mathematical proof.","scope":["recorded interpretation of the request"]},"LINKED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"PROVED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"TESTED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"TYPECHECKED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]}},"required":true,"revision":1,"role":"guarantee","scope":["every group and bucket on all specified inputs"],"source_refs":[{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-011:D21","end_byte":672,"interpretation":"eligible summands","origin":"explicit","start_byte":638},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-011:D21","end_byte":699,"interpretation":"eligible count","origin":"explicit","start_byte":673},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-011:D21","end_byte":1078,"interpretation":"duplicate multiplicity","origin":"explicit","start_byte":1020},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-011:D21","end_byte":1506,"interpretation":"unbounded exact sums","origin":"explicit","start_byte":1435},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-011:D21","end_byte":5288,"interpretation":"required canonical source delivery","origin":"explicit","start_byte":5036},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-011:D21","end_byte":5654,"interpretation":"universal functional refinement","origin":"explicit","start_byte":5459},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-011:D21","end_byte":8118,"interpretation":"O4 source and value facets","origin":"explicit","start_byte":5957}],"state":"INTERPRETED","statement":"For every group g and emitted bucket start b, let M(g,b) be the multiset of event occurrences e with e.group=g, b<=e.time<min(b+width,end) and e.value non-null. count=|M(g,b)| and sum is the exact mathematical sum of those values, with empty sum zero. Each duplicate occurrence contributes separately; null and out-of-range values contribute neither count nor sum. The arity-1 solve entry in canonical program.vscore.json must universally implement these formulas with typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only."},{"acceptance_criteria":["For count>0, value=sum regardless of fill.","For count=0 and fill='none', value=null.","For count=0 and fill='previous', value is null if no earlier nonempty same-group bucket exists, otherwise the sum at the greatest earlier nonempty bucket index.","Only nonempty in-range buckets update previous; zero is retained, empty buckets do not reset it and groups do not share it.","The exact canonical source universally implements these formulas and all seven source properties."],"dependencies":[{"id":"D1","relation":"uses_definition"},{"id":"A1","relation":"assumes"}],"id":"O5","kind":"postcondition","lifecycle":{"END_TO_END_VERIFIED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"FORMALIZED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"IMPLEMENTED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"INTERPRETED":{"evidence_refs":["provenance:tier2:tier2-source-facets-011:D21"],"outcome":"PASS","reason":"Recorded interpretation proposal; not mathematical proof.","scope":["recorded interpretation of the request"]},"LINKED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"PROVED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"TESTED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"TYPECHECKED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]}},"required":true,"revision":1,"role":"guarantee","scope":["both fill modes and every bucket of every group"],"source_refs":[{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-011:D21","end_byte":759,"interpretation":"nonempty value and previous update","origin":"explicit","start_byte":700},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-011:D21","end_byte":879,"interpretation":"empty fill branches","origin":"explicit","start_byte":760},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-011:D21","end_byte":915,"interpretation":"previous preservation","origin":"explicit","start_byte":880},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-011:D21","end_byte":956,"interpretation":"causal initialization","origin":"explicit","start_byte":916},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-011:D21","end_byte":1078,"interpretation":"zero previous value","origin":"explicit","start_byte":1020},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-011:D21","end_byte":5288,"interpretation":"required canonical source delivery","origin":"explicit","start_byte":5036},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-011:D21","end_byte":5654,"interpretation":"universal functional refinement","origin":"explicit","start_byte":5459},{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340d977799f2","document_ref":"tier2:tier2-source-facets-011:D21","end_byte":8118,"interpretation":"O5 source and value facets","origin":"explicit","start_byte":5957}],"state":"INTERPRETED","statement":"For each group independently, process its buckets in increasing start order with previous initially null. If count>0, output the bucket sum and set previous to that sum, including zero. If count=0, output null when fill='none'; when fill='previous', output the sum of the latest earlier bucket of this same group having count>0, or null if none exists. Empty buckets preserve previous; events before start cannot seed it. The arity-1 solve entry in canonical program.vscore.json must universally refine these branches with typed_total, deterministic, input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only."},{"acceptance_criteria":["Output equals the specified ordered group-by-bucket list, including exact fields and null/integer representations; the exact canonical source universally implements this list formula and all seven source properties."],"dependencies":[{"id":"D1","relation":"uses_definition"},{"id":"A1","relation":"assumes"},{"id":"O2","relation":"uses_proof"},{"id":"O3","relation":"uses_proof"},{"id":"O4","relation":"uses_proof"},{"id":"O5","relation":"uses_proof"}],"id":"O6","kind":"postcondition","lifecycle":{"END_TO_END_VERIFIED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"FORMALIZED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"IMPLEMENTED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"INTERPRETED":{"evidence_refs":["provenance:tier2:tier2-source-facets-011:D21"],"outcome":"PASS","reason":"Recorded interpretation proposal; not mathematical proof.","scope":["recorded interpretation of the request"]},"LINKED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"PROVED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"TESTED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"TYPECHECKED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]}},"required":true,"revision":1,"role":"guarantee","scope":["complete result on all specified inputs"],"source_refs":[{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87