 input_preserved, no_external_io, no_floating_point, pure_data and restricted_runtime_only."},{"acceptance_criteria":["For events [(a,0,2),(a,1,-2)], start=0,end=5,width=2,fill='previous', output is [{group:'a',start:0,count:2,value:0},{group:'a',start:2,count:0,value:0},{group:'a',start:4,count:0,value:0}].","For events [(z,-1,9)], start=0,end=1,width=2,fill='previous', output is [{group:'z',start:0,count:0,value:null}].","The complete O2 through O6 formulas are universally refined by this exact source, and all seven required source properties hold."],"dependencies":[{"id":"A1","relation":"assumes"},{"id":"O6","relation":"uses_proof"}],"id":"O7","kind":"postcondition","lifecycle":{"END_TO_END_VERIFIED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"FORMALIZED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"IMPLEMENTED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"INTERPRETED":{"evidence_refs":["provenance:tier2:tier2-source-facets-011:D21"],"outcome":"PASS","reason":"Recorded interpretation proposal; not mathematical proof.","scope":["recorded interpretation of the request"]},"LINKED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"PROVED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"TESTED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]},"TYPECHECKED":{"evidence_refs":[],"outcome":"PENDING","reason":"No VeriSlop verifier has evaluated this milestone.","scope":[]}},"required":true,"revision":1,"role":"guarantee","scope":["public examples and universal specified domain"],"source_refs":[{"document_hash":"sha256:789cb596e5b534eacc67b4942a06050b87af78619d904ab1a54e340