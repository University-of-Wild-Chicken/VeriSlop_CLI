      "revision": 1,
      "kind": "safety_property",
      "role": "guarantee",
      "statement": "The canonical program.vscore.json arity-1 solve entry executes only within the admitted restricted runtime: typed_total, deterministic, input_preserved, no_external_io, no_floating_point and pure_data. It performs no external I/O, cannot invoke external-effect constructors, does not mutate input, and uses unbounded mathematical integer arithmetic. S1 is explicitly source-only and retains these source requirements.",
      "required": true,
      "scope": ["canonical source and all admitted executions"],
