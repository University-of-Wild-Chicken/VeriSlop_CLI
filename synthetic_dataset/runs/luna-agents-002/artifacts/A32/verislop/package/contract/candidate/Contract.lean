constant returnsNull : JsonValue → Prop
constant returnsCompletion : JsonValue → Grid4x4 → Prop
constant lexicographicallyNoGreater : Grid4x4 → Grid4x4 → Prop
constant pureDeterministicPythonStdlib : Prop

