{"obligations":[{"id":"D1","revision":1,"kind":"entity","role":"declaration","statement":"The input is a JSON object with n and edges, where n is an integer from 0 through 10 and edges contains directed pairs [u,v].","required":true,"scope":["input graph"],"dependencies":[],"acceptance_criteria":["Recognize n and edges as the specified graph input.","Interpret each [u,v] as a directed edge from u to v."],"sources":[{"quote":"Input {n,edges}, n=0..10, directed [u,v];","origin":"explicit","interpretation":"Graph input structure and size domain."}]},{"id":"A1","revision":1,"kind":"precondition","role":"assumption","statement":"All supplied inputs conform to the specification.","required":true,"scope":["function invocations"],"dependencies":[{"id":"D1","relation":"uses_definition"}],"acceptance_criteria":["The caller supplies inputs conforming to the specified graph input domain."],"sources":[{"quote":"All inputs conform to this specification;","origin":"explicit","interpretation":"Explicit input-conformance assumption."}]},{"id":"O1","revision":1,"kind":"postcondition","role":"guarantee","statement":"Provide a pure deterministic Python 3 function solve(data) in solution.py that receives the specified JSON input and returns a JSON-serializable value.","required":true,"scope":["solution.py","solve(data)"],"dependencies":[{"id":"A1","relation":"assumes"}],"acceptance_criteria":["solution.py exposes solve(data).","Repeated calls with equivalent input produce equivalent output.","The returned value is JSON-serializable."],"sources":[{"quote":"Implement solution.py with solve(data).","origin":"explicit","interpretation":"Required module and callable."},{"quote":"Implement a pure deterministic Python 3 function solve(data) in solution.py.","origin":"explicit","interpretation":"Language, purity and determinism."},{"quote":"return JSON-compatible values.","origin":"explicit","interpretation":"Output compatibility."},{"quote":"The function receives a JSON value and returns a JSON-serializable value.","origin":"explicit","interpretation":"Function input and output interface."}]},{"id":"S1","revision":1,"kind":"safety_property","role":"guarantee","statement":"Use only the Python standard library, perform no external I/O, and neither read files, use the network, print, nor retain state across calls.","required":true,"scope":["implementation","all invocations"],"dependencies":[],"acceptance_criteria":["No nonstandard-library dependency is used.","No file reading, network access, printing or other external I/O occurs.","No state is retained across calls."],"sources":[{"quote":"Use only the Python standard library.","origin":"explicit","interpretation":"Allowed dependency boundary."},{"quote":"Do not read files, use the network, print, or retain state across calls.","origin":"explicit","interpretation":"Forbidden effects and persistent state."},{"quote":"Use only the standard library, no external I/O.","origin":"explicit","interpretation":"Dependency and I/O restrictions."}]},{"id":"O2","revision":1,"kind":"postcondition","role":"guarantee","statement":"Treat duplicate directed edges as a single edge throughout cycle detection and transitive reduction.","required":true,"scope":["all conforming graphs"],"dependencies":[{"id":"D1","relation":"uses_definition"},{"id":"A1","relation":"assumes"}],"acceptance_criteria":["Adding or removing duplicate copies of an edge does not change the result."],"sources":[{"quote":"duplicates are ignored.","origin":"explicit","interpretation":"Set semantics for input edges."}]},{"id":"E1","revision":1,"kind":"error_semantics","role":"guarantee","statement":"Return null whenever any directed cycle exists anywhere in the graph, including a self-loop or a cycle in a disconnected component.","required":true,"scope":["cyclic conforming graphs"],"dependencies":[{"id":"D1","relation":"uses_definition"},{"id":"A1","relation":"assumes"}],"acceptance_criteria":["Every graph containing a directed cycle returns Python None, serialized as JSON null.","Cycle detection covers the entire graph.","A self-loop causes a null result."],"sources":[{"quote":"Return null if any cycle exists.","origin":"explicit","interpretation":"Global cycle rejection, including self-loops."}]},{"id":"O3","revision":1,"kind":"postcondition","role":"guarantee","statement":"For an acyclic graph, return precisely the unique original edges [u,v] for which no alternate u-to-v path of at least two edges exists, sorted lexicographically by u then v.","required":true,"scope":["acyclic conforming graphs"],"dependencies":[{"id":"D1","relation":"uses_definition"},{"id":"A1","relation":"assumes"},{"id":"O2","relation":"uses_proof"}],"acceptance_criteria":["An original edge is retained if and only if there is no alternate path from its source to its destination using at least two edges.","The output contains no added edges or duplicate edges.","The output is a list of two-element lists sorted by source and then destination.","An edgeless graph, including n=0, returns an empty list."],"sources":[{"quote":"Otherwise return sorted unique edges [u,v] retained by the DAG transitive reduction: retain an edge exactly when there is no alternate u-to-v path using at least two edges.","origin":"explicit","interpretation":"Exact reduction predicate and sorted unique edge output."},{"quote":"Preserve the specified input/output structure and exact ordering.","origin":"explicit","interpretation":"Preserve output shape and ordering."}]},{"id":"O4","revision":1,"kind":"postcondition","role":"guarantee","statement":"For an acyclic input, the returned graph preserves all directed reachability, contains no redundant edges, and represents isolated vertices implicitly without separate output entries.","required":true,"scope":["acyclic conforming graphs"],"dependencies":[{"id":"D1","relation":"uses_definition"},{"id":"A1","relation":"assumes"},{"id":"O3","relation":"uses_proof"}],"acceptance_criteria":["For every vertex pair, reachability in the output equals reachability in the input.","Removing any returned edge would destroy reachability between its endpoints.","Isolated vertices produce no separate entries in the output."],"sources":[{"quote":"Preserve reachability, include no redundant edges, and keep isolated vertices implicit.","origin":"explicit","interpretation":"Reachability preservation, minimality and isolated-vertex representation."}]},{"id":"O5","revision":1,"kind":"postcondition","role":"guarantee","statement":"Match both public examples: the graph with edges [0,1], [1,2] and duplicate [0,2] returns [[0,1],[1,2]], and the single self-loop graph returns null.","required":true,"scope":["public examples"],"dependencies":[{"id":"O2","relation":"uses_proof"},{"id":"E1","relation":"uses_proof"},{"id":"O3","relation":"uses_proof"}],"acceptance_criteria":["solve({\"edges\":[[0,1],[1,2],[0,2],[0,2]],\"n\":3}) returns [[0,1],[1,2]].","solve({\"edges\":[[0,0]],\"n\":1}) returns None."],"sources":[{"quote":"[{\"input\": {\"edges\": [[0, 1], [1, 2], [0, 2], [0, 2]], \"n\": 3}, \"output\": [[0, 1], [1, 2]]}, {\"input\": {\"edges\": [[0, 0]], \"n\": 1}, \"output\": null}]","origin":"explicit","interpretation":"Concrete duplicate, transitive-edge and self-loop examples."}]}],"category_review":{"entities":"Directed graph represented by n and edges; JSON input and output.","preconditions":"Explicit caller-supplied input conformance.","postconditions":"Pure deterministic callable, duplicate handling, exact sorted DAG reduction, reachability preservation and public-example results.","invariants":"No separate invariant stated.","safety_properties":"Standard-library-only implementation, no external I/O or state retained across calls.","liveness_properties":"None stated.","resource_constraints":"Input size is bounded by n=0..10; no execution resource bound stated.","error_semantics":"Return null for any directed cycle anywhere in the graph.","explicit_non_goals":"None stated.","ambiguities":"None requiring resolution."},"clauses":[{"clause_id":"C1","quote":"Software engineering task G13: Transitive reduction with global cycle checks","disposition":"context","refs":[],"note":"Task title; global cycle checks and reduction behavior are specified by E1 and O3."},{"clause_id":"C2","quote":"Implement solution.py with solve(data).","disposition":"obligations","refs":["O1"],"note":""},{"clause_id":"C3","quote":"Use only the Python standard library.","disposition":"obligations","refs":["S1"],"note":""},{"clause_id":"C4","quote":"Do not read files, use the network, print, or retain state across calls.","disposition":"obligations","refs":["S1"],"note":""},{"clause_id":"C5","quote":"All inputs conform to this specification;","disposition":"obligations","refs":["A1"],"note":""},{"clause_id":"C6","quote":"return JSON-compatible values.","disposition":"obligations","refs":["O1"],"note":""},{"clause_id":"C7","quote":"Input {n,edges}, n=0..10, directed [u,v];","disposition":"obligations","refs":["D1"],"note":""},{"clause_id":"C8","quote":"duplicates are ignored.","disposition":"obligations","refs":["O2"],"note":""},{"clause_id":"C9","quote":"Return null if any cycle exists.","disposition":"obligations","refs":["E1"],"note":""},{"clause_id":"C10","quote":"Otherwise return sorted unique edges [u,v] retained by the DAG transitive reduction: retain an edge exactly when there is no alternate u-to-v path using at least two edges.","disposition":"obligations","refs":["O3"],"note":""},{"clause_id":"C11","quote":"Preserve reachability, include no redundant edges, and keep isolated vertices implicit.","disposition":"obligations","refs":["O4"],"note":""},{"clause_id":"C12","quote":"Implement a pure deterministic Python 3 function solve(data) in solution.py.","disposition":"obligations","refs":["O1"],"note":""},{"clause_id":"C13","quote":"Use only the standard library, no external I/O.","disposition":"obligations","refs":["S1"],"note":""},{"clause_id":"C14","quote":"The function receives a JSON value and returns a JSON-serializable value.","disposition":"obligations","refs":["O1"],"note":""},{"clause_id":"C15","quote":"Preserve the specified input/output structure and exact ordering.","disposition":"obligations","refs":["D1","O1","O3"],"note":""},{"clause_id":"C16","quote":"Public examples (additional held-out cases will be scored):\\n[{\\\"input\\\": {\\\"edges\\\": [[0, 1], [1, 2], [0, 2], [0, 2]], \\\"n\\\": 3}, \\\"output\\\": [[0, 1], [1, 2]]}, {\\\"input\\\": {\\\"edges\\\": [[0, 0]], \\\"n\\\": 1}, \\\"output\\\": null}]","disposition":"obligations","refs":["O5"],"note":"Examples are required behavior; held-out scoring is evaluation context."}],"assumptions":[{"id":"A1","supplied_by":"caller","discharged_at":"Each solve(data) invocation, by supplying input conforming to the specification."}],"ambiguities":[],"selected_defaults":[]}