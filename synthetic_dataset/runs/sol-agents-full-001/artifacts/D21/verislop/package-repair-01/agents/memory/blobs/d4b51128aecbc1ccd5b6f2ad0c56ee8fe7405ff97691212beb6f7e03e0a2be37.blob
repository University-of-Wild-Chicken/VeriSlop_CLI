  "blocked_by": []
 },
 {
  "id": "O3",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "For every selected group, emit one bucket for every start + k*width strictly below end, for nonnegative integer k. Each bucket covers [bucketStart, min(bucketStart+width,end)).",
  "required": true,
  "dependencies": [
   {
    "id": "A1",
    "relation": "assumes"
   },
   {
    "id": "O2",
    "relation": "uses_proof"
   }
  ],
  "acceptance_criteria": [
   "Bucket starts follow the specified arithmetic progression.",
   "Lower endpoints are included and upper endpoints excluded.",
   "The final bucket is clipped at end.",
   "start = end emits no buckets."
  ],
  "blocked_by": []
 },
 {
  "id": "O4",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "Within each group and bucket, sum and count exactly the non-null event values whose times belong to that bucket. Count duplicate events separately. A bucket is nonempty exactly when this count is positive, and its value is its sum, including a sum of zero.",
  "required": true,
  "dependencies": [
   {
    "id": "O3",
    "relation": "uses_proof"
   }
  ],
  "acceptance_criteria": [
   "Null values contribute neither to sum nor count.",
   "Out-of-range events contribute neither to sum nor count.",
   "Duplicate occurrences each contribute.",
   "Positive count implies value equals the integer sum even when zero."
  ],
  "blocked_by": []
 },
 {
  "id": "O5",
  "kind": "postcondition",
  "role": "guarantee",
  "statement": "For an empty bucket, return count zero and value null in fill none mode. In fill previous mode, return the latest previous nonempty bucket sum, or null when none exists.",
  "required": true,
  "dependencies": [
   {
    "id": "I1",
    "relation": "uses_proof"
   },
   {
    "id": "O4",
    "relation": "uses_proof"
   }
  ],
  "acceptance_criteria": [
