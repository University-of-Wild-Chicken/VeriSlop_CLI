             | none => state ++ [(id', val')]
           process rest new_state
         | Operation.remove id' => process rest (state.filter (fun (id'', _) => id'' ≠ id'))
         | Operation.median => process rest state
     process ops []
   in ¬ (∃ (v : Int), (id, v) ∈ state_after)) := by sorry

