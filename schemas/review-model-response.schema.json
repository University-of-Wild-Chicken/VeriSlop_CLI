{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:verislop:schema:review-model-response:0.1",
  "title": "Untrusted raw reviewer response for optional constrained generation",
  "$defs": {
    "probe": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "target_case"
            },
            "obligation_id": {
              "type": "string",
              "minLength": 1
            },
            "assignment": {
              "type": "array",
              "maxItems": 32,
              "items": {}
            }
          },
          "required": [
            "kind",
            "obligation_id",
            "assignment"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "source_violation"
            },
            "obligation_id": {
              "type": "string",
              "minLength": 1
            },
            "file": {
              "type": "string",
              "minLength": 1
            },
            "ast_path": {
              "type": "string",
              "minLength": 1
            },
            "rule": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "obligation_id",
            "file",
            "ast_path",
            "rule"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "missing_requirement"
            },
            "start_byte": {
              "type": "integer",
              "minimum": 0
            },
            "end_byte": {
              "type": "integer",
              "minimum": 1
            },
            "quoted": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "start_byte",
            "end_byte",
            "quoted"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "mechanical_failure"
            },
            "claim_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "claim_id"
          ]
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "verdict": {
      "enum": [
        "ACCEPT",
        "REJECT",
        "ABSTAIN"
      ]
    },
    "reviewed_obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "search": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "attempted_cases": {
              "type": "integer",
              "const": 1
            },
            "probes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "$ref": "#/$defs/probe"
              }
            },
            "conclusion": {
              "enum": [
                "NO_COUNTEREXAMPLE_FOUND",
                "COUNTEREXAMPLE_CANDIDATE",
                "INCOMPLETE"
              ]
            }
          },
          "required": [
            "method",
            "attempted_cases",
            "probes",
            "conclusion"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "attempted_cases": {
              "type": "integer",
              "const": 2
            },
            "probes": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "$ref": "#/$defs/probe"
              }
            },
            "conclusion": {
              "enum": [
                "NO_COUNTEREXAMPLE_FOUND",
                "COUNTEREXAMPLE_CANDIDATE",
                "INCOMPLETE"
              ]
            }
          },
          "required": [
            "method",
            "attempted_cases",
            "probes",
            "conclusion"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "attempted_cases": {
              "type": "integer",
              "const": 3
            },
            "probes": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "$ref": "#/$defs/probe"
              }
            },
            "conclusion": {
              "enum": [
                "NO_COUNTEREXAMPLE_FOUND",
                "COUNTEREXAMPLE_CANDIDATE",
                "INCOMPLETE"
              ]
            }
          },
          "required": [
            "method",
            "attempted_cases",
            "probes",
            "conclusion"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "attempted_cases": {
              "type": "integer",
              "const": 4
            },
            "probes": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/probe"
              }
            },
            "conclusion": {
              "enum": [
                "NO_COUNTEREXAMPLE_FOUND",
                "COUNTEREXAMPLE_CANDIDATE",
                "INCOMPLETE"
              ]
            }
          },
          "required": [
            "method",
            "attempted_cases",
            "probes",
            "conclusion"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "attempted_cases": {
              "type": "integer",
              "const": 5
            },
            "probes": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": {
                "$ref": "#/$defs/probe"
              }
            },
            "conclusion": {
              "enum": [
                "NO_COUNTEREXAMPLE_FOUND",
                "COUNTEREXAMPLE_CANDIDATE",
                "INCOMPLETE"
              ]
            }
          },
          "required": [
            "method",
            "attempted_cases",
            "probes",
            "conclusion"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "attempted_cases": {
              "type": "integer",
              "const": 6
            },
            "probes": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "items": {
                "$ref": "#/$defs/probe"
              }
            },
            "conclusion": {
              "enum": [
                "NO_COUNTEREXAMPLE_FOUND",
                "COUNTEREXAMPLE_CANDIDATE",
                "INCOMPLETE"
              ]
            }
          },
          "required": [
            "method",
            "attempted_cases",
            "probes",
            "conclusion"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "attempted_cases": {
              "type": "integer",
              "const": 7
            },
            "probes": {
              "type": "array",
              "minItems": 7,
              "maxItems": 7,
              "items": {
                "$ref": "#/$defs/probe"
              }
            },
            "conclusion": {
              "enum": [
                "NO_COUNTEREXAMPLE_FOUND",
                "COUNTEREXAMPLE_CANDIDATE",
                "INCOMPLETE"
              ]
            }
          },
          "required": [
            "method",
            "attempted_cases",
            "probes",
            "conclusion"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "attempted_cases": {
              "type": "integer",
              "const": 8
            },
            "probes": {
              "type": "array",
              "minItems": 8,
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/probe"
              }
            },
            "conclusion": {
              "enum": [
                "NO_COUNTEREXAMPLE_FOUND",
                "COUNTEREXAMPLE_CANDIDATE",
                "INCOMPLETE"
              ]
            }
          },
          "required": [
            "method",
            "attempted_cases",
            "probes",
            "conclusion"
          ]
        }
      ]
    },
    "findings": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "blocking",
              "major",
              "minor"
            ]
          },
          "obligations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string"
          },
          "trigger": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          },
          "counterexample": {
            "$ref": "#/$defs/probe"
          }
        },
        "required": [
          "id",
          "severity",
          "obligations",
          "statement",
          "counterexample"
        ]
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rationale": {
      "type": "string"
    }
  },
  "required": [
    "verdict",
    "reviewed_obligations",
    "search",
    "findings",
    "limitations",
    "rationale"
  ]
}
