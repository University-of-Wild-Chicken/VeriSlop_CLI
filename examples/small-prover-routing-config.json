{
  "schema_version": "0.1",
  "bridge_tier": 2,
  "endpoint": "restricted_source",
  "proof_routing": {
    "enabled": false,
    "initial_agent": "local-small-prover",
    "initial_attempts": 3
  },
  "providers": {
    "openai": {
      "adapter": "openai",
      "api_family": "responses",
      "endpoint_profile": "openai-direct",
      "credential_ref": "env:OPENAI_API_KEY",
      "concurrency": 1,
      "request_timeout_seconds": null
    },
    "local": {
      "adapter": "ollama",
      "api_family": "ollama_chat",
      "endpoint_profile": "ollama-local",
      "concurrency": 1,
      "request_timeout_seconds": null
    }
  },
  "agents": {
    "author": {
      "provider": "openai",
      "model_ref": "env:VERISLOP_AUTHOR_MODEL",
      "tool_profile": "candidate_writer",
      "max_output_tokens": 8192
    },
    "configured-prover": {
      "provider": "openai",
      "model_ref": "env:VERISLOP_PROVER_MODEL",
      "tool_profile": "proof_sandbox",
      "max_output_tokens": 8192
    },
    "reviewer": {
      "provider": "openai",
      "model_ref": "env:VERISLOP_REVIEW_MODEL",
      "tool_profile": "review_readonly",
      "max_output_tokens": 8192
    },
    "local-small-prover": {
      "provider": "local",
      "model_ref": "env:VERISLOP_SMALL_PROVER_MODEL",
      "tool_profile": "proof_sandbox",
      "proof_response_format": "theorem_fragment",
      "max_output_tokens": 4096,
      "context_window_tokens": 16384
    }
  },
  "roles": {
    "interpreter": "author",
    "formalizer": "author",
    "prover": "configured-prover",
    "implementer": "author",
    "repairer": "author"
  },
  "review": {
    "checkpoints": ["formal_contract", "release"],
    "restart_after_repair": "first_tier",
    "budgets": {
      "max_repair_rounds": 3,
      "max_provider_retries": 2,
      "max_calls_per_instance": 8,
      "max_total_tokens": 200000,
      "max_wall_seconds_per_tier": 0
    },
    "review_tiers": [{
      "id": "R0",
      "reviewers": [{"agent": "reviewer", "count": 1, "focus": "counterexamples"}],
      "consensus": {
        "mode": "unanimous",
        "require_all_responses": true,
        "max_soft_rejects": 0,
        "max_abstentions": 0,
        "blocking_findings_veto": true
      }
    }]
  },
  "release": {
    "require_mechanical_pass": true,
    "require_all_review_tiers": true,
    "require_requested_bridge_tier": true
  }
}
